{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "types": ["@cloudflare/workers-types", "node"],
    "paths": {
      "@nba/db": ["libs/shared/db/src/index.ts"],
      "@nba/pdf": ["libs/shared/pdf/src/index.ts"],
      "@nba/push": ["libs/shared/push/src/index.ts"],
      "@nba/html": ["libs/shared/html/src/index.ts"],
      "@nba/preview": ["libs/shared/preview/src/index.ts"],
      "@nba/db/test-utils": ["libs/shared/db/src/test-utils.ts"],
      "@nba/ui": ["libs/shared/ui/src/index.ts"],
      "@nba/api-client": ["libs/shared/api-client/src/index.ts"],
      "@nba/security-headers": ["libs/shared/security-headers/src/index.ts"],
      "@nba/members-api": ["libs/domains/members/index.ts"],
      "@nba/members/schema": ["libs/domains/members/shared/schema.ts"],
      "@nba/accounting-api": ["libs/domains/accounting/index.ts"],
      "@nba/accounting/schema": ["libs/domains/accounting/shared/schema.ts"],
      "@nba/expenses-api": ["libs/domains/expenses/index.ts"],
      "@nba/expenses/schema": ["libs/domains/expenses/shared/schema.ts"],
      "@nba/shop-api": ["libs/domains/shop/index.ts"],
      "@nba/shop/schema": ["libs/domains/shop/shared/schema.ts"],
      "@nba/notifications-api": ["libs/domains/notifications/index.ts"],
      "@nba/notifications/schema": ["libs/domains/notifications/shared/schema.ts"],
      "@nba/iam": ["libs/domains/iam/index.ts"],
      "@nba/iam/schema": ["libs/domains/iam/shared/schema.ts"],
      "@nba/iam-ui": ["libs/domains/iam/shared/ui.ts"],
      "@nba/members-ui": ["libs/domains/members/shared/ui.ts"],
      "@nba/accounting-ui": ["libs/domains/accounting/shared/ui.ts"],
      "@nba/expenses-ui": ["libs/domains/expenses/shared/ui.ts"],
      "@nba/shop-ui": ["libs/domains/shop/shared/ui.ts"],
      "@nba/notifications-ui": ["libs/domains/notifications/shared/ui.ts"],
      "@nba/cms-api": ["libs/domains/cms/index.ts"],
      "@nba/cms/public": ["libs/domains/cms/shared/public.ts"],
      "@nba/cms-ui": ["libs/domains/cms/shared/ui.ts"],
      "@nba/schedules-api": ["libs/domains/schedules/index.ts"],
      "@nba/schedules/schema": ["libs/domains/schedules/shared/schema.ts"],
      "@nba/events-api": ["libs/domains/events/index.ts"],
      "@nba/events/schema": ["libs/domains/events/shared/schema.ts"],
      "@nba/schedules-ui": ["libs/domains/schedules/shared/ui.ts"],
      "@nba/events-ui": ["libs/domains/events/shared/ui.ts"],
      "@nba/teams-api": ["libs/domains/teams/index.ts"],
      "@nba/teams/schema": ["libs/domains/teams/shared/schema.ts"],
      "@nba/teams-ui": ["libs/domains/teams/shared/ui.ts"],
      "@nba/cms/schema": ["libs/domains/cms/shared/schema.ts"]
    }

  },
  "include": ["libs/**/*.ts", "apps/**/*.ts"],
  "exclude": ["node_modules", "dist", "apps/*/dist", "apps/*/.astro"]
}
