{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@nba/db": ["libs/shared/db/src/index.ts"],
      "@nba/core": ["libs/shared/core/src/index.ts"],
      "@nba/ui": ["libs/shared/ui/src/index.ts"],
      "@metacult/shared-db/test-utils": ["libs/shared/db/src/test-utils.ts"],
      "@metacult/shared-db": ["libs/shared/db/src/index.ts"],
      "@metacult/features-members-api": ["libs/domains/members/index.ts"],
      "@metacult/features-accounting-api": ["libs/domains/accounting/index.ts"],
      "@metacult/features-expenses-api": ["libs/domains/expenses/index.ts"],
      "@metacult/features-shop-api": ["libs/domains/shop/index.ts"],
      "@metacult/shared-ui": ["libs/shared/ui/src/index.ts"],
      "@metacult/features-members-ui": ["libs/domains/members/ui.ts"],
      "@metacult/features-accounting-ui": ["libs/domains/accounting/ui.ts"],
      "@metacult/features-expenses-ui": ["libs/domains/expenses/ui.ts"],
      "@metacult/features-shop-ui": ["libs/domains/shop/ui.ts"]
    }
  }
}
