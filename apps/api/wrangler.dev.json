{
  "name": "nba-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-03-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nba-db",
      "database_id": "MOCK_DB_ID_FOR_LOCAL",
      "migrations_dir": "../../libs/shared/db/migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "INTERNAL_API_KEY": "dev-secret-key-12345"
  }
}
