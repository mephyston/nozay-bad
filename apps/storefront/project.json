{
  "name": "storefront",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/storefront/src",
  "targets": {
    "lint": {
      "command": "eslint {projectRoot}"
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "inputs": [
        "production",
        "^production",
        {
          "env": "PUBLIC_APP_ENV"
        },
        {
          "env": "PUBLIC_VAPID_PUBLIC_KEY"
        },
        {
          "env": "PUBLIC_TURNSTILE_SITE_KEY"
        }
      ],
      "options": {
        "command": "astro build",
        "cwd": "apps/storefront"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "PUBLIC_APP_ENV=development astro dev --port 4322",
        "cwd": "apps/storefront"
      }
    }
  },
  "tags": [
    "type:app",
    "scope:storefront"
  ]
}
