---
import { pwaInfo } from 'virtual:pwa-info';
import { ModeWatcher } from 'mode-watcher';
import { PwaInstallBanner } from '@nba/ui';
import { EnvBanner } from '@nba/ui';
import PwaSplash from '../components/PwaSplash.astro';
import '@fontsource-variable/outfit';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
// Suffixe d'icône selon l'environnement (inliné au build) : bandeau DEV / TEST.
const APP_ENV = import.meta.env.PUBLIC_APP_ENV || 'production';
const ICON_SUFFIX = APP_ENV === 'development' ? '-dev' : APP_ENV === 'staging' ? '-test' : '';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Nozay Bad" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon${ICON_SUFFIX}.png`} />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" is:inline async defer></script>
    <script>
      import { registerSW } from 'virtual:pwa-register'
      if (typeof window !== 'undefined' && 'serviceWorker' in navigator) {
        const updateSW = registerSW({
          onNeedRefresh() {
            if (confirm('Nouvelle version disponible. Mettre à jour ?')) {
              updateSW(true)
            }
          }
        });
      }
    </script>
    <script is:inline>
      (function() {
        try {
          let theme = 'light';
          if (typeof localStorage !== 'undefined') {
            let rawMode = localStorage.getItem('mode-watcher-mode') || localStorage.getItem('mode-watcher-user-preference');
            if (rawMode) {
              theme = rawMode.replace(/"/g, '').trim();
              if (rawMode !== theme) {
                localStorage.setItem('mode-watcher-mode', theme);
                localStorage.setItem('mode-watcher-user-preference', theme);
              }
            } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
              theme = 'dark';
            }
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
          }
          
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.style.colorScheme = 'dark';
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.style.colorScheme = 'light';
          }
        } catch (e) {}
      })();
    </script>
    <style is:inline>
      html.dark {
        background-color: rgb(38, 38, 36) !important;
        color: rgb(241, 241, 239);
        --background: rgb(38, 38, 36);
        --foreground: rgb(241, 241, 239);
        --sidebar: rgb(31, 30, 29);
        --sidebar-foreground: rgb(195, 192, 182);
        --card: rgb(44, 44, 43);
        --card-foreground: rgb(250, 249, 245);
        --popover: rgb(48, 48, 46);
        --popover-foreground: rgb(229, 229, 226);
        --muted: rgb(27, 27, 25);
        --muted-foreground: rgb(183, 181, 169);
        --accent: rgb(26, 25, 21);
        --border: rgb(62, 62, 56);
      }
      html:not(.dark) {
        background-color: rgb(250, 249, 245);
        color: rgb(61, 57, 41);
        --background: rgb(250, 249, 245);
        --foreground: rgb(61, 57, 41);
        --sidebar: rgb(245, 244, 238);
        --sidebar-foreground: rgb(61, 61, 58);
        --card: rgb(245, 244, 239);
        --card-foreground: rgb(20, 20, 19);
        --popover: rgb(255, 255, 255);
        --popover-foreground: rgb(40, 38, 27);
        --muted: rgb(237, 233, 222);
        --muted-foreground: rgb(110, 109, 104);
        --accent: rgb(233, 230, 220);
        --border: rgb(218, 217, 212);
      }
    </style>
  </head>
  <body class="bg-background text-foreground min-h-screen flex flex-col antialiased font-sans">
    <EnvBanner />
    <ModeWatcher client:load />
    <!-- L'installation sur l'écran d'accueil est un prérequis du push sur iOS. -->
    <PwaInstallBanner client:idle />
    <PwaSplash />
    <slot />
  </body>
</html>
