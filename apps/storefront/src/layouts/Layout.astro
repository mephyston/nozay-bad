---
import { ModeWatcher } from 'mode-watcher';
import { PwaInstallBanner } from '@nba/ui';
import { EnvBanner } from '@nba/ui';
import PwaSplash from '../components/PwaSplash.astro';
import '@fontsource-variable/outfit';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
// Le club suffixe le titre de l'onglet ; en son absence (repli), le titre reste nu.
const club = Astro.locals.club?.settings;
const titreOnglet = club?.shortName ? `${title} - ${club.shortName}` : title;
// Suffixe d'icône selon l'environnement (inliné au build) : bandeau DEV / TEST.
const APP_ENV = import.meta.env.PUBLIC_APP_ENV || 'production';
const ICON_SUFFIX = APP_ENV === 'development' ? '-dev' : APP_ENV === 'staging' ? '-test' : '';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={club?.shortName || "Espace adhérent"} />
    <link rel="icon" type="image/png" href="/pwa/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href={`/pwa/apple-touch-icon${ICON_SUFFIX}.png`} />
    <link rel="manifest" href="/manifest.webmanifest" />
    {description && <meta name="description" content={description} />}
    <title>{titreOnglet}</title>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" is:inline async defer></script>
    <script>
      /*
       * Nouvelle version : un bandeau, et non un `confirm()`.
       *
       * La boîte native coupait l'application au milieu de ce que l'adhérent faisait,
       * ne ressemblait à rien du reste de l'interface, et n'offrait que « rechercher
       * maintenant ou plus jamais » — un refus ne se represente pas.
       *
       * Le service worker du storefront porte les notifications push, d'où
       * `registerType: 'prompt'` : il ne doit pas être remplacé sous les pieds de
       * quelqu'un qui remplit une inscription. C'est donc bien à l'adhérent de choisir
       * le moment, mais sans qu'on lui bloque l'écran pour le lui demander.
       */
      import { registerSW } from 'virtual:pwa-register'
      if (typeof window !== 'undefined' && 'serviceWorker' in navigator) {
        const banner = document.getElementById('sw-update-banner');
        const reload = document.getElementById('sw-update-reload');
        const dismiss = document.getElementById('sw-update-dismiss');

        const updateSW = registerSW({
          onNeedRefresh() {
            banner?.classList.remove('hidden');
          }
        });

        reload?.addEventListener('click', () => {
          reload.setAttribute('disabled', 'true');
          reload.textContent = 'Un instant…';
          updateSW(true);
        });
        // Écarté pour cette visite seulement : la version suivante le reproposera, et
        // le service worker en attente reste prêt à prendre la main au prochain
        // démarrage de l'application.
        dismiss?.addEventListener('click', () => banner?.classList.add('hidden'));
      }
    </script>
    <script is:inline>
      (function() {
        try {
          let theme = 'light';
          if (typeof localStorage !== 'undefined') {
            let rawMode = localStorage.getItem('mode-watcher-mode') || localStorage.getItem('mode-watcher-user-preference');
            if (rawMode) {
              theme = rawMode.replace(/"/g, '').trim();
              if (rawMode !== theme) {
                localStorage.setItem('mode-watcher-mode', theme);
                localStorage.setItem('mode-watcher-user-preference', theme);
              }
            } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
              theme = 'dark';
            }
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
          }
          
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.style.colorScheme = 'dark';
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.style.colorScheme = 'light';
          }
        } catch (e) {}
      })();
    </script>
    <style is:inline>
      html.dark {
        background-color: rgb(38, 38, 36) !important;
        color: rgb(241, 241, 239);
        --background: rgb(38, 38, 36);
        --foreground: rgb(241, 241, 239);
        --sidebar: rgb(31, 30, 29);
        --sidebar-foreground: rgb(195, 192, 182);
        --card: rgb(44, 44, 43);
        --card-foreground: rgb(250, 249, 245);
        --popover: rgb(48, 48, 46);
        --popover-foreground: rgb(229, 229, 226);
        --muted: rgb(27, 27, 25);
        --muted-foreground: rgb(183, 181, 169);
        --accent: rgb(26, 25, 21);
        --border: rgb(62, 62, 56);
      }
      html:not(.dark) {
        background-color: rgb(250, 249, 245);
        color: rgb(61, 57, 41);
        --background: rgb(250, 249, 245);
        --foreground: rgb(61, 57, 41);
        --sidebar: rgb(245, 244, 238);
        --sidebar-foreground: rgb(61, 61, 58);
        --card: rgb(245, 244, 239);
        --card-foreground: rgb(20, 20, 19);
        --popover: rgb(255, 255, 255);
        --popover-foreground: rgb(40, 38, 27);
        --muted: rgb(237, 233, 222);
        --muted-foreground: rgb(110, 109, 104);
        --accent: rgb(233, 230, 220);
        --border: rgb(218, 217, 212);
      }
    </style>
  </head>
  <body class="bg-background text-foreground min-h-screen flex flex-col antialiased font-sans">
    <EnvBanner />
    <ModeWatcher client:load />
    <!-- L'installation sur l'écran d'accueil est un prérequis du push sur iOS. -->
    <PwaInstallBanner client:idle />
    <PwaSplash />
    <slot />

    <!--
      Posé au-dessus de la barre d'onglets flottante en petite largeur (hauteur + décollement + zone sûre), qui
      occupe le bas de l'écran et masquerait sinon le bandeau. Sur grand écran, il n'y a
      pas de barre : le bandeau se range simplement en bas.
    -->
    <div
      id="sw-update-banner"
      class="hidden fixed inset-x-0 bottom-[calc(5.75rem+env(safe-area-inset-bottom,0px))] z-50 mx-3 rounded-xl border border-border bg-card px-4 py-3 shadow-lg md:bottom-4 md:mx-auto md:max-w-md"
      role="status"
    >
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="text-sm text-foreground">Une nouvelle version est disponible.</p>
        <div class="flex items-center gap-2">
          <button
            id="sw-update-dismiss"
            type="button"
            class="min-h-[36px] rounded-lg px-3 text-sm font-medium text-muted-foreground hover:text-foreground"
          >
            Plus tard
          </button>
          <button
            id="sw-update-reload"
            type="button"
            class="min-h-[36px] rounded-lg bg-primary px-3 text-sm font-bold text-primary-foreground hover:bg-primary/90 disabled:opacity-60"
          >
            Recharger
          </button>
        </div>
      </div>
    </div>
  </body>
</html>
