---
import { dayShort, fixtureWhenShort, teamColor, venueShort, type ClubFixture } from '../lib/club-fixtures';

interface Props {
  fixtures: ClubFixture[];
  weekend: boolean;
  /** Jour civil du club : le jour même, l'heure suffit. */
  today: string;
}

const { fixtures, weekend, today } = Astro.props;
---

{/*
  Les rencontres de toutes les équipes, le week-end dès le vendredi, le jour même en semaine.

  La même carte que « Prochaine rencontre » : en-tête avec son icône, contenu, pied avec le
  lien. Dedans, une bande qui défile à l'horizontale, à hauteur fixe : dix équipes qui jouent
  ne repoussent pas l'accueil d'autant d'écrans. La couleur de l'équipe n'est qu'une pastille,
  comme dans le calendrier, et toujours accompagnée de son nom.
*/}
{fixtures.length > 0 && (
  <section class="rounded-xl border border-border bg-card shadow-sm" aria-labelledby="rencontres-club-title">
    <header class="flex items-center gap-2.5 border-b border-border px-4 py-3 sm:px-5">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-primary" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <h2 id="rencontres-club-title" class="text-base font-semibold text-foreground">
        {weekend ? 'Ce week-end, nos équipes jouent' : "Aujourd'hui, nos équipes jouent"}
      </h2>
      <span class="ml-auto rounded-full bg-primary/10 px-2 py-0.5 text-xs font-semibold text-primary">{fixtures.length}</span>
    </header>

    <ul class="flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 py-3 sm:px-5" style="scrollbar-width: none">
      {fixtures.map((fixture) => (
        <li class="w-60 shrink-0 snap-start">
          <a
            href={`/equipes/${fixture.teamId}/journee/${fixture.dayNumber}${fixture.slot > 1 ? `?r=${fixture.slot}` : ''}`}
            class="flex h-full flex-col rounded-lg border border-border bg-background px-3 py-2.5 hover:bg-muted/50"
          >
            {/* Le match en titre : « NBA91-1 vs Orsay 3 », tel que le capitaine a saisi l'adversaire. */}
            <span class="flex items-center gap-2">
              <span class="size-2.5 shrink-0 rounded-full" style={`background-color: ${teamColor(fixture.teamNumber)}`} aria-hidden="true"></span>
              <span class="truncate font-semibold text-foreground">
                {fixture.teamName}{fixture.opponent ? ` vs ${fixture.opponent}` : ''}
              </span>
            </span>
            {/* Le reste sur une ligne : « ICD Mixte · J3 · 20 h 30 à Palaiseau ». */}
            <span class="mt-1 truncate text-sm text-muted-foreground">
              {fixture.championshipShortLabel} · {dayShort(fixture)} · <span class="font-medium text-foreground">{fixtureWhenShort(fixture, today)}</span>{fixture.venue && <span> à {venueShort(fixture.venue)}</span>}
            </span>
            {!fixture.opponent && <span class="text-xs text-muted-foreground">Adversaire à préciser</span>}
          </a>
        </li>
      ))}
    </ul>

    <footer class="border-t border-border px-4 py-3 sm:px-5">
      <a href="/agenda?vue=interclubs" class="inline-flex min-h-[44px] items-center gap-1 text-sm font-semibold text-primary hover:underline">
        Toutes les rencontres du club &rarr;
      </a>
    </footer>
  </section>
)}
