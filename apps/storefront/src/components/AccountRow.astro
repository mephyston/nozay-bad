---
interface Props {
  href: string;
  title: string;
  description?: string;
  /** Ce qu'on vient y chercher, à droite : un nombre, un état. */
  value?: string;
}

/**
 * Une rubrique de « Mon compte ».
 *
 * Les rubriques étaient des cartes de cinq lignes — pictogramme, titre, « Ouvrir → »
 * qui n'apparaissait qu'au survol, et une phrase d'explication — ou des sections
 * repliées les unes sous les autres. Six rubriques faisaient deux écrans, et rien ne
 * disait au doigt ce qui menait ailleurs.
 *
 * Une rangée : l'intitulé à gauche, ce qu'on vient y chercher à droite, un chevron.
 * L'explication reste, sous le titre — elle est ce qui permet de choisir sans ouvrir.
 */
const { href, title, description, value } = Astro.props;
---

<a
  {href}
  class="flex min-h-[3.25rem] items-center gap-3 px-4 py-2.5 no-underline transition-colors hover:bg-muted/40"
>
  <span class="min-w-0 flex-1">
    <span class="block truncate text-sm font-semibold text-foreground">{title}</span>
    {description && <span class="block text-xs text-muted-foreground">{description}</span>}
  </span>

  {value && <span class="shrink-0 text-sm text-muted-foreground tabular-nums">{value}</span>}

  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-muted-foreground" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
</a>
