---
import type { MemberBirthday } from '../lib/birthdays';

interface Props {
  birthdays: MemberBirthday[];
}

const { birthdays } = Astro.props;

const plural = birthdays.length > 1;
---

{/*
  Le seul encart coloré de l'accueil, et c'est voulu : il n'apparaît que les jours où
  il a quelque chose à dire, alors qu'actualités et agenda sont là en permanence. Une
  couleur réservée à l'exception reste lisible comme une exception ; posée partout,
  elle ne signalerait plus rien.
*/}
<section
  class="rounded-xl border border-primary/30 bg-primary/10 px-4 py-4 shadow-sm sm:px-5"
  aria-labelledby="anniversaires-title"
>
  <div class="flex items-start gap-3">
    <span
      class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground"
      aria-hidden="true"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"/><path d="M4 16s.5-1 2-1 2.5 2 4 2 2.5-2 4-2 2.5 2 4 2 2-1 2-1"/><path d="M2 21h20"/><path d="M7 8v3"/><path d="M12 8v3"/><path d="M17 8v3"/><path d="M7 4h.01"/><path d="M12 4h.01"/><path d="M17 4h.01"/></svg>
    </span>

    <div class="min-w-0">
      <h2 id="anniversaires-title" class="text-base font-semibold text-primary">
        {plural ? 'Anniversaires du jour' : 'Anniversaire du jour'}
      </h2>

      <ul class="mt-2 flex flex-wrap gap-x-2 gap-y-1.5">
        {birthdays.map((member) => (
          <li class="rounded-full bg-card px-2.5 py-1 text-sm font-medium text-foreground shadow-sm">
            {member.firstName} {member.lastName}
            <span class="text-muted-foreground"> · {member.age} ans</span>
          </li>
        ))}
      </ul>

      <p class="mt-2.5 text-sm text-foreground/80">
        Toute l'équipe {plural ? 'leur' : 'lui'} souhaite un très bel anniversaire&nbsp;!
      </p>
    </div>
  </div>
</section>
