---
import ThemeToggle from './ThemeToggle.svelte';
import UserMenu from './UserMenu.svelte';

interface Props {
  currentPath: string;
  canExpense?: boolean;
}

const { currentPath, canExpense: canExpenseProp } = Astro.props;

const isHome = currentPath === '/';
const isNews = currentPath === '/actualites';
const isAgenda = currentPath === '/agenda';
const isBoutique = currentPath === '/boutique';
const isExpenses = currentPath === '/note-de-frais';
const isAttestation = currentPath === '/attestation';

const session = Astro.locals.session;
const activeMember = session?.members.find((m) => m.id === session.activeMemberId);
// Le statut frais peut être fourni "en direct" par la page (canExpenseProp) ; sinon
// on retombe sur le snapshot de session.
const canExpense = canExpenseProp ?? (activeMember?.expenseAuthorized ?? false);
---

<header
  class="flex shrink-0 items-center justify-between px-3 sm:px-6 border-b border-border bg-background sticky top-0 z-40"
  style="height: calc(3.5rem + env(safe-area-inset-top, 0px)); padding-top: env(safe-area-inset-top, 0px);"
>
  <div class="flex items-center gap-3 sm:gap-6">
    <a href="/" class="flex items-center gap-2 group min-h-[44px]">
      <img src="/logo.png" alt="Logo" class="h-7 w-7 shrink-0 object-contain transition-all duration-200" />
      <div>
        <span class="font-bold text-sm text-foreground tracking-tight block">Nozay Bad</span>
        <span class="text-[10px] sm:text-[11px] text-muted-foreground uppercase tracking-wider font-semibold block -mt-0.5">Adhérents</span>
      </div>
    </a>

    <!-- « Mon compte » n'est pas ici mais dans le menu de l'en-tête, aux côtés du
         changement de profil et de la déconnexion : ces trois actions portent sur
         l'adhérent connecté, là où la barre ne liste que les rubriques du club. -->
    <nav class="hidden md:flex items-center gap-1 border-l border-border pl-2 sm:pl-6 h-6">
      <a
        href="/"
        class={`px-2 lg:px-3 py-1.5 text-xs font-medium rounded-md transition-colors min-h-[36px] flex items-center whitespace-nowrap ${
          isHome
            ? 'bg-accent text-accent-foreground font-semibold'
            : 'text-muted-foreground hover:text-foreground hover:bg-accent/50'
        }`}
      >
        Accueil
      </a>
      <a
        href="/actualites"
        class={`px-2 lg:px-3 py-1.5 text-xs font-medium rounded-md transition-colors min-h-[36px] flex items-center whitespace-nowrap ${
          isNews
            ? 'bg-accent text-accent-foreground font-semibold'
            : 'text-muted-foreground hover:text-foreground hover:bg-accent/50'
        }`}
      >
        Actualités
      </a>
      <a
        href="/agenda"
        class={`px-2 lg:px-3 py-1.5 text-xs font-medium rounded-md transition-colors min-h-[36px] flex items-center whitespace-nowrap ${
          isAgenda
            ? 'bg-accent text-accent-foreground font-semibold'
            : 'text-muted-foreground hover:text-foreground hover:bg-accent/50'
        }`}
      >
        Agenda
      </a>
      <a
        href="/boutique"
        class={`px-2 lg:px-3 py-1.5 text-xs font-medium rounded-md transition-colors min-h-[36px] flex items-center whitespace-nowrap ${
          isBoutique
            ? 'bg-accent text-accent-foreground font-semibold'
            : 'text-muted-foreground hover:text-foreground hover:bg-accent/50'
        }`}
      >
        Boutique
      </a>
      {canExpense && (
        <a
          href="/note-de-frais"
          class={`px-2 lg:px-3 py-1.5 text-xs font-medium rounded-md transition-colors min-h-[36px] flex items-center whitespace-nowrap ${
            isExpenses
              ? 'bg-accent text-accent-foreground font-semibold'
              : 'text-muted-foreground hover:text-foreground hover:bg-accent/50'
          }`}
        >
          Note de frais
        </a>
      )}
      <a
        href="/attestation"
        class={`px-2 lg:px-3 py-1.5 text-xs font-medium rounded-md transition-colors min-h-[36px] flex items-center whitespace-nowrap ${
          isAttestation
            ? 'bg-accent text-accent-foreground font-semibold'
            : 'text-muted-foreground hover:text-foreground hover:bg-accent/50'
        }`}
      >
        Attestation
      </a>
    </nav>
  </div>

  <div class="flex items-center gap-2 sm:gap-3">
    <ThemeToggle client:load />
    {session && (
      <UserMenu
        client:load
        members={session.members}
        activeMemberId={session.activeMemberId}
        currentPath={currentPath}
      />
    )}
  </div>
</header>
