---
import ThemeToggle from './ThemeToggle.svelte';
import UserMenu from './UserMenu.svelte';

interface Props {
  currentPath: string;
  activeSeasonName?: string;
  pageTitle?: string;
}

const { currentPath, activeSeasonName = 'Saison 2025-2026', pageTitle } = Astro.props;

const isBoutique = currentPath === '/boutique';
const isExpenses = currentPath === '/note-de-frais';
const isAttestation = currentPath === '/attestation';

const session = Astro.locals.session;
const activeMember = session?.members.find((m) => m.id === session.activeMemberId);
const canExpense = activeMember?.expenseAuthorized ?? false;
---

<header class="flex h-14 shrink-0 items-center justify-between px-3 sm:px-6 border-b border-border bg-background sticky top-0 z-40">
  <div class="flex items-center gap-3 sm:gap-6">
    <a href="/" class="flex items-center gap-2 group min-h-[44px]">
      <img src="/logo.png" alt="Logo" class="h-7 w-7 shrink-0 object-contain transition-all duration-200" />
      <div>
        <span class="font-bold text-xs sm:text-sm text-foreground tracking-tight block">Nozay Bad</span>
        <span class="text-[9px] sm:text-[10px] text-muted-foreground uppercase tracking-wider font-semibold block -mt-0.5">Adhérents</span>
      </div>
    </a>

    {pageTitle && (
      <span class="md:hidden border-l border-border pl-3 text-sm font-semibold text-foreground truncate max-w-[40vw]">{pageTitle}</span>
    )}

    <nav class="hidden md:flex items-center gap-1 border-l border-border pl-2 sm:pl-6 h-6">
      <a
        href="/boutique"
        class={`px-2.5 sm:px-3 py-1.5 text-xs font-medium rounded-md transition-colors min-h-[36px] flex items-center ${
          isBoutique
            ? 'bg-accent text-accent-foreground font-semibold'
            : 'text-muted-foreground hover:text-foreground hover:bg-accent/50'
        }`}
      >
        Boutique
      </a>
      {canExpense && (
        <a
          href="/note-de-frais"
          class={`px-2.5 sm:px-3 py-1.5 text-xs font-medium rounded-md transition-colors min-h-[36px] flex items-center ${
            isExpenses
              ? 'bg-accent text-accent-foreground font-semibold'
              : 'text-muted-foreground hover:text-foreground hover:bg-accent/50'
          }`}
        >
          Note de frais
        </a>
      )}
      <a
        href="/attestation"
        class={`px-2.5 sm:px-3 py-1.5 text-xs font-medium rounded-md transition-colors min-h-[36px] flex items-center ${
          isAttestation
            ? 'bg-accent text-accent-foreground font-semibold'
            : 'text-muted-foreground hover:text-foreground hover:bg-accent/50'
        }`}
      >
        Attestation
      </a>
    </nav>
  </div>

  <div class="flex items-center gap-2 sm:gap-3">
    <div class="text-[11px] sm:text-xs text-muted-foreground bg-muted border border-border px-2 sm:px-2.5 py-1 rounded-md font-medium">
      <span class="hidden sm:inline">Saison : </span>
      <span class="text-foreground font-semibold">{activeSeasonName.replace('Saison ', '')}</span>
    </div>
    <ThemeToggle client:load />
    {session && (
      <UserMenu client:load members={session.members} activeMemberId={session.activeMemberId} />
    )}
  </div>
</header>
