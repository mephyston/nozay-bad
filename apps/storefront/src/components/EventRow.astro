---
import DatePill from './DatePill.astro';
import type { EventAnnouncement } from '@nba/cms/public';
import type { AgendaEvent } from '../lib/agenda';

interface Props {
  event: AgendaEvent;
  /**
   * Actualité qui annonce ce rendez-vous, si l'écran a su la retrouver.
   *
   * Passée plutôt que lue ici : la page rapproche l'agenda et les actualités **une
   * fois**, pour toutes ses lignes.
   */
  announcement?: EventAnnouncement | null;
  /** Contenu ajouté sous l'événement — l'encart d'inscription, en pratique. */
}

const { event, announcement = null } = Astro.props;

/**
 * Un événement, tel qu'il se lit partout dans l'espace adhérent.
 *
 * Extrait de `AgendaCard` le jour où la page `/agenda` a eu besoin de la même ligne :
 * une troisième copie de la pastille de date et de ses règles d'accessibilité aurait
 * fini par diverger des deux autres.
 */
const CATEGORY_LABELS: Record<AgendaEvent['category'], string> = {
  competition: 'Compétition',
  interclubs: 'Interclubs',
  tournoi: 'Tournoi',
  stage: 'Stage',
  vie_du_club: 'Vie du club',
  assemblee: 'Assemblée'
};

/**
 * Trois familles de couleur, et non une par catégorie — la même règle que l'agenda du
 * site public, pour que les deux écrans se lisent pareil. La teinte porte la *nature*
 * du rendez-vous ; la catégorie exacte reste écrite en toutes lettres, donc personne
 * n'a besoin de la couleur pour lire l'agenda.
 */
const FAMILY: Record<AgendaEvent['category'], 'jeu' | 'formation' | 'club'> = {
  competition: 'jeu',
  interclubs: 'jeu',
  tournoi: 'jeu',
  stage: 'formation',
  vie_du_club: 'club',
  assemblee: 'club'
};

/** Les dates sont stockées en heure locale sans fuseau : les relire telles quelles. */
const parse = (value: string) => new Date(`${value}:00`);

const time = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit' });
const fullDate = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'full' });

const start = parse(event.startsAt);
const end = event.endsAt ? parse(event.endsAt) : null;
// Un événement qui déborde sur un autre jour affiche ses deux dates ; sinon seule
// l'heure de fin, qui suffit.
const sameDay = end !== null && end.toDateString() === start.toDateString();
---

<div class="flex items-stretch gap-3 sm:gap-4">
  <DatePill date={start} family={FAMILY[event.category] ?? 'club'} />

  <div class="min-w-0 flex-1">
    {/*
      Le titre mène à l'actualité du club quand il y en a une, à la fiche externe
      sinon. Dans cet ordre : l'article est chez nous, il dit ce que le club a à en
      dire, et la fiche FFBaD reste joignable juste en dessous.
    */}
    <h3 class="text-base font-semibold leading-snug text-foreground">
      {announcement ? (
        <a href={announcement.href} class="hover:underline">{event.title}</a>
      ) : event.externalUrl ? (
        <a href={event.externalUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
          {event.title}
        </a>
      ) : (
        event.title
      )}
    </h3>

    <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground">
      <span class="sr-only">{fullDate.format(start)}</span>
      {event.allDay ? <span>Toute la journée</span> : (
        <span>
          {time.format(start)}
          {end && sameDay && ` – ${time.format(end)}`}
        </span>
      )}
      {end && !sameDay && <span>jusqu'au {fullDate.format(end)}</span>}
      {event.venueLabel && (
        <>
          <span aria-hidden="true">·</span>
          <span>{event.venueLabel}</span>
        </>
      )}
    </p>

    {/*
      Catégorie : retirée de l'écran, conservée pour le lecteur d'écran — exactement
      comme sur l'agenda du site public, pour que les deux se lisent pareil.

      À l'œil elle était redondante : la pastille de date porte déjà la couleur de la
      famille, à deux centimètres de là. Son étiquette coûtait vingt-quatre pixels de
      hauteur sur chaque ligne d'un agenda qui en aligne dix.

      `sr-only` plutôt qu'une suppression : la pastille est `aria-hidden`, ce libellé
      est donc le **seul** endroit où la catégorie soit annoncée. La retirer tout à fait
      la réserverait à qui distingue les couleurs, et ferait de la teinte le seul
      porteur d'une information — ce que la règle 1.4.1 interdit précisément.
    */}
    <span class="sr-only">{CATEGORY_LABELS[event.category] ?? event.category}</span>

    {/*
      Renvoi vers l'actualité. Un titre souligné au survol ne se voit pas sur un écran
      tactile : sans cette ligne, rien n'annoncerait qu'un article raconte le rendez-vous.

      Le titre de l'article passe en complément masqué, comme sur le site public : à
      l'écran il faisait doublon avec celui du rendez-vous, souvent au mot près, et
      allongeait la ligne pour le répéter. Mais un lecteur d'écran qui égrène les liens
      d'une page n'annoncerait sinon que trois « En savoir plus » indiscernables — ce
      que la règle 2.4.4 demande d'éviter.

      Le lien reste visible à toutes les largeurs, contrairement au site public qui rend
      la carte entière cliquable en petite largeur. Ici la carte porte le formulaire
      d'inscription, ses champs d'invités et le dépliage des inscrits : une surface
      cliquable posée par-dessus détournerait le premier appui sur « Je viens » vers
      l'article.
    */}
    {announcement && (
      <a
        href={announcement.href}
        class="mt-2 flex min-h-[44px] items-center gap-1 text-sm font-semibold text-primary hover:underline"
      >
        En savoir plus<span class="sr-only"> : {announcement.title}</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    )}

    {announcement && event.externalUrl && (
      <a
        href={event.externalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-[44px] items-center gap-1 text-sm text-muted-foreground hover:underline"
      >
        Fiche de la compétition <span aria-hidden="true">&#8599;</span>
      </a>
    )}

    <slot />
  </div>
</div>
