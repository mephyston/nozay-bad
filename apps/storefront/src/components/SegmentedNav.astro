---
interface Item {
  href: string;
  label: string;
  actif: boolean;
}

interface Props {
  items: Item[];
  /** Ce que la rangée fait choisir, pour le lecteur d'écran. */
  label: string;
  class?: string;
}

/**
 * Le contrôle segmenté en verre, **en liens**.
 *
 * Même forme que les onglets de l'administration et de la boutique — segments de
 * largeur égale, actif surélevé sur une surface en verre — reprise à la lettre de
 * `tabs-trigger`. Des liens et non des onglets `bits-ui` : ce sont eux qui gardent
 * l'adresse partageable, le retour arrière fonctionnel et la page utilisable sans
 * JavaScript, et ces pages sont rendues côté serveur.
 *
 * Remplace les pastilles cerclées qui défilaient en largeur, où l'onglet actif ne se
 * distinguait que par sa couleur.
 */
const { items, label, class: className = '' } = Astro.props;
---

<!--
  La rangée défile plutôt que de comprimer les libellés jusqu'à l'illisible : les
  rubriques d'actualité peuvent être nombreuses, et « Vie du club » compressé sur un
  sixième d'écran ne se lit plus. Jusqu'à quatre ou cinq segments, ils se partagent la
  largeur et rien ne défile ; au-delà, on glisse au doigt.

  La barre de défilement est masquée ici plutôt que par une classe utilitaire : le
  `no-scrollbar` qu'emploie le design system est défini dans le `<style>` d'un seul
  composant, donc sans effet ailleurs.
-->
<nav class:list={['glass-surface segments flex h-12 gap-1 overflow-x-auto rounded-full p-1', className]} aria-label={label}>
  {items.map((item) => (
    <a
      href={item.href}
      aria-current={item.actif ? 'page' : undefined}
      class:list={[
        'inline-flex flex-1 shrink-0 items-center justify-center whitespace-nowrap rounded-full px-4 text-sm font-medium no-underline transition-all',
        item.actif
          ? 'bg-card text-foreground font-bold shadow-sm ring-1 ring-border/60'
          : 'text-muted-foreground hover:text-foreground'
      ]}
    >
      {item.label}
    </a>
  ))}
</nav>

<style>
  .segments {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .segments::-webkit-scrollbar {
    display: none;
  }
</style>
