---
import DatePill from './DatePill.astro';
import { IndivRequest } from '@nba/schedules-ui';
import { formatSessionDate } from '../lib/open-play';
import { formatSlot, indivStatusLabel, type IndivSession } from '../lib/indiv';

interface Props {
  session: IndivSession;
  /** Page qui porte le POST de l'îlot : l'agenda, même depuis l'accueil. */
  endpoint?: string;
}

/**
 * La prochaine soirée d'indiv, et ma candidature dessus.
 *
 * Une seule soirée, sur l'accueil comme en tête du calendrier : la carte répond à « puis-je
 * demander ma séance ? », pas à « que propose l'entraîneur ce trimestre ? ». Une fois les
 * retenus annoncés, elle les nomme par créneau — c'est ce que le groupe WhatsApp lisait
 * déjà, et c'est ce qui permet à chacun de savoir avec qui il joue.
 */
const { session, endpoint = '/agenda' } = Astro.props;

const status = indivStatusLabel(session);
const today = new Date().toISOString().slice(0, 10);
const open = session.status === 'open' && session.date >= today;
const announced = session.status === 'announced';
---

<section id="indiv" class="rounded-xl border border-border bg-card shadow-sm" aria-labelledby="indiv-title">
  <header class="flex items-center gap-2.5 border-b border-border px-4 py-3 sm:px-5">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-primary" aria-hidden="true"><path d="M14.4 14.4 9.6 9.6"/><path d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"/><path d="m21.5 21.5-1.4-1.4"/><path d="M3.9 3.9 2.5 2.5"/><path d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z"/></svg>
    <h2 id="indiv-title" class="text-base font-semibold text-foreground">Prochaine séance d'indiv</h2>
  </header>

  <div class="px-4 py-3 sm:px-5">
    <div class="flex items-stretch gap-3 sm:gap-4">
      <DatePill date={new Date(`${session.date}T12:00:00Z`)} family="jeu" />

      <div class="min-w-0 flex-1">
        <h3 class="text-base font-semibold leading-snug text-foreground">
          {session.label ?? 'Séance individuelle'}
        </h3>

        <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground">
          <span class="sr-only">{formatSessionDate(session.date)}</span>
          <span>{session.startTime} – {session.endTime}</span>
          {session.venue && (
            <>
              <span aria-hidden="true">·</span>
              <span>{session.venue.name}</span>
            </>
          )}
        </p>

        <p
          class:list={[
            'mt-1 text-sm font-medium',
            status.tone === 'ok' && 'text-primary',
            status.tone === 'pending' && 'text-muted-foreground',
            status.tone === 'off' && 'text-destructive'
          ]}
        >
          {session.status === 'cancelled' ? `Annulée — ${status.text}` : status.text}
        </p>

        {/* Le découpage en créneaux ne se dit plus ici : il ne décide de rien pour
            l'adhérent, qui candidate à la soirée et non à une tranche horaire, et le
            tiroir de candidature les nomme déjà dans sa liste déroulante. */}

        {announced && (
          <ul class="mt-2 space-y-1 text-sm">
            {session.slots.map((slot) => (
              <li>
                <span class="font-medium text-foreground">{formatSlot(slot)}</span>
                <span class="text-muted-foreground"> · {(session.selectedNames[String(slot.index)] ?? []).join(', ') || 'personne'}</span>
              </li>
            ))}
          </ul>
        )}

        {session.notes && <p class="mt-1 text-sm text-muted-foreground">{session.notes}</p>}

        <div class="mt-3">
          <IndivRequest
            client:load
            sessionId={session.id}
            slots={session.slots}
            myRequest={session.myRequest}
            status={session.status}
            open={open}
            endpoint={endpoint}
          />
        </div>
      </div>
    </div>
  </div>
</section>
