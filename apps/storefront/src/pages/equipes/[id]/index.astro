---
import { RankingChip } from '@nba/teams-ui';
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import PageTitle from '../../../components/PageTitle.astro';
import MobileNav from '../../../components/MobileNav.svelte';
import { env as cfEnv } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';
import { resolveEnv } from '../../../lib/request-context';
import { MemberAvatar } from '@nba/ui';

const session = Astro.locals.session;
const env = resolveEnv(Astro.locals) ?? cfEnv;

const active = session?.members.find((m) => m.id === session.activeMemberId);
const viewerLicence = String(active?.licence ?? '').replace(/\D/g, '').padStart(8, '0');

const teamId = Number(Astro.params.id);
if (!Number.isSafeInteger(teamId) || teamId < 1) return Astro.redirect('/equipes');

const api = createApiClient(env);

let team: any = null;
let days: any[] = [];
let errorMsg: string | null = null;

try {
  const res = await api.fetch(`http://localhost/teams/${teamId}`);
  if (!res.ok) return Astro.redirect('/equipes');
  team = ((await res.json()) as any).data;

  days = team.calendar ?? [];
} catch {
  errorMsg = "Cette équipe n'est pas consultable pour le moment.";
}

const canCompose =
  Boolean(viewerLicence) &&
  (team?.captain?.licence === viewerLicence || team?.viceCaptain?.licence === viewerLicence);

const name = (p: any) => (p ? `${p.firstName} ${p.lastName}`.trim() : '—');

/**
 * Portrait d'un joueur de l'effectif, ou `null` s'il n'en a pas.
 *
 * `/api/adherents/photo/…` et non une adresse de fichier : le middleware laisse passer
 * sans session tout ce qui ressemble à une image, sauf sous `/api/`. Les portraits ne
 * sortent du bucket privé que pour un adhérent connecté, et c'est ce préfixe qui le tient.
 */
const photoSrc = (p: any): string | null =>
  p?.photoUpdatedAt
    ? `/api/adherents/photo/${String(p.licence).replace(/\D/g, '').padStart(8, '0')}?size=128&v=${p.photoUpdatedAt}`
    : null;
const frenchDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('fr-FR', {
    day: 'numeric', month: 'long', timeZone: 'UTC'
  });
---

<Layout title={`${team?.name ?? 'Équipe'}`}>
  <Header currentPath="/equipes" />

  <main class="flex-1 p-3 sm:p-6 w-full pb-nav md:pb-6 max-w-4xl mx-auto space-y-6">
    {errorMsg && (
      <div class="rounded-lg border border-destructive/20 bg-destructive/10 p-4 text-sm text-destructive">
        {errorMsg}
      </div>
    )}

    {team && (
      <>
        <PageTitle title={team.name} retour={{ href: '/equipes', label: 'Toutes les équipes' }}>
          <p class="text-muted-foreground text-sm">
            {team.championshipLabel} · {team.divisionLabel}
            {team.poolLabel ? ` · poule ${team.poolLabel}` : ''}
          </p>
          <p class="text-xs text-muted-foreground">
            Rencontre en {team.matchCount} matchs. {team.eligibilityRule}
          </p>
        </PageTitle>

        {team.rulesUrl && (
          <a
            href={team.rulesUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between gap-3 rounded-lg border p-4 hover:bg-muted/40 transition-colors"
          >
            <div>
              <p class="font-semibold text-sm">
                {team.rulesLabel ?? `Règlement — ${team.championshipLabel}`}
              </p>
              <p class="text-xs text-muted-foreground">
                Le texte qui fait foi le soir de la rencontre : composition, ordre des
                joueurs, valeurs d'équipe.
              </p>
            </div>
            <span class="text-xs rounded-md border px-3 py-1.5 whitespace-nowrap">Télécharger</span>
          </a>
        )}

        <section class="rounded-lg border p-4 space-y-2">
          <h2 class="font-semibold text-sm">Staff</h2>
          <div class="grid gap-2 sm:grid-cols-2 text-sm">
            <p><span class="text-muted-foreground">Capitaine :</span> {name(team.captain)}</p>
            <p><span class="text-muted-foreground">Vice-capitaine :</span> {name(team.viceCaptain)}</p>
          </div>
        </section>

        <section class="rounded-lg border p-4 space-y-3">
          <div class="flex items-baseline justify-between gap-2">
            <h2 class="font-semibold text-sm">Effectif ({team.roster.length})</h2>
            {team.referenceEloDate && (
              <p class="text-xs text-muted-foreground">
                Classements au {frenchDate(team.referenceEloDate)}
              </p>
            )}
          </div>
          {team.roster.length === 0 ? (
            <p class="text-sm text-muted-foreground">Aucun joueur déclaré dans l'effectif.</p>
          ) : (
            <ul class="divide-y text-sm">
              {team.roster.map((p: any) => (
                <li class="py-2 flex items-center justify-between gap-3">
                  {/*
                    Seule porte d'entrée vers la fiche d'un autre adhérent : il n'existe
                    aucun annuaire, et `GET /members` reste fermé à l'espace adhérent.
                  */}
                  <a
                    href={`/adherents/${p.licence}?equipe=${teamId}`}
                    class="flex min-w-0 items-center gap-2.5 text-foreground no-underline hover:underline"
                  >
                    <MemberAvatar
                      src={photoSrc(p)}
                      name={name(p)}
                      size="sm"
                      class="shrink-0"
                    />
                    <span class="truncate">{p.firstName} {p.lastName}</span>
                  </a>
                  {p.hasRanking ? (
                    <span class="flex shrink-0 items-center gap-1 text-xs" aria-label="Classements simple, double et mixte">
                      <RankingChip ranking={p.singles} />
                      <RankingChip ranking={p.doubles} />
                      <RankingChip ranking={p.mixed} />
                    </span>
                  ) : (
                    <span class="text-xs text-muted-foreground">sans classement</span>
                  )}
                </li>
              ))}
            </ul>
          )}
        </section>

        <section class="rounded-lg border p-4 space-y-3">
          <h2 class="font-semibold text-sm">Calendrier</h2>
          {/*
            Toute la ligne mène à la journée, et le chevron le dit.

            Le lien vivait au bout, en « Voir » de douze pixels gris — une cible de
            trente points à l'extrémité de la ligne, quand la ligne entière pouvait
            l'être. « Composer » reste nommé : il annonce qu'on va écrire, ce qu'un
            chevron ne promet pas.
          */}
          {days.length === 0 ? (
            <p class="text-sm text-muted-foreground">Le calendrier n'est pas encore publié.</p>
          ) : (
            <ul class="divide-y text-sm">
              {days.map((day: any) => (
                <li>
                  <a
                    href={`/equipes/${team.id}/journee/${day.number}${day.slot > 1 ? `?r=${day.slot}` : ''}`}
                    class="-mx-2 flex min-h-[3.25rem] items-center justify-between gap-3 rounded-lg px-2 py-2 no-underline transition-colors hover:bg-muted/40"
                  >
                  <div class="min-w-0">
                    <p class="font-medium">
                      {day.label ?? `Journée ${day.number}`}
                      {/*
                        Le régional dispute deux rencontres par journée, donc deux
                        compositions : l'adversaire les distingue bien mieux qu'un rang,
                        et « Rencontre n » prend le relais tant qu'il n'est pas saisi.
                      */}
                      {day.fixtureLabel && (
                        <span class="ml-1 text-muted-foreground">· {day.fixtureLabel}</span>
                      )}
                      {day.kind === 'playoff' && (
                        <span class="ml-1 text-xs text-muted-foreground">(si qualifié)</span>
                      )}
                    </p>
                    {/*
                      La date réelle prime à l'affichage : c'est elle qui dit quand se
                      présenter. La semaine théorique reste rappelée en cas de report,
                      parce que c'est elle qui porte les règles de composition.
                    */}
                    <p class="text-xs text-muted-foreground">
                      {day.playedAt
                        ? `${frenchDate(day.playedAt.slice(0, 10))}${day.playedAt.slice(11, 16) !== '00:00' ? ` à ${day.playedAt.slice(11, 16)}` : ''}`
                        : `semaine du ${frenchDate(day.weekStart)}`}
                      {day.venue ? ` · ${day.venue}` : ''}
                      {!day.fixtureLabel && day.opponent ? ` · ${day.opponent}` : ''}
                    </p>
                    {day.outsideTheoreticalWeek && (
                      <p class="text-xs text-warning">
                        Reportée — journée du calendrier : semaine du {frenchDate(day.weekStart)}
                      </p>
                    )}
                    {day.filledLines > 0 && (
                      <p class="text-xs text-muted-foreground">{day.filledLines} ligne(s) composée(s)</p>
                    )}
                  </div>
                  <span class="flex shrink-0 items-center gap-2">
                    {canCompose && (
                      <span class="whitespace-nowrap rounded-md border px-3 py-1.5 text-xs">Composer</span>
                    )}
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-muted-foreground" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                  </span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      </>
    )}
  </main>

  <MobileNav client:idle features={Astro.locals.club?.features ?? {}} currentPath="/equipes" />
</Layout>
