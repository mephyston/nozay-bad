---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import BackLink from '../../components/BackLink.astro';
import MobileNav from '../../components/MobileNav.svelte';
import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';
import { listSeasons, displaySeason } from '../../lib/season';
import { chargerCompte, eur, montantsDeCotisation } from '../../lib/compte';

/** Ma cotisation, sur sa propre page : ce qu'on vient y vérifier est « suis-je à jour ? ». */
const session = Astro.locals.session;
const active = session?.members.find((m) => m.id === session.activeMemberId);

let cotisation: any = null;
let seasonName = '';
if (active) {
  const season = displaySeason(await listSeasons(env), session?.seasonCode);
  seasonName = season?.name || '';
  const api = createApiClient(env);
  const donnees = await chargerCompte(
    api.fetch.bind(api),
    {
      licence: active.licence,
      memberId: active.id,
      email: session?.email,
      seasonCode: season?.code,
      seasonName,
      canExpense: active.expenseAuthorized ?? false
    }
  );
  cotisation = donnees.cotisation;
}

const { du, recu, restant, aJour } = montantsDeCotisation(cotisation);
---

<Layout title="Ma cotisation">
  <Header currentPath="/mon-compte" />

  <main class="w-full flex-1 p-3 pb-nav sm:p-6 md:pb-6">
    <div class="mx-auto max-w-3xl space-y-4">
      <BackLink href="/mon-compte" label="Mon compte" />

      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h1 class="text-xl font-bold text-foreground sm:text-2xl">
            Ma cotisation{seasonName ? ` — ${seasonName}` : ''}
          </h1>
          <p class="mt-1 text-sm text-muted-foreground">
            Montant dû, déjà réglé et restant à payer pour la saison.
          </p>
        </div>
        {aJour ? (
          <span class="inline-flex items-center rounded-md border border-success/20 bg-success/10 px-2.5 py-1 text-xs font-semibold text-success">À jour</span>
        ) : (
          <span class="inline-flex items-center rounded-md border border-destructive/20 bg-destructive/10 px-2.5 py-1 text-xs font-semibold text-destructive">Solde restant</span>
        )}
      </div>

      <div class="divide-y divide-border overflow-hidden rounded-xl border border-border bg-card">
        <div class="flex items-center justify-between gap-3 px-4 py-3">
          <span class="text-sm text-muted-foreground">Montant dû</span>
          <span class="text-sm font-semibold text-foreground">{eur(du)}</span>
        </div>
        <div class="flex items-center justify-between gap-3 px-4 py-3">
          <span class="text-sm text-muted-foreground">Déjà réglé</span>
          <span class="text-sm font-semibold text-foreground">{eur(recu)}</span>
        </div>
        <div class="flex items-center justify-between gap-3 px-4 py-3">
          <span class="text-sm text-muted-foreground">Restant à payer</span>
          <span class={`text-sm font-semibold ${restant > 0 ? 'text-destructive' : 'text-success'}`}>{eur(restant)}</span>
        </div>
      </div>

      {/* Trois chiffres en rangées, et non en colonnes : sur un téléphone, trois
          colonnes centrées coupent « Montant dû » en deux lignes et « Restant » en
          une, ce qui désaligne les montants qu'on vient comparer. */}
    </div>
  </main>

  <MobileNav client:idle features={Astro.locals.club?.features ?? {}} currentPath="/mon-compte" />
</Layout>
