---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PageTitle from '../../components/PageTitle.astro';
import MobileNav from '../../components/MobileNav.svelte';
import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';
import { listSeasons, displaySeason } from '../../lib/season';
import { chargerCompte, libelleDeStatut, classeDeStatut } from '../../lib/compte';
import { websiteOrigin } from '../../lib/media';
import { MemberOrders, type MemberOrderRow } from '@nba/shop-ui';

/**
 * Mes commandes, sur leur propre page.
 *
 * C'était une section repliée de « Mon compte », au milieu de cinq autres : on y
 * arrivait par une ancre qui devait déplier le bon `<details>`, et la boutique y
 * renvoyait par `#commandes`. Une rubrique qui a son adresse se partage, se met en
 * favori et se retrouve dans l'historique du navigateur.
 *
 * Une commande que le bureau n'a pas encore validée s'y modifie ou s'y annule.
 */
const session = Astro.locals.session;
const api = createApiClient(env);

/*
  Modifier ou annuler une commande : relayé à l'API, l'adhérent posé depuis la session.

  L'identifiant reçu n'est qu'une indication — il doit appartenir au foyer de la
  session, sinon refus. L'API vérifie ensuite que la commande appartient bien à cet
  adhérent, et qu'elle n'est pas encore validée : la page ne décide de rien d'autre.
*/
if (Astro.request.method === 'POST') {
  const json = (status: number, body: unknown) =>
    new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
  if (!session) return json(401, { success: false, error: 'Non authentifié.' });

  let body: any;
  try {
    body = await Astro.request.json();
  } catch {
    return json(400, { success: false, error: 'Requête illisible.' });
  }
  const id = Number(body?.id);
  const memberId = Number(body?.memberId);
  if (!Number.isSafeInteger(id) || id <= 0) return json(400, { success: false, error: 'Commande inconnue.' });
  if (!session.members.some((m) => m.id === memberId)) {
    return json(403, { success: false, error: "Cet adhérent ne fait pas partie de votre compte." });
  }

  if (body.action === 'withdraw') {
    return api.fetch(`http://localhost/shop/orders/${id}/withdraw`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ memberId })
    });
  }
  if (body.action === 'amend') {
    return api.fetch(`http://localhost/shop/orders/${id}/amend`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        memberId,
        productId: Number(body.productId),
        quantity: Number(body.quantity),
        paymentMethod: String(body.paymentMethod ?? '')
      })
    });
  }
  return json(400, { success: false, error: 'Action inconnue.' });
}

const active = session?.members.find((m) => m.id === session.activeMemberId);

let orders: any[] = [];
let products: any[] = [];
let paymentMethods: any[] = [];
let activeSeasonId = '';
if (active) {
  const season = displaySeason(await listSeasons(env), session?.seasonCode);
  activeSeasonId = season?.code ?? '';
  const donnees = await chargerCompte(
    api.fetch.bind(api),
    {
      licence: active.licence,
      memberId: active.id,
      email: session?.email,
      seasonCode: season?.code,
      seasonName: season?.name || '',
      canExpense: active.expenseAuthorized ?? false
    },
    { commandes: true }
  );
  orders = donnees.orders;

  // Le catalogue et les moyens de paiement ne servent qu'à modifier : inutiles sans commande à modifier.
  if (orders.some((o: any) => o.order?.status === 'created')) {
    try {
      const [productsRes, methodsRes] = await Promise.all([
        api.fetch('http://localhost/shop/products?active=true&storefront=true'),
        api.fetch('http://localhost/accounting/payment-methods')
      ]);
      if (productsRes.ok) products = ((await productsRes.json()) as any).data || [];
      if (methodsRes.ok) {
        paymentMethods = (((await methodsRes.json()) as any).data || []).map((m: any) => ({
          value: m.code,
          label: m.label,
          kind: m.kind
        }));
      }
    } catch {
      /* Sans catalogue, « Modifier » ne s'affiche pas ; l'annulation reste possible. */
    }
  }
}

const rows: MemberOrderRow[] = orders.map((o: any) => ({
  id: o.order?.id,
  memberId: o.order?.memberId,
  productId: o.order?.productId,
  productName: o.product?.name ?? 'Article',
  quantity: o.order?.quantity ?? 1,
  totalCents: o.order?.totalAmountCents ?? o.order?.totalAmount ?? 0,
  paymentMethod: o.order?.paymentMethod ?? '',
  status: o.order?.status ?? '',
  createdAt: o.order?.createdAt ?? null,
  rejectionReason: o.order?.rejectionReason ?? null,
  statutLabel: libelleDeStatut(o.order?.status),
  statutClasse: classeDeStatut(o.order?.status)
}));
---

<Layout title="Mes commandes">
  <Header currentPath="/mon-compte" />

  <main class="w-full flex-1 p-3 pb-nav sm:p-6 md:pb-6">
    <div class="mx-auto max-w-3xl space-y-4">
      <PageTitle title="Mes commandes" retour={{ href: '/mon-compte', label: 'Mon compte' }}>
        <p class="text-sm text-muted-foreground">Vos achats à la boutique du club et leur règlement.</p>
      </PageTitle>

      <MemberOrders
        client:load
        orders={rows}
        {products}
        {paymentMethods}
        member={active ?? null}
        mediaOrigin={websiteOrigin}
        {activeSeasonId}
      />
    </div>
  </main>

  <MobileNav client:idle features={Astro.locals.club?.features ?? {}} currentPath="/mon-compte" />
</Layout>
