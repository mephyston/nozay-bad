---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.svelte';
import PushOptIn from '../components/PushOptIn.svelte';
import { env } from 'cloudflare:workers';
import { getActiveMemberStatus } from '../lib/member-status';

const session = Astro.locals.session;
const active = session?.members.find((m) => m.id === session.activeMemberId);
const firstName = active?.firstName ?? '';

// Statut lu en direct (autorisation frais effective sans reconnexion) + saison pour le badge.
const status = await getActiveMemberStatus(env, session);
const canExpense = status.canExpense;
const activeSeasonName = status.seasonName;
---

<Layout title="Espace adhérent - Nozay Bad">
  <Header currentPath="/" activeSeasonName={activeSeasonName || undefined} pageTitle="Accueil" canExpense={canExpense} />

  <main class="flex-1 p-3 sm:p-6 w-full pb-24 md:pb-6">
    <div class="max-w-3xl mx-auto">
      <!-- Proposition d'activation, masquée dès que les notifications sont en place :
           un bandeau permanent finit par ne plus être lu. -->
      <div class="mb-6 empty:mb-0">
        <PushOptIn client:idle variant="banner" />
      </div>

      <div class="mb-6">
        <h1 class="text-xl sm:text-2xl font-bold text-foreground">
          Bonjour {firstName}, bienvenue sur ton espace adhérent
        </h1>
        <p class="text-sm text-muted-foreground mt-1">Nozay Badminton Association</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
          href="/mon-compte"
          class="flex flex-col gap-2 rounded-xl border border-border bg-card px-5 py-4 shadow-sm hover:border-ring hover:shadow transition-all no-underline group min-h-[44px]"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>
              <p class="text-sm font-semibold text-foreground">Mon compte</p>
            </div>
            <span class="text-primary text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity">Ouvrir &rarr;</span>
          </div>
          <p class="text-xs text-muted-foreground">{canExpense ? 'Cotisation, commandes et notes de frais.' : 'Cotisation et commandes.'}</p>
        </a>

        <a
          href="/boutique"
          class="flex flex-col gap-2 rounded-xl border border-border bg-card px-5 py-4 shadow-sm hover:border-ring hover:shadow transition-all no-underline group min-h-[44px]"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
              <p class="text-sm font-semibold text-foreground">Boutique</p>
            </div>
            <span class="text-primary text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity">Ouvrir &rarr;</span>
          </div>
          <p class="text-xs text-muted-foreground">Commandez volants, cordages et équipements du club.</p>
        </a>

        <a
          href="/attestation"
          class="flex flex-col gap-2 rounded-xl border border-border bg-card px-5 py-4 shadow-sm hover:border-ring hover:shadow transition-all no-underline group min-h-[44px]"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2.5">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
              <p class="text-sm font-semibold text-foreground">Attestation CSE</p>
            </div>
            <span class="text-primary text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity">Ouvrir &rarr;</span>
          </div>
          <p class="text-xs text-muted-foreground">Consultez et téléchargez votre attestation de paiement.</p>
        </a>

        {canExpense && (
          <a
            href="/note-de-frais"
            class="flex flex-col gap-2 rounded-xl border border-border bg-card px-5 py-4 shadow-sm hover:border-ring hover:shadow transition-all no-underline group min-h-[44px]"
          >
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/></svg>
                <p class="text-sm font-semibold text-foreground">Note de frais</p>
              </div>
              <span class="text-primary text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity">Ouvrir &rarr;</span>
            </div>
            <p class="text-xs text-muted-foreground">Soumettez vos dépenses engagées pour le compte du club.</p>
          </a>
        )}
      </div>
    </div>
  </main>

  <MobileNav currentPath="/" canExpense={canExpense} />

  <footer class="border-t border-border mt-12 py-8 bg-card/20 text-center text-xs text-muted-foreground pb-24 md:pb-8">
    <p>© {new Date().getFullYear()} Nozay Badminton Association. Tous droits réservés.</p>
    <p class="mt-2"><a href="/confidentialite" class="hover:underline">Politique de confidentialité</a> · <a href="/mentions-legales" class="hover:underline">Mentions légales</a></p>
  </footer>
</Layout>
