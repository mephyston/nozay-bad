---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.svelte';
import PushOptIn from '../components/PushOptIn.svelte';
import PostSummaryCard from '../components/PostSummaryCard.astro';
import AgendaCard from '../components/AgendaCard.astro';
import IndivCard from '../components/IndivCard.astro';
import NextFixtureCard from '../components/NextFixtureCard.astro';
import BirthdayCard from '../components/BirthdayCard.astro';
import { env } from 'cloudflare:workers';
import { getActiveMemberStatus } from '../lib/member-status';
import { fetchPosts, fetchAnnouncements, ANNOUNCEMENT_LOOKUP_LIMIT, postAnchor } from '../lib/posts';
import { announcementsByEvent } from '@nba/cms/public';
import { fetchUpcomingEvents } from '../lib/agenda';
import { fetchOpenPlaySessions, OPEN_PLAY_HORIZON_DAYS } from '../lib/open-play';
import { fetchNextIndivSession } from '../lib/indiv';
import { featureOn } from '@nba/club/context';
import { resolveEnv } from '../lib/request-context';
import { fetchTodayBirthdays } from '../lib/birthdays';
import { fetchMyFixtures, normalizeLicence } from '../lib/my-fixtures';

const session = Astro.locals.session;
const active = session?.members.find((m) => m.id === session.activeMemberId);
const firstName = active?.firstName ?? '';

// Statut lu en direct : autorisation frais effective sans reconnexion.
const status = await getActiveMemberStatus(env, session);

// Les trois blocs de l'accueil sont indépendants : ils sont donc lus en parallèle, et
// chacun disparaît seul s'il n'a rien à montrer ou si l'API n'a pas répondu — l'accueil
// ne doit jamais afficher un cadre vide.
//
// Un seul événement est demandé, et **au nom du profil actif** : l'encart n'annonce que
// le prochain rendez-vous, et son bouton d'inscription doit savoir si l'adhérent s'y
// est déjà annoncé.
//
// L'interclubs vient s'ajouter aux trois : il ne concerne que les adhérents engagés en
// équipe, et l'encart disparaît pour tous les autres. Une seule rencontre est demandée,
// la prochaine — l'agenda porte les suivantes.
const licence = normalizeLicence(active?.licence);

// Le jeu libre suit la configuration du club ; les indiv restent en plus derrière le
// drapeau de livraison `INDIV_ENABLED` de cette application (voir .env.example).
const openPlayEnabled = featureOn(Astro.locals.club, 'open_play');
const indivEnabled = resolveEnv<{ INDIV_ENABLED?: string }>(Astro.locals).INDIV_ENABLED === 'true' && featureOn(Astro.locals.club, 'indiv');

/*
 * Deux lectures d'actualités, et non plus une : trois articles à afficher, et l'index des
 * annonces. La lecture unique de cinquante articles complets servait surtout à en jeter
 * quarante-sept.
 */
const [{ posts: latestPosts }, annonces, events, birthdays, fixtures, openPlay, indiv] = await Promise.all([
  fetchPosts(env, 3),
  fetchAnnouncements(env, ANNOUNCEMENT_LOOKUP_LIMIT),
  fetchUpcomingEvents(env, 1, session?.activeMemberId),
  fetchTodayBirthdays(env),
  fetchMyFixtures(env, status.seasonCode ?? null, licence, 1),
  openPlayEnabled
    ? fetchOpenPlaySessions(env, {
        memberId: session?.activeMemberId,
        licence: licence ?? undefined,
        withinDays: OPEN_PLAY_HORIZON_DAYS
      })
    : Promise.resolve({ sessions: [], canOpen: false }),
  // La prochaine soirée d'indiv, une seule, et seulement pour un groupe compétiteur :
  // l'API répond `eligible` d'après le type d'adhésion lu à l'instant.
  indivEnabled
    ? fetchNextIndivSession(env, { memberId: session?.activeMemberId, group: status.membershipType })
    : Promise.resolve({ session: null, eligible: false })
]);

/*
 * Trois actualités à l'écran, une fenêtre plus large en mémoire.
 *
 * L'accueil n'en montre que trois, mais l'encart du prochain rendez-vous doit pouvoir
 * pointer vers l'article qui l'annonce — écrit, lui, il y a peut-être deux mois. La
 * lecture est déjà faite, l'élargir ne coûte pas d'aller-retour de plus ; c'est la
 * même liste qui sert aux deux.
 */
const posts = latestPosts;
const announcements = announcementsByEvent(annonces, (post) => postAnchor(post));

/*
 * Le prochain rendez-vous, au sens du calendrier.
 *
 * L'accueil doit annoncer ce que le calendrier annoncerait en premier : désigner un
 * tournoi comme « prochain » alors que trois séances de jeu libre le précèdent serait
 * doublement faux — l'information est inexacte, et les deux écrans se contrediraient.
 *
 * Les deux clés partagent le format à largeur fixe des dates locales, la comparaison
 * lexicographique suffit donc à les départager sans fabriquer de date.
 */
const firstEvent = events[0] ?? null;
const firstSession = openPlay.sessions[0] ?? null;
const sessionComesFirst =
  firstSession !== null &&
  (firstEvent === null ||
    `${firstSession.date}T${firstSession.startTime}` < firstEvent.startsAt);

const nextEvent = sessionComesFirst ? null : firstEvent;
const nextSession = sessionComesFirst ? firstSession : null;
---

<Layout title="Espace adhérent">
  <Header currentPath="/" />

  <main class="flex-1 p-3 sm:p-6 w-full pb-nav md:pb-6">
    <div class="max-w-3xl mx-auto">
      <!-- Proposition d'activation, masquée dès que les notifications sont en place :
           un bandeau permanent finit par ne plus être lu. -->
      <div class="mb-6 empty:mb-0">
        <PushOptIn client:idle variant="banner" />
      </div>

      <div class="mb-6">
        <h1 class="text-2xl sm:text-3xl font-bold text-foreground">
          Bonjour{firstName ? ` ${firstName}` : ''}
        </h1>
        {/* Le mot d'accueil du club, réglé dans sa configuration (Envois et rappels). */}
        {Astro.locals.club?.settings.memberWelcomeText && (
          <p class="mt-2 text-sm text-muted-foreground whitespace-pre-line">{Astro.locals.club.settings.memberWelcomeText}</p>
        )}
      </div>

      {birthdays.length > 0 && (
        <div class="mb-6">
          <BirthdayCard birthdays={birthdays} />
        </div>
      )}

      <!--
        Avant l'agenda du club : une rencontre d'interclubs engage l'adhérent
        personnellement, là où l'agenda l'invite.
      -->
      <div class="mb-6 empty:mb-0">
        <NextFixtureCard fixture={fixtures[0] ?? null} />
      </div>

      <!--
        Avant l'agenda, après les interclubs : la séance d'indiv est la mienne, et elle
        se demande — l'agenda, lui, s'annonce.
      -->
      {indiv.eligible && indiv.session && (
        <div class="mb-6">
          <IndivCard session={indiv.session} endpoint="/agenda" />
        </div>
      )}

      <div class="mb-6 empty:mb-0">
        <AgendaCard
          event={nextEvent}
          announcement={nextEvent ? announcements.get(nextEvent.id) ?? null : null}
          session={nextSession}
          canOpen={openPlay.canOpen}
        />
      </div>

      {posts.length > 0 && (
        <section aria-labelledby="actualites-title">
          <h2 id="actualites-title" class="mb-3 text-base font-semibold text-foreground">
            Dernières actualités
          </h2>
          {/*
            Cartes résumées, et non les articles en entier : l'accueil donne un aperçu
            de ce qui bouge, la lecture se fait dans « Actualités ». Trois articles
            complets faisaient de l'accueil une seconde page d'actualités, plus longue
            que l'originale.
          */}
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post, index) => (
              <PostSummaryCard post={post} priority={index === 0} />
            ))}
          </div>
          <a
            href="/actualites"
            class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-primary hover:underline min-h-[44px]"
          >
            Voir toutes les actualités &rarr;
          </a>
        </section>
      )}
    </div>
  </main>

  <MobileNav features={Astro.locals.club?.features ?? {}} currentPath="/" />

  <footer class="hidden md:block border-t border-border mt-12 py-8 bg-card/20 text-center text-xs text-muted-foreground md:pb-8">
    <p>© {new Date().getFullYear()} {Astro.locals.club?.settings.name}. Tous droits réservés.</p>
    <p class="mt-2"><a href="/confidentialite" class="hover:underline">Politique de confidentialité</a> · <a href="/mentions-legales" class="hover:underline">Mentions légales</a></p>
  </footer>
</Layout>
