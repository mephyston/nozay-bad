---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.svelte';
import AccountRow from '../components/AccountRow.astro';
import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';
import { listSeasons, displaySeason } from '../lib/season';
import { chargerCompte, montantsDeCotisation } from '../lib/compte';

/**
 * Le point d'entrée de tout ce qui ne concerne que l'adhérent connecté.
 *
 * La page empilait des cartes de cinq lignes et des sections repliées : six rubriques
 * faisaient deux écrans, l'ouverture se faisait par ancre — `#commandes` devait
 * déplier le bon `<details>` — et rien ne disait au doigt ce qui menait ailleurs.
 *
 * Elle ne fait plus qu'une liste de rangées à chevron ; chaque rubrique a sa page,
 * donc son adresse, son favori et sa place dans l'historique du navigateur.
 */
const session = Astro.locals.session;
const active = session?.members.find((m) => m.id === session.activeMemberId);

const season = displaySeason(await listSeasons(env), session?.seasonCode);
const seasonName = season?.name || '';

const api = createApiClient(env);
const donnees = active
  ? await chargerCompte(
      api.fetch.bind(api),
      {
        licence: active.licence,
        memberId: active.id,
        email: session?.email,
        seasonCode: season?.code,
        seasonName,
        canExpense: active.expenseAuthorized ?? false
      },
      // Le hub lit les listes pour en annoncer le nombre : une rangée muette ne dit pas
      // s'il vaut la peine d'y entrer.
      { commandes: true, notes: true, foyer: true }
    )
  : null;

const canExpense = donnees?.canExpense ?? false;
const { aJour } = montantsDeCotisation(donnees?.cotisation);

const renewUrl = Astro.locals.club?.settings.ffbadMembershipUrl || 'https://www.myffbad.fr/';
const lapsedNames = (donnees?.lapsedMembers ?? []).map((m) => `${m.firstName} ${m.lastName}`);

const licenceUrl = String(active?.licence ?? '').replace(/\D/g, '').padStart(8, '0');
const compte = (n: number, mot: string) => (n === 0 ? 'aucune' : `${n} ${mot}${n > 1 ? 's' : ''}`);
---

<Layout title="Mon compte">
  <Header currentPath="/mon-compte" />

  <main class="w-full flex-1 p-3 pb-nav sm:p-6 md:pb-6">
    <div class="mx-auto max-w-3xl space-y-6">
      <h1 class="text-xl font-bold text-foreground sm:text-2xl">Mon compte</h1>

      <!-- Foyer mixte : un membre réinscrit, un autre non. Placé tout en haut parce que
           c'est la seule alerte de cette page qui appelle une action, et qu'aucun email
           n'a été envoyé pour ce cas — le foyer ayant un accès valide. -->
      {lapsedNames.length > 0 && (
        <div class="rounded-xl border border-warning/20 bg-warning/10 px-5 py-4">
          <p class="text-sm font-semibold text-warning">
            {lapsedNames.length === 1
              ? `${lapsedNames[0]} n'a pas de licence pour ${seasonName || 'cette saison'}`
              : `${lapsedNames.slice(0, -1).join(', ')} et ${lapsedNames[lapsedNames.length - 1]} n'ont pas de licence pour ${seasonName || 'cette saison'}`}
          </p>
          <p class="mt-1 text-sm text-muted-foreground">
            Si la réadhésion est déjà faite, cette information disparaîtra d'elle-même sous
            quelques jours.
          </p>
          <a
            href={renewUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex min-h-[44px] items-center rounded-md bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground no-underline hover:bg-primary/90"
          >
            Reprendre la licence
          </a>
        </div>
      )}

      <!-- Ce que je suis, et ce que je dois. -->
      <section class="space-y-2">
        <h2 class="px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
          Mon adhésion
        </h2>
        <div class="divide-y divide-border overflow-hidden rounded-xl border border-border bg-card">
          {active && (
            <AccountRow
              href={`/adherents/${licenceUrl}?de=compte`}
              title="Ma fiche"
              description="Votre photo, vos équipes et vos classements, tels que les voient les autres adhérents."
            />
          )}
          <AccountRow
            href="/mon-compte/cotisation"
            title={`Ma cotisation${seasonName ? ` — ${seasonName}` : ''}`}
            description="Montant dû, déjà réglé et restant à payer pour la saison."
            value={aJour ? 'À jour' : 'Solde restant'}
          />
          <AccountRow
            href="/attestation"
            title="Mon attestation CSE"
            description={(session?.members.length ?? 0) > 1
              ? "Attestation de paiement à présenter à votre comité d'entreprise, pour chaque adhérent de votre compte."
              : "Attestation de paiement à présenter à votre comité d'entreprise."}
          />
        </div>
      </section>

      <!-- Mes démarches et leur suivi : les deux vont ensemble, déposer et relire. -->
      <section class="space-y-2">
        <h2 class="px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
          Mes démarches
        </h2>
        <div class="divide-y divide-border overflow-hidden rounded-xl border border-border bg-card">
          <AccountRow
            href="/mon-compte/commandes"
            title="Mes commandes"
            description="Vos achats à la boutique du club et leur règlement."
            value={compte(donnees?.orders.length ?? 0, 'commande')}
          />
          {canExpense && (
            <AccountRow
              href="/mon-compte/notes-de-frais"
              title="Mes notes de frais"
              description="Vos demandes de remboursement déposées, et de quoi en déposer une."
              value={compte(donnees?.expenses.length ?? 0, 'note')}
            />
          )}
        </div>
      </section>

      <section class="space-y-2">
        <h2 class="px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
          Réglages
        </h2>
        <div class="divide-y divide-border overflow-hidden rounded-xl border border-border bg-card">
          <AccountRow
            href="/notifications"
            title="Notifications"
            description="Activez ou coupez les alertes sur cet appareil, et choisissez les actualités du club que vous souhaitez recevoir."
          />
        </div>
      </section>
    </div>
  </main>

  <MobileNav client:idle features={Astro.locals.club?.features ?? {}} currentPath="/mon-compte" />
</Layout>
