---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.svelte';
import { ErrorAlert } from '@nba/ui';
import { ExpenseReportForm } from '@nba/expenses-ui';
import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';
import { getActiveMemberStatus } from '../lib/member-status';

const apiService = createApiClient(env);

interface Season {
  id: string;
  name: string;
  active: boolean;
}

interface Member {
  id: number;
  firstName: string;
  lastName: string;
  licence: string;
}

if (Astro.request.method === 'POST') {
  try {
    const postSession = Astro.locals.session;
    if (!postSession) {
      return new Response(JSON.stringify({ success: false, error: 'Non authentifié.' }), {
        status: 401,
        headers: { 'Content-Type': 'application/json' }
      });
    }

    const body = await Astro.request.json();

    if (body.action === 'expense') {
      // Le demandeur est TOUJOURS le profil actif de la session (jamais une valeur cliente).
      const data = { ...body.data, memberId: postSession.activeMemberId };
      return apiService.fetch('http://localhost/expenses', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
      });
    }
  } catch (err: any) {
    return new Response(JSON.stringify({ success: false, error: err.message }), {
      status: 500,
      headers: { 'Content-Type': 'application/json' }
    });
  }
}

// Membres = uniquement le foyer de la session (plus de fetch global des adhérents).
const session = Astro.locals.session;
const members: Member[] = session?.members ?? [];
const initialMemberId = session?.activeMemberId ? String(session.activeMemberId) : '';
// Statut frais lu en direct (effet immédiat après (dé)autorisation, sans reconnexion).
const canExpense = (await getActiveMemberStatus(env, session)).canExpense;

let seasons: Season[] = [];
let categories: any[] = [];
let errorMsg = '';

try {
  const seasonsRes = await apiService.fetch('http://localhost/accounting/seasons');
  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasons = json.data || [];
  } else {
    errorMsg = 'Impossible de charger les saisons.';
  }

  const categoriesRes = await apiService.fetch('http://localhost/accounting/categories');
  if (categoriesRes.ok) {
    const json = await categoriesRes.json() as any;
    categories = json.data || [];
  }
} catch (e: any) {
  errorMsg = 'Une erreur de connexion est survenue lors du chargement des données.';
}

const activeSeason = seasons.find((s: Season) => s.active) || seasons[0] || { id: '25-26', name: 'Saison 2025-2026', active: false };
const activeSeasonId = activeSeason.id;
---

<Layout title="Notes de frais - NBA 91">
  <Header currentPath="/note-de-frais" activeSeasonName={activeSeason.name || activeSeasonId} pageTitle="Note de frais" canExpense={canExpense} />

  <main class="flex-1 p-3 sm:p-6 w-full pb-24 md:pb-6">
    {errorMsg && (
      <div class="mb-6">
        <ErrorAlert message={errorMsg} />
      </div>
    )}

    {canExpense ? (
      <ExpenseReportForm
        client:load
        activeSeasonId={activeSeasonId}
        members={members}
        categories={categories}
        lockToMembers={true}
        initialMemberId={initialMemberId}
      />
    ) : (
      <div class="max-w-2xl mx-auto rounded-xl border border-border bg-muted/30 p-6 text-center">
        <p class="text-sm font-semibold text-foreground">Saisie des notes de frais non autorisée</p>
        <p class="text-sm text-muted-foreground mt-2">
          Votre compte n'est pas autorisé à soumettre des notes de frais. Rapprochez-vous du
          trésorier si vous pensez que c'est une erreur.
        </p>
      </div>
    )}
  </main>

  <MobileNav currentPath="/note-de-frais" canExpense={canExpense} />

  <footer class="border-t border-border mt-12 py-8 bg-card/20 text-center text-xs text-muted-foreground pb-24 md:pb-8">
    <p>© {new Date().getFullYear()} Nozay Badminton Association. Tous droits réservés.</p>
    <p class="mt-2"><a href="/confidentialite" class="hover:underline">Politique de confidentialité</a> · <a href="/mentions-legales" class="hover:underline">Mentions légales</a></p>
    <p class="mt-1">Les notes de frais sont soumises à la validation du trésorier.</p>
  </footer>
</Layout>
