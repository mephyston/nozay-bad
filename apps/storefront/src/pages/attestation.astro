---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.svelte';
import { env } from 'cloudflare:workers';
import { getSessionMembersStatus } from '../lib/member-status';

const session = Astro.locals.session;

// Écran de portée FOYER : on liste tous les profils de la session, chacun avec son
// attestation. Un parent qui gère les licences de ses enfants les récupère d'une traite,
// là où l'écran mono-profil l'obligeait à basculer de profil entre chaque — un aller-
// retour par enfant, pour un document qu'on télécharge une fois l'an.
//
// Aucun effet de bord : le profil actif ne change pas, et /api/attestation.pdf revalide
// que l'id demandé appartient bien à la session.
const members = await getSessionMembersStatus(env, session);
const solo = members.length <= 1;

// Un premier règlement suffit : l'attestation dit alors le montant réglé à ce jour, et
// le comité d'entreprise rembourse sur cette base. L'API applique la même règle.
const attestable = (m: { paid: boolean; partiallyPaid: boolean }) => m.paid || m.partiallyPaid;
const statusLabel = (m: { paid: boolean; partiallyPaid: boolean }) =>
  m.paid ? 'Cotisation réglée' : m.partiallyPaid ? 'Cotisation réglée en partie' : 'Cotisation en attente de règlement';
---

<Layout title="Attestation CSE - Nozay Bad">
  <Header currentPath="/attestation" />

  <main class="flex-1 p-6 w-full pb-24 md:pb-6">
    <div class="max-w-2xl mx-auto">
      <div class="mb-6">
        <h1 class="text-xl font-bold text-foreground">Attestation CSE</h1>
        <p class="text-sm text-muted-foreground mt-1">
          {solo
            ? "Attestation de paiement à présenter à votre comité d'entreprise."
            : "Attestation de paiement à présenter à votre comité d'entreprise, pour chaque adhérent de votre compte."}
        </p>
      </div>

      <div class="space-y-3">
        {members.map((m) => (
          <div class="rounded-xl border border-border bg-card p-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <p class="text-sm font-semibold text-foreground">{m.firstName} {m.lastName}</p>
                <p class="text-xs text-muted-foreground mt-0.5">
                  {statusLabel(m)}
                </p>
              </div>

              {attestable(m) && (
                <div class="flex gap-2">
                  <a
                    href={`/api/attestation.pdf?memberId=${m.id}`}
                    target="_blank"
                    rel="noopener"
                    data-document
                    class="inline-flex items-center justify-center gap-2 rounded-md bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground hover:bg-primary/90 min-h-[44px]"
                  >
                    Ouvrir
                  </a>
                  <a
                    href={`/api/attestation.pdf?memberId=${m.id}`}
                    download
                    class="inline-flex items-center justify-center gap-2 rounded-md border border-border bg-background px-3 py-2 text-sm font-semibold text-foreground hover:bg-accent min-h-[44px]"
                  >
                    Télécharger
                  </a>
                </div>
              )}
            </div>

            {!attestable(m) && (
              <p class="text-sm text-muted-foreground mt-3">
                L'attestation sera consultable ici dès qu'un premier règlement aura été
                enregistré par le trésorier.
              </p>
            )}
          </div>
        ))}
      </div>

      {/* L'aperçu intégré n'a de sens que sur un seul document : au-delà, la liste
          ci-dessus reste le point d'entrée et l'aperçu s'ouvre dans un onglet. */}
      {solo && members[0] && attestable(members[0]) && (
        <div class="hidden md:block rounded-xl border border-border overflow-hidden bg-card mt-4">
          <iframe
            src={`/api/attestation.pdf?memberId=${members[0].id}`}
            title="Attestation CSE"
            class="w-full h-[75vh]"
          ></iframe>
        </div>
      )}
    </div>
  </main>

  <MobileNav currentPath="/attestation" />

  <!-- En application installée, « Ouvrir » ne doit pas ouvrir de nouvelle fenêtre : elle
       n'aurait ni onglets ni historique, et « Précédent » n'y ramènerait nulle part — il
       ne resterait qu'à tuer l'application. Le PDF remplace alors l'écran, que le geste
       de retour ramène. Dans un navigateur, le nouvel onglet reste préférable : la page
       reste sous la main. Même détection que le splash (PwaSplash.astro). -->
  <script is:inline>
    if (
      window.matchMedia('(display-mode: standalone)').matches ||
      window.navigator.standalone === true
    ) {
      document.querySelectorAll('a[data-document]').forEach((a) => a.removeAttribute('target'));
    }
  </script>

  <footer class="hidden md:block border-t border-border mt-12 py-8 bg-card/20 text-center text-xs text-muted-foreground md:pb-8">
    <p>© {new Date().getFullYear()} Nozay Badminton Association. Tous droits réservés.</p>
    <p class="mt-2"><a href="/confidentialite" class="hover:underline">Politique de confidentialité</a> · <a href="/mentions-legales" class="hover:underline">Mentions légales</a></p>
  </footer>
</Layout>
