---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.svelte';
import { ErrorAlert } from '@nba/ui';
import { ShopCatalog } from '@nba/shop-ui';
import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';
import { getActiveMemberStatus } from '../lib/member-status';

const apiService = createApiClient(env);

interface Season {
  id: string;
  name: string;
  active: boolean;
}

interface Product {
  id: number;
  name: string;
  category: 'shuttlecock' | 'string';
  price: number;
  stock: number;
  active: boolean;
}

interface Member {
  id: number;
  firstName: string;
  lastName: string;
  licence: string;
}

if (Astro.request.method === 'POST') {
  try {
    const postSession = Astro.locals.session;
    if (!postSession) {
      return new Response(JSON.stringify({ success: false, error: 'Non authentifié.' }), {
        status: 401,
        headers: { 'Content-Type': 'application/json' }
      });
    }

    const body = await Astro.request.json();
    // L'adhérent de la commande est TOUJOURS le profil actif de la session.
    const order = { ...body, memberId: postSession.activeMemberId };

    return apiService.fetch('http://localhost/shop/orders', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(order)
    });
  } catch (err: any) {
    return new Response(JSON.stringify({ success: false, error: err.message }), {
      status: 500,
      headers: { 'Content-Type': 'application/json' }
    });
  }
}

// Membres = uniquement le foyer de la session.
const session = Astro.locals.session;
const members: Member[] = session?.members ?? [];
const initialMemberId = session?.activeMemberId ? String(session.activeMemberId) : '';
const canExpense = (await getActiveMemberStatus(env, session)).canExpense;

let products: Product[] = [];
let seasons: Season[] = [];
let errorMsg = '';

try {
  const productsRes = await apiService.fetch('http://localhost/shop/products?active=true');
  if (productsRes.ok) {
    const json = await productsRes.json() as any;
    products = json.data || [];
  } else {
    errorMsg = 'Impossible de charger les produits de la boutique.';
  }

  const seasonsRes = await apiService.fetch('http://localhost/accounting/seasons');
  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasons = json.data || [];
  } else {
    errorMsg = 'Impossible de charger les saisons.';
  }
} catch (e: any) {
  errorMsg = 'Une erreur de connexion est survenue lors du chargement des données.';
}

const activeSeason = seasons.find((s: Season) => s.active) || seasons[0] || { id: '25-26', name: 'Saison 2025-2026', active: false };
const activeSeasonId = activeSeason.id;
---

<Layout title="Boutique Adhérents - NBA 91">
  <Header currentPath="/boutique" activeSeasonName={activeSeason.name || activeSeasonId} canExpense={canExpense} />

  <main class="flex-1 p-3 sm:p-6 w-full pb-24 md:pb-6">
    {errorMsg && (
      <div class="mb-6">
        <ErrorAlert message={errorMsg} />
      </div>
    )}

    <ShopCatalog
      client:load
      products={products}
      members={members}
      activeSeasonId={activeSeasonId}
      lockToMembers={true}
      initialMemberId={initialMemberId}
    />
  </main>

  <MobileNav currentPath="/boutique" canExpense={canExpense} />

  <footer class="hidden md:block border-t border-border mt-12 py-8 bg-card/20 text-center text-xs text-muted-foreground md:pb-8">
    <p>© {new Date().getFullYear()} Nozay Badminton Association. Tous droits réservés.</p>
    <p class="mt-2"><a href="/confidentialite" class="hover:underline">Politique de confidentialité</a> · <a href="/mentions-legales" class="hover:underline">Mentions légales</a></p>
    <p class="mt-1">Les commandes passées via la boutique sont soumises à la validation du trésorier.</p>
  </footer>
</Layout>
