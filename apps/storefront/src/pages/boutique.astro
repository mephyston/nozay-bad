---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { ShopCatalog } from '@nba/shop-ui';
import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';
import { verifyTurnstileToken } from '../lib/turnstile';

const apiService = createApiClient(env);

interface Season {
  id: string;
  name: string;
  active: boolean;
}

interface Product {
  id: number;
  name: string;
  category: 'shuttlecock' | 'string';
  price: number;
  stock: number;
  active: boolean;
}

interface Member {
  id: number;
  firstName: string;
  lastName: string;
  licence: string;
}

const apiService = env.API_SERVICE;

if (Astro.request.method === 'POST') {
  try {
    const body = await Astro.request.json();
    const turnstileToken = body.turnstileToken;
    const ip = Astro.request.headers.get('CF-Connecting-IP') || Astro.request.headers.get('x-real-ip') || '127.0.0.1';
    let runtimeEnv: any = {};
    try {
      runtimeEnv = (Astro.locals as any).runtime?.env || {};
    } catch {}
    const kv = (env as any)?.RATE_LIMIT_KV || runtimeEnv.RATE_LIMIT_KV;

    const verifyResult = await verifyTurnstileToken(turnstileToken, ip, { kv, runtimeEnv });
    if (!verifyResult.success) {
      return new Response(JSON.stringify({ success: false, error: verifyResult.error || 'Validation anti-bot échouée.' }), {
        status: 400,
        headers: { 'Content-Type': 'application/json' }
      });
    }

    return apiService.fetch('http://localhost/shop/orders', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(body)
    });
  } catch (err: any) {
    return new Response(JSON.stringify({ success: false, error: err.message }), {
      status: 500,
      headers: { 'Content-Type': 'application/json' }
    });
  }
}

let products: Product[] = [];
let members: Member[] = [];
let seasons: Season[] = [];
let errorMsg = '';

try {
  const productsRes = await apiService.fetch('http://localhost/shop/products?active=true');
  if (productsRes.ok) {
    const json = await productsRes.json() as any;
    products = json.data || [];
  } else {
    errorMsg = 'Impossible de charger les produits de la boutique.';
  }

  const seasonsRes = await apiService.fetch('http://localhost/accounting/seasons');
  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasons = json.data || [];
  } else {
    errorMsg = 'Impossible de charger les saisons.';
  }
} catch (e: any) {
  errorMsg = 'Une erreur de connexion est survenue lors du chargement des données.';
}

const activeSeason = seasons.find((s: Season) => s.active) || seasons[0] || { id: '25-26', name: 'Saison 2025-2026', active: false };
const activeSeasonId = activeSeason.id;
---

<Layout title="Boutique Adhérents - NBA 91">
  <Header currentPath="/boutique" activeSeasonName={activeSeason.name || activeSeasonId} />

  <main class="flex-1 p-6 w-full">
    {errorMsg && (
      <div class="mb-6 p-4 bg-destructive/15 border border-destructive/20 text-destructive text-sm rounded-xl font-medium flex items-center gap-2">
        <span>⚠️ {errorMsg}</span>
      </div>
    )}

    <ShopCatalog
      client:load
      products={products}
      members={members}
      activeSeasonId={activeSeasonId}
    />
  </main>

  <footer class="border-t border-border mt-12 py-8 bg-card/20 text-center text-xs text-muted-foreground">
    <p>© {new Date().getFullYear()} Nozay Badminton Associatif. Tous droits réservés.</p>
    <p class="mt-1">Les commandes passées via la boutique sont soumises à la validation du trésorier.</p>
  </footer>
</Layout>
