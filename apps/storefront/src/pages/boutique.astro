---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.svelte';
import { ErrorAlert } from '@nba/ui';
import { ShopStorefront } from '@nba/shop-ui';
import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';
import { listSeasons, displaySeason, type Season } from '../lib/season';
import { websiteOrigin } from '../lib/media';

const apiService = createApiClient(env);

/*
  Le type vient du composant qui l'affiche, il n'est plus redéclaré ici.

  La copie locale avait divergé : elle annonçait `price` et `category` là où le
  catalogue attend `priceCents` et `productCategoryId`. Le code fonctionnait — l'API
  renvoie la bonne forme — mais le type mentait, et c'est exactement ce qui rend un
  renommage silencieusement dangereux.
*/
import type { Product } from '@nba/shop-ui';

interface Member {
  id: number;
  firstName: string;
  lastName: string;
  licence: string;
}

if (Astro.request.method === 'POST') {
  try {
    const postSession = Astro.locals.session;
    if (!postSession) {
      return new Response(JSON.stringify({ success: false, error: 'Non authentifié.' }), {
        status: 401,
        headers: { 'Content-Type': 'application/json' }
      });
    }

    const body = await Astro.request.json();
    // L'adhérent de la commande est TOUJOURS le profil actif de la session.
    const order = { ...body, memberId: postSession.activeMemberId };

    return apiService.fetch('http://localhost/shop/orders', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(order)
    });
  } catch (err: any) {
    return new Response(JSON.stringify({ success: false, error: err.message }), {
      status: 500,
      headers: { 'Content-Type': 'application/json' }
    });
  }
}

// Membres = uniquement le foyer de la session.
const session = Astro.locals.session;
const members: Member[] = session?.members ?? [];
const initialMemberId = session?.activeMemberId ? String(session.activeMemberId) : '';

let products: Product[] = [];
let seasons: Season[] = [];
/** Les moyens de paiement proposés aux adhérents, depuis la configuration du club. */
let paymentMethods: { value: string; label: string; kind: 'transfer' | 'cheque' | 'cash' | 'card' | 'voucher' | 'internal' }[] = [];
let errorMsg = '';

try {
  const productsRes = await apiService.fetch('http://localhost/shop/products?active=true');
  if (productsRes.ok) {
    const json = await productsRes.json() as any;
    products = json.data || [];
  } else {
    errorMsg = 'Impossible de charger les produits de la boutique.';
  }

  seasons = await listSeasons(env);
  if (seasons.length === 0) errorMsg = 'Impossible de charger les saisons.';

  const methodsRes = await apiService.fetch('http://localhost/accounting/payment-methods');
  if (methodsRes.ok) {
    const json = (await methodsRes.json()) as any;
    paymentMethods = (json.data || []).map((m: any) => ({ value: m.code, label: m.label, kind: m.kind }));
  }
} catch (e: any) {
  errorMsg = 'Une erreur de connexion est survenue lors du chargement des données.';
}

// Saison de la session (celle du calendrier), pas la saison comptable : une commande doit
// s'imputer sur la saison que l'adhérent est en train de jouer.
const activeSeasonId = displaySeason(seasons, session?.seasonCode)?.code ?? '';

// Un résultat de recherche arrive avec `?produit=` : la carte s'ouvre d'elle-même.
const requestedProduct = Number(Astro.url.searchParams.get('produit'));
const initialProductId = Number.isSafeInteger(requestedProduct) && requestedProduct > 0 ? requestedProduct : null;
---

<Layout title="Boutique Adhérents">
  <Header currentPath="/boutique" />

  <main class="flex-1 p-3 sm:p-6 w-full pb-nav md:pb-6">
    {errorMsg && (
      <div class="mb-6">
        <ErrorAlert message={errorMsg} />
      </div>
    )}

    <ShopStorefront
      client:load
      products={products}
      members={members}
      activeSeasonId={activeSeasonId}
      initialMemberId={initialMemberId}
      historyHref="/mon-compte/commandes"
      mediaOrigin={websiteOrigin}
      {initialProductId}
      {paymentMethods}
      bankDetails={{
        holder: Astro.locals.club?.settings.bankHolder ?? '',
        iban: Astro.locals.club?.settings.iban ?? '',
        bic: Astro.locals.club?.settings.bic ?? ''
      }}
    />
  </main>

  <MobileNav client:idle features={Astro.locals.club?.features ?? {}} currentPath="/boutique" />

  <footer class="hidden md:block border-t border-border mt-12 py-8 bg-card/20 text-center text-xs text-muted-foreground md:pb-8">
    <p>© {new Date().getFullYear()} {Astro.locals.club?.settings.name}. Tous droits réservés.</p>
    <p class="mt-2"><a href="/confidentialite" class="hover:underline">Politique de confidentialité</a> · <a href="/mentions-legales" class="hover:underline">Mentions légales</a></p>
    <p class="mt-1">Les commandes passées via la boutique sont soumises à la validation du trésorier.</p>
  </footer>
</Layout>
