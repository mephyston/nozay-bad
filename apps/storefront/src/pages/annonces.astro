---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.svelte';
import { ErrorAlert } from '@nba/ui';
import { AnnouncementCard } from '@nba/announcements-ui';
import { env } from 'cloudflare:workers';
import { getActiveMemberStatus } from '../lib/member-status';
import { fetchPublishedAnnouncements } from '../lib/announcements';

const session = Astro.locals.session;
const status = await getActiveMemberStatus(env, session);

const { announcements, failed } = await fetchPublishedAnnouncements(env, 50);
---

<Layout title="Annonces - Nozay Bad">
  <Header currentPath="/annonces" activeSeasonName={status.seasonName || undefined} canExpense={status.canExpense} />

  <main class="flex-1 p-3 sm:p-6 w-full pb-24 md:pb-6">
    <div class="max-w-3xl mx-auto">
      <div class="mb-6">
        <h1 class="text-xl sm:text-2xl font-bold text-foreground">Annonces du club</h1>
        <p class="mt-1 text-sm text-muted-foreground">Toutes les informations publiées par le bureau.</p>
      </div>

      {failed && <ErrorAlert message="Impossible de charger les annonces pour le moment." />}

      {!failed && announcements.length === 0 && (
        <div class="rounded-xl border border-border bg-card px-5 py-8 text-center">
          <p class="text-sm text-muted-foreground">Aucune annonce pour le moment.</p>
        </div>
      )}

      <div class="space-y-4">
        {announcements.map((announcement) => (
          <AnnouncementCard announcement={announcement} />
        ))}
      </div>
    </div>
  </main>

  <MobileNav currentPath="/annonces" canExpense={status.canExpense} />

  <footer class="hidden md:block border-t border-border mt-12 py-8 bg-card/20 text-center text-xs text-muted-foreground md:pb-8">
    <p>© {new Date().getFullYear()} Nozay Badminton Association. Tous droits réservés.</p>
    <p class="mt-2"><a href="/confidentialite" class="hover:underline">Politique de confidentialité</a> · <a href="/mentions-legales" class="hover:underline">Mentions légales</a></p>
  </footer>
</Layout>
