---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageTitle from '../components/PageTitle.astro';
import MobileNav from '../components/MobileNav.svelte';
import PushOptIn from '../components/PushOptIn.svelte';
import PushPreferences from '../components/PushPreferences.svelte';

---

<Layout title="Mes notifications">
  <Header currentPath="/notifications" />

  <main class="flex-1 p-3 sm:p-6 w-full pb-nav md:pb-6">
    <div class="max-w-3xl mx-auto space-y-8">
      <PageTitle title="Mes notifications" retour={{ href: '/mon-compte', label: 'Mon compte' }} />

      <section>
        <h2 class="text-base font-bold text-foreground mb-3">Cet appareil</h2>
        <!-- Ne s'affiche pas si l'appareil ne peut pas recevoir de notifications. -->
        <PushOptIn client:idle showSettingsLink={false} />
      </section>

      <section>
        <h2 class="text-base font-bold text-foreground mb-3">Ce que je souhaite recevoir</h2>
        <PushPreferences client:load />
      </section>
    </div>
  </main>

  <MobileNav client:idle features={Astro.locals.club?.features ?? {}} currentPath="/notifications" />
</Layout>
