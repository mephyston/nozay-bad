{
  "name": "nba-boutique",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "services": [
    { "binding": "API_SERVICE", "service": "nba-api" }
  ],
  "env": {
    "staging": {
      "name": "nba-boutique-staging",
      "services": [
        { "binding": "API_SERVICE", "service": "nba-api-staging" }
      ]
    }
  }
}
