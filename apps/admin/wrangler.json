{
  "name": "nba-admin",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "APP_ENV": "production"
  },
  "services": [
    {
      "binding": "API_SERVICE",
      "service": "nba-api"
    }
  ],
  "env": {
    "staging": {
      "name": "nba-admin-staging",
      "vars": {
        "APP_ENV": "staging"
      },
      "services": [
        {
          "binding": "API_SERVICE",
          "service": "nba-api-staging"
        }
      ]
    }
  }
}
