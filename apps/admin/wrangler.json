{
  "name": "nba-admin",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "INTERNAL_API_KEY": "dev-secret-key-12345"
  },
  "services": [
    { "binding": "API_SERVICE", "service": "nba-api" }
  ],
  "env": {
    "staging": {
      "name": "nba-admin-staging",
      "vars": {
        "INTERNAL_API_KEY": "nba_stg_sec_7f9c8d2a1e4b3c5d6e8f9a0b1c2d3e4f"
      },
      "services": [
        { "binding": "API_SERVICE", "service": "nba-api-staging" }
      ]
    }
  }
}
