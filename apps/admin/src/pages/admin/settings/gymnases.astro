---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import VenuesScreen from '../../../components/VenuesScreen.svelte';
import { PageHeader } from '@nba/ui';

/**
 * Les gymnases du club, sous « Configuration ».
 *
 * Page figée : l'îlot demande la liste au relais des créneaux (`gymnases`).
 *
 * Le retour vers le hub est confié à `retour` de `PageHeader` : un rond à chevron à
 * gauche du titre, sur téléphone seulement. Le lien de texte qu'il remplace vivait
 * *au-dessus* du titre, là où le pouce ne va pas, et doublait sur grand écran le fil
 * d'Ariane de la barre du haut — comme sur les quatre pages voisines, qui n'en ont
 * jamais eu.
 */
export const prerender = true;
---

<Layout title="Gymnases">
  <AdminLayout client:idle breadcrumb="Configuration / Gymnases">
    <div class="space-y-6">
      <PageHeader
        title="Gymnases"
        description="Les salles où le club joue. Les créneaux, l'agenda et le site public y renvoient."
        retour={{ href: '/admin/settings', libelle: 'Retour à la configuration' }}
      />
      <VenuesScreen client:load />
    </div>
  </AdminLayout>
</Layout>
