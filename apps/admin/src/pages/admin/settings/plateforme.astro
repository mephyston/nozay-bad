---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { PageHeader, ErrorAlert } from '@nba/ui';
import { createAdminApiClient } from '../../../lib/api';

/**
 * Consommation de la plateforme Cloudflare.
 *
 * La page dit une chose que le tableau de bord de Cloudflare ne dit nulle part : la
 * **distance au mur**. Sur le plan gratuit, dépasser un quota n'ajoute pas une ligne à
 * une facture, ça arrête le service jusqu'à minuit UTC — 1027 pour les requêtes, refus
 * sec des requêtes pour D1. Un pourcentage est donc la seule lecture utile.
 */

const userEmail = Astro.locals.user?.email || '';
const apiService = createAdminApiClient(Astro.locals);

interface WorkerUsage {
  script: string;
  requests: number;
  errors: number;
  subrequests: number;
  cpuP50Ms: number;
  cpuP99Ms: number;
  statuses: { status: string; requests: number }[];
}

interface DayPoint {
  date: string;
  workerRequests: number;
  d1RowsRead: number;
  d1RowsWritten: number;
}

interface Usage {
  configured: boolean;
  since: string;
  history: { days: number; series: DayPoint[] };
  workers: WorkerUsage[];
  databases: { databaseId: string; rowsRead: number; rowsWritten: number; readQueries: number; writeQueries: number }[];
  totals: { workerRequests: number; d1RowsRead: number; d1RowsWritten: number; cronTriggers: number };
  limits: {
    workerRequestsPerDay: number;
    d1RowsReadPerDay: number;
    d1RowsWrittenPerDay: number;
    cronTriggersPerAccount: number;
    cpuMsPerInvocation: number;
  };
}

let usage: Usage | null = null;
let error: string | null = null;

const PERIODES = [7, 15, 30];
const periodeDemandee = Astro.url.searchParams.get('periode') ?? '7';

try {
  const res = await apiService.fetch(
    `http://localhost/platform/usage?periode=${encodeURIComponent(periodeDemandee)}`
  );
  const body = (await res.json()) as { success: boolean; data?: Usage; error?: string };
  if (!res.ok || !body.success) error = body.error ?? `Erreur ${res.status}`;
  else usage = body.data ?? null;
} catch (err) {
  error = err instanceof Error ? err.message : 'Erreur inconnue';
}

const nombre = new Intl.NumberFormat('fr-FR');

/**
 * Trois décisions, pas un dégradé : rien à faire, surveiller, agir aujourd'hui.
 *
 * Une seule échelle pour tout l'écran — jauges, points des courbes, temps CPU — pour
 * qu'un même pourcentage de limite ait toujours la même couleur. Jetons sémantiques et
 * non palette brute : `libs/design-system.test.ts` le vérifie.
 */
function niveau(part: number): 'success' | 'warning' | 'destructive' {
  if (part >= 0.85) return 'destructive';
  if (part >= 0.6) return 'warning';
  return 'success';
}

const FOND = { success: 'bg-success', warning: 'bg-warning', destructive: 'bg-destructive' };
const TEXTE = {
  success: 'text-success',
  warning: 'text-warning',
  destructive: 'text-destructive'
};

/**
 * Deux repères sous chaque jauge : la veille, et le pire jour de la période.
 *
 * Sans eux la jauge du jour se lit mal — à huit heures du matin elle n'affiche qu'un
 * début de journée, et 4 % ne dit pas si l'on finira à 6 % ou à 40 %. La veille donne
 * l'échelle d'une journée entière, le pic dit jusqu'où on est déjà monté. Les deux se
 * rapportent à la **limite quotidienne**, puisque ce sont des journées.
 *
 * Ils sortent de la série d'historique, déjà chargée : aucune requête de plus.
 */
const series = usage?.history.series ?? [];
/** Journées achevées : celle en cours est partielle et fausserait le pic comme la moyenne. */
const joursComplets = series.slice(0, -1);

function reperes(cle: keyof DayPoint | null) {
  if (!cle || joursComplets.length === 0) return { veille: null, pic: null };
  const valeurs = joursComplets.map((p) => p[cle] as number);
  return { veille: valeurs[valeurs.length - 1] ?? null, pic: Math.max(...valeurs) };
}

const jauges = usage?.configured
  ? [
      {
        label: 'Requêtes Workers',
        value: usage.totals.workerRequests,
        limit: usage.limits.workerRequestsPerDay,
        detail: 'aujourd’hui, tous workers du compte',
        cle: 'workerRequests' as const
      },
      {
        label: 'Lignes D1 lues',
        value: usage.totals.d1RowsRead,
        limit: usage.limits.d1RowsReadPerDay,
        detail: 'aujourd’hui, toutes bases',
        cle: 'd1RowsRead' as const
      },
      {
        label: 'Lignes D1 écrites',
        value: usage.totals.d1RowsWritten,
        limit: usage.limits.d1RowsWrittenPerDay,
        detail: 'aujourd’hui, toutes bases',
        cle: 'd1RowsWritten' as const
      },
      {
        // Un décompte de configuration, pas une consommation : ni veille ni pic.
        label: 'Déclencheurs cron',
        value: usage.totals.cronTriggers,
        limit: usage.limits.cronTriggersPerAccount,
        detail: 'déclarés — la limite la moins visible',
        cle: null
      }
    ].map((j) => ({ ...j, part: j.limit > 0 ? j.value / j.limit : 0, ...reperes(j.cle) }))
  : [];

const jourCourt = new Intl.DateTimeFormat('fr-FR', { day: '2-digit', month: '2-digit' });

/** Étiquettes de points : « 420 k » plutôt que « 419 792 », qui se chevaucheraient. */
const compact = new Intl.NumberFormat('fr-FR', {
  notation: 'compact',
  maximumFractionDigits: 1
});

/** Cadre des courbes, en unités du `viewBox` — le SVG s'étire ensuite à la largeur dispo. */
const GRAPH = { largeur: 600, hauteur: 150, cote: 12, haut: 26, bas: 8 };

/**
 * Trois courbes à tracer.
 *
 * L'échelle verticale se cale sur **les données**, pas sur la limite : à 6 % du quota,
 * une échelle calée sur la limite écraserait la courbe contre l'axe et l'évolution — ce
 * qu'on vient précisément lire — deviendrait invisible. La limite n'est donc tracée que
 * lorsqu'elle tient dans le cadre ; sinon elle reste annoncée en toutes lettres au-dessus.
 *
 * La moyenne ignore le dernier point : la journée en cours est partielle, et la compter
 * tirerait la moyenne d'autant plus bas qu'on regarde la page tôt le matin.
 */
const metriques = usage?.configured
  ? (
      [
        {
          cle: 'workerRequests',
          label: 'Requêtes Workers',
          limite: usage.limits.workerRequestsPerDay
        },
        { cle: 'd1RowsRead', label: 'Lignes D1 lues', limite: usage.limits.d1RowsReadPerDay },
        {
          cle: 'd1RowsWritten',
          label: 'Lignes D1 écrites',
          limite: usage.limits.d1RowsWrittenPerDay
        }
      ] as const
    ).map(({ cle, label, limite }) => {
      const brut = series.map((p) => ({ date: p.date, valeur: p[cle] as number }));
      const valeurs = brut.map((p) => p.valeur);
      const max = Math.max(0, ...valeurs);
      const complets = valeurs.slice(0, -1);

      const limiteVisible = max > 0 && limite <= max * 1.6;
      const plafond = Math.max(limiteVisible ? limite * 1.1 : max * 1.25, 1);

      const largeurUtile = GRAPH.largeur - GRAPH.cote * 2;
      const hauteurUtile = GRAPH.hauteur - GRAPH.haut - GRAPH.bas;
      const abscisse = (i: number) =>
        GRAPH.cote + (brut.length > 1 ? (i / (brut.length - 1)) * largeurUtile : largeurUtile / 2);
      const ordonnee = (v: number) => GRAPH.haut + (1 - v / plafond) * hauteurUtile;

      const points = brut.map((point, i) => ({
        ...point,
        x: abscisse(i),
        y: ordonnee(point.valeur),
        part: limite > 0 ? point.valeur / limite : 0,
        /** Journée en cours : incomplète, donc annoncée comme telle au survol. */
        partiel: i === brut.length - 1
      }));

      return {
        label,
        limite,
        points,
        max,
        moyenne: complets.length
          ? Math.round(complets.reduce((a, b) => a + b, 0) / complets.length)
          : 0,
        ligne: points.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' '),
        limiteY: limiteVisible ? ordonnee(limite) : null,
        /** Trente étiquettes se chevauchent : au-delà de quinze jours, une sur deux. */
        pasEtiquette: brut.length > 15 ? 2 : 1
      };
    })
  : [];

const depuis = usage
  ? new Intl.DateTimeFormat('fr-FR', {
      dateStyle: 'long',
      timeStyle: 'short',
      timeZone: 'Europe/Paris'
    }).format(new Date(usage.since))
  : '';
---

<Layout title="Consommation de la plateforme - NBA 91">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={userEmail}
    breadcrumb="Consommation de la plateforme"
    permissions={Astro.locals.user?.permissions || []}
  >
    <div class="space-y-6">
      <PageHeader
        title="Consommation de la plateforme"
        description="Ce que les quatre applications consomment sur le compte Cloudflare, rapporté aux quotas du plan gratuit. Tout se remet à zéro à minuit UTC."
      />

      {error && <ErrorAlert message={error} />}

      {usage && !usage.configured && (
        <div class="rounded-xl border border-border bg-card px-5 py-4 space-y-2">
          <p class="text-sm font-semibold text-foreground">Jeton d’analytique non configuré</p>
          <p class="text-xs text-muted-foreground">
            Ces chiffres viennent de l’API GraphQL de Cloudflare, qui exige un jeton à portée
            compte, en lecture seule. Créez-le depuis <span class="font-mono">My Profile → API
            Tokens</span> avec la portée <span class="font-mono">Account Analytics: Read</span>,
            puis posez-le sur le Worker :
          </p>
          <pre class="text-xs bg-muted rounded-md px-3 py-2 overflow-x-auto"><code>npx wrangler secret put CLOUDFLARE_ANALYTICS_TOKEN --name nba-api</code></pre>
        </div>
      )}

      {usage?.configured && (
        <>
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
            {jauges.map((jauge) => (
              <div class="rounded-xl border border-border bg-card px-5 py-4 space-y-3">
                <div class="flex items-baseline justify-between gap-2">
                  <p class="text-sm font-semibold text-foreground">{jauge.label}</p>
                  <p class="text-sm font-semibold tabular-nums text-foreground">
                    {Math.round(jauge.part * 100)} %
                  </p>
                </div>
                <div class="h-2 w-full rounded-full bg-muted overflow-hidden">
                  <div
                    class={`h-full rounded-full ${FOND[niveau(jauge.part)]}`}
                    style={`width: ${Math.min(100, Math.max(jauge.part * 100, jauge.value > 0 ? 1 : 0))}%`}
                  />
                </div>
                <p class="text-xs text-muted-foreground tabular-nums">
                  {nombre.format(jauge.value)} / {nombre.format(jauge.limit)}
                </p>
                {jauge.veille !== null && jauge.pic !== null ? (
                  <p
                    class="text-xs text-muted-foreground tabular-nums"
                    title={`Hier : ${nombre.format(jauge.veille)} · pire journée des ${usage.history.days} derniers jours : ${nombre.format(jauge.pic)}`}
                  >
                    hier {Math.round((jauge.veille / jauge.limit) * 100)} % · pic{' '}
                    {Math.round((jauge.pic / jauge.limit) * 100)} % sur {usage.history.days} j
                  </p>
                ) : (
                  <p class="text-xs text-muted-foreground">&nbsp;</p>
                )}
                <p class="text-xs text-muted-foreground">{jauge.detail}</p>
              </div>
            ))}
          </div>

          <div class="rounded-xl border border-border bg-card overflow-hidden">
            <div class="px-5 py-4 border-b border-border flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="text-sm font-semibold text-foreground">Évolution</p>
                <p class="text-xs text-muted-foreground">
                  Consommation jour par jour. La dernière barre est la journée en cours, donc
                  incomplète — la moyenne l’ignore.
                </p>
              </div>
              <div class="flex items-center gap-1 rounded-lg border border-border p-1">
                {PERIODES.map((jours) => (
                  <a
                    href={`?periode=${jours}`}
                    class={`rounded-md px-3 py-1 text-xs font-medium no-underline transition-colors ${
                      usage.history.days === jours
                        ? 'bg-primary text-primary-foreground'
                        : 'text-muted-foreground hover:text-foreground'
                    }`}
                  >
                    {jours} jours
                  </a>
                ))}
              </div>
            </div>
            <div class="px-5 py-4 space-y-6">
              {metriques.map((metrique) => (
                <div class="space-y-1">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                    <p class="text-xs font-medium text-foreground">{metrique.label}</p>
                    <p class="text-xs text-muted-foreground tabular-nums">
                      moyenne {nombre.format(metrique.moyenne)} / jour · pic{' '}
                      <span class={TEXTE[niveau(metrique.limite > 0 ? metrique.max / metrique.limite : 0)]}>
                        {nombre.format(metrique.max)} ={' '}
                        {Math.round((metrique.max / metrique.limite) * 100)} % de la limite
                      </span>{' '}
                      · limite {nombre.format(metrique.limite)} / jour
                      {metrique.limiteY === null ? ', hors du cadre' : ''}
                    </p>
                  </div>

                  <svg
                    viewBox={`0 0 ${GRAPH.largeur} ${GRAPH.hauteur}`}
                    class="w-full h-auto overflow-visible"
                    role="img"
                    aria-label={`${metrique.label} : ${metrique.points.map((p) => `${jourCourt.format(new Date(p.date))} ${nombre.format(p.valeur)}`).join(', ')}`}
                  >
                    {metrique.limiteY !== null && (
                      <g class="text-destructive">
                        <line
                          x1="0"
                          x2={GRAPH.largeur}
                          y1={metrique.limiteY}
                          y2={metrique.limiteY}
                          stroke="currentColor"
                          stroke-width="1"
                          stroke-dasharray="5 4"
                          opacity="0.7"
                        />
                        <text
                          x={GRAPH.largeur}
                          y={metrique.limiteY - 5}
                          text-anchor="end"
                          font-size="10"
                          fill="currentColor"
                        >
                          limite {compact.format(metrique.limite)}
                        </text>
                      </g>
                    )}

                    <polyline
                      points={metrique.ligne}
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                      class="text-muted-foreground"
                    />

                    {metrique.points.map((point, i) => (
                      <g class={TEXTE[niveau(point.part)]}>
                        <circle
                          cx={point.x}
                          cy={point.y}
                          r={point.partiel ? 4 : 3}
                          fill={point.partiel ? 'var(--color-card)' : 'currentColor'}
                          stroke="currentColor"
                          stroke-width="1.5"
                        >
                          <title>
                            {`${jourCourt.format(new Date(point.date))} : ${nombre.format(point.valeur)} — ${Math.round(point.part * 100)} % de la limite quotidienne${point.partiel ? ' (journée en cours)' : ''}`}
                          </title>
                        </circle>
                        {i % metrique.pasEtiquette === 0 && (
                          <text
                            x={point.x}
                            y={point.y - 9}
                            text-anchor="middle"
                            font-size="10"
                            fill="currentColor"
                          >
                            {compact.format(point.valeur)}
                          </text>
                        )}
                      </g>
                    ))}
                  </svg>

                  <div class="flex justify-between text-[10px] text-muted-foreground">
                    <span>{metrique.points.length > 0 ? jourCourt.format(new Date(metrique.points[0].date)) : ''}</span>
                    <span>
                      {metrique.points.length > 0
                        ? `${jourCourt.format(new Date(metrique.points[metrique.points.length - 1].date))} (en cours)`
                        : ''}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="rounded-xl border border-border bg-card overflow-hidden">
            <div class="px-5 py-4 border-b border-border">
              <p class="text-sm font-semibold text-foreground">Workers</p>
              <p class="text-xs text-muted-foreground">
                Le temps CPU ne compte que l’exécution : l’attente d’une requête réseau ou d’une
                lecture D1 n’y entre pas. Les couleurs le situent face aux 10 ms par invocation
                du plan gratuit — un seuil <em>documenté</em>, pas un couperet : sur sept jours
                de ce compte, aucune invocation n’a fini en
                <span class="font-mono">exceededCpu</span> malgré des pointes bien au-delà.
                Cloudflare tolère, sans rien garantir. C’est la colonne « Statuts » qui
                trancherait : <span class="font-mono">exceededCpu</span> y désignerait des
                requêtes réellement tuées.
              </p>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="bg-muted/50 text-xs text-muted-foreground">
                  <tr>
                    <th class="text-left font-medium px-5 py-2">Worker</th>
                    <th class="text-right font-medium px-3 py-2">Requêtes</th>
                    <th class="text-right font-medium px-3 py-2">Sous-req.</th>
                    <th class="text-right font-medium px-3 py-2">CPU p50</th>
                    <th class="text-right font-medium px-3 py-2">CPU p99</th>
                    <th class="text-left font-medium px-5 py-2">Statuts</th>
                  </tr>
                </thead>
                <tbody>
                  {usage.workers.map((worker) => (
                    <tr class="border-t border-border">
                      <td class="px-5 py-2 font-medium text-foreground">{worker.script}</td>
                      <td class="px-3 py-2 text-right tabular-nums">{nombre.format(worker.requests)}</td>
                      <td class="px-3 py-2 text-right tabular-nums text-muted-foreground">
                        {nombre.format(worker.subrequests)}
                      </td>
                      <td
                        class={`px-3 py-2 text-right tabular-nums ${TEXTE[niveau(worker.cpuP50Ms / usage.limits.cpuMsPerInvocation)]}`}
                      >
                        {worker.cpuP50Ms} ms
                      </td>
                      <td
                        class={`px-3 py-2 text-right tabular-nums ${TEXTE[niveau(worker.cpuP99Ms / usage.limits.cpuMsPerInvocation)]}`}
                      >
                        {worker.cpuP99Ms} ms
                      </td>
                      <td class="px-5 py-2 text-xs text-muted-foreground">
                        {worker.statuses
                          .filter((s) => s.status !== 'success')
                          .map((s) => `${s.status} : ${nombre.format(s.requests)}`)
                          .join(' · ') || '—'}
                      </td>
                    </tr>
                  ))}
                  {usage.workers.length === 0 && (
                    <tr>
                      <td colspan="6" class="px-5 py-6 text-center text-muted-foreground text-xs">
                        Aucune invocation depuis minuit UTC.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>

          <div class="rounded-xl border border-border bg-card overflow-hidden">
            <div class="px-5 py-4 border-b border-border">
              <p class="text-sm font-semibold text-foreground">Bases D1</p>
              <p class="text-xs text-muted-foreground">
                Ce sont les <em>lignes lues</em> qui comptent, pas les requêtes : une requête sans
                index en lit toute une table.
              </p>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="bg-muted/50 text-xs text-muted-foreground">
                  <tr>
                    <th class="text-left font-medium px-5 py-2">Base</th>
                    <th class="text-right font-medium px-3 py-2">Lignes lues</th>
                    <th class="text-right font-medium px-3 py-2">Lignes écrites</th>
                    <th class="text-right font-medium px-3 py-2">Requêtes L / É</th>
                    <th class="text-right font-medium px-5 py-2">Lignes / requête</th>
                  </tr>
                </thead>
                <tbody>
                  {usage.databases.map((base) => (
                    <tr class="border-t border-border">
                      <td class="px-5 py-2 font-mono text-xs text-foreground">
                        {base.databaseId.slice(0, 8)}…
                      </td>
                      <td class="px-3 py-2 text-right tabular-nums">{nombre.format(base.rowsRead)}</td>
                      <td class="px-3 py-2 text-right tabular-nums">{nombre.format(base.rowsWritten)}</td>
                      <td class="px-3 py-2 text-right tabular-nums text-muted-foreground">
                        {nombre.format(base.readQueries)} / {nombre.format(base.writeQueries)}
                      </td>
                      <td class="px-5 py-2 text-right tabular-nums">
                        {base.readQueries > 0 ? Math.round(base.rowsRead / base.readQueries) : 0}
                      </td>
                    </tr>
                  ))}
                  {usage.databases.length === 0 && (
                    <tr>
                      <td colspan="5" class="px-5 py-6 text-center text-muted-foreground text-xs">
                        Aucune requête depuis minuit UTC.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>

          <p class="text-xs text-muted-foreground">
            Fenêtre : depuis le {depuis} (minuit UTC). Chiffres rafraîchis au plus toutes les
            cinq minutes — l’API d’analytique agrège elle-même à la minute, et un rechargement
            compulsif pèserait plus lourd que ce qu’il mesure.
          </p>
        </>
      )}
    </div>
  </AdminLayout>
</Layout>
