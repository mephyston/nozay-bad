---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import SettingsScreen from '../../../components/SettingsScreen.svelte';

/*
  Page figée : elle n'est plus rendue par un worker, mais servie depuis les actifs.
  Elle ne porte donc aucune donnée, aucune identité et aucun paramètre d'URL — l'îlot
  demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Configuration des saisons - NBA 91">
  <AdminLayout
    client:idle
    breadcrumb="Configuration / Saisons"
  >
    <div class="space-y-6">
      <SettingsScreen
        client:load
        domaine="accounting"
        ecran="seasons"
        titre="Saisons comptables"
        description="Ouvrez, activez et clôturez les exercices comptables du club."
        view="seasons"
        allowedViews={['seasons']}
      />
    </div>
  </AdminLayout>
</Layout>
