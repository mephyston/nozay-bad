---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import SettingsScreen from '../../../components/SettingsScreen.svelte';
---

<Layout title="Configuration des saisons - NBA 91">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || ''}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Configuration / Saisons"
  >
    <div class="space-y-6">
      <SettingsScreen
        client:load
        domaine="accounting"
        ecran="seasons"
        titre="Saisons comptables"
        description="Ouvrez, activez et clôturez les exercices comptables du club."
        view="seasons"
        allowedViews={['seasons']}
      />
    </div>
  </AdminLayout>
</Layout>
