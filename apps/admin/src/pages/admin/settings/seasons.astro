---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import SettingsScreen from '../../../components/SettingsScreen.svelte';

/*
  Page figée.

  Le worker reste **invoqué** — l'adaptateur d'Astro sert les actifs lui-même, par
  `env.ASSETS.fetch` — mais il ne rend plus rien : il transmet un fichier. Ce que le
  prerender supprime est le rendu, pas l'invocation.

  Corollaire : la page ne porte aucune donnée, aucune identité et aucun paramètre d'URL.
  L'îlot demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Configuration des saisons">
  <AdminLayout
    client:idle
    breadcrumb="Configuration / Saisons"
  >
    <div class="space-y-6">
      <SettingsScreen
        client:load
        domaine="accounting"
        ecran="seasons"
        titre="Saisons comptables"
        description="Ouvrez, activez et clôturez les exercices comptables du club."
        view="seasons"
        allowedViews={['seasons']}
      />
    </div>
  </AdminLayout>
</Layout>
