---
import { SECTION_SPECS } from '@nba/club-ui';

/*
  Les réglages du club s'ouvrent désormais **en tiroir** depuis le hub de configuration,
  comme tous les autres formulaires : croix et validation en haut, à portée du pouce.

  L'adresse reste servie pour les liens gardés — un signet, un lien dans une note — et
  renvoie vers le hub avec la section demandée, qu'il ouvre aussitôt.

  Une redirection **temporaire**, et non permanente. Une 301 est mise en cache par le
  navigateur sans expiration et sans revalidation : elle ne redemande jamais au serveur.
  Si la réorganisation est un jour défaite — cela vient d'arriver pour les gymnases —
  l'ancienne adresse reste détournée chez tous ceux qui l'ont visitée entre-temps, et
  aucun correctif serveur ne les atteint.
*/
export const prerender = true;

export function getStaticPaths() {
  /*
    Du catalogue, et non d'une liste recopiée : une section ajoutée à `SECTION_SPECS`
    gagne sa redirection sans que personne n'y pense, et une section retirée perd la
    sienne. Les deux qui n'en relèvent pas — les fonctionnalités et les images — sont
    nommées ici parce qu'elles n'ont pas de spécification de champs.
  */
  const sections = [...SECTION_SPECS.map((s) => s.section), 'fonctionnalites', 'documents'];
  return sections.map((section) => ({ params: { section } }));
}

const { section } = Astro.params;
return Astro.redirect(`/admin/settings?section=${section}`);
---
