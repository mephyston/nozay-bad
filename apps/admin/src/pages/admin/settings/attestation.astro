---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { PageHeader, ErrorAlert } from '@nba/ui';
import { env } from 'cloudflare:workers';
import { createAdminApiClient } from '../../../lib/api';
import { MAX_SIGNATURE_BYTES } from '@nba/members-api';

const userEmail = Astro.locals.user?.email || '';
const apiService = createAdminApiClient(Astro.locals);

// Dérivé du plafond serveur, jamais recopié : deux chiffres à maintenir en accord
// divergent toujours, et celui-ci ne se serait vu qu'au refus du serveur.
const MAX_SIGNATURE_KB = Math.round(MAX_SIGNATURE_BYTES / 1024);

/*
  Les écritures de cet écran vivent sur `/admin/api/members/attestation`, avec leurs
  gardes. Cette page ne fait plus que lire — une seule lecture — et rendre son formulaire.
*/
// --- GET : charge la config courante ---
let config: any = null;
let errorMsg = '';
try {
  const res = await apiService.fetch('http://localhost/members/attestation/config');
  if (res.ok) {
    config = (await res.json() as any).data;
  } else {
    errorMsg = 'Impossible de charger la configuration de l\'attestation.';
  }
} catch {
  errorMsg = 'Impossible de charger la configuration de l\'attestation.';
}
---

<Layout title="Attestation CSE - Configuration">
  <AdminLayout realEmail={Astro.locals.realUser?.email || ""}
    name={Astro.locals.user?.name}
    client:idle
    email={userEmail}
    breadcrumb="Configuration / Attestation CSE"
    permissions={Astro.locals.user?.permissions || []}
  >
    <div class="space-y-6 max-w-3xl">
      <div class="no-print">
        <a
          href="/admin/settings"
          class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          Retour à la configuration
        </a>
      </div>

      <PageHeader
        title="Attestation CSE"
        description="Personnalisez le signataire et la signature qui apparaissent sur les attestations générées."
      />

      {errorMsg && <ErrorAlert message={errorMsg} />}

      {config && (
        <div class="space-y-8">
          <!-- Identité du signataire -->
          <form id="info-form" class="bg-card text-card-foreground border border-border rounded-xl p-6 space-y-4 shadow-sm">
            <h2 class="text-base font-semibold text-foreground">Signataire</h2>
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="block">
                <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wide">Nom du signataire</span>
                <input name="signatoryName" value={config.signatoryName} required maxlength="120"
                  class="mt-1 w-full rounded-lg border border-input bg-background text-foreground px-3 py-2 text-sm focus:border-ring focus:ring-1 focus:ring-ring outline-none" />
              </label>
              <label class="block">
                <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wide">Adresse mail</span>
                <input name="signatoryEmail" type="text" value={config.signatoryEmail} required maxlength="200"
                  class="mt-1 w-full rounded-lg border border-input bg-background text-foreground px-3 py-2 text-sm focus:border-ring focus:ring-1 focus:ring-ring outline-none" />
              </label>
              <label class="block sm:col-span-2">
                <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wide">Site web</span>
                <input name="websiteUrl" value={config.websiteUrl} required maxlength="200"
                  class="mt-1 w-full rounded-lg border border-input bg-background text-foreground px-3 py-2 text-sm focus:border-ring focus:ring-1 focus:ring-ring outline-none" />
              </label>
            </div>
            <div class="flex items-center gap-3">
              <button type="submit"
                class="px-4 py-2 rounded-lg bg-primary hover:bg-primary/90 text-primary-foreground text-sm font-semibold cursor-pointer border-0">
                Enregistrer
              </button>
              <span id="info-status" class="text-sm"></span>
            </div>
          </form>

          <!-- Signature -->
          <div class="bg-card text-card-foreground border border-border rounded-xl p-6 space-y-4 shadow-sm">
            <div>
              <h2 class="text-base font-semibold text-foreground">Signature</h2>
              <p class="text-xs text-muted-foreground mt-1">
                Image PNG ou JPEG. Elle est réduite automatiquement pour l'impression : inutile de la préparer.
                Le PNG est préférable, il conserve la transparence.
              </p>
            </div>
            <div class="flex items-center gap-6">
              <img id="signature-preview" src={config.signature.dataUrl} alt="Signature"
                class="h-20 w-auto max-w-[220px] object-contain border border-border rounded bg-background p-2" />
              <div class="space-y-3">
                <input id="signature-file" type="file" accept="image/png,image/jpeg"
                  class="block text-sm text-muted-foreground file:mr-3 file:rounded-lg file:border-0 file:bg-muted file:px-3 file:py-2 file:text-sm file:font-semibold file:text-foreground hover:file:bg-muted/80 file:cursor-pointer" />
                <div class="flex items-center gap-3">
                  <button id="signature-upload" disabled
                    class="px-4 py-2 rounded-lg bg-primary hover:bg-primary/90 text-primary-foreground text-sm font-semibold cursor-pointer border-0 disabled:opacity-40 disabled:cursor-not-allowed">
                    Remplacer la signature
                  </button>
                  <span id="signature-status" class="text-sm"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  </AdminLayout>
</Layout>

<script define:vars={{ MAX_SIGNATURE_KB }}>
  const post = async (payload) => {
    // Le relais du domaine, et non la page : celle-ci ne porte plus de gestionnaire, et
    // Astro répondrait 200 en rendant son HTML — un succès pour une écriture nulle.
    const res = await fetch('/admin/api/members/attestation', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    if (!res.ok) throw new Error(await res.text());
    return res.json();
  };

  const setStatus = (el, msg, ok) => {
    el.textContent = msg;
    el.className = 'text-sm ' + (ok ? 'text-success' : 'text-destructive');
  };

  // --- Infos signataire ---
  const infoForm = document.getElementById('info-form');
  infoForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = document.getElementById('info-status');
    const fd = new FormData(infoForm);
    try {
      await post({
        action: 'update_info',
        signatoryName: fd.get('signatoryName'),
        signatoryEmail: fd.get('signatoryEmail'),
        websiteUrl: fd.get('websiteUrl')
      });
      setStatus(status, 'Enregistré ✓', true);
    } catch (err) {
      setStatus(status, err.message || 'Erreur', false);
    }
  });

  // --- Signature ---
  const fileInput = document.getElementById('signature-file');
  const uploadBtn = document.getElementById('signature-upload');
  const preview = document.getElementById('signature-preview');
  const sigStatus = document.getElementById('signature-status');
  let pendingDataUrl = null;

  /*
   * Une signature s'imprime sur quatre centimètres de large.
   *
   * Au-delà de ces dimensions, les pixels supplémentaires ne se voient sur aucune
   * attestation : ils alourdissent seulement le PDF de chaque adhérent. Un scan de
   * téléphone fait couramment un demi-méga ; réduit ici, il tombe à quelques dizaines de
   * kilo-octets sans différence visible.
   */
  const SIGNATURE_MAX_W = 900;
  const SIGNATURE_MAX_H = 300;

  /** Charge un fichier image en `HTMLImageElement`, via une URL d'objet libérée après coup. */
  function loadImage(file) {
    return new Promise((resolve, reject) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => { URL.revokeObjectURL(url); resolve(img); };
      img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('Image illisible.')); };
      img.src = url;
    });
  }

  /**
   * Réduit l'image jusqu'à ce qu'elle tienne sous le plafond, et rend sa data URL.
   *
   * Le PNG est conservé en PNG : c'est lui qui porte la transparence, et la reconvertir
   * en JPEG poserait le rectangle blanc qu'on cherche justement à éviter. Un trait sur
   * fond transparent se compresse d'ailleurs très bien — ce sont les aplats qui coûtent
   * cher en PNG, pas les lignes.
   *
   * Si le premier passage ne suffit pas — un scan bruité, où chaque pixel diffère de son
   * voisin — on réduit encore par paliers plutôt que d'échouer en renvoyant l'utilisateur
   * à son logiciel de retouche.
   */
  async function shrinkSignature(file) {
    const img = await loadImage(file);
    const mime = file.type === 'image/png' ? 'image/png' : 'image/jpeg';
    let scale = Math.min(1, SIGNATURE_MAX_W / img.width, SIGNATURE_MAX_H / img.height);

    for (let attempt = 0; attempt < 5; attempt++) {
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(img.width * scale));
      canvas.height = Math.max(1, Math.round(img.height * scale));
      const ctx = canvas.getContext('2d');
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

      const dataUrl = canvas.toDataURL(mime, 0.9);
      // Longueur du base64 → octets décodés, sans décoder.
      const base64 = dataUrl.slice(dataUrl.indexOf(',') + 1);
      const bytes = Math.floor((base64.length * 3) / 4);
      if (bytes <= MAX_SIGNATURE_KB * 1024) return { dataUrl, bytes };

      scale *= 0.75;
    }
    return null;
  }

  fileInput?.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    // Le PNG est préférable : il garde la transparence, là où le JPEG pose un rectangle
    // blanc sur le document et bave autour des traits fins.
    if (file.type !== 'image/png' && file.type !== 'image/jpeg') {
      setStatus(sigStatus, 'Format PNG ou JPEG requis.', false);
      uploadBtn.disabled = true;
      return;
    }

    uploadBtn.disabled = true;
    setStatus(sigStatus, 'Préparation de l’image…', true);

    try {
      const shrunk = await shrinkSignature(file);
      if (!shrunk) {
        setStatus(sigStatus, `Image trop chargée pour être réduite sous ${MAX_SIGNATURE_KB} Ko. Recadrez-la sur la signature seule.`, false);
        return;
      }
      pendingDataUrl = shrunk.dataUrl;
      preview.src = pendingDataUrl;
      uploadBtn.disabled = false;
      const before = Math.round(file.size / 1024);
      const after = Math.round(shrunk.bytes / 1024);
      setStatus(
        sigStatus,
        after < before ? `Prête à enregistrer (${before} Ko réduits à ${after} Ko).` : 'Prête à enregistrer.',
        true
      );
    } catch (err) {
      setStatus(sigStatus, err.message || 'Image illisible.', false);
    }
  });

  uploadBtn?.addEventListener('click', async () => {
    if (!pendingDataUrl) return;
    uploadBtn.disabled = true;
    try {
      await post({ action: 'upload_signature', signature: pendingDataUrl });
      setStatus(sigStatus, 'Signature mise à jour ✓', true);
    } catch (err) {
      setStatus(sigStatus, err.message || 'Erreur', false);
      uploadBtn.disabled = false;
    }
  });
</script>
