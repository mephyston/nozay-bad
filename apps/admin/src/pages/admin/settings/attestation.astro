---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { PageHeader, ErrorAlert } from '@nba/ui';
import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';

const userEmail = Astro.locals.user?.email || 'admin@nozaybad.fr';
const apiService = createApiClient(env);

// Cap signature aligné sur le serveur (MAX_SIGNATURE_BYTES = 48 Ko).
const MAX_SIGNATURE_KB = 48;

// --- POST : mise à jour des infos ou upload de la signature ---
if (Astro.request.method === 'POST') {
  try {
    const data = (await Astro.request.json()) as any;

    if (data.action === 'update_info') {
      const apiRes = await apiService.fetch('http://localhost/members/attestation/config', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          signatoryName: data.signatoryName,
          signatoryEmail: data.signatoryEmail,
          websiteUrl: data.websiteUrl
        })
      });
      if (!apiRes.ok) return new Response(await apiRes.text(), { status: apiRes.status });
    } else if (data.action === 'upload_signature') {
      const apiRes = await apiService.fetch('http://localhost/members/attestation/signature', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ signature: data.signature })
      });
      if (!apiRes.ok) return new Response(await apiRes.text(), { status: apiRes.status });
    } else {
      return new Response('Action inconnue', { status: 400 });
    }

    return new Response(JSON.stringify({ success: true }), {
      headers: { 'Content-Type': 'application/json' }
    });
  } catch (err: any) {
    return new Response(err?.message || 'Erreur serveur', { status: 500 });
  }
}

// --- GET : charge la config courante ---
let config: any = null;
let errorMsg = '';
try {
  const res = await apiService.fetch('http://localhost/members/attestation/config');
  if (res.ok) {
    config = (await res.json() as any).data;
  } else {
    errorMsg = 'Impossible de charger la configuration de l\'attestation.';
  }
} catch {
  errorMsg = 'Impossible de charger la configuration de l\'attestation.';
}
---

<Layout title="Attestation CSE - Configuration">
  <AdminLayout
    name={Astro.locals.user?.name}
    client:idle
    email={userEmail}
    breadcrumb="Configuration / Attestation CSE"
    permissions={Astro.locals.user?.permissions || []}
  >
    <div class="space-y-6 max-w-3xl">
      <div class="no-print">
        <a
          href="/admin/settings"
          class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          Retour à la configuration
        </a>
      </div>

      <PageHeader
        title="Attestation CSE"
        description="Personnalisez le signataire et la signature qui apparaissent sur les attestations générées."
      />

      {errorMsg && <ErrorAlert message={errorMsg} />}

      {config && (
        <div class="space-y-8">
          <!-- Identité du signataire -->
          <form id="info-form" class="bg-card text-card-foreground border border-border rounded-xl p-6 space-y-4 shadow-sm">
            <h2 class="text-base font-semibold text-foreground">Signataire</h2>
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="block">
                <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wide">Nom du signataire</span>
                <input name="signatoryName" value={config.signatoryName} required maxlength="120"
                  class="mt-1 w-full rounded-lg border border-input bg-background text-foreground px-3 py-2 text-sm focus:border-ring focus:ring-1 focus:ring-ring outline-none" />
              </label>
              <label class="block">
                <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wide">Adresse mail</span>
                <input name="signatoryEmail" type="text" value={config.signatoryEmail} required maxlength="200"
                  class="mt-1 w-full rounded-lg border border-input bg-background text-foreground px-3 py-2 text-sm focus:border-ring focus:ring-1 focus:ring-ring outline-none" />
              </label>
              <label class="block sm:col-span-2">
                <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wide">Site web</span>
                <input name="websiteUrl" value={config.websiteUrl} required maxlength="200"
                  class="mt-1 w-full rounded-lg border border-input bg-background text-foreground px-3 py-2 text-sm focus:border-ring focus:ring-1 focus:ring-ring outline-none" />
              </label>
            </div>
            <div class="flex items-center gap-3">
              <button type="submit"
                class="px-4 py-2 rounded-lg bg-primary hover:bg-primary/90 text-primary-foreground text-sm font-semibold cursor-pointer border-0">
                Enregistrer
              </button>
              <span id="info-status" class="text-sm"></span>
            </div>
          </form>

          <!-- Signature -->
          <div class="bg-card text-card-foreground border border-border rounded-xl p-6 space-y-4 shadow-sm">
            <div>
              <h2 class="text-base font-semibold text-foreground">Signature</h2>
              <p class="text-xs text-muted-foreground mt-1">
                Image JPEG, max {MAX_SIGNATURE_KB} Ko. {config.signature.isDefault ? 'Signature d\'origine (modèle) actuellement utilisée.' : 'Signature personnalisée active.'}
              </p>
            </div>
            <div class="flex items-center gap-6">
              <img id="signature-preview" src={config.signature.dataUrl} alt="Signature"
                class="h-20 w-auto max-w-[220px] object-contain border border-border rounded bg-background p-2" />
              <div class="space-y-3">
                <input id="signature-file" type="file" accept="image/jpeg"
                  class="block text-sm text-muted-foreground file:mr-3 file:rounded-lg file:border-0 file:bg-muted file:px-3 file:py-2 file:text-sm file:font-semibold file:text-foreground hover:file:bg-muted/80 file:cursor-pointer" />
                <div class="flex items-center gap-3">
                  <button id="signature-upload" disabled
                    class="px-4 py-2 rounded-lg bg-primary hover:bg-primary/90 text-primary-foreground text-sm font-semibold cursor-pointer border-0 disabled:opacity-40 disabled:cursor-not-allowed">
                    Remplacer la signature
                  </button>
                  <span id="signature-status" class="text-sm"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  </AdminLayout>
</Layout>

<script define:vars={{ MAX_SIGNATURE_KB }}>
  const post = async (payload) => {
    const res = await fetch(window.location.pathname, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    if (!res.ok) throw new Error(await res.text());
    return res.json();
  };

  const setStatus = (el, msg, ok) => {
    el.textContent = msg;
    el.className = 'text-sm ' + (ok ? 'text-success' : 'text-destructive');
  };

  // --- Infos signataire ---
  const infoForm = document.getElementById('info-form');
  infoForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = document.getElementById('info-status');
    const fd = new FormData(infoForm);
    try {
      await post({
        action: 'update_info',
        signatoryName: fd.get('signatoryName'),
        signatoryEmail: fd.get('signatoryEmail'),
        websiteUrl: fd.get('websiteUrl')
      });
      setStatus(status, 'Enregistré ✓', true);
    } catch (err) {
      setStatus(status, err.message || 'Erreur', false);
    }
  });

  // --- Signature ---
  const fileInput = document.getElementById('signature-file');
  const uploadBtn = document.getElementById('signature-upload');
  const preview = document.getElementById('signature-preview');
  const sigStatus = document.getElementById('signature-status');
  let pendingDataUrl = null;

  fileInput?.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    if (file.type !== 'image/jpeg') {
      setStatus(sigStatus, 'Format JPEG requis.', false);
      uploadBtn.disabled = true;
      return;
    }
    if (file.size > MAX_SIGNATURE_KB * 1024) {
      setStatus(sigStatus, `Image trop lourde (${Math.round(file.size / 1024)} Ko, max ${MAX_SIGNATURE_KB} Ko).`, false);
      uploadBtn.disabled = true;
      return;
    }
    const reader = new FileReader();
    reader.onload = () => {
      pendingDataUrl = reader.result;
      preview.src = pendingDataUrl;
      uploadBtn.disabled = false;
      setStatus(sigStatus, 'Prête à enregistrer.', true);
    };
    reader.readAsDataURL(file);
  });

  uploadBtn?.addEventListener('click', async () => {
    if (!pendingDataUrl) return;
    uploadBtn.disabled = true;
    try {
      await post({ action: 'upload_signature', signature: pendingDataUrl });
      setStatus(sigStatus, 'Signature mise à jour ✓', true);
    } catch (err) {
      setStatus(sigStatus, err.message || 'Erreur', false);
      uploadBtn.disabled = false;
    }
  });
</script>
