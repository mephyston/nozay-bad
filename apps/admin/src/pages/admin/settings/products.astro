---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import SettingsScreen from '../../../components/SettingsScreen.svelte';
---

<Layout title="Catégories Produits - NBA 91">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || ''}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Configuration / Catégories Produits"
  >
    <div class="space-y-6">
      <SettingsScreen
        client:load
        domaine="shop"
        ecran="categories"
        titre="Catégories de Produits"
        description="Gérez les catégories de la boutique et leurs correspondances avec la comptabilité."
        view="shop"
        allowedViews={['shop']}
      />
    </div>
  </AdminLayout>
</Layout>
