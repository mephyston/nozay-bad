---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import SettingsScreen from '../../../components/SettingsScreen.svelte';

/*
  Page figée : elle n'est plus rendue par un worker, mais servie depuis les actifs.
  Elle ne porte donc aucune donnée, aucune identité et aucun paramètre d'URL — l'îlot
  demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Catégories Produits - NBA 91">
  <AdminLayout
    client:idle
    breadcrumb="Configuration / Catégories Produits"
  >
    <div class="space-y-6">
      <SettingsScreen
        client:load
        domaine="shop"
        ecran="categories"
        titre="Catégories de Produits"
        description="Gérez les catégories de la boutique et leurs correspondances avec la comptabilité."
        view="shop"
        allowedViews={['shop']}
      />
    </div>
  </AdminLayout>
</Layout>
