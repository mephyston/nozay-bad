---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { PageHeader, ErrorAlert } from '@nba/ui';
import { SettingsManager } from '@nba/accounting-ui';
import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';

const userEmail = Astro.locals.user?.email || "admin@nozaybad.fr";
const apiService = createApiClient(env);

async function handleApiError(res: Response) {
  let errMsg = await res.text();
  try {
    const j = JSON.parse(errMsg);
    if (j.error) errMsg = j.error;
  } catch(e){}
  return new Response(errMsg, { status: res.status });
}

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.json() as any;
    
    if (data.action === 'create_category') {
      const apiRes = await apiService.fetch('http://localhost/accounting/categories', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          adminLabel: data.adminLabel,
          adherentLabel: data.adherentLabel,
          hideInExpenses: data.hideInExpenses,
          receiptCode: data.receiptCode,
          expenseCode: data.expenseCode
        })
      });
      if (!apiRes.ok) return handleApiError(apiRes);
    } else if (data.action === 'update_category') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/categories/${data.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data.updates)
      });
      if (!apiRes.ok) return handleApiError(apiRes);
    } else if (data.action === 'delete_category') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/categories/${data.id}`, {
        method: 'DELETE'
      });
      if (!apiRes.ok) return handleApiError(apiRes);
    } else if (data.action === 'create_account_class') {
      const apiRes = await apiService.fetch('http://localhost/accounting/account-classes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          code: data.code,
          label: data.label,
          type: data.type
        })
      });
      if (!apiRes.ok) return handleApiError(apiRes);
    } else if (data.action === 'update_account_class') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/account-classes/${data.code}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          label: data.label,
          type: data.type
        })
      });
      if (!apiRes.ok) return handleApiError(apiRes);
    } else if (data.action === 'delete_account_class') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/account-classes/${data.code}`, {
        method: 'DELETE'
      });
      if (!apiRes.ok) return handleApiError(apiRes);
    }

    return new Response(JSON.stringify({ success: true }), {
      headers: { 'Content-Type': 'application/json' }
    });
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let categoriesList: any[] = [];
let accountClassesList: any[] = [];
let errorMsg = '';

try {
  const [categoriesRes, classesRes] = await Promise.all([
    apiService.fetch('http://localhost/accounting/categories'),
    apiService.fetch('http://localhost/accounting/account-classes')
  ]);

  if (categoriesRes.ok) {
    const json = await categoriesRes.json() as any;
    categoriesList = json.data || [];
  }

  if (classesRes.ok) {
    const json = await classesRes.json() as any;
    accountClassesList = json.data || [];
  }
} catch (err: any) {
  errorMsg = 'Erreur lors de la récupération de la configuration.';
}

// L'URL permet de pré-selectionner l'onglet "compta" (Catégories) ou "classes" (Plan comptable)
const view = (Astro.url.searchParams.get('view') || 'compta') as 'compta' | 'classes';
---

<Layout title="Catégories et classes - NBA 91">
  <AdminLayout name={Astro.locals.user?.name} client:idle email={userEmail} breadcrumb="Configuration / Catégories et Classes" permissions={Astro.locals.user?.permissions || []}>
    <div class="space-y-6">
      <div class="no-print">
        <a
          href="/admin/settings"
          class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          Retour à la configuration
        </a>
      </div>

      <PageHeader
        title="Catégories et Plan comptable"
        description="Gérez les catégories comptables et les classes de comptes (Plan Comptable Associatif)."
      />

      {errorMsg && <ErrorAlert message={errorMsg} />}

      <SettingsManager
        client:load
        seasons={[]}
        categories={categoriesList}
        accountClasses={accountClassesList}
        seasonId=""
        view={view}
        allowedViews={['compta', 'classes']}
      />
    </div>
  </AdminLayout>
</Layout>
