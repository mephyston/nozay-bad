---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import SettingsScreen from '../../../components/SettingsScreen.svelte';

/**
 * Catégories et plan comptable.
 *
 * Rangé sous « Configuration » dans le menu, servi par le relais de la **comptabilité** :
 * c'est `accounting:config:*` qui le garde, et la permission décide du domaine.
 */

/*
  Page figée : elle n'est plus rendue par un worker, mais servie depuis les actifs.
  Elle ne porte donc aucune donnée, aucune identité et aucun paramètre d'URL — l'îlot
  demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Catégories et classes - NBA 91">
  <AdminLayout
    client:idle
    breadcrumb="Configuration / Catégories et Classes"
  >
    <div class="space-y-6">
      <SettingsScreen
        client:load
        domaine="accounting"
        ecran="config"
        titre="Catégories et Plan comptable"
        description="Gérez les catégories comptables et les classes de comptes (Plan Comptable Associatif)."
        view="compta"
        allowedViews={['compta', 'classes']}
      />
    </div>
  </AdminLayout>
</Layout>
