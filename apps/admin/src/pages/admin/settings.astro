---
import Layout from '../../layouts/Layout.astro';
import AdminLayout from '../../components/AdminLayout.svelte';
import { PageHeader } from '@nba/ui';
import SettingsHubScreen from '../../components/SettingsHubScreen.svelte';

/*
  Page figée.

  Ses cartes étaient filtrées sur les droits au rendu serveur ; le filtrage vit désormais
  dans l'îlot, qui lit l'identité mutualisée. Il reste cosmétique : chaque destination se
  garde elle-même, et l'API par-dessus.
*/
export const prerender = true;
---

<Layout title="Configuration - NBA 91">
  <AdminLayout client:idle breadcrumb="Configuration">
    <div class="space-y-6">
      <PageHeader
        title="Configuration"
        description="Gérez les paramètres globaux de l'application : attestations, saisons, catégories comptables et boutique."
      />

      <SettingsHubScreen client:load />
    </div>
  </AdminLayout>
</Layout>
