---
import Layout from '../../layouts/Layout.astro';
import AdminLayout from '../../components/AdminLayout.svelte';
import { SettingsManager } from '@nba/accounting-ui';
import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';

const userEmail = Astro.locals.user?.email || "admin@nozay-bad.fr";
const apiService = createApiClient(env);

const requestedSeason = Astro.url.searchParams.get('season');
const view = (Astro.url.searchParams.get('view') || 'seasons') as 'seasons' | 'compta' | 'classes';

async function handleApiError(res: Response) {
  let errMsg = await res.text();
  try {
    const j = JSON.parse(errMsg);
    if (j.error) errMsg = j.error;
  } catch(e){}
  return new Response(errMsg, { status: res.status });
}

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.json() as any;
    
    if (data.action === 'create_season') {
      const apiRes = await apiService.fetch('http://localhost/accounting/seasons', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: data.id,
          name: data.name,
          active: data.active
        })
      });
      if (!apiRes.ok) {
        return handleApiError(apiRes);
      }
    } else if (data.action === 'close_season') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/seasons/${data.id}/close`, {
        method: 'POST'
      });
      if (!apiRes.ok) {
        return handleApiError(apiRes);
      }
    } else if (data.action === 'activate_season') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/seasons/${data.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ active: true })
      });
      if (!apiRes.ok) {
        return handleApiError(apiRes);
      }
    } else if (data.action === 'update_balances') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/seasons/${data.seasonId}/balances`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data.balances)
      });
      if (!apiRes.ok) {
        return handleApiError(apiRes);
      }
    } else if (data.action === 'create_category') {
      const apiRes = await apiService.fetch('http://localhost/accounting/categories', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          adminLabel: data.adminLabel,
          adherentLabel: data.adherentLabel,
          hideInExpenses: data.hideInExpenses,
          receiptCode: data.receiptCode,
          expenseCode: data.expenseCode
        })
      });
      if (!apiRes.ok) {
        return handleApiError(apiRes);
      }
    } else if (data.action === 'update_category') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/categories/${data.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data.updates)
      });
      if (!apiRes.ok) {
        return handleApiError(apiRes);
      }
    } else if (data.action === 'delete_category') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/categories/${data.id}`, {
        method: 'DELETE'
      });
      if (!apiRes.ok) {
        return handleApiError(apiRes);
      }
    } else if (data.action === 'create_account_class') {
      const apiRes = await apiService.fetch('http://localhost/accounting/account-classes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          code: data.code,
          label: data.label,
          type: data.type
        })
      });
      if (!apiRes.ok) {
        return handleApiError(apiRes);
      }
    } else if (data.action === 'update_account_class') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/account-classes/${data.code}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          label: data.label,
          type: data.type
        })
      });
      if (!apiRes.ok) {
        return handleApiError(apiRes);
      }
    } else if (data.action === 'delete_account_class') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/account-classes/${data.code}`, {
        method: 'DELETE'
      });
      if (!apiRes.ok) {
        return handleApiError(apiRes);
      }
    } else if (data.action === 'create_product_category') {
      const apiRes = await apiService.fetch('http://localhost/shop/product-categories', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          label: data.label,
          accountingCategoryId: data.accountingCategoryId,
          active: data.active
        })
      });
      if (!apiRes.ok) return handleApiError(apiRes);
    } else if (data.action === 'update_product_category') {
      const apiRes = await apiService.fetch(`http://localhost/shop/product-categories/${data.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data.updates)
      });
      if (!apiRes.ok) return handleApiError(apiRes);
    } else if (data.action === 'delete_product_category') {
      const apiRes = await apiService.fetch(`http://localhost/shop/product-categories/${data.id}`, {
        method: 'DELETE'
      });
      if (!apiRes.ok) return handleApiError(apiRes);
    }

    return new Response(JSON.stringify({ success: true }), {
      headers: { 'Content-Type': 'application/json' }
    });
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let seasonsList: any[] = [];
let categoriesList: any[] = [];
let accountClassesList: any[] = [];
let productCategoriesList: any[] = [];
let errorMsg = '';
let season = requestedSeason || '25-26';

try {
  const [seasonsRes, categoriesRes, classesRes, productCategoriesRes] = await Promise.all([
    apiService.fetch('http://localhost/accounting/seasons'),
    apiService.fetch('http://localhost/accounting/categories'),
    apiService.fetch('http://localhost/accounting/account-classes'),
    apiService.fetch('http://localhost/shop/product-categories')
  ]);

  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    const rawSeasons: any[] = json.data || [];
    rawSeasons.sort((a: any, b: any) => (a.startDate || a.code || '').localeCompare(b.startDate || b.code || ''));

    if (!requestedSeason && rawSeasons.length > 0) {
      const activeSeasonObj = rawSeasons.find((s: any) => s.active || s.active === 1) || rawSeasons[rawSeasons.length - 1];
      season = activeSeasonObj.code || String(activeSeasonObj.id);
    }

    seasonsList = await Promise.all(rawSeasons.map(async (s) => {
      const balRes = await apiService.fetch(`http://localhost/accounting/seasons/${s.code || s.id}/balances`);
      let initialCurrentBalance = 0;
      let initialSavingsBalance = 0;
      let initialCashBalance = 0;
      if (balRes.ok) {
        const balJson = await balRes.json() as any;
        const balList: any[] = balJson.data || [];
        const curr = balList.find(b => b.accountId === 'current' || b.accountId === 1);
        const sav = balList.find(b => b.accountId === 'savings' || b.accountId === 2);
        const csh = balList.find(b => b.accountId === 'cash' || b.accountId === 3);
        if (curr) initialCurrentBalance = curr.initialBalanceCents ?? curr.initialBalance ?? 0;
        if (sav) initialSavingsBalance = sav.initialBalanceCents ?? sav.initialBalance ?? 0;
        if (csh) initialCashBalance = csh.initialBalanceCents ?? csh.initialBalance ?? 0;
      }
      return {
        ...s,
        initialCurrentBalance,
        initialSavingsBalance,
        initialCashBalance
      };
    }));
  }

  if (categoriesRes.ok) {
    const json = await categoriesRes.json() as any;
    categoriesList = json.data || [];
  }

  if (classesRes.ok) {
    const json = await classesRes.json() as any;
    accountClassesList = json.data || [];
  }

  if (productCategoriesRes.ok) {
    const json = await productCategoriesRes.json() as any;
    productCategoriesList = json.data || [];
  }
} catch (err: any) {
  errorMsg = 'Erreur lors de la récupération de la configuration.';
}
---

<Layout title="Réglages - NBA 91">
  <AdminLayout client:idle email={userEmail} breadcrumb="Réglages">
    <div class="space-y-6">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">Réglages Association</h1>
        <p class="text-muted-foreground mt-2">
          Gérez l'exercice comptable et configurez les catégories de trésorerie.
        </p>
      </div>

      {errorMsg && (
        <div class="p-4 bg-destructive/15 border border-destructive text-destructive rounded-lg">
          {errorMsg}
        </div>
      )}

      <SettingsManager
        client:load
        seasons={seasonsList}
        categories={categoriesList}
        accountClasses={accountClassesList}
        productCategories={productCategoriesList}
        seasonId={season}
        view={view as any}
      />
    </div>
  </AdminLayout>
</Layout>
