---
import Layout from '../../layouts/Layout.astro';
import AdminLayout from '../../components/AdminLayout.svelte';
import { PageHeader, ErrorAlert } from '@nba/ui';
import { env } from 'cloudflare:workers';

const userEmail = Astro.locals.user?.email || "admin@nozaybad.fr";
---

<Layout title="Configuration - NBA 91">
  <AdminLayout name={Astro.locals.user?.name} client:idle email={userEmail} breadcrumb="Configuration" permissions={Astro.locals.user?.permissions || []}>
    <div class="space-y-6">
      <PageHeader
        title="Configuration"
        description="Gérez les paramètres globaux de l'application : attestations, saisons, catégories comptables et boutique."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a
          href="/admin/settings/attestation"
          class="flex flex-col gap-2 rounded-xl border border-border bg-card px-5 py-4 shadow-sm hover:border-ring hover:shadow transition-all no-underline relative overflow-hidden group"
        >
          <div class="flex items-center justify-between">
            <p class="text-sm font-semibold text-foreground">Attestation CSE</p>
            <span class="text-primary text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity">Configurer &rarr;</span>
          </div>
          <p class="text-xs text-muted-foreground pr-8">Signataire, mail, site web et signature du modèle d'attestation.</p>
        </a>

        <a
          href="/admin/settings/seasons"
          class="flex flex-col gap-2 rounded-xl border border-border bg-card px-5 py-4 shadow-sm hover:border-ring hover:shadow transition-all no-underline relative overflow-hidden group"
        >
          <div class="flex items-center justify-between">
            <p class="text-sm font-semibold text-foreground">Saisons Comptables</p>
            <span class="text-primary text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity">Configurer &rarr;</span>
          </div>
          <p class="text-xs text-muted-foreground pr-8">Exercices comptables, clôture, soldes initiaux et saison active.</p>
        </a>

        <a
          href="/admin/settings/accounting"
          class="flex flex-col gap-2 rounded-xl border border-border bg-card px-5 py-4 shadow-sm hover:border-ring hover:shadow transition-all no-underline relative overflow-hidden group"
        >
          <div class="flex items-center justify-between">
            <p class="text-sm font-semibold text-foreground">Catégories et Classes</p>
            <span class="text-primary text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity">Configurer &rarr;</span>
          </div>
          <p class="text-xs text-muted-foreground pr-8">Catégories comptables, plan comptable associatif (classes de comptes).</p>
        </a>

        <a
          href="/admin/settings/products"
          class="flex flex-col gap-2 rounded-xl border border-border bg-card px-5 py-4 shadow-sm hover:border-ring hover:shadow transition-all no-underline relative overflow-hidden group"
        >
          <div class="flex items-center justify-between">
            <p class="text-sm font-semibold text-foreground">Catégories Produits</p>
            <span class="text-primary text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity">Configurer &rarr;</span>
          </div>
          <p class="text-xs text-muted-foreground pr-8">Catégories de la boutique et leurs correspondances comptables.</p>
        </a>
      </div>
    </div>
  </AdminLayout>
</Layout>
