---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import ExpensesScreen from '../../../components/ExpensesScreen.svelte';

/*
  Page figée : elle n'est plus rendue par un worker, mais servie depuis les actifs.
  Elle ne porte donc aucune donnée, aucune identité et aucun paramètre d'URL — l'îlot
  demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Notes de Frais - NBA 91">
  <AdminLayout
    client:idle
    breadcrumb="Comptabilité / Notes de frais"
  >
    <div class="space-y-6">
      <ExpensesScreen client:load />
    </div>
  </AdminLayout>
</Layout>
