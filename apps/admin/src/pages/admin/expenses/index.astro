---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { ExpensesManager } from '@nba/expenses-ui';

import { env } from 'cloudflare:workers';

const userEmail = Astro.locals.user?.email || "admin@nozay-bad.fr";
const apiService = env.API_SERVICE;

const season = Astro.url.searchParams.get('season') || '25-26';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.json() as any;
    if (data.action === 'approve') {
      const apiRes = await apiService.fetch(`http://localhost/expenses/${data.id}/approve`, {
        method: 'POST'
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
    } else if (data.action === 'reject') {
      const apiRes = await apiService.fetch(`http://localhost/expenses/${data.id}/reject`, {
        method: 'POST'
      });
      if (!apiRes.ok) {
        return new Response('Erreur rejet', { status: apiRes.status });
      }
    } else if (data.action === 'update') {
      const apiRes = await apiService.fetch(`http://localhost/expenses/${data.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data.updates)
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
    } else if (data.action === 'cancel') {
      const apiRes = await apiService.fetch(`http://localhost/expenses/${data.id}/cancel`, {
        method: 'POST'
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
    }
    return new Response(JSON.stringify({ success: true }), {
      headers: { 'Content-Type': 'application/json' }
    });
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let expensesList = [];
let seasonsList = [];
let categoriesList = [];
let errorMsg = '';

try {
  const [expensesRes, seasonsRes, categoriesRes] = await Promise.all([
    apiService.fetch(`http://localhost/expenses?season=${season}`),
    apiService.fetch('http://localhost/accounting/seasons'),
    apiService.fetch('http://localhost/accounting/categories')
  ]);

  if (expensesRes.ok) {
    const json = await expensesRes.json() as any;
    expensesList = json.data || [];
  }

  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasonsList = json.data || [];
  }

  if (categoriesRes.ok) {
    const json = await categoriesRes.json() as any;
    categoriesList = json.data || [];
  }
} catch (err: any) {
  errorMsg = 'Une erreur est survenue lors du chargement des notes de frais.';
}
const isClosed = !!seasonsList.find((s: any) => s.id === season)?.closed;
---

<Layout title="Notes de Frais - NBA 91">
  <AdminLayout client:load email={userEmail} breadcrumb="Notes de frais">
    <div class="space-y-6">
      {errorMsg && (
        <div class="p-4 bg-destructive/15 border border-destructive text-destructive rounded-lg">
          {errorMsg}
        </div>
      )}

      <div class="flex items-center justify-between print:hidden">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Notes de Frais</h1>
          <p class="text-muted-foreground mt-2">
            Validation, modification et remboursement des notes de frais des membres du club.
          </p>
        </div>
        <div class="flex items-center gap-3">
          {isClosed && (
            <span class="px-2.5 py-1 text-xs font-bold rounded bg-muted border border-border text-muted-foreground">
              Saison clôturée (Lecture seule)
            </span>
          )}
          <select
            id="season-selector"
            class="px-3 py-1.5 border border-border bg-background rounded-md text-xs font-semibold focus:outline-none focus:ring-1 focus:ring-primary cursor-pointer h-9"
          >
            {seasonsList.map((s: any) => (
              <option value={s.id} selected={s.id === season}>{s.name}</option>
            ))}
          </select>
        </div>
      </div>

      <ExpensesManager
        client:load
        expenses={expensesList}
        seasonId={season}
        seasons={seasonsList}
        categories={categoriesList}
      />
    </div>
  </AdminLayout>
  <script>
    const selector = document.getElementById('season-selector');
    if (selector) {
      selector.addEventListener('change', (e) => {
        const newSeason = (e.target as HTMLSelectElement).value;
        const params = new URLSearchParams(window.location.search);
        params.set('season', newSeason);
        window.location.href = `/admin/expenses?${params.toString()}`;
      });
    }
  </script>
</Layout>
