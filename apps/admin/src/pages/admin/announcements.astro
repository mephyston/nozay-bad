---
import Layout from '../../layouts/Layout.astro';
import AdminLayout from '../../components/AdminLayout.svelte';
import { PageHeader, ErrorAlert } from '@nba/ui';
import { AnnouncementsManager } from '@nba/announcements-ui';
import { createAdminApiClient } from '../../lib/api';
import { can, guardAction } from '../../lib/guard';

const userPerms = Astro.locals.user?.permissions || [];

// La consultation est déjà exigée par PAGE_PERMISSIONS. Rédiger, supprimer et diffuser
// sont trois droits distincts : la diffusion fait sonner tous les téléphones du club,
// elle relève donc du même droit qu'une notification.
const canWrite = can(Astro.locals, 'announcements:posts:write');
const canDelete = can(Astro.locals, 'announcements:posts:delete');
const canNotify = can(Astro.locals, 'notifications:messages:send');

const apiService = createAdminApiClient(Astro.locals);

const ACTIONS = {
  create: 'announcements:posts:write',
  update: 'announcements:posts:write',
  delete: 'announcements:posts:delete',
  notify: 'notifications:messages:send'
} as const;

if (Astro.request.method === 'POST') {
  const data = (await Astro.request.json()) as any;
  const denied = guardAction(Astro.locals, data.action, ACTIONS);
  if (denied) return denied;

  const routes: Record<string, { url: string; method: string; body?: unknown }> = {
    create: {
      url: 'http://localhost/announcements',
      method: 'POST',
      body: { title: data.title, bodyHtml: data.bodyHtml, status: data.status }
    },
    update: {
      url: `http://localhost/announcements/${data.id}`,
      method: 'PUT',
      body: { title: data.title, bodyHtml: data.bodyHtml, status: data.status }
    },
    delete: { url: `http://localhost/announcements/${data.id}`, method: 'DELETE' },
    notify: { url: `http://localhost/announcements/${data.id}/notify`, method: 'POST' }
  };

  const route = routes[data.action];
  const apiRes = await apiService.fetch(route.url, {
    method: route.method,
    headers: { 'Content-Type': 'application/json' },
    ...(route.body ? { body: JSON.stringify(route.body) } : {})
  });

  if (!apiRes.ok) return new Response(await apiRes.text(), { status: apiRes.status });
  return new Response(JSON.stringify(await apiRes.json()), {
    headers: { 'Content-Type': 'application/json' }
  });
}

let announcements: any[] = [];
let errorMsg = '';

try {
  const res = await apiService.fetch('http://localhost/announcements');
  if (res.ok) {
    const json = (await res.json()) as any;
    announcements = json.data ?? [];
  } else {
    errorMsg = 'Impossible de charger les annonces.';
  }
} catch {
  errorMsg = 'Impossible de charger les annonces.';
}
---

<Layout title="Annonces - NBA 91">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || 'admin@nozaybad.fr'}
    breadcrumb="Annonces"
    permissions={userPerms}
  >
    <div class="space-y-6">
      {errorMsg && <ErrorAlert message={errorMsg} />}

      <PageHeader
        title="Annonces"
        description="Publiez les informations du club sur l'accueil de l'espace adhérent."
      />

      <AnnouncementsManager
        client:load
        announcements={announcements}
        canWrite={canWrite}
        canDelete={canDelete}
        canNotify={canNotify}
      />
    </div>
  </AdminLayout>
</Layout>
