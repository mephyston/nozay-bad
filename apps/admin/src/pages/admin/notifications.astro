---
import Layout from '../../layouts/Layout.astro';
import AdminLayout from '../../components/AdminLayout.svelte';
import NotificationsScreen from '../../components/NotificationsScreen.svelte';
---

<Layout title="Notifications - NBA 91">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || ''}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Notifications"
  >
    <div class="space-y-6">
      <NotificationsScreen client:load />
    </div>
  </AdminLayout>
</Layout>
