---
import Layout from '../../layouts/Layout.astro';
import AdminLayout from '../../components/AdminLayout.svelte';
import NotificationsScreen from '../../components/NotificationsScreen.svelte';

/*
  Page figée : elle n'est plus rendue par un worker, mais servie depuis les actifs.
  Elle ne porte donc aucune donnée, aucune identité et aucun paramètre d'URL — l'îlot
  demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Notifications - NBA 91">
  <AdminLayout
    client:idle
    breadcrumb="Notifications"
  >
    <div class="space-y-6">
      <NotificationsScreen client:load />
    </div>
  </AdminLayout>
</Layout>
