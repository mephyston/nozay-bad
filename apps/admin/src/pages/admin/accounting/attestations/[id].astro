---
import Layout from '../../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';
import { createAdminApiClient } from '../../../../lib/api';

// Proxy vers le PDF généré par l'API (pdf-lib). L'onglet ouvert affiche
// directement le PDF ; en cas d'erreur métier (adhérent non soldé, introuvable)
// on rend une page HTML lisible plutôt qu'un PDF cassé.
const { id } = Astro.params;
const apiService = createAdminApiClient(Astro.locals);

let errorMsg = '';

try {
  const res = await apiService.fetch(`http://localhost/members/${id}/cse-attestation.pdf`);
  if (res.ok) {
    return new Response(res.body, {
      status: 200,
      headers: {
        'Content-Type': 'application/pdf',
        'Content-Disposition': res.headers.get('Content-Disposition') ?? 'inline',
        'Cache-Control': 'no-store'
      }
    });
  }
  const errorJson = (await res.json().catch(() => ({ error: 'Erreur lors de la génération.' }))) as any;
  errorMsg = errorJson.error || "Impossible de générer l'attestation pour cet adhérent.";
} catch (err: any) {
  errorMsg = err?.message || 'Une erreur inattendue est survenue.';
}
---

<Layout title="Attestation CSE">
  <div class="min-h-screen bg-background flex items-center justify-center p-6">
    <div class="p-6 bg-card border border-destructive/30 text-destructive rounded-lg max-w-lg shadow-sm">
      <h2 class="text-lg font-bold mb-2">Attestation indisponible</h2>
      <p class="text-sm text-muted-foreground">{errorMsg}</p>
      <button
        onclick="window.close()"
        class="mt-4 px-4 py-2 bg-muted hover:bg-muted/80 text-foreground rounded font-semibold text-xs cursor-pointer border-0"
      >
        Fermer l'onglet
      </button>
    </div>
  </div>
</Layout>
