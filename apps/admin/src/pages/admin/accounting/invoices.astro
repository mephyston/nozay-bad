---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import InvoicesScreen from '../../../components/InvoicesScreen.svelte';

const parametres = Object.fromEntries(Astro.url.searchParams);
---

<Layout title="Factures - NBA 91">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || ''}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Comptabilité / Factures"
  >
    <div class="space-y-6">
      <InvoicesScreen client:load {parametres} />
    </div>
  </AdminLayout>
</Layout>
