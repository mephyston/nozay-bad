---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { InvoicesManager } from '@nba/accounting-ui';

import { env } from 'cloudflare:workers';

const userEmail = Astro.locals.user?.email || "admin@nozay-bad.fr";
const apiService = env.API_SERVICE;

let season = Astro.url.searchParams.get('season') || '';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.json() as any;

    if (data.action === 'create') {
      const apiRes = await apiService.fetch('http://localhost/accounting/invoices', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data.invoice)
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
      return new Response(await apiRes.text(), {
        headers: { 'Content-Type': 'application/json' }
      });
    } else if (data.action === 'update') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/invoices/${data.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data.invoice)
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
      return new Response(JSON.stringify({ success: true }), {
        headers: { 'Content-Type': 'application/json' }
      });
    } else if (data.action === 'status') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/invoices/${data.id}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: data.status })
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
      return new Response(JSON.stringify({ success: true }), {
        headers: { 'Content-Type': 'application/json' }
      });
    } else if (data.action === 'delete') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/invoices/${data.id}`, {
        method: 'DELETE'
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
      return new Response(JSON.stringify({ success: true }), {
        headers: { 'Content-Type': 'application/json' }
      });
    } else if (data.action === 'get-details') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/invoices/${data.id}`);
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
      return new Response(await apiRes.text(), {
        headers: { 'Content-Type': 'application/json' }
      });
    }

    return new Response(JSON.stringify({ success: false, error: 'Action inconnue' }), { status: 400 });
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let invoicesList = [];
let seasonsList = [];
let errorMsg = '';

try {
  // 1. Récupérer la liste des saisons d'abord pour avoir la saison active par défaut
  const seasonsRes = await apiService.fetch('http://localhost/accounting/seasons');
  if (!seasonsRes.ok) {
    throw new Error('Impossible de récupérer la liste des saisons.');
  }
  const seasonsJson = await seasonsRes.json() as any;
  seasonsList = seasonsJson.data || [];

  // Déterminer la saison par défaut dynamiquement
  if (!season) {
    const activeSeason = seasonsList.find((s: any) => s.active === true || s.active === 1);
    season = activeSeason ? activeSeason.id : '25-26';
  }

  // 2. Récupérer les factures de la saison
  const invoicesRes = await apiService.fetch(`http://localhost/accounting/invoices?season=${season}`);
  if (!invoicesRes.ok) {
    throw new Error('Impossible de récupérer les factures pour cette saison.');
  }
  const invoicesJson = await invoicesRes.json() as any;
  invoicesList = invoicesJson.data || [];
} catch (err: any) {
  errorMsg = err.message || 'Une erreur est survenue lors du chargement des données.';
}

const isClosed = !!seasonsList.find((s: any) => s.id === season)?.closed;
---

<Layout title="Factures - NBA 91">
  <AdminLayout client:load email={userEmail} breadcrumb="Comptabilité / Factures">
    <div class="space-y-6">
      {errorMsg && (
        <div class="p-4 bg-destructive/15 border border-destructive text-destructive rounded-lg">
          {errorMsg}
        </div>
      )}

      <div class="flex items-center justify-between print:hidden">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Factures</h1>
          <p class="text-muted-foreground mt-2">
            Création, suivi, validation et rapprochement comptable des factures émises par l'association.
          </p>
        </div>
        <div class="flex items-center gap-3">
          {isClosed && (
            <span class="px-2.5 py-1 text-xs font-bold rounded bg-muted border border-border text-muted-foreground">
              Saison clôturée (Lecture seule)
            </span>
          )}
          <select
            id="season-selector"
            class="px-3 py-1.5 border border-border bg-background rounded-md text-xs font-semibold focus:outline-none focus:ring-1 focus:ring-primary cursor-pointer h-9"
          >
            {seasonsList.map((s: any) => (
              <option value={s.id} selected={s.id === season}>{s.name}</option>
            ))}
            {seasonsList.length === 0 && (
              <option value="25-26" selected>Saison 2025-2026</option>
            )}
          </select>
        </div>
      </div>

      <InvoicesManager
        client:load
        invoices={invoicesList}
        seasonId={season}
        seasons={seasonsList}
      />
    </div>
  </AdminLayout>
  <script>
    const selector = document.getElementById('season-selector');
    if (selector) {
      selector.addEventListener('change', (e) => {
        const newSeason = (e.target as HTMLSelectElement).value;
        const params = new URLSearchParams(window.location.search);
        params.set('season', newSeason);
        window.location.href = `/admin/accounting/invoices?${params.toString()}`;
      });
    }
  </script>
</Layout>
