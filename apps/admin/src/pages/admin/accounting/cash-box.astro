---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { CashBoxManager } from '@nba/accounting-ui';

import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';

const userEmail = Astro.locals.user?.email || "admin@nozay-bad.fr";
const apiService = createApiClient(env);

const requestedSeason = Astro.url.searchParams.get('season');

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.json() as any;
    if (data.action === 'create') {
      const apiRes = await apiService.fetch('http://localhost/accounting/transactions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
    } else if (data.action === 'delete') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/transactions/${data.id}`, {
        method: 'DELETE'
      });
      if (!apiRes.ok) {
        return new Response('Erreur suppression', { status: apiRes.status });
      }
    }
    return new Response(JSON.stringify({ success: true }));
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let transactionsList = [];
let initialBalance = 0;
let seasonsList: any[] = [];
let errorMsg = '';
let season = requestedSeason || '25-26';

try {
  const seasonsRes = await apiService.fetch('http://localhost/accounting/seasons');
  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasonsList = json.data || [];
    seasonsList.sort((a: any, b: any) => (a.startDate || a.code || '').localeCompare(b.startDate || b.code || ''));
    if (!requestedSeason && seasonsList.length > 0) {
      const activeSeasonObj = seasonsList.find((s: any) => s.active || s.active === 1) || seasonsList[seasonsList.length - 1];
      season = activeSeasonObj.code || String(activeSeasonObj.id);
    }
  }

  const [balancesRes, txRes] = await Promise.all([
    apiService.fetch(`http://localhost/accounting/seasons/${season}/balances`),
    apiService.fetch(`http://localhost/accounting/transactions?season=${season}&accountId=cash&limit=100`)
  ]);

  if (balancesRes.ok) {
    const json = await balancesRes.json() as any;
    const balances = json.data || [];
    const cashBalance = balances.find((b: any) => b.accountId === 'cash' || b.accountId === 3);
    if (cashBalance) {
      initialBalance = cashBalance.initialBalanceCents ?? cashBalance.initialBalance ?? 0;
    }
  }

  if (txRes.ok) {
    const json = await txRes.json() as any;
    transactionsList = json.data || [];
  }
} catch (err: any) {
  errorMsg = 'Une erreur est survenue lors du chargement des données de la caisse.';
}
const isClosed = !!seasonsList.find((s: any) => s.code === season || String(s.id) === season)?.closed;
---

<Layout title="Gestion de la Caisse - NBA 91">
  <AdminLayout client:idle email={userEmail} breadcrumb="Comptabilité / Caisse">
    <div class="space-y-6">
      {errorMsg && (
        <div class="p-4 bg-destructive/15 border border-destructive text-destructive rounded-lg">
          {errorMsg}
        </div>
      )}

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 print:hidden">
        <div class="text-center sm:text-left w-full sm:w-auto">
          <h1 class="text-3xl font-bold tracking-tight">Gestion de la Caisse</h1>
          <p class="text-muted-foreground mt-2">
            Suivi des mouvements d'espèces et transactions physiques de la caisse de l'association.
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-center sm:justify-end gap-3 w-full sm:w-auto">
          {isClosed && (
            <span class="px-2.5 py-1 text-xs font-bold rounded bg-muted border border-border text-muted-foreground">
              Saison clôturée (Lecture seule)
            </span>
          )}
          <select
            id="season-selector"
            class="px-3 py-1.5 border border-border bg-background rounded-md text-xs font-semibold focus:outline-none focus:ring-1 focus:ring-primary cursor-pointer h-9"
          >
            {seasonsList.map((s: any) => {
              const val = s.code || String(s.id);
              const isSelected = val === season || String(s.id) === season;
              return (
                <option value={val} selected={isSelected}>{s.name}</option>
              );
            })}
          </select>
        </div>
      </div>

      <CashBoxManager
        client:load
        initialBalance={initialBalance}
        transactions={transactionsList}
        seasonId={season}
        seasons={seasonsList}
      />
    </div>
  </AdminLayout>
  <script>
    const selector = document.getElementById('season-selector');
    if (selector) {
      selector.addEventListener('change', (e) => {
        const newSeason = (e.target as HTMLSelectElement).value;
        const params = new URLSearchParams(window.location.search);
        params.set('season', newSeason);
        window.location.href = `/admin/accounting/cash-box?${params.toString()}`;
      });
    }
  </script>
</Layout>
