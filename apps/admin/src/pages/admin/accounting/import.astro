---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { ErrorAlert } from '@nba/ui';
import { BankStatementReconciliation } from '@nba/accounting-ui';
import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';

const userEmail = Astro.locals.user?.email || "admin@nozaybad.fr";
const apiService = createApiClient(env);

const requestedSeason = Astro.url.searchParams.get('season');

// Si requête POST, intercepter pour les actions d'écriture (import ou reconcile/ignore/unignore/analyze/delete-transaction)
if (Astro.request.method === 'POST') {
  try {
    const contentType = Astro.request.headers.get('content-type') || '';
    if (contentType.includes('multipart/form-data')) {
      const formData = await Astro.request.formData();
      const apiRes = await apiService.fetch('http://localhost/accounting/bank-transactions/import', {
        method: 'POST',
        body: formData as any
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
      return new Response(JSON.stringify({ success: true }));
    } else {
      const data = await Astro.request.json() as any;
      if (data.action === 'analyze') {
        const url = data.btId
          ? `http://localhost/accounting/bank-transactions/analyze?season=${data.season}&id=${data.btId}`
          : `http://localhost/accounting/bank-transactions/analyze?season=${data.season}`;
        const apiRes = await apiService.fetch(url, { method: 'POST' });
        if (!apiRes.ok) {
          return new Response(await apiRes.text(), { status: apiRes.status });
        }
        return new Response(await apiRes.text(), {
          headers: { 'Content-Type': 'application/json' }
        });
      } else if (data.action === 'create' || data.action === 'match' || data.action === 'reconcile') {
        const btId = data.btId || (data.match && data.match.btId);
        const apiRes = await apiService.fetch(`http://localhost/accounting/bank-transactions/${btId}/reconcile`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data.match ? data.match : data)
        });
        if (!apiRes.ok) {
          const errText = await apiRes.text();
          console.error('ERROR:', errText, 'PAYLOAD:', JSON.stringify(data.match ? data.match : data));
          return new Response(errText, { status: apiRes.status });
        }
        return new Response(await apiRes.text(), {
          headers: { 'Content-Type': 'application/json' }
        });
      } else if (data.action === 'bulk' || data.action === 'reconcile-bulk') {
        const apiRes = await apiService.fetch('http://localhost/accounting/bank-transactions/reconcile-bulk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ requests: data.requests })
        });
        if (!apiRes.ok) {
          return new Response(await apiRes.text(), { status: apiRes.status });
        }
        return new Response(await apiRes.text(), { headers: { 'Content-Type': 'application/json' } });
      } else if (data.action === 'ignore') {
        const apiRes = await apiService.fetch(`http://localhost/accounting/bank-transactions/${data.btId}/ignore`, {
          method: 'POST'
        });
        if (!apiRes.ok) {
          return new Response('Erreur masquage ligne', { status: apiRes.status });
        }
        return new Response(await apiRes.text(), { headers: { 'Content-Type': 'application/json' } });
      } else if (data.action === 'unignore') {
        const apiRes = await apiService.fetch(`http://localhost/accounting/bank-transactions/${data.btId}/unignore`, {
          method: 'POST'
        });
        if (!apiRes.ok) {
          return new Response('Erreur réaffichage ligne', { status: apiRes.status });
        }
        return new Response(await apiRes.text(), { headers: { 'Content-Type': 'application/json' } });
      } else if (data.action === 'delete-transaction' || data.action === 'delete-ledger-entry') {
        const apiRes = await apiService.fetch(`http://localhost/accounting/transactions/${data.txId}`, {
          method: 'DELETE'
        });
        if (!apiRes.ok) {
          return new Response('Erreur suppression transaction', { status: apiRes.status });
        }
        return new Response(await apiRes.text(), { headers: { 'Content-Type': 'application/json' } });
      } else if (data.action === 'get-unpaid-invoices') {
        const apiRes = await apiService.fetch(`http://localhost/accounting/invoices?season=${data.season}`);
        if (!apiRes.ok) {
          return new Response(await apiRes.text(), { status: apiRes.status });
        }
        return new Response(await apiRes.text(), {
          headers: { 'Content-Type': 'application/json' }
        });
      }
      return new Response(JSON.stringify({ success: true }));
    }
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let bankStatementLines = [];
let glTransactionsList = [];
let seasonsList: any[] = [];
let membersList = [];
let categoriesList = [];
let errorMsg = '';
let season = requestedSeason || '25-26';

try {
  const seasonsRes = await apiService.fetch('http://localhost/accounting/seasons');
  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasonsList = json.data || [];
    seasonsList.sort((a: any, b: any) => (a.startDate || a.code || '').localeCompare(b.startDate || b.code || ''));
    if (!requestedSeason && seasonsList.length > 0) {
      const activeSeasonObj = seasonsList.find((s: any) => s.active || s.active === 1) || seasonsList[seasonsList.length - 1];
      season = activeSeasonObj.code || String(activeSeasonObj.id);
    }
  }

  const [btRes, glRes, membersRes, categoriesRes] = await Promise.all([
    apiService.fetch(`http://localhost/accounting/bank-transactions?season=${season}`),
    apiService.fetch(`http://localhost/accounting/transactions?season=${season}&page=1&limit=2000`),
    apiService.fetch(`http://localhost/members?season=${season}&limit=500`),
    apiService.fetch('http://localhost/accounting/categories')
  ]);

  if (btRes.ok) {
    const json = await btRes.json() as any;
    bankStatementLines = json.data || [];
  }

  if (glRes.ok) {
    const json = await glRes.json() as any;
    glTransactionsList = json.data || [];
  }

  if (membersRes.ok) {
    const json = await membersRes.json() as any;
    membersList = json.data || [];
  }

  if (categoriesRes.ok) {
    const json = await categoriesRes.json() as any;
    categoriesList = json.data || [];
  }
} catch (err: any) {
  errorMsg = 'Une erreur est survenue lors de la communication avec le serveur comptable.';
}

const isClosed = !!seasonsList.find((s: any) => s.code === season || String(s.id) === season)?.closed;
---

<Layout title="Rapprochement Bancaire - NBA 91">
  <AdminLayout client:idle email={userEmail} breadcrumb="Comptabilité / Rapprochement bancaire" permissions={Astro.locals.user?.permissions || []}>
    <div class="space-y-6">
      {errorMsg && <ErrorAlert message={errorMsg} />}

      <BankStatementReconciliation
        client:load
        bankStatementLines={bankStatementLines}
        glTransactions={glTransactionsList}
        seasons={seasonsList}
        seasonId={season}
        members={membersList}
        dbCategories={categoriesList}
      />
    </div>
  </AdminLayout>
</Layout>
