---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { BankStatementReconciliation } from '@nba/accounting-ui';
import { env } from 'cloudflare:workers';

const userEmail = Astro.locals.user?.email || "admin@nozay-bad.fr";
const apiService = env.API_SERVICE;

const season = Astro.url.searchParams.get('season') || '25-26';

// Si requête POST, intercepter pour les actions d'écriture (import ou reconcile/ignore/unignore/analyze/delete-transaction)
if (Astro.request.method === 'POST') {
  try {
    const contentType = Astro.request.headers.get('content-type') || '';
    if (contentType.includes('multipart/form-data')) {
      const formData = await Astro.request.formData();
      const apiRes = await apiService.fetch('http://localhost/accounting/bank-transactions/import', {
        method: 'POST',
        body: formData as any
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
      return new Response(JSON.stringify({ success: true }));
    } else {
      const data = await Astro.request.json() as any;
      if (data.action === 'analyze') {
        const url = data.btId
          ? `http://localhost/accounting/bank-transactions/analyze?season=${data.season}&id=${data.btId}`
          : `http://localhost/accounting/bank-transactions/analyze?season=${data.season}`;
        const apiRes = await apiService.fetch(url, {
          method: 'POST'
        });
        if (!apiRes.ok) {
          return new Response(await apiRes.text(), { status: apiRes.status });
        }
      } else if (data.action === 'match' || data.action === 'create') {
        const apiRes = await apiService.fetch(`http://localhost/accounting/bank-transactions/${data.btId}/reconcile`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (!apiRes.ok) {
          return new Response(await apiRes.text(), { status: apiRes.status });
        }
      } else if (data.action === 'bulk') {
        const apiRes = await apiService.fetch('http://localhost/accounting/bank-transactions/reconcile-bulk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (!apiRes.ok) {
          return new Response(await apiRes.text(), { status: apiRes.status });
        }
      } else if (data.action === 'ignore') {
        const apiRes = await apiService.fetch(`http://localhost/accounting/bank-transactions/${data.btId}/ignore`, {
          method: 'POST'
        });
        if (!apiRes.ok) {
          return new Response('Erreur ignore', { status: apiRes.status });
        }
      } else if (data.action === 'unignore') {
        const apiRes = await apiService.fetch(`http://localhost/accounting/bank-transactions/${data.btId}/unignore`, {
          method: 'POST'
        });
        if (!apiRes.ok) {
          return new Response('Erreur unignore', { status: apiRes.status });
        }
      } else if (data.action === 'delete-transaction') {
        const apiRes = await apiService.fetch(`http://localhost/accounting/transactions/${data.txId}`, {
          method: 'DELETE'
        });
        if (!apiRes.ok) {
          return new Response(await apiRes.text(), { status: apiRes.status });
        }
      } else if (data.action === 'get-unpaid-invoices') {
        const apiRes = await apiService.fetch(`http://localhost/accounting/invoices?season=${data.season}`);
        if (!apiRes.ok) {
          return new Response(await apiRes.text(), { status: apiRes.status });
        }
        return new Response(await apiRes.text(), {
          headers: { 'Content-Type': 'application/json' }
        });
      }
      return new Response(JSON.stringify({ success: true }));
    }
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let bankTransactionsList = [];
let glTransactionsList = [];
let seasonsList = [];
let membersList = [];
let categoriesList = [];
let errorMsg = '';

try {
  const [btRes, glRes, seasonsRes, membersRes, categoriesRes] = await Promise.all([
    apiService.fetch(`http://localhost/accounting/bank-transactions?season=${season}`),
    apiService.fetch(`http://localhost/accounting/transactions?season=${season}&page=1&limit=500`),
    apiService.fetch('http://localhost/accounting/seasons'),
    apiService.fetch(`http://localhost/members?season=${season}&limit=500`),
    apiService.fetch('http://localhost/accounting/categories')
  ]);

  if (btRes.ok) {
    const json = await btRes.json() as any;
    bankTransactionsList = json.data || [];
  }

  if (glRes.ok) {
    const json = await glRes.json() as any;
    glTransactionsList = json.data || [];
  }

  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasonsList = json.data || [];
  }

  if (membersRes.ok) {
    const json = await membersRes.json() as any;
    membersList = json.data || [];
  }

  if (categoriesRes.ok) {
    const json = await categoriesRes.json() as any;
    categoriesList = json.data || [];
  }
} catch (err: any) {
  errorMsg = 'Une erreur est survenue lors de la communication avec le serveur comptable.';
}

const isClosed = !!seasonsList.find((s: any) => s.id === season)?.closed;
---

<Layout title="Importation & Rapprochement - NBA 91">
  <AdminLayout client:idle email={userEmail} breadcrumb="Comptabilité / Rapprochement bancaire">
    <div class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Rapprochement bancaire</h1>
          <p class="text-muted-foreground mt-2">
            Rapprochez les relevés bancaires importés avec les écritures du grand livre et validez les factures.
          </p>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          {isClosed && (
            <span class="px-2.5 py-1 text-xs font-bold rounded bg-muted border border-border text-muted-foreground">
              Saison clôturée (Lecture seule)
            </span>
          )}
          {!isClosed && bankTransactionsList.length > 0 && (
            <button
              id="trigger-import-btn"
              onclick="window.dispatchEvent(new CustomEvent('open-bank-import'))"
              class="px-4 py-2 bg-primary text-primary-foreground text-sm font-medium rounded-md shadow hover:bg-primary/90 cursor-pointer inline-flex items-center gap-2 border-0"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
              Importer un relevé bancaire
            </button>
          )}
        </div>
      </div>

      {errorMsg && (
        <div class="p-4 bg-destructive/15 border border-destructive text-destructive rounded-lg">
          {errorMsg}
        </div>
      )}

      <BankStatementReconciliation
        client:load
        bankTransactions={bankTransactionsList}
        glTransactions={glTransactionsList}
        seasonId={season}
        seasons={seasonsList}
        members={membersList}
        dbCategories={categoriesList}
      />
    </div>
  </AdminLayout>
</Layout>
