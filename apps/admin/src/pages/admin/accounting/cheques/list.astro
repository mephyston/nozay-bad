---
import Layout from '../../../../layouts/Layout.astro';
import AdminLayout from '../../../../components/AdminLayout.svelte';
import ChequesScreen from '../../../../components/ChequesScreen.svelte';

/*
  Page figée.

  Le worker reste **invoqué** — l'adaptateur d'Astro sert les actifs lui-même, par
  `env.ASSETS.fetch` — mais il ne rend plus rien : il transmet un fichier. Ce que le
  prerender supprime est le rendu, pas l'invocation.

  Corollaire : la page ne porte aucune donnée, aucune identité et aucun paramètre d'URL.
  L'îlot demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Remises de Chèques">
  <AdminLayout
    client:idle
    breadcrumb="Comptabilité / Remises de chèques / Gestion des chèques"
  >
    <div class="space-y-6">
      <ChequesScreen client:load titre="Gestion des chèques" initialTab="checks" />
    </div>
  </AdminLayout>
</Layout>
