---
import Layout from '../../../../layouts/Layout.astro';
import AdminLayout from '../../../../components/AdminLayout.svelte';
import ChequesScreen from '../../../../components/ChequesScreen.svelte';

const parametres = Object.fromEntries(Astro.url.searchParams);
---

<Layout title="Remises de Chèques - NBA 91">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || ''}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Comptabilité / Remises de chèques / Gestion des chèques"
  >
    <div class="space-y-6">
      <ChequesScreen client:load titre="Gestion des chèques" initialTab="checks" {parametres} />
    </div>
  </AdminLayout>
</Layout>
