---
import Layout from '../../../../layouts/Layout.astro';
import AdminLayout from '../../../../components/AdminLayout.svelte';
import ChequesScreen from '../../../../components/ChequesScreen.svelte';

/*
  Page figée : elle n'est plus rendue par un worker, mais servie depuis les actifs.
  Elle ne porte donc aucune donnée, aucune identité et aucun paramètre d'URL — l'îlot
  demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Remises de Chèques - NBA 91">
  <AdminLayout
    client:idle
    breadcrumb="Comptabilité / Remises de chèques / Gestion de remise de bordereaux"
  >
    <div class="space-y-6">
      <ChequesScreen
        client:load
        titre="Gestion de remise de bordereaux"
        initialTab="deposits"
      />
    </div>
  </AdminLayout>
</Layout>
