---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { GeneralMeetingReport } from '@nba/accounting-ui';
import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';

const userEmail = Astro.locals.user?.email || "admin@nozay-bad.fr";
const apiService = createApiClient(env);

const requestedSeason = Astro.url.searchParams.get('season');

// Si requête POST, intercepter pour modifier les soldes initiaux ou le budget (proxying)
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.json() as any;
    if (data.action === 'save_budget') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/seasons/${data.seasonId}/budget`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data.budget)
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text() || 'Erreur configuration budget', { status: apiRes.status });
      }
      return new Response(JSON.stringify({ success: true }));
    } else {
      const apiRes = await apiService.fetch(`http://localhost/accounting/seasons/${data.seasonId}/balances`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data.balances)
      });
      if (!apiRes.ok) {
        return new Response('Erreur configuration soldes', { status: apiRes.status });
      }
      return new Response(JSON.stringify({ success: true }));
    }
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let seasonsList: any[] = [];
let categoriesList: any[] = [];
let accountClassesList: any[] = [];
let budgetList: any[] = [];
let prevReportData: any = null;
let errorMsg = '';
let season = requestedSeason || '25-26';

let reportData = {
  compteResultat: { totalRecettes: 0, totalDepenses: 0, netResult: 0, categories: {} },
  bilanTrésorerie: [
    { accountId: 'current' as const, initialBalance: 0, finalBalance: 0 },
    { accountId: 'savings' as const, initialBalance: 0, finalBalance: 0 },
    { accountId: 'cash' as const, initialBalance: 0, finalBalance: 0 }
  ]
};

function getPreviousSeasonId(currentId: string): string {
  const parts = currentId.split('-');
  if (parts.length === 2) {
    const start = parseInt(parts[0]);
    const end = parseInt(parts[1]);
    if (!isNaN(start) && !isNaN(end)) {
      const prevStart = (start - 1).toString().padStart(2, '0');
      const prevEnd = (end - 1).toString().padStart(2, '0');
      return `${prevStart}-${prevEnd}`;
    }
  }
  return '';
}

try {
  const seasonsRes = await apiService.fetch('http://localhost/accounting/seasons');
  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasonsList = json.data || [];
    // Tri chronologique des saisons par date de début / code (ordre croissant)
    seasonsList.sort((a: any, b: any) => (a.startDate || a.code || '').localeCompare(b.startDate || b.code || ''));
    if (!requestedSeason && seasonsList.length > 0) {
      const activeSeasonObj = seasonsList.find((s: any) => s.active || s.active === 1) || seasonsList[seasonsList.length - 1];
      season = activeSeasonObj.code || String(activeSeasonObj.id);
    }
  }

  const prevSeason = getPreviousSeasonId(season);
  const [res, prevResResult, categoriesRes, classesRes, budgetRes] = await Promise.all([
    apiService.fetch(`http://localhost/accounting/seasons/${season}/reports`),
    prevSeason ? apiService.fetch(`http://localhost/accounting/seasons/${prevSeason}/reports`).catch((e) => {
      console.error('Failed to fetch previous season reports', e);
      return null;
    }) : Promise.resolve(null),
    apiService.fetch('http://localhost/accounting/categories'),
    apiService.fetch('http://localhost/accounting/account-classes'),
    apiService.fetch(`http://localhost/accounting/seasons/${season}/budget`)
  ]);

  if (res.ok) {
    const json = await res.json() as any;
    reportData = json.data;
  } else {
    throw new Error('Erreur récupération du rapport');
  }

  if (prevResResult && prevResResult.ok) {
    const json = await prevResResult.json() as any;
    prevReportData = json.data;
  }

  if (categoriesRes.ok) {
    const json = await categoriesRes.json() as any;
    categoriesList = json.data || [];
  }

  if (classesRes.ok) {
    const json = await classesRes.json() as any;
    accountClassesList = json.data || [];
  }

  if (budgetRes.ok) {
    const json = await budgetRes.json() as any;
    budgetList = json.data || [];
  }
} catch (err: any) {
  errorMsg = 'Impossible de charger les données du bilan AG.';
}
---

<Layout title="Rapports financiers - NBA 91">
  <AdminLayout client:idle email={userEmail} breadcrumb="Comptabilité / Rapports financiers">
    <div class="space-y-6">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="text-center sm:text-left w-full sm:w-auto">
          <h1 class="text-3xl font-bold tracking-tight">Rapports financiers</h1>
          <p class="text-muted-foreground mt-2">
            Consultez les comptes de résultat, le bilan de trésorerie et gérez les budgets prévisionnels.
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-center sm:justify-end gap-3 print:hidden w-full sm:w-auto">
          <select
            id="season-selector"
            class="px-3 py-1.5 border border-border bg-background rounded-md text-xs font-semibold focus:outline-none focus:ring-1 focus:ring-primary cursor-pointer h-9"
          >
            {seasonsList.map((s: any) => {
              const val = s.code || String(s.id);
              const isSelected = val === season || String(s.id) === season;
              return (
                <option value={val} selected={isSelected}>{s.name}</option>
              );
            })}
            {seasonsList.length === 0 && (
              <option value="25-26" selected>Saison 2025-2026</option>
            )}
          </select>

          <button
            id="print-btn"
            class="px-3 py-1.5 bg-primary text-primary-foreground text-xs font-medium rounded-md shadow hover:bg-primary/90 cursor-pointer inline-flex items-center gap-1.5 border-0 h-9"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            Imprimer
          </button>
        </div>
      </div>

      {errorMsg && (
        <div class="p-4 bg-destructive/15 border border-destructive text-destructive rounded-lg">
          {errorMsg}
        </div>
      )}

      <GeneralMeetingReport client:load report={reportData} prevReport={prevReportData} seasonId={season} seasons={seasonsList} categories={categoriesList} accountClasses={accountClassesList} budget={budgetList} />
    </div>
  </AdminLayout>
</Layout>

<script>
  const selector = document.getElementById('season-selector');
  if (selector) {
    selector.addEventListener('change', (e) => {
      const newSeason = (e.target as HTMLSelectElement).value;
      const params = new URLSearchParams(window.location.search);
      params.set('season', newSeason);
      window.location.href = `/admin/accounting/reports?${params.toString()}`;
    });
  }

  const printBtn = document.getElementById('print-btn');
  if (printBtn) {
    printBtn.addEventListener('click', () => window.print());
  }
</script>
