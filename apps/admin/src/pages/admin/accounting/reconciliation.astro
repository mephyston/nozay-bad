---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import ReconciliationScreen from '../../../components/ReconciliationScreen.svelte';

/**
 * Le rapprochement bancaire, en coquille.
 *
 * L'import d'un relevé ne passe plus par cette page : c'est un dépôt de fichier, il vit
 * sur `/admin/api/accounting/upload`, où il porte la permission `accounting:bank:import`
 * que le catalogue déclarait sans que personne l'applique.
 */

/*
  Page figée.

  Le worker reste **invoqué** — l'adaptateur d'Astro sert les actifs lui-même, par
  `env.ASSETS.fetch` — mais il ne rend plus rien : il transmet un fichier. Ce que le
  prerender supprime est le rendu, pas l'invocation.

  Corollaire : la page ne porte aucune donnée, aucune identité et aucun paramètre d'URL.
  L'îlot demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Rapprochement Bancaire">
  <AdminLayout
    client:idle
    breadcrumb="Comptabilité / Rapprochement bancaire"
  >
    <div class="space-y-6">
      <ReconciliationScreen client:load />
    </div>
  </AdminLayout>
</Layout>
