---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import ReconciliationScreen from '../../../components/ReconciliationScreen.svelte';

/**
 * Le rapprochement bancaire, en coquille.
 *
 * L'import d'un relevé ne passe plus par cette page : c'est un dépôt de fichier, il vit
 * sur `/admin/api/accounting/upload`, où il porte la permission `accounting:bank:import`
 * que le catalogue déclarait sans que personne l'applique.
 */
const parametres = Object.fromEntries(Astro.url.searchParams);
---

<Layout title="Rapprochement Bancaire - NBA 91">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || ''}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Comptabilité / Rapprochement bancaire"
  >
    <div class="space-y-6">
      <ReconciliationScreen client:load {parametres} />
    </div>
  </AdminLayout>
</Layout>
