---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { ErrorAlert } from '@nba/ui';
import { BankStatementReconciliation } from '@nba/accounting-ui';
import { env } from 'cloudflare:workers';
import { createAdminApiClient } from '../../../lib/api';
import { guardAction } from '../../../lib/guard';

const userEmail = Astro.locals.user?.email || "";
const apiService = createAdminApiClient(Astro.locals);

const requestedSeason = Astro.url.searchParams.get('season');

// Si requête POST, intercepter pour les actions d'écriture (import ou reconcile/ignore/unignore/analyze/delete-transaction)
/** Permission exigée par action d'écriture de cette page. */
const ACTIONS = {
  analyze: 'accounting:bank:reconcile',
  bulk: 'accounting:bank:reconcile',
  reconcile: 'accounting:bank:reconcile',
  'reconcile-bulk': 'accounting:bank:reconcile',
  match: 'accounting:bank:reconcile',
  ignore: 'accounting:bank:reconcile',
  unignore: 'accounting:bank:reconcile',
  create: 'accounting:ledger:write',
  'delete-ledger-entry': 'accounting:ledger:delete',
  'delete-transaction': 'accounting:ledger:delete',
  'get-unpaid-invoices': 'accounting:invoices:read',
  'get-reconciliation-statements': 'accounting:bank:read'
} as const;

if (Astro.request.method === 'POST') {
  try {
    const contentType = Astro.request.headers.get('content-type') || '';
    if (contentType.includes('multipart/form-data')) {
      const formData = await Astro.request.formData();
      const apiRes = await apiService.fetch('http://localhost/accounting/bank-transactions/import', {
        method: 'POST',
        body: formData as any
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
      /*
        On relaie le compte rendu de l'API au lieu d'un `{ success: true }` muet : c'est lui qui
        porte le nombre de lignes lues, insérées et déjà connues, et l'écran n'a rien à dire
        sans lui.
      */
      return new Response(await apiRes.text(), { headers: { 'Content-Type': 'application/json' } });
    } else {
      const data = await Astro.request.json() as any;

    const denied = guardAction(Astro.locals, data.action, ACTIONS);
    if (denied) return denied;
      if (data.action === 'analyze') {
        const url = data.btId
          ? `http://localhost/accounting/bank-transactions/analyze?season=${data.season}&id=${data.btId}`
          : `http://localhost/accounting/bank-transactions/analyze?season=${data.season}`;
        const apiRes = await apiService.fetch(url, { method: 'POST' });
        if (!apiRes.ok) {
          return new Response(await apiRes.text(), { status: apiRes.status });
        }
        return new Response(await apiRes.text(), {
          headers: { 'Content-Type': 'application/json' }
        });
      } else if (data.action === 'create' || data.action === 'match' || data.action === 'reconcile') {
        const btId = data.btId || (data.match && data.match.btId);
        /*
         * Sans identifiant, on refuse ici plutôt que d'appeler l'API.
         *
         * Le gabarit d'URL acceptait `undefined` sans broncher et produisait
         * `/bank-transactions/undefined/reconcile`, que l'API rejetait en 400 — un
         * message qui ne disait ni quelle ligne, ni pourquoi, et envoyait chercher la
         * panne du mauvais côté. Le refus nomme désormais la cause.
         */
        if (btId === undefined || btId === null || btId === '') {
          console.error('RECONCILE sans identifiant de ligne bancaire. PAYLOAD:', JSON.stringify(data));
          return new Response(
            JSON.stringify({
              success: false,
              error:
                "Aucune ligne bancaire n'est sélectionnée : rechargez la page et resélectionnez l'opération à rapprocher."
            }),
            { status: 400, headers: { 'Content-Type': 'application/json' } }
          );
        }
        const apiRes = await apiService.fetch(`http://localhost/accounting/bank-transactions/${btId}/reconcile`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data.match ? data.match : data)
        });
        if (!apiRes.ok) {
          const errText = await apiRes.text();
          console.error('ERROR:', errText, 'PAYLOAD:', JSON.stringify(data.match ? data.match : data));
          return new Response(errText, { status: apiRes.status });
        }
        return new Response(await apiRes.text(), {
          headers: { 'Content-Type': 'application/json' }
        });
      } else if (data.action === 'bulk' || data.action === 'reconcile-bulk') {
        const apiRes = await apiService.fetch('http://localhost/accounting/bank-transactions/reconcile-bulk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ requests: data.requests })
        });
        if (!apiRes.ok) {
          return new Response(await apiRes.text(), { status: apiRes.status });
        }
        return new Response(await apiRes.text(), { headers: { 'Content-Type': 'application/json' } });
      } else if (data.action === 'ignore') {
        const apiRes = await apiService.fetch(`http://localhost/accounting/bank-transactions/${data.btId}/ignore`, {
          method: 'POST'
        });
        if (!apiRes.ok) {
          return new Response('Erreur masquage ligne', { status: apiRes.status });
        }
        return new Response(await apiRes.text(), { headers: { 'Content-Type': 'application/json' } });
      } else if (data.action === 'unignore') {
        const apiRes = await apiService.fetch(`http://localhost/accounting/bank-transactions/${data.btId}/unignore`, {
          method: 'POST'
        });
        if (!apiRes.ok) {
          return new Response('Erreur réaffichage ligne', { status: apiRes.status });
        }
        return new Response(await apiRes.text(), { headers: { 'Content-Type': 'application/json' } });
      } else if (data.action === 'delete-transaction' || data.action === 'delete-ledger-entry') {
        const apiRes = await apiService.fetch(`http://localhost/accounting/transactions/${data.txId}`, {
          method: 'DELETE'
        });
        if (!apiRes.ok) {
          return new Response('Erreur suppression transaction', { status: apiRes.status });
        }
        return new Response(await apiRes.text(), { headers: { 'Content-Type': 'application/json' } });
      } else if (data.action === 'get-reconciliation-statements') {
        /*
          L'encart d'état de rapprochement se relit seul après chaque écriture.

          C'est le seul morceau de l'écran que le client ne peut pas recalculer : l'écart tient
          au solde annoncé par la banque, que seul le serveur connaît.
        */
        const apiRes = await apiService.fetch(`http://localhost/accounting/reconciliation-statements?season=${data.season}`);
        if (!apiRes.ok) {
          return new Response(await apiRes.text(), { status: apiRes.status });
        }
        return new Response(await apiRes.text(), { headers: { 'Content-Type': 'application/json' } });
      } else if (data.action === 'get-unpaid-invoices') {
        const apiRes = await apiService.fetch(`http://localhost/accounting/invoices?season=${data.season}`);
        if (!apiRes.ok) {
          return new Response(await apiRes.text(), { status: apiRes.status });
        }
        return new Response(await apiRes.text(), {
          headers: { 'Content-Type': 'application/json' }
        });
      }
      return new Response(JSON.stringify({ success: true }));
    }
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let bankStatementLines = [];
let glTransactionsList = [];
let seasonsList: any[] = [];
let membersList = [];
let categoriesList = [];
let reconciliationStatements: any[] = [];
let errorMsg = '';
let season = requestedSeason || '25-26';

try {
  const seasonsRes = await apiService.fetch('http://localhost/accounting/seasons');
  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasonsList = json.data || [];
    seasonsList.sort((a: any, b: any) => (a.startDate || a.code || '').localeCompare(b.startDate || b.code || ''));
    if (!requestedSeason && seasonsList.length > 0) {
      const activeSeasonObj = seasonsList.find((s: any) => s.active || s.active === 1) || seasonsList[seasonsList.length - 1];
      season = activeSeasonObj.code || String(activeSeasonObj.id);
    }
  }

  /*
    L'annuaire de la saison consultée, **et** celui de la suivante.

    Un adhérent qui rejoint le club en août règle sa cotisation de la rentrée : le
    virement tombe dans l'exercice en cours, mais son adhésion n'existe que dans la
    saison suivante. Il était alors introuvable dans la liste, et l'encaissement ne
    pouvait se rattacher à personne — précisément le cas que le cut-off « produit
    constaté d'avance » est là pour traiter.
  */
  const nextSeason = seasonsList[seasonsList.findIndex((s: any) => (s.code || String(s.id)) === season) + 1];
  const nextSeasonCode = nextSeason ? nextSeason.code || String(nextSeason.id) : null;

  const [btRes, glRes, membersRes, nextMembersRes, categoriesRes, statementsRes] = await Promise.all([
    /*
      Toutes les lignes, sans borne d'exercice.

      Une ligne de relevé n'appartient à aucune saison : `bank_statement_lines` ne porte pas de
      `season_id`, c'est un mouvement daté. Les borner à l'exercice consulté faisait disparaître
      de la file, au 1er septembre, tout ce qui restait à rapprocher de l'année écoulée — et
      l'écran n'aurait rien eu pour le dire.
    */
    apiService.fetch('http://localhost/accounting/bank-transactions'),
    /*
      Le solde progressif est refusé : c'est une sous-requête corrélée, réévaluée pour chacune
      des 2000 écritures demandées, et cet écran ne l'affiche nulle part. Seul le grand livre
      en a l'usage.
    */
    apiService.fetch(`http://localhost/accounting/transactions?season=${season}&page=1&limit=2000&runningBalance=0`),
    apiService.fetch(`http://localhost/members?season=${season}&limit=500`),
    nextSeasonCode
      ? apiService.fetch(`http://localhost/members?season=${nextSeasonCode}&limit=500`)
      : Promise.resolve(null),
    apiService.fetch('http://localhost/accounting/categories'),
    apiService.fetch(`http://localhost/accounting/reconciliation-statements?season=${season}`)
  ]);

  if (btRes.ok) {
    const json = await btRes.json() as any;
    bankStatementLines = json.data || [];
  }

  if (glRes.ok) {
    const json = await glRes.json() as any;
    glTransactionsList = json.data || [];
  }

  if (membersRes.ok) {
    const json = await membersRes.json() as any;
    membersList = json.data || [];
  }

  if (nextMembersRes?.ok && nextSeasonCode) {
    const json = await nextMembersRes.json() as any;
    // `seasonCode` n'est posé que sur ceux de l'autre saison : c'est lui qui les
    // signale à l'écran, et son absence vaut « saison consultée ».
    const known = new Set(membersList.map((m: any) => m.id));
    for (const member of (json.data || []) as any[]) {
      if (!known.has(member.id)) membersList.push({ ...member, seasonCode: nextSeasonCode });
    }
  }

  if (categoriesRes.ok) {
    const json = await categoriesRes.json() as any;
    categoriesList = json.data || [];
  }

  /*
    L'état de rapprochement ne s'établit que pour les comptes dont un relevé a été importé ;
    en l'absence de tout relevé la réponse est une liste vide, et l'encart ne s'affiche pas.
  */
  if (statementsRes.ok) {
    const json = await statementsRes.json() as any;
    reconciliationStatements = json.data || [];
  }
} catch (err: any) {
  errorMsg = 'Une erreur est survenue lors de la communication avec le serveur comptable.';
}

const isClosed = !!seasonsList.find((s: any) => s.code === season || String(s.id) === season)?.closed;
---

<Layout title="Rapprochement Bancaire - NBA 91">
  <AdminLayout realEmail={Astro.locals.realUser?.email || ""} name={Astro.locals.user?.name} client:idle email={userEmail} breadcrumb="Comptabilité / Rapprochement bancaire" permissions={Astro.locals.user?.permissions || []}>
    <div class="space-y-6">
      {errorMsg && <ErrorAlert message={errorMsg} />}

      <BankStatementReconciliation
        client:load
        bankStatementLines={bankStatementLines}
        glTransactions={glTransactionsList}
        seasons={seasonsList}
        seasonId={season}
        members={membersList}
        dbCategories={categoriesList}
        reconciliationStatements={reconciliationStatements}
      />
    </div>
  </AdminLayout>
</Layout>
