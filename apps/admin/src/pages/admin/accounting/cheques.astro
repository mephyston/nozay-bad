---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { CheckDepositManager } from '@nba/accounting-ui';

import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';

const userEmail = Astro.locals.user?.email || "admin@nozay-bad.fr";
const apiService = createApiClient(env);

const requestedSeason = Astro.url.searchParams.get('season');

if (Astro.request.method === 'POST') {
  try {
    const actionHeader = Astro.request.headers.get('x-action');

    // Action 1: Vision AI analysis
    if (actionHeader === 'analyze') {
      const formData = await Astro.request.formData();
      const apiRes = await apiService.fetch('http://localhost/accounting/checks/analyze', {
        method: 'POST',
        body: formData as any
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
      return new Response(await apiRes.text(), {
        headers: { 'Content-Type': 'application/json' }
      });
    }

    // Action 2: Standard JSON API requests
    const data = await Astro.request.json() as any;

    if (data.action === 'create-check') {
      const apiRes = await apiService.fetch('http://localhost/accounting/checks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
    } else if (data.action === 'delete-check') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/checks/${data.id}`, {
        method: 'DELETE'
      });
      if (!apiRes.ok) {
        return new Response('Erreur suppression chèque', { status: apiRes.status });
      }
    } else if (data.action === 'create-deposit') {
      const apiRes = await apiService.fetch('http://localhost/accounting/check-deposits', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
    } else if (data.action === 'delete-deposit') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/check-deposits/${data.id}/delete`, {
        method: 'POST'
      });
      if (!apiRes.ok) {
        return new Response('Erreur suppression bordereau', { status: apiRes.status });
      }
    } else if (data.action === 'clear-deposit') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/check-deposits/${data.id}/clear`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
    }

    return new Response(JSON.stringify({ success: true }));
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let checksList = [];
let depositsList = [];
let membersList = [];
let seasonsList: any[] = [];
let pendingBankTx = [];
let errorMsg = '';
let season = requestedSeason || '25-26';

try {
  const seasonsRes = await apiService.fetch('http://localhost/accounting/seasons');
  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasonsList = json.data || [];
    seasonsList.sort((a: any, b: any) => (a.startDate || a.code || '').localeCompare(b.startDate || b.code || ''));
    if (!requestedSeason && seasonsList.length > 0) {
      const activeSeasonObj = seasonsList.find((s: any) => s.active || s.active === 1) || seasonsList[seasonsList.length - 1];
      season = activeSeasonObj.code || String(activeSeasonObj.id);
    }
  }

  const [checksRes, depositsRes, membersRes, bankTxRes] = await Promise.all([
    apiService.fetch(`http://localhost/accounting/checks?season=${season}`),
    apiService.fetch(`http://localhost/accounting/check-deposits?season=${season}`),
    apiService.fetch(`http://localhost/members?limit=1000&season=${season}`),
    apiService.fetch(`http://localhost/accounting/bank-transactions?season=${season}`)
  ]);

  if (checksRes.ok) {
    const json = await checksRes.json() as any;
    checksList = json.data || [];
  }

  if (depositsRes.ok) {
    const json = await depositsRes.json() as any;
    depositsList = json.data || [];
  }

  if (membersRes.ok) {
    const json = await membersRes.json() as any;
    membersList = json.data || [];
  }

  if (bankTxRes.ok) {
    const json = await bankTxRes.json() as any;
    const allBankTx = json.data || [];
    pendingBankTx = allBankTx.filter((tx: any) => tx.status === 'pending' && tx.amount > 0);
  }
} catch (err: any) {
  errorMsg = 'Erreur lors de la récupération des données de remise de chèques.';
}

let displaySeasonName = season;
if (seasonsList.length > 0) {
  const currentSeason = seasonsList.find((s: any) => s.code === season || String(s.id) === season);
  if (currentSeason && currentSeason.name) {
    displaySeasonName = currentSeason.name.replace('Saison ', '');
  }
}

const isClosed = !!seasonsList.find((s: any) => s.code === season || String(s.id) === season)?.closed;
---

<Layout title="Remises de Chèques - NBA 91">
  <AdminLayout client:idle email={userEmail} breadcrumb="Comptabilité / Remises de chèques">
    <div class="space-y-6">
      {errorMsg && (
        <div class="p-4 bg-destructive/15 border border-destructive text-destructive rounded-lg">
          {errorMsg}
        </div>
      )}

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 print:hidden">
        <div class="text-center sm:text-left w-full sm:w-auto">
          <h1 class="text-3xl font-bold tracking-tight">Remise de chèques</h1>
          <p class="text-muted-foreground mt-2">
            Gestion et suivi des chèques physiques, génération de bordereaux de remise et rapprochement bancaire pour la saison {displaySeasonName}.
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-center sm:justify-end gap-3 w-full sm:w-auto">
          {isClosed && (
            <span class="px-2.5 py-1 text-xs font-bold rounded bg-muted border border-border text-muted-foreground">
              Saison clôturée (Lecture seule)
            </span>
          )}
        </div>
      </div>

      <CheckDepositManager
        client:load
        seasonId={season}
        seasons={seasonsList}
        checks={checksList}
        checkDeposits={depositsList}
        members={membersList}
        pendingBankTransactions={pendingBankTx}
      />
    </div>
  </AdminLayout>
</Layout>
