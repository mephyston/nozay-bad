---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { TransactionLedger } from '@metacult/features-accounting-ui';
import { env } from 'cloudflare:workers';

const userEmail = Astro.locals.user?.email || "admin@nozay-bad.fr";
const apiService = env.API_SERVICE;

const season = Astro.url.searchParams.get('season') || '25-26';
const page = Astro.url.searchParams.get('page') || '1';
const category = Astro.url.searchParams.get('category') || '';
const classCode = Astro.url.searchParams.get('classCode') || '';
const unreconciledChequesOnly = Astro.url.searchParams.get('unreconciledCheques') === 'true';
const accountId = Astro.url.searchParams.get('accountId') || '';

// Si requête POST, intercepter pour les actions d'écriture (proxying vers Hono)
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.json() as any;
    if (data.action === 'create') {
      const apiRes = await apiService.fetch('http://localhost/accounting/transactions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
    } else if (data.action === 'update') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/transactions/${data.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data.updates)
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
    } else if (data.action === 'delete') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/transactions/${data.id}`, {
        method: 'DELETE'
      });
      if (!apiRes.ok) {
        return new Response('Erreur suppression', { status: apiRes.status });
      }
    }
    return new Response(JSON.stringify({ success: true }));
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let transactionsList = [];
let pagination = { total: 0, page: 1, limit: 20, totalPages: 1 };
let balances = [];
let seasonsList = [];
let categoriesList = [];
let accountClassesList = [];
let errorMsg = '';

try {
  const queryParams = new URLSearchParams({ season, page, limit: '20' });
  if (category) queryParams.set('category', category);
  if (classCode) queryParams.set('classCode', classCode);
  if (unreconciledChequesOnly) queryParams.set('unreconciledCheques', 'true');
  if (accountId) queryParams.set('accountId', accountId);

  const [txRes, reportRes, seasonsRes, categoriesRes, classesRes] = await Promise.all([
    apiService.fetch(`http://localhost/accounting/transactions?${queryParams.toString()}`),
    apiService.fetch(`http://localhost/accounting/seasons/${season}/reports`),
    apiService.fetch('http://localhost/accounting/seasons'),
    apiService.fetch('http://localhost/accounting/categories'),
    apiService.fetch('http://localhost/accounting/account-classes')
  ]);

  if (txRes.ok) {
    const json = await txRes.json() as any;
    transactionsList = json.data || [];
    pagination = json.pagination;
  }

  if (reportRes.ok) {
    const json = await reportRes.json() as any;
    balances = json.data?.bilanTrésorerie || [];
  }

  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasonsList = json.data || [];
  }

  if (categoriesRes.ok) {
    const json = await categoriesRes.json() as any;
    categoriesList = json.data || [];
  }

  if (classesRes.ok) {
    const json = await classesRes.json() as any;
    accountClassesList = json.data || [];
  }
} catch (err: any) {
  errorMsg = 'Une erreur est survenue lors de la communication avec le serveur comptable.';
}
---

<Layout title="Comptabilité - NBA 91">
  <AdminLayout client:load email={userEmail} breadcrumb="Comptabilité / Grand Livre">
    <div class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Comptabilité</h1>
          <p class="text-muted-foreground mt-2">
            Consultez le grand livre comptable et suivez les mouvements de fonds de l'association.
          </p>
        </div>
      </div>

      {errorMsg && (
        <div class="p-4 bg-destructive/15 border border-destructive text-destructive rounded-lg">
          {errorMsg}
        </div>
      )}

      <TransactionLedger
        client:load
        transactions={transactionsList}
        pagination={pagination}
        seasonId={season}
        balances={balances}
        seasons={seasonsList}
        categories={categoriesList}
        accountClasses={accountClassesList}
        unreconciledChequesOnly={unreconciledChequesOnly}
        accountId={accountId}
      />
    </div>
  </AdminLayout>
</Layout>
