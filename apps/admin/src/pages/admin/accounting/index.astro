---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import LedgerScreen from '../../../components/LedgerScreen.svelte';

/**
 * Le grand livre, en coquille.
 *
 * Les filtres de l'écran vivent dans l'URL — neuf paramètres — et sont transmis tels
 * quels à l'îlot, qui les passe au relais `/admin/api/accounting/ledger`. Les recopier un
 * à un obligerait à toucher ce fichier à chaque filtre ajouté ; les lire ici ne coûte
 * rien, c'est une chaîne de requête.
 */
const parametres = Object.fromEntries(Astro.url.searchParams);
---

<Layout title="Comptabilité - NBA 91">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || ''}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Comptabilité / Grand Livre"
  >
    <div class="space-y-6">
      <LedgerScreen client:load {parametres} />
    </div>
  </AdminLayout>
</Layout>
