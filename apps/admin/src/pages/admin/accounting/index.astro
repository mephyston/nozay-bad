---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import LedgerScreen from '../../../components/LedgerScreen.svelte';

/**
 * Le grand livre, en coquille.
 *
 * Les filtres de l'écran vivent dans l'URL — neuf paramètres — et sont transmis tels
 * quels à l'îlot, qui les passe au relais `/admin/api/accounting/ledger`. Les recopier un
 * à un obligerait à toucher ce fichier à chaque filtre ajouté ; les lire ici ne coûte
 * rien, c'est une chaîne de requête.
 */

/*
  Page figée.

  Le worker reste **invoqué** — l'adaptateur d'Astro sert les actifs lui-même, par
  `env.ASSETS.fetch` — mais il ne rend plus rien : il transmet un fichier. Ce que le
  prerender supprime est le rendu, pas l'invocation.

  Corollaire : la page ne porte aucune donnée, aucune identité et aucun paramètre d'URL.
  L'îlot demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Grand livre">
  <AdminLayout
    client:idle
    breadcrumb="Comptabilité / Grand Livre"
  >
    <div class="space-y-6">
      <LedgerScreen client:load />
    </div>
  </AdminLayout>
</Layout>
