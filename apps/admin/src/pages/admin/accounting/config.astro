---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { InitialBalancesConfig } from '@nba/accounting-ui';
import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';

const userEmail = Astro.locals.user?.email || "admin@nozay-bad.fr";
const apiService = createApiClient(env);

const requestedSeason = Astro.url.searchParams.get('season');

// Proxying POST requests to configure initial balances for a season
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.json() as any;
    const apiRes = await apiService.fetch(`http://localhost/accounting/seasons/${data.seasonId}/balances`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data.balances)
    });
    if (!apiRes.ok) {
      return new Response('Erreur configuration soldes', { status: apiRes.status });
    }
    return new Response(JSON.stringify({ success: true }));
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let seasonsList: any[] = [];
let errorMsg = '';
let season = requestedSeason || '25-26';

try {
  const seasonsRes = await apiService.fetch('http://localhost/accounting/seasons');
  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    const rawSeasons: any[] = json.data || [];
    rawSeasons.sort((a: any, b: any) => (a.startDate || a.code || '').localeCompare(b.startDate || b.code || ''));

    if (!requestedSeason && rawSeasons.length > 0) {
      const activeSeasonObj = rawSeasons.find((s: any) => s.active || s.active === 1) || rawSeasons[rawSeasons.length - 1];
      season = activeSeasonObj.code || String(activeSeasonObj.id);
    }

    seasonsList = await Promise.all(rawSeasons.map(async (s) => {
      const balRes = await apiService.fetch(`http://localhost/accounting/seasons/${s.code || s.id}/balances`);
      let initialCurrentBalance = 0;
      let initialSavingsBalance = 0;
      let initialCashBalance = 0;
      let isAutoFilled = false;
      if (balRes.ok) {
        const balJson = await balRes.json() as any;
        const balList: any[] = balJson.data || [];
        if (balList.length > 0) {
          const curr = balList.find(b => b.accountId === 'current');
          const sav = balList.find(b => b.accountId === 'savings');
          const csh = balList.find(b => b.accountId === 'cash');
          if (curr) initialCurrentBalance = curr.initialBalance;
          if (sav) initialSavingsBalance = sav.initialBalance;
          if (csh) initialCashBalance = csh.initialBalance;
        } else {
          const sCode = s.code || String(s.id);
          const match = sCode.match(/^(\d+)-(\d+)$/);
          if (match) {
            const yy = parseInt(match[1]);
            const zz = parseInt(match[2]);
            const prevSeasonId = `${String(yy - 1).padStart(2, '0')}-${String(zz - 1).padStart(2, '0')}`;
            const prevReportRes = await apiService.fetch(`http://localhost/accounting/seasons/${prevSeasonId}/reports`);
            if (prevReportRes.ok) {
              const prevReportJson = await prevReportRes.json() as any;
              const prevBilan: any[] = prevReportJson.data?.bilanTrésorerie || [];
              const prevCurr = prevBilan.find((b: any) => b.accountId === 'current');
              const prevSav = prevBilan.find((b: any) => b.accountId === 'savings');
              const prevCsh = prevBilan.find((b: any) => b.accountId === 'cash');
              if (prevCurr) initialCurrentBalance = prevCurr.finalBalance;
              if (prevSav) initialSavingsBalance = prevSav.finalBalance;
              if (prevCsh) initialCashBalance = prevCsh.finalBalance;
              isAutoFilled = true;
            }
          }
        }
      }
      return {
        ...s,
        initialCurrentBalance,
        initialSavingsBalance,
        initialCashBalance,
        isAutoFilled
      };
    }));
  }
} catch (err: any) {
  errorMsg = 'Impossible de charger la liste des saisons comptables.';
}
const isClosed = !!seasonsList.find((s: any) => (s.code || String(s.id)) === season || String(s.id) === season)?.closed;
---

<Layout title="Soldes initiaux - NBA 91">
  <AdminLayout client:idle email={userEmail} breadcrumb="Comptabilité / Soldes initiaux">
    <div class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Soldes initiaux</h1>
          <p class="text-muted-foreground mt-2">
            Définissez l'état des comptes au premier jour de l'exercice comptable.
          </p>
        </div>
        <div class="flex items-center gap-3 print:hidden">
          {isClosed && (
            <span class="px-2.5 py-1 text-xs font-bold rounded bg-muted border border-border text-muted-foreground">
              Saison clôturée (Lecture seule)
            </span>
          )}
          <select
            id="season-selector"
            class="px-3 py-1.5 border border-border bg-background rounded-md text-xs font-semibold focus:outline-none focus:ring-1 focus:ring-primary cursor-pointer h-9"
          >
            {seasonsList.map((s: any) => {
              const val = s.code || String(s.id);
              const isSelected = val === season || String(s.id) === season;
              return (
                <option value={val} selected={isSelected}>{s.name}</option>
              );
            })}
            {seasonsList.length === 0 && (
              <option value="25-26" selected>Saison 2025-2026</option>
            )}
          </select>
        </div>
      </div>

      {errorMsg && (
        <div class="p-4 bg-destructive/15 border border-destructive text-destructive rounded-lg">
          {errorMsg}
        </div>
      )}

      <InitialBalancesConfig client:load seasons={seasonsList} seasonId={season} />
    </div>
  </AdminLayout>
</Layout>

<script>
  const selector = document.getElementById('season-selector');
  if (selector) {
    selector.addEventListener('change', (e) => {
      const newSeason = (e.target as HTMLSelectElement).value;
      const params = new URLSearchParams(window.location.search);
      params.set('season', newSeason);
      window.location.href = `/admin/accounting/config?${params.toString()}`;
    });
  }
</script>
