---
import Layout from '../../../../layouts/Layout.astro';
import AdminLayout from '../../../../components/AdminLayout.svelte';
import ReportScreen from '../../../../components/ReportScreen.svelte';

/**
 * Un rapport financier, en coquille.
 *
 * Cette page ne relaie plus rien. Elle portait deux métiers — servir un écran et
 * streamer un PDF ou un ZIP selon un paramètre d'URL — ce qui la condamnait à rester
 * dynamique. Les téléchargements vivent désormais sur
 * `/admin/api/accounting/download`, qui relaie le flux sans le lire.
 */
const RAPPORTS: Record<string, { titre: string; vue: 'resultat' | 'tresorerie' | 'budget' | 'analytique' }> = {
  'income-statement': { titre: 'Compte de Résultat', vue: 'resultat' },
  analytics: { titre: 'Suivi Analytique', vue: 'analytique' },
  'cash-flow': { titre: 'Bilan de Trésorerie', vue: 'tresorerie' },
  forecast: { titre: 'Budget Prévisionnel', vue: 'budget' }
};

const report = Astro.params.report ?? '';
const rapport = RAPPORTS[report];
if (!rapport) return Astro.redirect('/admin/accounting/reports');

const season = Astro.url.searchParams.get('season') ?? '';
---

<Layout title={`${rapport.titre} - NBA 91`}>
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || ''}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb={`Comptabilité / Rapports / ${rapport.titre}`}
  >
    <div class="space-y-6">
      <ReportScreen client:load {report} titre={rapport.titre} vue={rapport.vue} {season} />
    </div>
  </AdminLayout>
</Layout>
