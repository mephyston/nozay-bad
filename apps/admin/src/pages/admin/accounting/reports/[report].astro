---
import Layout from '../../../../layouts/Layout.astro';
import AdminLayout from '../../../../components/AdminLayout.svelte';
import { PageHeader, ErrorAlert, SeasonSelector } from '@nba/ui';
import { GeneralMeetingReport } from '@nba/accounting-ui';
import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';

const userEmail = Astro.locals.user?.email || "admin@nozaybad.fr";
const apiService = createApiClient(env);

const requestedSeason = Astro.url.searchParams.get('season');
const isExport = Astro.url.searchParams.get('export');
const isPdf = Astro.url.searchParams.get('pdf');

// Téléchargement PDF d'un rapport financier (compte de résultat, suivi
// analytique, bilan de trésorerie). Le type découle du segment d'URL.
if (isPdf && requestedSeason) {
  const pdfTypeMap: Record<string, string> = {
    'income-statement': 'income-statement',
    'analytics': 'analytics',
    'cash-flow': 'cash-flow'
  };
  const pdfType = pdfTypeMap[Astro.params.report || ''];
  if (pdfType) {
    try {
      const pdfRes = await apiService.fetch(`http://localhost/accounting/seasons/${requestedSeason}/reports/pdf?type=${pdfType}`);
      if (pdfRes.ok) {
        return new Response(pdfRes.body, {
          headers: {
            'Content-Type': 'application/pdf',
            'Content-Disposition': pdfRes.headers.get('Content-Disposition') || `inline; filename="rapport-${pdfType}-${requestedSeason}.pdf"`
          }
        });
      }
    } catch (err) {
      console.error('Report PDF failed', err);
    }
  }
}

if (isExport && requestedSeason) {
  try {
    const exportType = isExport === 'true' ? 'all' : isExport;
    const exportRes = await apiService.fetch(`http://localhost/accounting/seasons/${requestedSeason}/export?type=${exportType}`);
    if (exportRes.ok) {
      return new Response(exportRes.body, {
        headers: {
          'Content-Type': exportRes.headers.get('Content-Type') || 'application/zip',
          'Content-Disposition': exportRes.headers.get('Content-Disposition') || `attachment; filename="export-compta-${requestedSeason}.zip"`
        }
      });
    }
  } catch (err) {
    console.error('Export failed', err);
  }
}

// Si requête POST, intercepter pour modifier les soldes initiaux ou le budget (proxying)
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.json() as any;
    if (data.action === 'save_budget') {
      const apiRes = await apiService.fetch(`http://localhost/accounting/seasons/${data.seasonId}/budget`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data.budget)
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text() || 'Erreur configuration budget', { status: apiRes.status });
      }
      return new Response(JSON.stringify({ success: true }));
    } else {
      const apiRes = await apiService.fetch(`http://localhost/accounting/seasons/${data.seasonId}/balances`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data.balances)
      });
      if (!apiRes.ok) {
        return new Response('Erreur configuration soldes', { status: apiRes.status });
      }
      return new Response(JSON.stringify({ success: true }));
    }
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let seasonsList: any[] = [];
let categoriesList: any[] = [];
let accountClassesList: any[] = [];
let budgetList: any[] = [];
let prevReportData: any = null;
let errorMsg = '';
let season = requestedSeason || '25-26';

let reportData = {
  compteResultat: { totalRecettes: 0, totalDepenses: 0, netResult: 0, categories: {} },
  bilanTrésorerie: [
    { accountId: 'current' as const, initialBalance: 0, finalBalance: 0 },
    { accountId: 'savings' as const, initialBalance: 0, finalBalance: 0 },
    { accountId: 'cash' as const, initialBalance: 0, finalBalance: 0 }
  ]
};

function getPreviousSeasonId(currentId: string): string {
  const parts = currentId.split('-');
  if (parts.length === 2) {
    const start = parseInt(parts[0]);
    const end = parseInt(parts[1]);
    if (!isNaN(start) && !isNaN(end)) {
      const prevStart = (start - 1).toString().padStart(2, '0');
      const prevEnd = (end - 1).toString().padStart(2, '0');
      return `${prevStart}-${prevEnd}`;
    }
  }
  return '';
}

try {
  const seasonsRes = await apiService.fetch('http://localhost/accounting/seasons');
  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasonsList = json.data || [];
    // Tri chronologique des saisons par date de début / code (ordre croissant)
    seasonsList.sort((a: any, b: any) => (a.startDate || a.code || '').localeCompare(b.startDate || b.code || ''));
    if (!requestedSeason && seasonsList.length > 0) {
      const activeSeasonObj = seasonsList.find((s: any) => s.active || s.active === 1) || seasonsList[seasonsList.length - 1];
      season = activeSeasonObj.code || String(activeSeasonObj.id);
    }
  }

  const prevSeason = getPreviousSeasonId(season);
  const todayDate = new Date().toISOString().split('T')[0];
  const arretedAuParam = (season === seasonsList.find((s: any) => s.active || s.active === 1)?.code || season === seasonsList[seasonsList.length - 1]?.code) 
    ? `?arretedAu=${todayDate}` 
    : '';

  const [res, prevResResult, categoriesRes, classesRes, budgetRes] = await Promise.all([
    apiService.fetch(`http://localhost/accounting/seasons/${season}/reports${arretedAuParam}`),
    prevSeason ? apiService.fetch(`http://localhost/accounting/seasons/${prevSeason}/reports`).catch((e) => {
      console.error('Failed to fetch previous season reports', e);
      return null;
    }) : Promise.resolve(null),
    apiService.fetch('http://localhost/accounting/categories'),
    apiService.fetch('http://localhost/accounting/account-classes'),
    apiService.fetch(`http://localhost/accounting/seasons/${season}/budget`)
  ]);

  if (res.ok) {
    const json = await res.json() as any;
    reportData = json.data;
  } else {
    throw new Error('Erreur récupération du rapport');
  }

  if (prevResResult && prevResResult.ok) {
    const json = await prevResResult.json() as any;
    prevReportData = json.data;
  }

  if (categoriesRes.ok) {
    const json = await categoriesRes.json() as any;
    categoriesList = json.data || [];
  }

  if (classesRes.ok) {
    const json = await classesRes.json() as any;
    accountClassesList = json.data || [];
  }

  if (budgetRes.ok) {
    const json = await budgetRes.json() as any;
    budgetList = json.data || [];
  }
} catch (err: any) {
  errorMsg = 'Impossible de charger les données du bilan AG.';
}
const { report: reportType } = Astro.params;
const validReports: Record<string, { title: string, desc: string, view: 'resultat' | 'tresorerie' | 'budget' | 'analytique' }> = {
  'income-statement': { title: 'Compte de Résultat', desc: 'Consultez les produits et charges pour la saison.', view: 'resultat' },
  'analytics': { title: 'Suivi Analytique', desc: 'Détail des recettes et dépenses par catégorie analytique.', view: 'analytique' },
  'cash-flow': { title: 'Bilan de Trésorerie', desc: 'Consultez les soldes initiaux et finaux des comptes financiers.', view: 'tresorerie' },
  'forecast': { title: 'Budget Prévisionnel', desc: 'Préparez et consultez le budget de la saison.', view: 'budget' }
};

if (!reportType || !validReports[reportType]) {
  return Astro.redirect('/admin/accounting/reports');
}

const currentReport = validReports[reportType];
---

<Layout title={`${currentReport.title} - NBA 91`}>
  <AdminLayout name={Astro.locals.user?.name} client:idle email={userEmail} breadcrumb={`Comptabilité / Rapports / ${currentReport.title}`} permissions={Astro.locals.user?.permissions || []}>
    <div class="space-y-6">
      <div class="no-print">
        <a
          href="/admin/accounting/reports"
          class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          Retour aux rapports financiers
        </a>
      </div>

      <PageHeader
        title={currentReport.title}
        description={currentReport.desc}
      >
        <Fragment slot="actions">
          <SeasonSelector client:load seasons={seasonsList} current={season} />
        </Fragment>
      </PageHeader>

      {errorMsg && <ErrorAlert message={errorMsg} />}

      <GeneralMeetingReport client:load view={currentReport.view} report={reportData} prevReport={prevReportData} seasonId={season} seasons={seasonsList} categories={categoriesList} accountClasses={accountClassesList} budget={budgetList} userPermissions={Astro.locals.user?.permissions || []} />
    </div>
  </AdminLayout>
</Layout>

