---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import ClubFunctionsScreen from '../../../components/ClubFunctionsScreen.svelte';

const parametres = Object.fromEntries(Astro.url.searchParams);
---

<Layout title="Dirigeants - NBA 91">
  <AdminLayout
    email={Astro.locals.user?.email || ''}
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    breadcrumb="Adhérents / Dirigeants"
    permissions={Astro.locals.user?.permissions || []}
  >
    <div class="space-y-6">
      <ClubFunctionsScreen client:load {parametres} />
    </div>
  </AdminLayout>
</Layout>
