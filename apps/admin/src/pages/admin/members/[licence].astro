---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import MemberProfileScreen from '../../../components/MemberProfileScreen.svelte';

/**
 * La fiche d'un adhérent, en coquille.
 *
 * La licence est validée ici **et** dans le relais : une URL absurde doit renvoyer sur la
 * liste, pas monter un écran qui échouera.
 */
const licence = Astro.params.licence ?? '';
if (!/^\d{1,8}$/.test(licence)) return Astro.redirect('/admin/members');

const season = Astro.url.searchParams.get('season') ?? '';
---

<Layout title="Profil Adhérent - NBA 91">
  <AdminLayout
    email={Astro.locals.user?.email || ''}
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    breadcrumb="Adhérents / Fiche Adhérent"
    permissions={Astro.locals.user?.permissions || []}
  >
    <div class="space-y-6">
      <MemberProfileScreen client:load {licence} {season} />
    </div>
  </AdminLayout>
</Layout>
