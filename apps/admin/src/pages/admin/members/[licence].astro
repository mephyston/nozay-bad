---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { ErrorAlert } from '@nba/ui';
import { MemberProfile } from '@nba/members-ui';

import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';

const { licence } = Astro.params;
const season = Astro.url.searchParams.get('season') || '25-26';
const apiService = createApiClient(env);

let member = null;
let memberTransactionsList = [];
let errorMsg = '';

try {
  const res = await apiService.fetch(`http://localhost/members/${licence}?season=${season}`);
  if (!res.ok) {
    if (res.status === 404) {
      throw new Error(`Adhérent avec la licence ${licence} introuvable.`);
    }
    throw new Error('Erreur de communication avec le service API.');
  }
  const body = await res.json() as any;
  member = body.data;

  if (member) {
    const txRes = await apiService.fetch(`http://localhost/accounting/transactions?season=${season}&memberId=${member.id}&limit=100`);
    if (txRes.ok) {
      const txBody = await txRes.json() as any;
      memberTransactionsList = txBody.data || [];
    }
  }
} catch (err: any) {
  errorMsg = err.message || 'Une erreur inattendue est survenue.';
}
---

<Layout title={member ? `Profil ${member.lastName} ${member.firstName} - NBA 91` : "Profil Adhérent - NBA 91"}>
  <AdminLayout name={Astro.locals.user?.name} client:idle breadcrumb="Adhérents / Fiche Adhérent" permissions={Astro.locals.user?.permissions || []}>
    <div class="space-y-6">
      {errorMsg && (
        <div class="max-w-3xl mx-auto space-y-4">
          <ErrorAlert message={errorMsg} />
          <a href="/admin/members" class="text-sm text-primary hover:underline">
            &larr; Retour à la liste des adhérents
          </a>
        </div>
      )}

      {member && <MemberProfile client:load {member} transactions={memberTransactionsList} seasonId={season} />}
    </div>
  </AdminLayout>
</Layout>
