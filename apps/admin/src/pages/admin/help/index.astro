---
import AdminLayout from "../../../components/AdminLayout.svelte";
import Layout from "../../../layouts/Layout.astro";
import { PageHeader } from '@nba/ui';
import HelpCenterScreen from '../../../components/HelpCenterScreen.svelte';
import { getCollection } from 'astro:content';

const { user } = Astro.locals as any;
const permissions = user?.permissions || [];
const helpEntries = await getCollection('help');

const groupedHelp = helpEntries.reduce((acc, entry) => {
  const cat = entry.data.category;
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(entry);
  return acc;
}, {} as Record<string, typeof helpEntries>);

// Sort by order
Object.keys(groupedHelp).forEach(cat => {
  groupedHelp[cat].sort((a, b) => a.data.order - b.data.order);
});

const categoryNames: Record<string, string> = {
  'adherents': 'Gestion des Adhérents',
  'entrainement': 'Entraînement',
  'interclubs': 'Interclubs',
  'comptabilite': 'Comptabilité et Trésorerie',
  'boutique': 'Boutique',
  'communication': 'Communication',
  'site': 'Site public',
  'admin': 'Administration'
};

// Ordre d'affichage des rubriques, calqué sur le menu d'administration. Sans lui,
// l'ordre dépendait de la première occurrence rencontrée dans la collection.
const categoryOrder = ['admin', 'adherents', 'entrainement', 'interclubs', 'comptabilite', 'boutique', 'communication', 'site'];
const sortedCategories = Object.entries(groupedHelp).sort(
  ([a], [b]) => categoryOrder.indexOf(a) - categoryOrder.indexOf(b)
);

/*
  Les rubriques passent à l'îlot, qui les réduit au terme cherché sans aller-retour
  réseau : la collection est lue au build, il n'y a rien à demander au serveur pour
  filtrer quarante articles.
*/
const rubriques = sortedCategories.map(([category, entries]) => ({
  cle: category,
  titre: categoryNames[category] || category,
  articles: entries.map((entry) => ({
    id: entry.id,
    titre: entry.data.title,
    description: entry.data.description
  }))
}));
---

<Layout title="Aide aux bénévoles">
  <AdminLayout realEmail={Astro.locals.realUser?.email || ""} 
    client:load 
    email={user?.email || ""} 
    name={user?.name || ""} 
    permissions={permissions} 
    breadcrumb="Aide / Centre d'aide"
  >
    <div class="max-w-4xl mx-auto space-y-6">
      <PageHeader
        title="Centre d'aide"
        description="Trouvez des réponses à vos questions et apprenez à utiliser l'application."
      />

      <HelpCenterScreen client:load {rubriques} />
    </div>
  </AdminLayout>
</Layout>
