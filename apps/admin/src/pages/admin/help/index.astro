---
import AdminLayout from "../../../components/AdminLayout.svelte";
import Layout from "../../../layouts/Layout.astro";
import { PageHeader } from '@nba/ui';
import { getCollection } from 'astro:content';

const { user } = Astro.locals as any;
const permissions = user?.permissions || [];
const helpEntries = await getCollection('help');

const groupedHelp = helpEntries.reduce((acc, entry) => {
  const cat = entry.data.category;
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(entry);
  return acc;
}, {} as Record<string, typeof helpEntries>);

// Sort by order
Object.keys(groupedHelp).forEach(cat => {
  groupedHelp[cat].sort((a, b) => a.data.order - b.data.order);
});

const categoryNames: Record<string, string> = {
  'adherents': 'Gestion des Adhérents',
  'comptabilite': 'Comptabilité et Trésorerie',
  'boutique': 'Boutique',
  'admin': 'Administration'
};
---

<Layout title="Aide aux bénévoles - Nozay Bad Admin">
  <AdminLayout 
    client:load 
    email={user?.email || ""} 
    name={user?.name || ""} 
    permissions={permissions} 
    breadcrumb="Aide / Centre d'aide"
  >
    <div class="max-w-4xl mx-auto space-y-6">
      <PageHeader
        title="Centre d'aide"
        description="Trouvez des réponses à vos questions et apprenez à utiliser l'application."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {Object.keys(groupedHelp).length === 0 ? (
          <p class="text-muted-foreground">Aucun article d'aide n'a été trouvé.</p>
        ) : (
          Object.entries(groupedHelp).map(([category, entries]) => (
            <div class="rounded-xl border bg-card text-card-foreground shadow">
              <div class="flex flex-col space-y-1.5 p-6">
                <h3 class="font-semibold leading-none tracking-tight">{categoryNames[category] || category}</h3>
              </div>
              <div class="p-6 pt-0">
                <div class="grid gap-2">
                  {entries.map(entry => (
                    <a href={`/admin/help/${entry.id}`} class="flex items-center gap-2 hover:bg-muted p-2 rounded-md transition-colors">
                      <div class="flex-1">
                        <div class="font-medium text-sm">{entry.data.title}</div>
                        {entry.data.description && <div class="text-xs text-muted-foreground">{entry.data.description}</div>}
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </AdminLayout>
</Layout>
