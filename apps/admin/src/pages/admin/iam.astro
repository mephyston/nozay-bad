---
import Layout from '../../layouts/Layout.astro';
import AdminLayout from '../../components/AdminLayout.svelte';
import IamHubScreen from '../../components/IamHubScreen.svelte';

/*
  L'accueil des accès : deux rubriques, chacune sur sa page.

  Page figée : l'îlot demande ses données au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Accès et rôles">
  <AdminLayout client:idle breadcrumb="Accès & Rôles">
    <div class="space-y-6">
      <IamHubScreen client:load />
    </div>
  </AdminLayout>
</Layout>
