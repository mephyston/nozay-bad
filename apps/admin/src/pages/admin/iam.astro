---
import Layout from '../../layouts/Layout.astro';
import AdminLayout from '../../components/AdminLayout.svelte';
import { PageHeader, ErrorAlert } from '@nba/ui';
import { UsersManager, RolesMatrix } from '@nba/iam-ui';
import { env } from 'cloudflare:workers';
import { createAdminApiClient } from '../../lib/api';
import { can } from '../../lib/guard';
import { guardAction } from '../../lib/guard';

// La consultation est exigée par PAGE_PERMISSIONS (`iam:users:read`) ; chaque action
// d'écriture a sa propre permission, ci-dessous.
const apiService = createAdminApiClient(Astro.locals);

let usersList: any[] = [];
let rolesList: any[] = [];
let errorMsg = '';

/** Permission exigée par action d'écriture de cette page. */
const ACTIONS = {
  create_user: 'iam:users:write',
  update_user: 'iam:users:write',
  delete_user: 'iam:users:delete'
} as const;

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.json() as any;

    const denied = guardAction(Astro.locals, data.action, ACTIONS);
    if (denied) return denied;
    
    if (data.action === 'create_user') {
      const apiRes = await apiService.fetch('http://localhost/iam/users', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: data.email, name: data.name, roles: data.roles })
      });
      if (!apiRes.ok) return new Response(await apiRes.text(), { status: apiRes.status });
      await apiRes.text(); // Consume body to release connection
    } else if (data.action === 'update_user') {
      const apiRes = await apiService.fetch(`http://localhost/iam/users/${data.id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: data.name, roles: data.roles })
      });
      if (!apiRes.ok) return new Response(await apiRes.text(), { status: apiRes.status });
      await apiRes.text(); // Consume body to release connection
    } else if (data.action === 'delete_user') {
      const apiRes = await apiService.fetch(`http://localhost/iam/users/${data.id}`, {
        method: 'DELETE'
      });
      if (!apiRes.ok) return new Response(await apiRes.text(), { status: apiRes.status });
      await apiRes.text(); // Consume body to release connection
    }
    
    return new Response(JSON.stringify({ success: true }), { headers: { 'Content-Type': 'application/json' } });
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

try {
  const usersRes = await apiService.fetch('http://localhost/iam/users');
  if (usersRes.ok) {
    const json = await usersRes.json() as any;
    usersList = json.data || [];
  }

  // La matrice des droits vient de l'API : les rôles sont modifiables, le code n'en
  // porte plus que la définition d'origine.
  const rolesRes = await apiService.fetch('http://localhost/iam/roles');
  if (rolesRes.ok) {
    const json = (await rolesRes.json()) as any;
    rolesList = json.data || [];
  }
} catch (err: any) {
  errorMsg = 'Erreur lors de la récupération des utilisateurs.';
}
---

<Layout title="Accès et rôles - NBA 91">
  <AdminLayout realEmail={Astro.locals.realUser?.email || ""} name={Astro.locals.user?.name} client:idle email={Astro.locals.user?.email || ''} permissions={Astro.locals.user?.permissions || []} breadcrumb="Accès & Rôles">
    <div class="space-y-6">
      <PageHeader
        title="Accès et rôles"
        description="Attribuez un rôle aux personnes qui administrent Nozay Bad Association."
      />

      {errorMsg && <ErrorAlert message={errorMsg} />}

      <div>
        <UsersManager client:load users={usersList} />
      </div>

      <!-- Les îlots Astro sont des éléments inline : sans ce bloc, `space-y-6` ne
           pose pas de marge entre la liste des comptes et cette section. -->
      <div>
        <RolesMatrix client:visible roles={rolesList} canEdit={can(Astro.locals, 'iam:roles:write')} />
      </div>
    </div>
  </AdminLayout>
</Layout>
