---
import Layout from '../../layouts/Layout.astro';
import AdminLayout from '../../components/AdminLayout.svelte';
import IamScreen from '../../components/IamScreen.svelte';
---

<Layout title="Accès et rôles - NBA 91">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || ''}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Accès & Rôles"
  >
    <div class="space-y-6">
      <IamScreen client:load />
    </div>
  </AdminLayout>
</Layout>
