---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { PageHeader } from '@nba/ui';
import PostsScreen from '../../../components/PostsScreen.svelte';

/*
  Page figée.

  Le worker reste **invoqué** — l'adaptateur d'Astro sert les actifs lui-même, par
  `env.ASSETS.fetch` — mais il ne rend plus rien : il transmet un fichier. Ce que le
  prerender supprime est le rendu, pas l'invocation.

  Corollaire : la page ne porte aucune donnée, aucune identité et aucun paramètre d'URL.
  L'îlot demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Actualités - NBA 91">
  <AdminLayout
    client:idle
    breadcrumb="Actualités"
  >
    <div class="space-y-6">

      <PageHeader
        title="Actualités"
        description="Les communications du club. Publiques, elles paraissent sur le site et dans l'espace adhérent ; réservées, dans l'espace adhérent seul — et peuvent alors déclencher une notification."
      />

      <PostsScreen client:load />
    </div>
  </AdminLayout>
</Layout>
