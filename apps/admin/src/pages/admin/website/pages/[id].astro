---
import Layout from '../../../../layouts/Layout.astro';
import AdminLayout from '../../../../components/AdminLayout.svelte';
import PageEditorScreen from '../../../../components/PageEditorScreen.svelte';

/**
 * L'éditeur d'une page, en coquille.
 *
 * Dernier écran converti de la rubrique, et le seul qui portait sur un objet précis :
 * neuf lectures, un jeton d'aperçu à signer, et un titre qui dépend de ce qu'on édite.
 *
 * Tout est passé au relais `/admin/api/cms/page`, qui reçoit l'identifiant en paramètre
 * de requête. La signature du jeton d'aperçu y reste : elle emploie
 * `PREVIEW_TOKEN_SECRET`, partagé avec le site public, et ce secret n'a rien à faire
 * dans le navigateur.
 *
 * L'identifiant est encore validé ici, avant même d'atteindre l'îlot : une URL absurde
 * doit renvoyer sur la liste, pas monter un écran qui échouera.
 */
const id = Number(Astro.params.id);
if (!Number.isSafeInteger(id) || id < 1) return Astro.redirect('/admin/website/pages');
---

<Layout title="Page du site - NBA 91">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || ''}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Pages du site"
  >
    <div class="space-y-6">
      <PageEditorScreen client:load {id} />
    </div>
  </AdminLayout>
</Layout>
