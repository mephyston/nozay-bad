---
import Layout from '../../../../layouts/Layout.astro';
import AdminLayout from '../../../../components/AdminLayout.svelte';
import { PageHeader } from '@nba/ui';
import PagesScreen from '../../../../components/PagesScreen.svelte';
import { createAdminApiClient } from '../../../../lib/api';
import { guardAction } from '../../../../lib/guard';


const apiService = createAdminApiClient(Astro.locals);

const ACTIONS = {
  create: 'cms:pages:write',
  delete: 'cms:pages:delete'
} as const;

if (Astro.request.method === 'POST') {
  const data = (await Astro.request.json()) as any;
  const denied = guardAction(Astro.locals, data.action, ACTIONS);
  if (denied) return denied;

  const routes: Record<string, { url: string; method: string; body?: unknown }> = {
    create: { url: 'http://localhost/cms/pages', method: 'POST', body: { title: data.title } },
    delete: { url: `http://localhost/cms/pages/${data.id}`, method: 'DELETE' }
  };

  const route = routes[data.action];
  const apiRes = await apiService.fetch(route.url, {
    method: route.method,
    headers: { 'Content-Type': 'application/json' },
    ...(route.body ? { body: JSON.stringify(route.body) } : {})
  });

  if (!apiRes.ok) return new Response(await apiRes.text(), { status: apiRes.status });
  return new Response(JSON.stringify(await apiRes.json()), {
    headers: { 'Content-Type': 'application/json' }
  });
}

---

<Layout title="Pages du site - NBA 91">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || ''}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Pages du site"
  >
    <div class="space-y-6">

      <PageHeader
        title="Pages du site"
        description="Les pages du site public. Une page reste invisible tant qu'elle n'est pas publiée."
      />

      <PagesScreen client:only="svelte" />
    </div>
  </AdminLayout>
</Layout>
