---
import Layout from '../../../../layouts/Layout.astro';
import AdminLayout from '../../../../components/AdminLayout.svelte';
import { PageHeader } from '@nba/ui';
import PagesScreen from '../../../../components/PagesScreen.svelte';

/*
  Page figée : elle n'est plus rendue par un worker, mais servie depuis les actifs.
  Elle ne porte donc aucune donnée, aucune identité et aucun paramètre d'URL — l'îlot
  demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Pages du site - NBA 91">
  <AdminLayout
    client:idle
    breadcrumb="Pages du site"
  >
    <div class="space-y-6">

      <PageHeader
        title="Pages du site"
        description="Les pages du site public. Une page reste invisible tant qu'elle n'est pas publiée."
      />

      <PagesScreen client:load />
    </div>
  </AdminLayout>
</Layout>
