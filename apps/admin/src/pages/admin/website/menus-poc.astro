---
import Layout from '../../../layouts/Layout.astro';
import MenusPoc from '../../../components/MenusPoc.svelte';
import { createAdminApiClient } from '../../../lib/api';
import { guardAction } from '../../../lib/guard';

/**
 * PREUVE DE CONCEPT — à supprimer une fois la question tranchée.
 *
 * La même page que `/admin/website/menus`, mais dont le serveur ne rend **rien** : ni
 * l'habillage de l'administration, ni le gestionnaire, ni ses données sérialisées en
 * props. Le worker n'émet qu'une coquille ; l'îlot va chercher ses données par
 * `/admin/api/cms/menus`.
 *
 * Ce qu'on mesure : le temps processeur d'une page qui ne calcule pas de HTML. La page
 * de référence tient 23,9 ms de moyenne et 18 ms au minimum ; retirer le seul rendu du
 * gestionnaire l'avait ramenée à 8 ms. Si cette page-ci tombe à 1-2 ms, l'architecture
 * « coquille plus relais » vaut les semaines qu'elle coûterait.
 *
 * L'habillage est absent, pas déplacé : c'est un banc d'essai, pas un écran fini.
 */

const ACTIONS = { proxy: 'cms:pages:write' } as const;

// Le même relais d'écriture que la page d'origine : sans lui, l'essai ne serait pas
// comparable — on mesurerait une page qu'on ne peut pas utiliser.
if (Astro.request.method === 'POST') {
  const data = (await Astro.request.json()) as any;
  const denied = guardAction(Astro.locals, data.action, ACTIONS);
  if (denied) return denied;

  const allowed = /^\/cms\/nav(\/reorder|\/\d+)?$/;
  if (typeof data.path !== 'string' || !allowed.test(data.path)) {
    return new Response(JSON.stringify({ error: 'Chemin non autorisé.' }), { status: 400 });
  }
  if (!['POST', 'PUT', 'DELETE'].includes(data.method)) {
    return new Response(JSON.stringify({ error: 'Méthode non autorisée.' }), { status: 400 });
  }

  const apiRes = await createAdminApiClient(Astro.locals).fetch(`http://localhost${data.path}`, {
    method: data.method,
    headers: { 'Content-Type': 'application/json' },
    ...(data.payload ? { body: JSON.stringify(data.payload) } : {})
  });

  if (!apiRes.ok) return new Response(await apiRes.text(), { status: apiRes.status });
  return new Response(JSON.stringify(await apiRes.json()), {
    headers: { 'Content-Type': 'application/json' }
  });
}
---

<Layout title="Menus du site (essai) - NBA 91">
  <div class="mx-auto max-w-5xl px-4 py-8 space-y-6">
    <div>
      <p class="text-sm font-semibold text-foreground">Menus du site — essai sans rendu serveur</p>
      <p class="text-xs text-muted-foreground">
        Page de mesure : le serveur n’émet qu’une coquille, tout est monté par le navigateur.
        L’habillage de l’administration est volontairement absent.
      </p>
    </div>
    <MenusPoc client:only="svelte" />
  </div>
</Layout>
