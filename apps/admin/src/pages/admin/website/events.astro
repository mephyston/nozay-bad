---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { PageHeader } from '@nba/ui';
import EventsScreen from '../../../components/EventsScreen.svelte';

/*
  Page figée : elle n'est plus rendue par un worker, mais servie depuis les actifs.
  Elle ne porte donc aucune donnée, aucune identité et aucun paramètre d'URL — l'îlot
  demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Agenda - NBA 91">
  <AdminLayout
    client:idle
    breadcrumb="Agenda"
  >
    <div class="space-y-6">
      <PageHeader
        title="Agenda"
        description="Compétitions, stages et animations. Chaque événement publié devient une fiche indexable, là où l'agenda Google intégré restait invisible."
      />

      <EventsScreen client:load />
    </div>
  </AdminLayout>
</Layout>
