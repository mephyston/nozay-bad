---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { PageHeader, ErrorAlert } from '@nba/ui';
import { EventsManager } from '@nba/events-ui';
import { createAdminApiClient } from '../../../lib/api';
import { can, guardAction } from '../../../lib/guard';

const canWrite = can(Astro.locals, 'events:events:write');
const canDelete = can(Astro.locals, 'events:events:delete');
const apiService = createAdminApiClient(Astro.locals);

const ACTIONS = {
  create: 'events:events:write',
  update: 'events:events:write',
  delete: 'events:events:delete'
} as const;

if (Astro.request.method === 'POST') {
  const data = (await Astro.request.json()) as any;
  const denied = guardAction(Astro.locals, data.action, ACTIONS);
  if (denied) return denied;

  const routes: Record<string, { url: string; method: string; body?: unknown }> = {
    create: {
      url: 'http://localhost/events',
      method: 'POST',
      body: { title: data.title, startsAt: data.startsAt, category: data.category, venueLabel: data.venueLabel }
    },
    update: { url: `http://localhost/events/${data.id}`, method: 'PUT', body: { status: data.status } },
    delete: { url: `http://localhost/events/${data.id}`, method: 'DELETE' }
  };
  const route = routes[data.action];
  const apiRes = await apiService.fetch(route.url, {
    method: route.method,
    headers: { 'Content-Type': 'application/json' },
    ...(route.body ? { body: JSON.stringify(route.body) } : {})
  });
  if (!apiRes.ok) return new Response(await apiRes.text(), { status: apiRes.status });
  return new Response(JSON.stringify(await apiRes.json()), { headers: { 'Content-Type': 'application/json' } });
}

let events: any[] = [];
let errorMsg = '';

try {
  // `past=1` : l'administration voit aussi l'historique, contrairement au site.
  const res = await apiService.fetch('http://localhost/events?past=1&limit=100');
  if (res.ok) events = ((await res.json()) as any).data ?? [];
  else errorMsg = "Impossible de charger l'agenda.";
} catch {
  errorMsg = "Impossible de charger l'agenda.";
}
---

<Layout title="Agenda - NBA 91">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || ''}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Agenda"
  >
    <PageHeader
      title="Agenda"
      description="Compétitions, stages et animations. Chaque événement publié devient une fiche indexable, là où l'agenda Google intégré restait invisible."
    />
    {errorMsg && <ErrorAlert message={errorMsg} />}
    <EventsManager client:load events={events} canWrite={canWrite} canDelete={canDelete} />
  </AdminLayout>
</Layout>
