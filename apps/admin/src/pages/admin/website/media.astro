---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { PageHeader } from '@nba/ui';
import MediaScreen from '../../../components/MediaScreen.svelte';

/*
  Page figée : elle n'est plus rendue par un worker, mais servie depuis les actifs.
  Elle ne porte donc aucune donnée, aucune identité et aucun paramètre d'URL — l'îlot
  demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Médiathèque - NBA 91">
  <AdminLayout
    client:idle
    breadcrumb="Médiathèque"
  >
    <div class="space-y-6">

      <PageHeader
        title="Médiathèque"
        description="Images et documents du site public. Les fichiers déposés ici sont réutilisables dans toutes les pages."
      />

      <MediaScreen client:load />
    </div>
  </AdminLayout>
</Layout>
