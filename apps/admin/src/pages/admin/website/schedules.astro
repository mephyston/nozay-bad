---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { PageHeader } from '@nba/ui';
import SchedulesScreen from '../../../components/SchedulesScreen.svelte';

/*
  Page figée.

  Le worker reste **invoqué** — l'adaptateur d'Astro sert les actifs lui-même, par
  `env.ASSETS.fetch` — mais il ne rend plus rien : il transmet un fichier. Ce que le
  prerender supprime est le rendu, pas l'invocation.

  Corollaire : la page ne porte aucune donnée, aucune identité et aucun paramètre d'URL.
  L'îlot demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Créneaux">
  <AdminLayout
    client:idle
    breadcrumb="Créneaux"
  >
    <div class="space-y-6">
      <PageHeader
        title="Créneaux"
        description="Ces créneaux alimentent la page publique : ils remplacent la feuille Google que les moteurs de recherche ne voyaient pas. Ils valent d'une saison à l'autre — ce qui ne se tient plus se désactive."
      />

      <SchedulesScreen client:load />
    </div>
  </AdminLayout>
</Layout>
