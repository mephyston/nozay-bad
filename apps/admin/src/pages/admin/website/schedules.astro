---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { PageHeader } from '@nba/ui';
import SchedulesScreen from '../../../components/SchedulesScreen.svelte';

/*
  Page figée : elle n'est plus rendue par un worker, mais servie depuis les actifs.
  Elle ne porte donc aucune donnée, aucune identité et aucun paramètre d'URL — l'îlot
  demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Créneaux - NBA 91">
  <AdminLayout
    client:idle
    breadcrumb="Créneaux"
  >
    <div class="space-y-6">
      <PageHeader
        title="Créneaux"
        description="Ces créneaux alimentent la page publique : ils remplacent la feuille Google que les moteurs de recherche ne voyaient pas. Ils valent d'une saison à l'autre — ce qui ne se tient plus se désactive."
      />

      <SchedulesScreen client:load />
    </div>
  </AdminLayout>
</Layout>
