---
import Layout from '../../../../layouts/Layout.astro';
import AdminLayout from '../../../../components/AdminLayout.svelte';
import { PageHeader } from '@nba/ui';
import OpenPlayOpenersScreen from '../../../../components/OpenPlayOpenersScreen.svelte';
import { resolveEnv } from '@nba/runtime-env';

/**
 * Les détenteurs de clé, sur leur propre page.
 *
 * Séparés des séances, parce qu'ils ne se tiennent pas au même rythme : on ouvre des
 * séances toutes les semaines, on confie une clé une fois l'an.
 */

/*
  Page figée.

  Le worker reste **invoqué** — l'adaptateur d'Astro sert les actifs lui-même, par
  `env.ASSETS.fetch` — mais il ne rend plus rien : il transmet un fichier. Ce que le
  prerender supprime est le rendu, pas l'invocation.

  Corollaire : la page ne porte aucune donnée, aucune identité et aucun paramètre d'URL.
  L'îlot demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Ouvreurs - NBA 91">
  <AdminLayout
    client:idle
    breadcrumb="Ouvreurs"
  >
    <div class="space-y-6">
      <PageHeader
        title="Ouvreurs"
        description="Les adhérents à qui le club confie une clé de gymnase. Eux seuls peuvent confirmer une séance de jeu libre depuis leur espace — sans eux, aucune séance ne s'ouvre."
      />

      <OpenPlayOpenersScreen client:load />
    </div>
  </AdminLayout>
</Layout>
