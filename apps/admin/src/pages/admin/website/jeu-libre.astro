---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { PageHeader } from '@nba/ui';
import OpenPlayScreen from '../../../components/OpenPlayScreen.svelte';
import { resolveEnv } from '@nba/runtime-env';

/**
 * Les séances de jeu libre, tenues par le bureau.
 *
 * Remplace le Google Sheet : ici on ouvre des séances datées, on lit qui vient — invités
 * compris — et on annule avec un motif que l'adhérent inscrit pourra lire.
 *
 * Le réglage « jeu libre » du club ne se lit pas ici : c'est l'API qui le porte, et le
 * relais traduit son 404 en message. L'espace adhérent garde le sien, parce que lui
 * annonce la fonctionnalité à des adhérents.
 */

/*
  Page figée.

  Le worker reste **invoqué** — l'adaptateur d'Astro sert les actifs lui-même, par
  `env.ASSETS.fetch` — mais il ne rend plus rien : il transmet un fichier. Ce que le
  prerender supprime est le rendu, pas l'invocation.

  Corollaire : la page ne porte aucune donnée, aucune identité et aucun paramètre d'URL.
  L'îlot demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Jeu libre">
  <AdminLayout
    client:idle
    breadcrumb="Jeu libre"
  >
    <div class="space-y-6">
      <PageHeader
        title="Jeu libre"
        description="Les séances datées auxquelles les adhérents s'inscrivent depuis leur espace, avec les invités qu'ils annoncent. Remplace le tableur partagé, où personne ne savait qui s'était réellement inscrit."
      />

      <OpenPlayScreen client:load />
    </div>
  </AdminLayout>
</Layout>
