---
import Layout from '../../../../layouts/Layout.astro';
import AdminLayout from '../../../../components/AdminLayout.svelte';
import { PageHeader } from '@nba/ui';
import RedirectsScreen from '../../../../components/RedirectsScreen.svelte';

/*
  Page figée : elle n'est plus rendue par un worker, mais servie depuis les actifs.
  Elle ne porte donc aucune donnée, aucune identité et aucun paramètre d'URL — l'îlot
  demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Redirections - NBA 91">
  <AdminLayout
    client:idle
    breadcrumb="Redirections"
  >
    <div class="space-y-6">

      <PageHeader
        title="Redirections"
        description="Les anciennes adresses du site et leur destination. Une adresse sans cible répond « page supprimée » (410) : les moteurs la retirent de leur index. Le compteur dit si une adresse sert encore."
      />

      <RedirectsScreen client:load />
    </div>
  </AdminLayout>
</Layout>
