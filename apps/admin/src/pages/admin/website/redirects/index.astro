---
import Layout from '../../../../layouts/Layout.astro';
import AdminLayout from '../../../../components/AdminLayout.svelte';
import { PageHeader } from '@nba/ui';
import RedirectsScreen from '../../../../components/RedirectsScreen.svelte';

/*
  Page figée.

  Le worker reste **invoqué** — l'adaptateur d'Astro sert les actifs lui-même, par
  `env.ASSETS.fetch` — mais il ne rend plus rien : il transmet un fichier. Ce que le
  prerender supprime est le rendu, pas l'invocation.

  Corollaire : la page ne porte aucune donnée, aucune identité et aucun paramètre d'URL.
  L'îlot demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Redirections">
  <AdminLayout
    client:idle
    breadcrumb="Redirections"
  >
    <div class="space-y-6">

      <PageHeader
        title="Redirections"
        description="Les anciennes adresses du site et leur destination. Une adresse sans cible répond « page supprimée » (410) : les moteurs la retirent de leur index. Le compteur dit si une adresse sert encore."
      />

      <RedirectsScreen client:load />
    </div>
  </AdminLayout>
</Layout>
