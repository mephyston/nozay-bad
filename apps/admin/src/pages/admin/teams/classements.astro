---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import RankingsScreen from '../../../components/RankingsScreen.svelte';

// L'import vit sur `/admin/teams/classements/import`, avec sa propre garde.
const season = Astro.url.searchParams.get('season') ?? '';
const eloDate = Astro.url.searchParams.get('eloDate') ?? '';
---

<Layout title="Classements - NBA 91">
  <AdminLayout
    client:idle
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    email={Astro.locals.user?.email}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Classements"
  >
    <div class="space-y-6">
      <RankingsScreen client:load {season} {eloDate} />
    </div>
  </AdminLayout>
</Layout>
