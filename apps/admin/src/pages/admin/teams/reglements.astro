---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import ChampionshipRulesScreen from '../../../components/ChampionshipRulesScreen.svelte';

const season = Astro.url.searchParams.get('season') ?? '';
---

<Layout title="Règlements - NBA 91">
  <AdminLayout
    client:idle
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    email={Astro.locals.user?.email}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Règlements"
  >
    <div class="space-y-6">
      <ChampionshipRulesScreen client:load {season} />
    </div>
  </AdminLayout>
</Layout>
