---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import TeamsScreen from '../../../components/TeamsScreen.svelte';

/**
 * Les équipes engagées, en coquille.
 *
 * Saison et championnat viennent de l'URL et sont passés à l'îlot, qui les transmet au
 * relais `/admin/api/teams/teams`. Les lire ici ne coûte rien — c'est une chaîne de
 * requête, pas un appel — et garde l'URL comme seule source de vérité : le sélecteur de
 * saison navigue, et l'îlot est remonté avec la nouvelle valeur.
 */

/*
  Page figée.

  Le worker reste **invoqué** — l'adaptateur d'Astro sert les actifs lui-même, par
  `env.ASSETS.fetch` — mais il ne rend plus rien : il transmet un fichier. Ce que le
  prerender supprime est le rendu, pas l'invocation.

  Corollaire : la page ne porte aucune donnée, aucune identité et aucun paramètre d'URL.
  L'îlot demande les siennes au relais, et lit l'URL dans le navigateur.
*/
export const prerender = true;
---

<Layout title="Équipes - NBA 91">
  <AdminLayout
    client:idle
    breadcrumb="Équipes"
  >
    <div class="space-y-6">
      <TeamsScreen client:load />
    </div>
  </AdminLayout>
</Layout>
