---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import TeamsScreen from '../../../components/TeamsScreen.svelte';

/**
 * Les équipes engagées, en coquille.
 *
 * Saison et championnat viennent de l'URL et sont passés à l'îlot, qui les transmet au
 * relais `/admin/api/teams/teams`. Les lire ici ne coûte rien — c'est une chaîne de
 * requête, pas un appel — et garde l'URL comme seule source de vérité : le sélecteur de
 * saison navigue, et l'îlot est remonté avec la nouvelle valeur.
 */
const season = Astro.url.searchParams.get('season') ?? '';
const championship = Astro.url.searchParams.get('championship') ?? '';
---

<Layout title="Équipes - NBA 91">
  <AdminLayout
    client:idle
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    email={Astro.locals.user?.email}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Équipes"
  >
    <div class="space-y-6">
      <TeamsScreen client:load {season} {championship} />
    </div>
  </AdminLayout>
</Layout>
