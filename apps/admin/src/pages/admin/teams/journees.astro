---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import DayValuesScreen from '../../../components/DayValuesScreen.svelte';

const season = Astro.url.searchParams.get('season') ?? '';
const championship = Astro.url.searchParams.get('championship') ?? '';
const day = Astro.url.searchParams.get('day') ?? '';
---

<Layout title="Contrôle des journées - NBA 91">
  <AdminLayout
    client:idle
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    email={Astro.locals.user?.email}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Contrôle des journées"
  >
    <div class="space-y-6">
      <DayValuesScreen client:load {season} {championship} {day} />
    </div>
  </AdminLayout>
</Layout>
