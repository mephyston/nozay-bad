---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import ShopProductsScreen from '../../../components/ShopProductsScreen.svelte';
---

<Layout title="Gestion des Produits - NBA 91">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || ''}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Boutique / Produits"
  >
    <div class="space-y-6">
      <ShopProductsScreen client:load />
    </div>
  </AdminLayout>
</Layout>
