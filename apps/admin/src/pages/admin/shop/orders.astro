---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import { PageHeader, ErrorAlert, Badge } from '@nba/ui';
import { OrdersManager } from '@nba/shop-ui';

import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';

import { hasPermission } from '@nba/iam';
const userPerms = Astro.locals.user?.permissions || [];
if (!hasPermission(userPerms, '*') && !hasPermission(userPerms, 'shop:*') && !hasPermission(userPerms, 'orders:*') && !hasPermission(userPerms, 'orders:read') && !hasPermission(userPerms, 'orders:create') && !hasPermission(userPerms, 'orders:validate')) {
  return Astro.redirect('/');
}

const userEmail = Astro.locals.user?.email || "admin@nozaybad.fr";
const apiService = createApiClient(env);

const season = Astro.url.searchParams.get('season') || '25-26';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.json() as any;
    
    const canValidate = hasPermission(userPerms, '*') || hasPermission(userPerms, 'shop:*') || hasPermission(userPerms, 'orders:*') || hasPermission(userPerms, 'orders:validate');
    const canCreate = hasPermission(userPerms, '*') || hasPermission(userPerms, 'shop:*') || hasPermission(userPerms, 'orders:*') || hasPermission(userPerms, 'orders:create');
    const canUpdate = hasPermission(userPerms, '*') || hasPermission(userPerms, 'shop:*') || hasPermission(userPerms, 'orders:*') || hasPermission(userPerms, 'orders:update');

    if (['approve', 'reject'].includes(data.action) && !canValidate) {
      return new Response("Accès refusé. Droits de validation requis.", { status: 403 });
    }
    
    if (data.action === 'update' && !canUpdate) {
      return new Response("Accès refusé. Droits de modification requis.", { status: 403 });
    }

    if (data.productId && data.quantity && !canCreate) {
      return new Response("Accès refusé. Droits de création requis.", { status: 403 });
    }

    if (data.action === 'approve') {
      const apiRes = await apiService.fetch(`http://localhost/shop/orders/${data.id}/approve`, {
        method: 'POST'
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
      return new Response(JSON.stringify(await apiRes.json()));
    } else if (data.action === 'reject') {
      const apiRes = await apiService.fetch(`http://localhost/shop/orders/${data.id}/reject`, {
        method: 'POST'
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
      return new Response(JSON.stringify(await apiRes.json()));
    } else if (data.productId && data.quantity) {
      const apiRes = await apiService.fetch('http://localhost/shop/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (!apiRes.ok) {
        return new Response(JSON.stringify({ success: false, error: await apiRes.text() }), { status: 400 });
      }
      return new Response(JSON.stringify({ success: true }));
    }
    return new Response('Action inconnue', { status: 400 });
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let ordersList = [];
let seasonsList = [];
let productsList = [];
let membersList = [];
let errorMsg = '';

try {
  const [seasonsRes, ordersRes, productsRes, membersRes] = await Promise.all([
    apiService.fetch('http://localhost/accounting/seasons'),
    apiService.fetch(`http://localhost/shop/orders?season=${season}`),
    apiService.fetch('http://localhost/shop/products?active=true'),
    apiService.fetch(`http://localhost/members?limit=1000&season=${season}`)
  ]);

  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasonsList = json.data || [];
  } else {
    errorMsg = 'Impossible de charger la liste des saisons.';
  }

  if (ordersRes.ok) {
    const json = await ordersRes.json() as any;
    ordersList = json.data || [];
  } else {
    errorMsg = 'Impossible de charger la liste des commandes.';
  }

  if (productsRes.ok) {
    const json = await productsRes.json() as any;
    productsList = json.data || [];
  }

  if (membersRes.ok) {
    const json = await membersRes.json() as any;
    membersList = json.data || [];
  }
} catch (err: any) {
  errorMsg = 'Une erreur est survenue lors de la récupération des données de la boutique.';
}

let displaySeasonName = season;
if (seasonsList.length > 0) {
  const currentSeason = seasonsList.find((s: any) => s.id === season || s.code === season);
  if (currentSeason && currentSeason.name) {
    displaySeasonName = currentSeason.name.replace('Saison ', '');
  }
}

const isClosed = !!seasonsList.find((s: any) => s.id === season)?.closed;
---

<Layout title="Validation des Commandes - NBA 91">
  <AdminLayout name={Astro.locals.user?.name} client:idle email={userEmail} breadcrumb="Boutique / Commandes" permissions={Astro.locals.user?.permissions || []}>
    <div class="space-y-6">
      {errorMsg && <ErrorAlert message={errorMsg} />}

      <PageHeader
        title="Commandes Boutique"
        description={`Validez ou refusez les demandes d'achats boutique des adhérents et consultez l'historique pour la saison ${displaySeasonName}.`}
        class="print:hidden"
      >
        <Fragment slot="actions">
          {isClosed && <Badge variant="outline" size="lg">Saison clôturée (Lecture seule)</Badge>}
        </Fragment>
      </PageHeader>

      <OrdersManager
        client:load
        seasons={seasonsList}
        orders={ordersList}
        products={productsList}
        members={membersList}
        seasonId={season}
        initialAction={Astro.url.searchParams.get('action')}
      />
    </div>
  </AdminLayout>
</Layout>
