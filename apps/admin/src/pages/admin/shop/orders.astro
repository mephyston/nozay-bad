---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.astro';
import { OrdersManager } from '@nba/shop-ui';

import { env } from 'cloudflare:workers';
import { createApiClient } from '@nba/api-client';

const userEmail = Astro.locals.user?.email || "admin@nozay-bad.fr";
const apiService = createApiClient(env);

const season = Astro.url.searchParams.get('season') || '25-26';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.json() as any;
    if (data.action === 'approve') {
      const apiRes = await apiService.fetch(`http://localhost/shop/orders/${data.id}/approve`, {
        method: 'POST'
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
      return new Response(JSON.stringify(await apiRes.json()));
    } else if (data.action === 'reject') {
      const apiRes = await apiService.fetch(`http://localhost/shop/orders/${data.id}/reject`, {
        method: 'POST'
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
      return new Response(JSON.stringify(await apiRes.json()));
    }
    return new Response('Action inconnue', { status: 400 });
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let ordersList = [];
let seasonsList = [];
let errorMsg = '';

try {
  const [seasonsRes, ordersRes] = await Promise.all([
    apiService.fetch('http://localhost/accounting/seasons'),
    apiService.fetch(`http://localhost/shop/orders?season=${season}`)
  ]);

  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasonsList = json.data || [];
  } else {
    errorMsg = 'Impossible de charger la liste des saisons.';
  }

  if (ordersRes.ok) {
    const json = await ordersRes.json() as any;
    ordersList = json.data || [];
  } else {
    errorMsg = 'Impossible de charger la liste des commandes.';
  }
} catch (err: any) {
  errorMsg = 'Une erreur est survenue lors de la récupération des données de la boutique.';
}

const isClosed = !!seasonsList.find((s: any) => s.id === season)?.closed;
---

<Layout title="Commandes Boutique - NBA 91">
  <AdminLayout email={userEmail} breadcrumb="Boutique / Commandes">
    <div class="space-y-6">
      {errorMsg && (
        <div class="p-4 bg-destructive/15 border border-destructive text-destructive rounded-lg">
          {errorMsg}
        </div>
      )}

      <div class="flex items-center justify-between print:hidden">
        <div>
          <h1 class="text-3xl font-bold tracking-tight">Commandes Boutique</h1>
          <p class="text-muted-foreground mt-2">
            Validez ou refusez les demandes d'achats boutique des adhérents et consultez l'historique.
          </p>
        </div>
        <div class="flex items-center gap-3">
          {isClosed && (
            <span class="px-2.5 py-1 text-xs font-bold rounded bg-muted border border-border text-muted-foreground">
              Saison clôturée (Lecture seule)
            </span>
          )}
          <select
            id="season-selector"
            class="px-3 py-1.5 border border-border bg-background rounded-md text-xs font-semibold focus:outline-none focus:ring-1 focus:ring-primary cursor-pointer h-9"
          >
            {seasonsList.map((s: any) => (
              <option value={s.id} selected={s.id === season}>{s.name}</option>
            ))}
          </select>
        </div>
      </div>

      <OrdersManager
        client:load
        seasons={seasonsList}
        orders={ordersList}
        seasonId={season}
      />
    </div>
  </AdminLayout>
  <script>
    const selector = document.getElementById('season-selector');
    if (selector) {
      selector.addEventListener('change', (e) => {
        const newSeason = (e.target as HTMLSelectElement).value;
        const params = new URLSearchParams(window.location.search);
        params.set('season', newSeason);
        window.location.href = `/admin/shop/orders?${params.toString()}`;
      });
    }
  </script>
</Layout>
