---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import OrdersScreen from '../../../components/OrdersScreen.svelte';

const parametres = Object.fromEntries(Astro.url.searchParams);
const initialAction = Astro.url.searchParams.get('action');
---

<Layout title="Validation des Commandes - NBA 91">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || ''}
    permissions={Astro.locals.user?.permissions || []}
    breadcrumb="Boutique / Commandes"
  >
    <div class="space-y-6">
      <OrdersScreen client:load {parametres} {initialAction} />
    </div>
  </AdminLayout>
</Layout>
