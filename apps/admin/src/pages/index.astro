---
import Layout from '../layouts/Layout.astro';
import AdminLayout from '../components/AdminLayout.svelte';
import { env } from 'cloudflare:workers';
import {
  resolveActiveSeason,
  fetchTreasuryBalance,
  formatTreasuryBalance,
  fetchMembersCount,
  calculatePaidPercentage,
  formatPaidPercentage
} from '../utils/dashboard';

const userEmail = Astro.locals.user?.email || "admin@nozay-bad.fr";
const apiService = env.API_SERVICE;

// Fetch data in SSR
const activeSeasonId = await resolveActiveSeason(apiService);

const [balanceCents, paidCount, totalCount] = await Promise.all([
  fetchTreasuryBalance(apiService, activeSeasonId),
  fetchMembersCount(apiService, activeSeasonId, true),
  fetchMembersCount(apiService, activeSeasonId)
]);

const formattedBalance = formatTreasuryBalance(balanceCents);
const paidPercentage = calculatePaidPercentage(paidCount, totalCount);
const formattedPaidPercentage = formatPaidPercentage(paidPercentage);

const formattedMembersCount = (paidCount !== null && totalCount !== null)
  ? `${paidCount} / ${totalCount}`
  : '--';
---

<Layout title="NBA 91 - Console Admin">
  <AdminLayout client:idle email={userEmail} breadcrumb="Tableau de Bord">
    <div class="space-y-6">
      <div>
        <h2 class="text-2xl font-bold tracking-tight">Bonjour, Trésorier NBA 91</h2>
        <p class="text-muted-foreground">Voici l'état récapitulatif de vos outils d'administration pour la saison {activeSeasonId}.</p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        <!-- Carte 1 -->
        <div class="rounded-xl border border-border bg-card text-card-foreground p-6 shadow-sm">
          <div class="flex flex-row items-center justify-between space-y-0 pb-2">
            <h3 class="text-sm font-medium tracking-tight">Trésorerie</h3>
          </div>
          <div class="text-2xl font-bold">{formattedBalance}</div>
          <p class="text-xs text-muted-foreground">Solde comptable actif</p>
        </div>
        <!-- Carte 2 -->
        <div class="rounded-xl border border-border bg-card text-card-foreground p-6 shadow-sm">
          <div class="flex flex-row items-center justify-between space-y-0 pb-2">
            <h3 class="text-sm font-medium tracking-tight">Adhérents Poona</h3>
          </div>
          <div class="text-2xl font-bold">{formattedMembersCount}</div>
          <p class="text-xs text-muted-foreground">{formattedPaidPercentage}</p>
        </div>
      </div>
    </div>
  </AdminLayout>
</Layout>

