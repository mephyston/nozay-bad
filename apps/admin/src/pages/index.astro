---
import Layout from '../layouts/Layout.astro';
import AdminLayout from '../components/AdminLayout.svelte';
import DashboardScreen from '../components/DashboardScreen.svelte';

const parametres = Object.fromEntries(Astro.url.searchParams);
const permissions = Astro.locals.user?.permissions || [];
---

<Layout title="NBA 91 - Console Admin">
  <AdminLayout
    realEmail={Astro.locals.realUser?.email || ''}
    name={Astro.locals.user?.name}
    client:idle
    email={Astro.locals.user?.email || ''}
    {permissions}
    breadcrumb="Tableau de Bord"
  >
    <div class="space-y-6">
      <DashboardScreen client:load {parametres} {permissions} />
    </div>
  </AdminLayout>
</Layout>
