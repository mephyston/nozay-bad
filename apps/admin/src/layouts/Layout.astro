---
import { ClientRouter } from 'astro:transitions';
import { pwaInfo } from 'virtual:pwa-info';
import { ModeWatcher } from 'mode-watcher';
import pkg from '../../../../package.json';
import { EnvBanner } from '@nba/ui';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
// Suffixe d'icône selon l'environnement (inliné au build) : bandeau DEV / TEST.
const APP_ENV = import.meta.env.PUBLIC_APP_ENV || 'production';
const ICON_SUFFIX = APP_ENV === 'development' ? '-dev' : APP_ENV === 'staging' ? '-test' : '';
---

<!doctype html>
<html lang="fr" style="font-size: 17px;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet" />
    <link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon${ICON_SUFFIX}.png`} />
    <meta name="apple-mobile-web-app-title" content="Nozay Bad" />
    { pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} /> }
    <title>{title}</title>
    <ClientRouter />
    <script>
      import { registerSW } from 'virtual:pwa-register'
      if (typeof window !== 'undefined' && 'serviceWorker' in navigator) {
        const updateSW = registerSW({
          onNeedRefresh() {
            if (confirm('Nouvelle version disponible. Mettre à jour ?')) {
              updateSW(true)
            }
          }
        });
      }
    </script>
    <script is:inline>
      (function() {
        try {
          let theme = 'light';
          if (typeof localStorage !== 'undefined') {
            let rawMode = localStorage.getItem('mode-watcher-mode') || localStorage.getItem('mode-watcher-user-preference');
            if (rawMode) {
              theme = rawMode.replace(/"/g, '').trim();
              if (rawMode !== theme) {
                localStorage.setItem('mode-watcher-mode', theme);
                localStorage.setItem('mode-watcher-user-preference', theme);
              }
            } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
              theme = 'dark';
            }
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
          }
          
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.style.colorScheme = 'dark';
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.style.colorScheme = 'light';
          }
        } catch (e) {}
      })();
    </script>
    <style is:inline>
      html.dark {
        background-color: rgb(38, 38, 36) !important;
        color: rgb(241, 241, 239);
        --background: rgb(38, 38, 36);
        --foreground: rgb(241, 241, 239);
        --sidebar: rgb(31, 30, 29);
        --sidebar-foreground: rgb(195, 192, 182);
        --card: rgb(44, 44, 43);
        --card-foreground: rgb(250, 249, 245);
        --popover: rgb(48, 48, 46);
        --popover-foreground: rgb(229, 229, 226);
        --muted: rgb(27, 27, 25);
        --muted-foreground: rgb(183, 181, 169);
        --accent: rgb(26, 25, 21);
        --border: rgb(62, 62, 56);
      }
      html:not(.dark) {
        background-color: rgb(250, 249, 245);
        color: rgb(61, 57, 41);
        --background: rgb(250, 249, 245);
        --foreground: rgb(61, 57, 41);
        --sidebar: rgb(245, 244, 238);
        --sidebar-foreground: rgb(61, 61, 58);
        --card: rgb(245, 244, 239);
        --card-foreground: rgb(20, 20, 19);
        --popover: rgb(255, 255, 255);
        --popover-foreground: rgb(40, 38, 27);
        --muted: rgb(237, 233, 222);
        --muted-foreground: rgb(110, 109, 104);
        --accent: rgb(233, 230, 220);
        --border: rgb(218, 217, 212);
      }
    </style>
  </head>
  <body class="bg-background text-foreground min-h-screen antialiased font-sans relative">
    <EnvBanner />
    <ModeWatcher client:load />
    
    <!-- PWA Splash Screen -->
    <div id="pwa-splash" class="fixed inset-0 z-[9999] bg-background flex flex-col items-center justify-center transition-opacity duration-500">
      <div class="relative z-10 flex flex-col items-center gap-6">
        <img src="/logo.png" alt="Logo Nozay Bad" class="w-80 h-80 animate-pulse object-contain" />
      </div>  
        <div class="absolute -bottom-8 left-1/2 -translate-x-1/2 flex gap-1.5">
          <span class="w-2 h-2 rounded-full bg-primary animate-bounce" style="animation-delay: -0.3s"></span>
          <span class="w-2 h-2 rounded-full bg-primary animate-bounce" style="animation-delay: -0.15s"></span>
          <span class="w-2 h-2 rounded-full bg-primary animate-bounce" style="animation-delay: 0s"></span>
        </div>
      <p class="mt-12 text-xs text-muted-foreground/60 font-medium tracking-widest uppercase">v{pkg.version}</p>
      <div class="mt-8 flex flex-col items-center gap-4 relative z-10 w-full px-6">
        <button onclick="document.getElementById('pwa-splash').style.opacity = '0'; setTimeout(() => document.getElementById('pwa-splash').remove(), 500)" class="w-full max-w-[200px] px-6 py-3 bg-primary text-primary-foreground rounded-xl text-sm font-semibold hover:bg-primary/90 transition-colors shadow-md">
          Continuer
        </button>
        <a href="/changelog" class="text-sm text-muted-foreground hover:text-foreground underline underline-offset-4 transition-colors">
          Voir les nouveautés
        </a>
      </div>
    </div>

    <script is:inline>
      (function() {
        const isPWA = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;
        const splash = document.getElementById('pwa-splash');

        // Le splash ne doit apparaître qu'au démarrage à froid de la PWA (nouvelle
        // session). Les rechargements plein-écran internes (ex: changement de saison
        // via window.location dans SeasonSelector) ne doivent PAS le réafficher.
        // sessionStorage persiste tant que la PWA tourne et se vide à sa fermeture.
        let alreadyShown = false;
        try { alreadyShown = sessionStorage.getItem('pwa-splash-shown') === '1'; } catch (e) {}

        if (!isPWA || alreadyShown) {
          if (splash) splash.style.display = 'none';
        } else {
          // Premier affichage de la session : il reste visible jusqu'au clic sur Continuer.
          try { sessionStorage.setItem('pwa-splash-shown', '1'); } catch (e) {}
        }

        // Cache instantanément le splash screen lors d'une navigation interne (Astro ViewTransitions)
        document.addEventListener('astro:after-swap', () => {
          const newSplash = document.getElementById('pwa-splash');
          if (newSplash) {
            newSplash.style.display = 'none';
          }
        });
      })();
    </script>

    <slot />
  </body>
</html>
