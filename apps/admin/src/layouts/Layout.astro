---
import { ModeWatcher } from 'mode-watcher';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      (function() {
        try {
          let theme = 'light';
          if (typeof localStorage !== 'undefined') {
            const storedMode = localStorage.getItem('mode-watcher-mode') || localStorage.getItem('mode-watcher-user-preference');
            if (storedMode) {
              theme = storedMode.replace(/"/g, '').trim();
            } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
              theme = 'dark';
            }
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            theme = 'dark';
          }
          
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
          document.documentElement.style.colorScheme = theme;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-background text-foreground transition-colors duration-200">
    <ModeWatcher client:load />
    <slot />
  </body>
</html>
