{
  "name": "nba-admin-console",
  "main": "./dist/server/entry.mjs",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "API_SERVICE", "service": "nba-api" }
  ],
  "vars": {
    "INTERNAL_API_KEY": "dev-secret-key-12345"
  }
}
