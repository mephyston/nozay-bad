{
  "name": "nba-buvette",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true }
  },
  "kv_namespaces": [{ "binding": "RATE_LIMIT_KV", "id": "281c9992dd914501a709ef8f03fe2ab8" }],
  "routes": [{ "pattern": "buvette.nozaybad.fr", "custom_domain": true }],
  "vars": {
    "EMAIL_FROM": "Nozay Badminton Association <noreply@nozaybad.fr>",
    "EMAIL_MODE": "live",
    "EMAIL_ALLOWLIST": ""
  },
  "services": [{ "binding": "API_SERVICE", "service": "nba-api" }],
  "env": {
    "staging": {
      "name": "nba-buvette-staging",
      "routes": [{ "pattern": "staging-buvette.nozaybad.fr", "custom_domain": true }],
      "vars": {
        "EMAIL_FROM": "Nozay Badminton Association <noreply@nozaybad.fr>",
        "EMAIL_MODE": "live",
        "EMAIL_ALLOWLIST": ""
      },
      "kv_namespaces": [{ "binding": "RATE_LIMIT_KV", "id": "e1f0b19b7ea44399ba66d10fe7907ce9" }],
      "services": [{ "binding": "API_SERVICE", "service": "nba-api-staging" }]
    }
  }
}
