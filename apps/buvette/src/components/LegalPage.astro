---
import Layout from '../layouts/Layout.astro';
import { TERMS_DATE_LABEL } from '../lib/terms';

/** Le gabarit des pages légales : lisibles sans carte, depuis la page de connexion. */
interface Props {
  title: string;
}
const { title } = Astro.props;
const hasCard = Boolean(Astro.locals.card);
---

<Layout title={title} nav={hasCard}>
  <article class="space-y-6 text-sm leading-relaxed">
    <header>
      <h1 class="text-2xl font-semibold">{title}</h1>
      <p class="text-muted-foreground mt-1">Dernière mise à jour : {TERMS_DATE_LABEL}</p>
    </header>
    <slot />
    <footer class="text-muted-foreground flex flex-wrap gap-x-4 gap-y-1 border-t pt-4 text-xs">
      <a href="/mentions-legales" class="hover:underline">Mentions légales</a>
      <a href="/confidentialite" class="hover:underline">Confidentialité</a>
      <a href="/conditions" class="hover:underline">Conditions d'utilisation</a>
      <a href={hasCard ? '/' : '/connexion'} class="hover:underline">{hasCard ? 'Ma carte' : 'Retour à la connexion'}</a>
    </footer>
  </article>
</Layout>

<style>
  article :global(h2) {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  article :global(p),
  article :global(li) {
    color: var(--color-muted-foreground);
  }
  article :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  article :global(strong) {
    color: var(--color-foreground);
  }
</style>
