---
import { EnvBanner } from '@nba/ui';
import '@fontsource-variable/outfit';
import '../styles/global.css';

const { title } = Astro.props;
const club = Astro.locals.club?.settings;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{club?.shortName ? `${title} - ${club.shortName}` : title}</title>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" is:inline async defer></script>
  </head>
  <body class="bg-background text-foreground min-h-dvh">
    <EnvBanner />
    <slot />
  </body>
</html>
