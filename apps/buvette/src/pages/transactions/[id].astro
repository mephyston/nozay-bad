---
import Layout from '../../layouts/Layout.astro';
import { forCard } from '../../lib/card-api';
import { dateTime, euros, MOVEMENT_LABELS, signedEuros } from '../../lib/format';

const id = Astro.params.id ?? '';
if (!/^\d+$/.test(id)) return Astro.redirect('/');
const res = await forCard(Astro.locals, `movements/${id}`);
if (!res.ok) return Astro.redirect('/');
const movement = ((await res.json()) as any).data;
---

<Layout title="Transaction">
  <a href="/" class="text-muted-foreground flex min-h-11 items-center gap-1 text-sm no-underline">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
    Mes transactions
  </a>

  <section class="bg-card rounded-2xl border p-5 text-center">
    <h1 class="text-muted-foreground text-sm font-normal">{MOVEMENT_LABELS[movement.type]}</h1>
    <p class="text-4xl font-semibold tabular-nums">{signedEuros(movement.amountCents)}</p>
    <p class="text-muted-foreground mt-1 text-sm">{dateTime(movement.createdAt, Astro.locals.club?.settings.timezone)}</p>
  </section>

  {movement.lines.length > 0 && (
    <section class="space-y-2">
      <h2 class="font-semibold">Articles</h2>
      <ul class="bg-card divide-y rounded-2xl border">
        {movement.lines.map((line: any) => (
          <li class="flex justify-between gap-3 px-4 py-3 text-sm">
            <span>{line.quantity} × {line.name}</span>
            <span class="tabular-nums">{euros(line.quantity * line.unitPriceCents)}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {(movement.cashCents > 0 || movement.cardCents > 0) && (
    <p class="text-muted-foreground text-sm">
      Complété par {movement.cardCents > 0 ? `${euros(movement.cardCents)} en CB` : `${euros(movement.cashCents)} en espèces`}.
    </p>
  )}
</Layout>
