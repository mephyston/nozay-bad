{
  "name": "website",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/website/src",
  "implicitDependencies": [
    "@nba/runtime-env",
    "@nba/security-headers"
  ],
  "targets": {
    "lint": {
      "command": "eslint {projectRoot}"
    },
    /* Contrôle de types des fichiers .astro, que `tsc --noEmit` ne couvre pas : c'est lui
       qui attrape un import retiré alors qu'un appel subsiste — une page qui compile,
       passe les tests, et tombe en 500 au premier chargement. */
    "check": {
      "command": "astro check",
      "options": { "cwd": "{projectRoot}" },
      "cache": true,
      "inputs": ["default", "^default"]
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "inputs": [
        "production",
        "^production",
        {
          "env": "PUBLIC_APP_ENV"
        }
      ],
      "options": {
        "command": "astro build",
        "cwd": "apps/website"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "PUBLIC_APP_ENV=development astro dev --port 4323",
        "cwd": "apps/website"
      }
    }
  },
  "tags": [
    "type:app",
    "scope:website"
  ]
}
