---
import { normalisePath } from '@nba/cms/public';
import { verifyPreviewToken } from '@nba/preview';
import BaseLayout from '../layouts/BaseLayout.astro';
import BlockRenderer from '../components/blocks/BlockRenderer.astro';
import { resolvePublicRoute, loadMedia, mediaIdsInBlocks, listScheduleSlots } from '../lib/cms';
import { resolveEnv } from '../lib/request-context';
import { pageTitle, pageDescription, absoluteUrl } from '../lib/seo';
import { sportsClub, webPage, breadcrumbList, article, openingHours } from '../lib/jsonld';
import { HTML_CACHE_CONTROL } from '../lib/cache';

const env = resolveEnv(Astro.locals);
const siteUrl = env.SITE_URL ?? import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;

const path = normalisePath(Astro.url.pathname);

// Aperçu : le jeton porte le chemin et une échéance. Vérifié ici, dans le Worker du
// site — le domaine cms ne dépend pas de l'authentification.
const isPreview = await verifyPreviewToken(
  Astro.url.searchParams.get('preview'),
  path,
  env.PREVIEW_TOKEN_SECRET
);

const resolved = await resolvePublicRoute(env, path, isPreview);

// Redirections et 410 sortent avant tout rendu : ce sont les ~70 URL héritées de
// WordPress qui n'ont pas de contenu ici, et elles ne doivent rien coûter.
if (resolved.kind === 'redirect') {
  return Astro.redirect(resolved.toPath, resolved.statusCode as 301 | 302);
}

if (resolved.kind === 'gone') {
  // 410 plutôt que 404 : la page a existé et n'a pas de successeur. Google la sort de
  // son index bien plus vite ainsi.
  return new Response('Cette page a été supprimée.', {
    status: 410,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' }
  });
}

if (resolved.kind === 'notfound') return new Response(null, { status: 404 });

// Un aperçu n'est ni mis en cache ni indexé. Sans ces deux garde-fous, un lien partagé
// par erreur ferait entrer un brouillon dans l'index de Google *et* dans le cache
// partagé de Cloudflare, où il resterait visible de tous.
if (isPreview) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
} else {
  Astro.response.headers.set('Cache-Control', HTML_CACHE_CONTROL);
}

const post = resolved.kind === 'post' ? resolved.post : null;
const page = resolved.kind === 'page' ? resolved.page : null;
const blocks = resolved.kind === 'page' ? resolved.blocks : [];

// Les blocs ne portent que des identifiants : on résout les médias en une passe, pour
// disposer des dimensions et des variantes au moment du rendu.
const media = await loadMedia(env, mediaIdsInBlocks(blocks));

// Les créneaux ne sont chargés que si la page en affiche : une page de prose ne doit
// pas payer un aller-retour inutile.
const needsSchedule = blocks.some((block) => block.type === 'schedule');
const slots = needsSchedule ? await listScheduleSlots(env) : [];

const dateFormatter = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' });

// --- Vue « actualité » --------------------------------------------------------
const postPublished = post?.publishedAt ? new Date(post.publishedAt).toISOString() : null;
const postDescription = post
  ? (post.seoDescription ?? post.excerpt ?? `${post.title} — Nozay Badminton Association`)
  : '';
const postJsonLd = post
  ? [
      article(siteUrl, {
        title: post.title,
        description: postDescription,
        path: post.path,
        publishedAt: postPublished,
        updatedAt: post.updatedAt ? new Date(post.updatedAt).toISOString() : null,
        authorName: post.authorName
      }),
      breadcrumbList(siteUrl, [
        { name: 'Accueil', path: '/' },
        { name: 'Actualités', path: '/actualites/' },
        { name: post.title, path: post.path }
      ])
    ]
  : [];

// --- Vue « page » -------------------------------------------------------------
const pageDescriptionText = page ? pageDescription(page.seoDescription, blocks) : '';
const pageJsonLd: unknown[] = [];
if (page) {
  const trail = [{ name: 'Accueil', path: '/' }];
  if (page.path !== '/') trail.push({ name: page.title, path: page.path });
  pageJsonLd.push(webPage(siteUrl, { title: page.title, description: pageDescriptionText, path: page.path }));
  pageJsonLd.push(breadcrumbList(siteUrl, trail));
  if (page.path === '/') pageJsonLd.unshift(sportsClub(siteUrl));
  // Les horaires rendent la page « Créneaux » exploitable par une machine.
  if (slots.length > 0) {
    pageJsonLd.push({
      '@context': 'https://schema.org',
      '@type': 'SportsClub',
      name: 'Nozay Badminton Association',
      openingHoursSpecification: openingHours(slots)
    });
  }
}
---

{post && (
  <BaseLayout
    title={pageTitle(post.seoTitle, post.title)}
    description={postDescription}
    canonical={absoluteUrl(siteUrl, post.path)}
    ogType="article"
    noindex={isPreview}
    jsonLd={postJsonLd}
  >
    <article class="mx-auto max-w-3xl px-4 py-10">
      <h1 class="text-3xl font-semibold tracking-tight">{post.title}</h1>
      <p class="text-muted-foreground mt-2 text-sm">
        {postPublished && (
          <time datetime={postPublished}>{dateFormatter.format(new Date(postPublished))}</time>
        )}
        {postPublished && ' · '}
        {post.authorName}
      </p>
      {/* Le corps a été assaini à l'écriture avec le profil du site public : c'est
          l'API qui fait autorité, pas ce composant. */}
      <div class="prose prose-neutral dark:prose-invert mt-6 max-w-none" set:html={post.bodyHtml} />
      <p class="mt-10">
        <a href="/actualites/" class="text-primary hover:underline">← Toutes les actualités</a>
      </p>
    </article>
  </BaseLayout>
)}

{page && (
  <BaseLayout
    title={pageTitle(page.seoTitle, page.title)}
    description={pageDescriptionText}
    canonical={absoluteUrl(siteUrl, page.path)}
    noindex={page.noindex || isPreview}
    jsonLd={pageJsonLd}
  >
    {/* Le bloc `hero` porte déjà le h1 ; sans lui, le titre de la page en tient lieu,
        pour qu'il y ait toujours exactement un h1 — l'ancien site en avait deux. */}
    {blocks[0]?.type !== 'hero' && (
      <div class="mx-auto max-w-5xl px-4 pt-10">
        <h1 class="text-3xl font-semibold tracking-tight">{page.title}</h1>
      </div>
    )}
    {blocks.map((block) => <BlockRenderer block={block} media={media} slots={slots} />)}
  </BaseLayout>
)}
