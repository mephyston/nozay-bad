---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveEnv } from '../../lib/request-context';
import { listClubEvents } from '../../lib/cms';
import { absoluteUrl } from '../../lib/seo';
import { sportsEvent, breadcrumbList } from '../../lib/jsonld';
import { HTML_CACHE_CONTROL } from '../../lib/cache';

const env = resolveEnv(Astro.locals);
const siteUrl = env.SITE_URL ?? import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;

const events = await listClubEvents(env, 50);

const CATEGORIES: Record<string, string> = {
  competition: 'Compétition',
  interclubs: 'Interclubs',
  tournoi: 'Tournoi',
  stage: 'Stage',
  vie_du_club: 'Vie du club',
  assemblee: 'Assemblée'
};

const dayFormatter = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'full' });
const timeFormatter = new Intl.DateTimeFormat('fr-FR', { hour: '2-digit', minute: '2-digit' });

// Les dates sont stockées en heure locale sans fuseau : les relire telles quelles
// évite tout décalage à l'affichage.
const parse = (value: string) => new Date(`${value}:00`);

Astro.response.headers.set('Cache-Control', HTML_CACHE_CONTROL);

const jsonLd: unknown[] = [
  breadcrumbList(siteUrl, [
    { name: 'Accueil', path: '/' },
    { name: 'Agenda', path: '/agenda/' }
  ]),
  ...events.map((event) =>
    sportsEvent(siteUrl, {
      title: event.title,
      slug: event.slug,
      startsAt: event.startsAt,
      endsAt: event.endsAt,
      venueLabel: event.venueLabel,
      status: event.status
    })
  )
];
---

<BaseLayout
  title="Agenda"
  description="Compétitions, interclubs, stages et animations du club de badminton de Nozay."
  canonical={absoluteUrl(siteUrl, '/agenda/')}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-semibold tracking-tight">Agenda</h1>

    {events.length === 0 ? (
      <p class="text-muted-foreground mt-6">Aucun événement programmé pour le moment.</p>
    ) : (
      <ul class="divide-border mt-8 divide-y">
        {events.map((event) => (
          <li class="py-5">
            <p class="text-muted-foreground text-sm">
              <time datetime={event.startsAt}>{dayFormatter.format(parse(event.startsAt))}</time>
              {!event.allDay && <> · {timeFormatter.format(parse(event.startsAt))}</>}
            </p>
            <p class="mt-1 flex flex-wrap items-center gap-2">
              <span class="text-lg font-medium">{event.title}</span>
              <span class="bg-muted text-muted-foreground rounded px-2 py-0.5 text-xs">
                {CATEGORIES[event.category] ?? event.category}
              </span>
            </p>
            {event.venueLabel && <p class="text-muted-foreground mt-1 text-sm">{event.venueLabel}</p>}
            {event.descriptionHtml && (
              <div class="prose prose-neutral dark:prose-invert mt-2 max-w-none text-sm" set:html={event.descriptionHtml} />
            )}
            {event.externalUrl && (
              <p class="mt-2">
                <a
                  href={event.externalUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary text-sm hover:underline"
                >
                  Voir la fiche
                </a>
              </p>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
