---
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl } from '../lib/seo';
import { resolveEnv } from '../lib/request-context';
import { searchSite, type SiteSearchGroup } from '../lib/search';
import { allowSearch, cleanQuery, NO_STORE, SEARCH_MAX_LENGTH, SEARCH_MIN_LENGTH } from '../lib/search-guard';

/*
  La page de recherche : le formulaire qui marche sans script, et l'adresse que la
  loupe de l'en-tête soumet quand on appuie sur Entrée. Jamais indexée — un moteur n'a
  rien à faire d'une page de résultats —, jamais mise en cache (`?q=` n'entre pas dans
  la clé du cache de page ; voir `lib/cache.ts`, qui la déclare non mémorisable).
*/
const env = resolveEnv(Astro.locals);
const siteUrl = env.SITE_URL ?? import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;
const siteHost = (() => {
  try {
    return new URL(siteUrl).hostname;
  } catch {
    return Astro.url.hostname;
  }
})();
const q = cleanQuery(Astro.url.searchParams.get('q'));

let limited = false;
let groups: SiteSearchGroup[] = [];
if (q.length >= SEARCH_MIN_LENGTH) {
  if (await allowSearch(env as never, Astro.request)) {
    groups = await searchSite(env, q);
  } else {
    limited = true;
    Astro.response.status = 429;
    Astro.response.headers.set('Retry-After', '60');
  }
}
for (const [name, value] of Object.entries(NO_STORE)) Astro.response.headers.set(name, value);

const total = groups.reduce((n, g) => n + g.hits.length, 0);
---
<BaseLayout
  title={q ? `Recherche : ${q}` : 'Recherche'}
  description="Rechercher une page, une actualité ou un rendez-vous du club."
  canonical={absoluteUrl(siteUrl, '/recherche/')}
  noindex={true}
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="font-display text-3xl">Recherche</h1>

    <form method="get" action="/recherche/" class="mt-6 flex gap-2" role="search">
      <input
        type="search"
        name="q"
        value={q}
        maxlength={SEARCH_MAX_LENGTH}
        placeholder={`Rechercher sur ${siteHost}`}
        aria-label="Rechercher sur le site"
        class="border-border bg-background text-foreground placeholder:text-muted-foreground h-11 min-w-0 flex-1 rounded-lg border px-4 text-base focus:outline-none focus:ring-2 focus:ring-primary"
        autofocus={!q}
      />
      <button type="submit" class="bg-primary text-primary-foreground h-11 shrink-0 rounded-lg px-4 text-sm font-medium">Chercher</button>
    </form>

    {limited && (
      <p class="text-muted-foreground mt-6 text-sm" role="status">Trop de recherches en peu de temps : réessayez dans une minute.</p>
    )}

    {!limited && q.length > 0 && q.length < SEARCH_MIN_LENGTH && (
      <p class="text-muted-foreground mt-6 text-sm">Tapez au moins deux lettres.</p>
    )}

    {!limited && q.length >= SEARCH_MIN_LENGTH && total === 0 && (
      <p class="text-muted-foreground mt-6 text-sm">Rien pour « {q} ». Essayez un autre mot, ou parcourez le menu.</p>
    )}

    {groups.map((group) => group.hits.length > 0 && (
      <section class="mt-8">
        <h2 class="text-muted-foreground text-xs font-semibold uppercase tracking-wider">{group.label}</h2>
        <ul class="mt-2 divide-y divide-border">
          {group.hits.map((hit) => (
            <li>
              <a href={hit.href} class="hover:bg-muted -mx-2 flex flex-col rounded-md px-2 py-3">
                <span class="text-foreground font-medium">{hit.title}</span>
                {hit.subtitle && <span class="text-muted-foreground mt-0.5 text-sm">{hit.subtitle}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
