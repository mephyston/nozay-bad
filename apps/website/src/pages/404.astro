---
import BaseLayout from '../layouts/BaseLayout.astro';
import { absoluteUrl } from '../lib/seo';

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;
Astro.response.status = 404;
---
<BaseLayout
  title="Page introuvable"
  description="Cette page n'existe pas ou a été déplacée."
  canonical={absoluteUrl(siteUrl, '/404/')}
  noindex={true}
>
  <div class="mx-auto max-w-5xl px-4 py-16 text-center">
    <h1 class="text-3xl font-display">Page introuvable</h1>
    <p class="text-muted-foreground mt-3">
      Cette page n'existe pas, ou elle a changé d'adresse depuis l'ancien site.
    </p>
    <a href="/" class="bg-primary text-primary-foreground mt-6 inline-block rounded-lg px-4 py-2 text-sm font-medium">
      Retour à l'accueil
    </a>
  </div>
</BaseLayout>
