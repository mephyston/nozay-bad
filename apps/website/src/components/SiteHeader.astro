---
import ThemeToggle from './ThemeToggle.astro';
import SiteSearch from './SiteSearch.svelte';
import { resolveEnv } from '../lib/request-context';
import { listNavItems, type NavItemView } from '../lib/cms';

/**
 * En-tête du site.
 *
 * Le menu vient de la base : il se compose depuis l'écran « Menus du site » de
 * l'administration, sur deux niveaux au plus. Une liste vide — API indisponible, ou
 * menu jamais renseigné — laisse au moins le logo et le retour à l'accueil, plutôt
 * qu'un en-tête cassé.
 */
const env = resolveEnv(Astro.locals);
const nav: NavItemView[] = await listNavItems(env, 'header');
/** « Rechercher sur nozaybad.fr » — l'hôte du site, lu dans sa configuration. */
const siteHost = (() => {
  try {
    return new URL(env.SITE_URL ?? import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin).hostname;
  } catch {
    return Astro.url.hostname;
  }
})();
const searchPlaceholder = `Rechercher sur ${siteHost}`;
const current = Astro.url.pathname;

const isExternal = (item: NavItemView) => item.externalUrl !== null;

/**
 * Entrée qui ne fait que regrouper, sans page à elle.
 *
 * Le menu hérité de WordPress est bâti ainsi : « Le club » n'est pas une page, c'est
 * un chapeau au-dessus de « Présentation », « Notre équipe » et « Partenaires ».
 */
const isContainer = (item: NavItemView) => item.href === null;

/** Une entrée est active si l'on est dessus, ou sur l'une de ses sous-entrées. */
function isActive(item: NavItemView): boolean {
  if (item.href === current) return true;
  return item.children.some((child) => child.href === current);
}

/**
 * Un sous-menu s'ouvre-t-il vers la gauche ?
 *
 * Aligné sur le bord **gauche** de son entrée, un sous-menu de 14 rem sort de l'écran
 * dès que l'entrée est loin dans la barre : « Adultes » débordait de 57 px entre 768 et
 * 825 px de large — la plage exacte où le menu horizontal apparaît sans que la fenêtre
 * ne soit encore large. La page y prenait un défilement horizontal, et le sous-menu
 * ouvert y aurait été tronqué.
 *
 * Les entrées de la seconde moitié s'alignent donc sur leur bord **droit** et se
 * déploient vers l'intérieur. C'est le comportement des barres de menus depuis toujours,
 * et il se calcule au rendu : pas de mesure, pas de JavaScript, rien à recalculer au
 * redimensionnement. Le repère est l'index et non la position réelle — celle-ci dépend
 * de la longueur des libellés, que le rendu ne connaît pas — mais l'approximation ne
 * peut se tromper que sur l'entrée médiane, celle qui a de la place des deux côtés.
 */
const opensLeft = (index: number) => index >= Math.ceil(nav.length / 2);

/**
 * Rubrique dépliée à l'ouverture du menu mobile : celle où l'on se trouve, et elle
 * seule — l'accordéon étant exclusif, une seule peut l'être. Le lecteur retrouve ainsi
 * sa position dans le menu sans avoir à la rechercher ; ailleurs, tout est replié.
 */
const openSection = nav.findIndex((item) => item.children.length > 0 && isActive(item));
---
{/*
  Liseré de marque sous l'en-tête, dans le rouge exact de la charte.

  C'est le seul endroit du gabarit où la couleur du maillot est posée en aplat, et
  c'est assez : deux pixels sur toute la largeur suffisent à signer la page, là où
  teinter l'en-tête entier obligerait à repeindre le menu, le sélecteur de thème et
  le nom du club pour tenir le contraste. `--brand-red` et non `--primary` : rien
  n'est écrit dessus, la valeur de la charte peut donc rester intacte.
*/}
<header class="border-brand-red bg-background sticky top-0 z-40 border-b-2">
  <div class="mx-auto flex max-w-5xl items-center gap-4 px-4 py-3">
    {/*
      Deux marques selon la largeur, et non une seule redimensionnée : l'écusson tient
      dans un carré et reste lisible à 36 px, là où la version complète — qui porte le
      nom du club — deviendrait illisible sur mobile.

      `alt` vide sur les deux : le nom qui suit dit déjà où mène ce lien, et le
      dupliquer ferait annoncer le nom du club deux fois de suite au
      lecteur d'écran.
    */}
    <a href="/" class="font-display flex shrink-0 items-center gap-2">
      {/*
        Deux enveloppes en `display: contents` plutôt que quatre images à variantes
        croisées `dark:md:` : le passage clair/sombre se lit d'un coup, et la règle
        de largeur reste écrite une seule fois par thème.

        Les masters PNG vivent dans `apps/website/assets/` et les WebP servis ici en
        sont dérivés par `scripts/generate-website-logos.mjs`, à 3× la taille
        d'affichage. Les variantes sombres viennent de `scripts/make-dark-logo.py`,
        qui échange clair et sombre en préservant le rouge de la marque — un `filter:
        invert()` en CSS retournerait aussi l'écusson.
      */}
      <span class="contents dark:hidden">
        <img src="/logo.webp" alt="" width="108" height="108" class="h-9 w-9 md:hidden" />
        <img src="/logo-large.webp" alt="" width="120" height="120" class="hidden h-10 w-10 md:block" />
      </span>
      <span class="hidden dark:contents">
        <img src="/logo-dark.webp" alt="" width="108" height="108" class="h-9 w-9 md:hidden" />
        <img src="/logo-large-dark.webp" alt="" width="144" height="144" class="hidden h-10 w-10 md:block" />
      </span>
      {/*
        `sr-only` et non `hidden` en dessous de `sm`.

        Avec `hidden`, le nom sortait de l'arbre d'accessibilité en même temps que de
        l'écran : les deux images portant un `alt` vide, le lien vers l'accueil se
        retrouvait **sans nom du tout** sur mobile. Lighthouse le relevait à la fois
        en accessibilité et en navigation agentique. Visuellement hidden et sr-only
        reviennent au même ; seul le lecteur d'écran voit la différence.
      */}
      <span class="sr-only sm:not-sr-only">{Astro.locals.club?.settings.name}</span>
    </a>

    {/* Les sous-menus s'ouvrent au survol **et** au focus clavier : un `:hover` seul
        rendrait les sous-entrées inatteignables sans souris. */}
    <nav aria-label="Navigation principale" class="hidden flex-1 md:block">
      <ul class="flex flex-wrap items-center gap-x-1 text-sm">
        {nav.map((item, index) => (
          <li class="group relative">
            {/*
              Un conteneur est un `<button>`, jamais un `<span>`.

              Le sous-menu est masqué par `invisible`, donc `visibility: hidden`, donc
              ses liens ne sont **pas focusables** : sans un élément focusable pour
              déclencher `group-focus-within`, tout le sous-menu deviendrait
              inatteignable au clavier. Le bouton conserve l'ouverture au survol comme
              au focus, sans une ligne de JavaScript.
            */}
            {isContainer(item) ? (
              <button
                type="button"
                aria-haspopup={item.children.length > 0 ? 'true' : undefined}
                class:list={[
                  'hover:bg-muted inline-flex items-center gap-1 rounded-md px-3 py-2 transition-colors',
                  isActive(item) && 'text-primary font-medium'
                ]}
              >
                {item.label}
                {item.children.length > 0 && (
                  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                )}
              </button>
            ) : (
              <a
                href={item.href}
                target={isExternal(item) ? '_blank' : undefined}
                rel={isExternal(item) ? 'noopener noreferrer' : undefined}
                aria-current={item.href === current ? 'page' : undefined}
                aria-haspopup={item.children.length > 0 ? 'true' : undefined}
                class:list={[
                  'hover:bg-muted inline-flex items-center gap-1 rounded-md px-3 py-2 transition-colors',
                  isActive(item) && 'text-primary font-medium'
                ]}
              >
                {item.label}
                {item.children.length > 0 && (
                  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                )}
              </a>
            )}

            {item.children.length > 0 && (
              <ul
                class:list={[
                  'border-border bg-background invisible absolute top-full z-50 min-w-56 rounded-md border p-1 opacity-0 shadow-lg transition-[opacity,visibility] group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100',
                  opensLeft(index) ? 'right-0' : 'left-0'
                ]}
              >
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      target={child.externalUrl !== null ? '_blank' : undefined}
                      rel={child.externalUrl !== null ? 'noopener noreferrer' : undefined}
                      aria-current={child.href === current ? 'page' : undefined}
                      class:list={[
                        'hover:bg-muted block rounded-sm px-3 py-2 text-sm transition-colors',
                        child.href === current && 'text-primary font-medium'
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1">
      {/* Les entrées de premier niveau qui mènent quelque part : les liens rapides de la loupe. */}
      <SiteSearch client:idle placeholder={searchPlaceholder} quickLinks={nav.flatMap((item) => (item.href ? [{ label: item.label, href: item.href }] : item.children.filter((c) => c.href).map((c) => ({ label: c.label, href: c.href as string })))).slice(0, 8)} />
      <ThemeToggle />

      <button
        type="button"
        id="burger"
        class="hover:bg-muted text-muted-foreground inline-flex h-11 w-11 items-center justify-center rounded-md transition-colors md:hidden"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  {/*
      Menu mobile en accordéon : chaque rubrique est repliée, en ouvrir une referme
      celle qui l'était — c'est ce que fait l'attribut `name` sur `<details>`, sans une
      ligne de JavaScript et sans rien perdre si le script n'a pas encore tourné. Les
      liens restent dans le HTML servi, donc lisibles des moteurs, repliés ou non.

      Le repli est ce qui rend ce menu tenable : déplié, il faisait la moitié de sa
      hauteur en sous-entrées qu'on n'était pas venu chercher.
  */}
  {/*
      `text-base` et non `text-sm` comme la barre de bureau : ici les entrées se visent
      au pouce, pas au curseur. Avec les `py-2.5` ci-dessous, chaque lien fait 44 px de
      haut — la cible tactile recommandée (Apple HIG, WCAG 2.5.5) ; en `text-sm py-1.5`
      les sous-entrées tombaient à 32 px.
  */}
  {/*
      Le panneau se superpose à la page, il ne la pousse pas.

      En flux, ouvrir le menu agrandissait l'en-tête et décalait tout le contenu vers le
      bas — un saut de mise en page à chaque ouverture, et un second au repli. En
      `absolute` sous la barre (`top-full`), la page reste exactement où elle est et le
      menu passe devant : d'où le fond et l'ombre, que le panneau ne devait pas porter
      tant qu'il partageait ceux de l'en-tête.

      Le panneau défile pour lui-même, et sa hauteur est bornée à ce qui reste sous la
      barre. L'en-tête étant `sticky top-0`, un menu plus haut que l'écran débordait
      sans recours : le document défilait derrière, mais l'en-tête restait épinglé, si
      bien que ses dernières entrées étaient inatteignables.

      `svh` et non `vh` : sur mobile, `100vh` compte la barre d'adresse *rétractée*, donc
      dépasse la hauteur réellement visible tant qu'elle est déployée — la borne serait
      trop haute au moment précis où elle sert. `overscroll-contain` empêche le défilement
      de se propager à la page une fois le bas du menu atteint.
  */}
  <nav
    id="mobile-nav"
    aria-label="Navigation principale"
    class="border-border bg-background absolute inset-x-0 top-full z-50 hidden max-h-[calc(100svh-4.25rem)] overflow-y-auto overscroll-contain border-t shadow-lg md:hidden"
  >
    <ul class="mx-auto max-w-5xl px-4 py-2 text-base">
      {nav.map((item, index) => (
        <li class="py-0.5">
          {item.children.length === 0 ? (
            <a
              href={item.href}
              target={isExternal(item) ? '_blank' : undefined}
              rel={isExternal(item) ? 'noopener noreferrer' : undefined}
              aria-current={item.href === current ? 'page' : undefined}
              class:list={['block rounded-md px-2 py-2.5', isActive(item) && 'text-primary font-medium']}
            >
              {item.label}
            </a>
          ) : (
            <details name="mobile-nav-section" open={index === openSection}>
              <summary
                class:list={[
                  'flex cursor-pointer items-center justify-between gap-2 rounded-md px-2 py-2.5',
                  isActive(item) && 'text-primary font-medium'
                ]}
              >
                {item.label}
                <svg
                  class="chevron text-muted-foreground h-4 w-4 shrink-0 transition-transform duration-200"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <ul class="border-border ml-3 border-l pl-2">
                {/*
                  Une rubrique peut avoir une page à elle *et* des sous-entrées : rien ne
                  l'interdit à la composition du menu, et la barre de bureau la rend alors
                  comme un lien surmontant son sous-menu. Ici l'intitulé sert à déplier ;
                  la page du parent devient donc la première sous-entrée, sans quoi elle
                  n'aurait plus aucun chemin sur mobile.
                */}
                {!isContainer(item) && (
                  <li>
                    <a
                      href={item.href}
                      target={isExternal(item) ? '_blank' : undefined}
                      rel={isExternal(item) ? 'noopener noreferrer' : undefined}
                      aria-current={item.href === current ? 'page' : undefined}
                      class:list={[
                        'text-muted-foreground block rounded-md px-2 py-2.5',
                        item.href === current && 'text-primary font-medium'
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                )}
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      target={child.externalUrl !== null ? '_blank' : undefined}
                      rel={child.externalUrl !== null ? 'noopener noreferrer' : undefined}
                      aria-current={child.href === current ? 'page' : undefined}
                      class:list={[
                        'text-muted-foreground block rounded-md px-2 py-2.5',
                        child.href === current && 'text-primary font-medium'
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* Le marqueur natif du `<summary>` casserait l'alignement avec les liens voisins. */
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] > summary .chevron {
    transform: rotate(180deg);
  }
  /* Posée par le script sur `<html>`, donc hors de la portée du style scopé. */
  :global(html.nav-open) {
    overflow: hidden;
  }
</style>

<script is:inline>
  (() => {
    const burger = document.getElementById('burger');
    const nav = document.getElementById('mobile-nav');
    if (!burger || !nav) return;

    /*
      Défilement de la page gelé tant que le menu est ouvert : sans cela, un geste
      commencé à côté du panneau fait glisser le contenu derrière lui.

      `overflow: hidden` sur `<html>`, et non la vieille recette du `<body>` mis en
      `position: fixed` : celle-ci retire le document du flux, or l'en-tête est
      `sticky` — il retomberait à sa position statique, c'est-à-dire hors de l'écran
      dès que la page est un peu défilée, emportant le menu avec lui. Geler la racine
      conserve à la fois la position de défilement et l'en-tête épinglé.
    */
    const setOpen = (open) => {
      nav.classList.toggle('hidden', !open);
      document.documentElement.classList.toggle('nav-open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    };

    burger.addEventListener('click', () => setOpen(nav.classList.contains('hidden')));

    /*
      Clic hors du menu : on referme.

      `click` et non `pointerdown` : un geste qui commence dans le panneau et se termine
      ailleurs — un défilement au doigt relâché hors de la liste — ne doit pas compter
      comme une sortie. Le bouton est exclu de la règle : son propre gestionnaire vient
      de basculer l'état, et refermer ici annulerait l'ouverture qu'il déclenche.
    */
    document.addEventListener('click', (event) => {
      if (nav.classList.contains('hidden')) return;
      if (nav.contains(event.target) || burger.contains(event.target)) return;
      setOpen(false);
    });

    // Échap referme aussi, et rend le focus au bouton : sans cela il resterait dans un
    // menu devenu invisible, et la tabulation suivante repartirait de nulle part.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || nav.classList.contains('hidden')) return;
      setOpen(false);
      burger.focus();
    });

    // Passage en écran large : le menu mobile disparaît par `md:hidden`, mais le gel
    // du défilement, lui, ne dépend d'aucun point de rupture — il resterait en place
    // sur une page devenue impossible à faire défiler.
    matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  })();
</script>
