---
import ThemeToggle from './ThemeToggle.astro';
import { resolveEnv } from '../lib/request-context';
import { listNavItems, type NavItemView } from '../lib/cms';

/**
 * En-tête du site.
 *
 * Le menu vient de la base : il se compose depuis l'écran « Menus du site » de
 * l'administration, sur deux niveaux au plus. Une liste vide — API indisponible, ou
 * menu jamais renseigné — laisse au moins le logo et le retour à l'accueil, plutôt
 * qu'un en-tête cassé.
 */
const env = resolveEnv(Astro.locals);
const nav: NavItemView[] = await listNavItems(env, 'header');
const current = Astro.url.pathname;

const isExternal = (item: NavItemView) => item.externalUrl !== null;

/**
 * Entrée qui ne fait que regrouper, sans page à elle.
 *
 * Le menu hérité de WordPress est bâti ainsi : « Le club » n'est pas une page, c'est
 * un chapeau au-dessus de « Présentation », « Notre équipe » et « Partenaires ».
 */
const isContainer = (item: NavItemView) => item.href === null;

/** Une entrée est active si l'on est dessus, ou sur l'une de ses sous-entrées. */
function isActive(item: NavItemView): boolean {
  if (item.href === current) return true;
  return item.children.some((child) => child.href === current);
}
---
<header class="border-border bg-background sticky top-0 z-40 border-b">
  <div class="mx-auto flex max-w-5xl items-center gap-4 px-4 py-3">
    {/*
      Deux marques selon la largeur, et non une seule redimensionnée : l'écusson tient
      dans un carré et reste lisible à 36 px, là où la version complète — qui porte le
      nom du club — deviendrait illisible sur mobile.

      `alt` vide sur les deux : le nom qui suit dit déjà où mène ce lien, et le
      dupliquer ferait annoncer « Nozay Badminton Association » deux fois de suite au
      lecteur d'écran.
    */}
    <a href="/" class="flex shrink-0 items-center gap-2 font-semibold">
      {/*
        Deux enveloppes en `display: contents` plutôt que quatre images à variantes
        croisées `dark:md:` : le passage clair/sombre se lit d'un coup, et la règle
        de largeur reste écrite une seule fois par thème.

        Les masters PNG vivent dans `apps/website/assets/` et les WebP servis ici en
        sont dérivés par `scripts/generate-website-logos.mjs`, à 3× la taille
        d'affichage. Les variantes sombres viennent de `scripts/make-dark-logo.py`,
        qui échange clair et sombre en préservant le rouge de la marque — un `filter:
        invert()` en CSS retournerait aussi l'écusson.
      */}
      <span class="contents dark:hidden">
        <img src="/logo.webp" alt="" width="108" height="108" class="h-9 w-9 md:hidden" />
        <img src="/logo-large.webp" alt="" width="120" height="120" class="hidden h-10 w-10 md:block" />
      </span>
      <span class="hidden dark:contents">
        <img src="/logo-dark.webp" alt="" width="108" height="108" class="h-9 w-9 md:hidden" />
        <img src="/logo-large-dark.webp" alt="" width="144" height="144" class="hidden h-10 w-10 md:block" />
      </span>
      {/*
        `sr-only` et non `hidden` en dessous de `sm`.

        Avec `hidden`, le nom sortait de l'arbre d'accessibilité en même temps que de
        l'écran : les deux images portant un `alt` vide, le lien vers l'accueil se
        retrouvait **sans nom du tout** sur mobile. Lighthouse le relevait à la fois
        en accessibilité et en navigation agentique. Visuellement hidden et sr-only
        reviennent au même ; seul le lecteur d'écran voit la différence.
      */}
      <span class="sr-only sm:not-sr-only">Nozay Badminton Association</span>
    </a>

    {/* Les sous-menus s'ouvrent au survol **et** au focus clavier : un `:hover` seul
        rendrait les sous-entrées inatteignables sans souris. */}
    <nav aria-label="Navigation principale" class="hidden flex-1 md:block">
      <ul class="flex flex-wrap items-center gap-x-1 text-sm">
        {nav.map((item) => (
          <li class="group relative">
            {/*
              Un conteneur est un `<button>`, jamais un `<span>`.

              Le sous-menu est masqué par `invisible`, donc `visibility: hidden`, donc
              ses liens ne sont **pas focusables** : sans un élément focusable pour
              déclencher `group-focus-within`, tout le sous-menu deviendrait
              inatteignable au clavier. Le bouton conserve l'ouverture au survol comme
              au focus, sans une ligne de JavaScript.
            */}
            {isContainer(item) ? (
              <button
                type="button"
                aria-haspopup={item.children.length > 0 ? 'true' : undefined}
                class:list={[
                  'hover:bg-muted inline-flex items-center gap-1 rounded-md px-3 py-2 transition-colors',
                  isActive(item) && 'text-primary font-medium'
                ]}
              >
                {item.label}
                {item.children.length > 0 && (
                  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                )}
              </button>
            ) : (
              <a
                href={item.href}
                target={isExternal(item) ? '_blank' : undefined}
                rel={isExternal(item) ? 'noopener noreferrer' : undefined}
                aria-current={item.href === current ? 'page' : undefined}
                aria-haspopup={item.children.length > 0 ? 'true' : undefined}
                class:list={[
                  'hover:bg-muted inline-flex items-center gap-1 rounded-md px-3 py-2 transition-colors',
                  isActive(item) && 'text-primary font-medium'
                ]}
              >
                {item.label}
                {item.children.length > 0 && (
                  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                )}
              </a>
            )}

            {item.children.length > 0 && (
              <ul class="border-border bg-background invisible absolute left-0 top-full z-50 min-w-56 rounded-md border p-1 opacity-0 shadow-lg transition-[opacity,visibility] group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      target={child.externalUrl !== null ? '_blank' : undefined}
                      rel={child.externalUrl !== null ? 'noopener noreferrer' : undefined}
                      aria-current={child.href === current ? 'page' : undefined}
                      class:list={[
                        'hover:bg-muted block rounded-sm px-3 py-2 text-sm transition-colors',
                        child.href === current && 'text-primary font-medium'
                      ]}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1">
      <ThemeToggle />

      <button
        type="button"
        id="burger"
        class="hover:bg-muted text-muted-foreground inline-flex h-11 w-11 items-center justify-center rounded-md transition-colors md:hidden"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  {/* Le menu mobile est rendu déplié dans le HTML puis masqué par `hidden` : son
      contenu reste donc lisible des moteurs et des lecteurs d'écran même si le script
      n'a pas encore été exécuté. */}
  {/*
      `text-base` et non `text-sm` comme la barre de bureau : ici les entrées se visent
      au pouce, pas au curseur. Avec les `py-2.5` ci-dessous, chaque lien fait 44 px de
      haut — la cible tactile recommandée (Apple HIG, WCAG 2.5.5) ; en `text-sm py-1.5`
      les sous-entrées tombaient à 32 px.
  */}
  <nav id="mobile-nav" aria-label="Navigation principale" class="border-border hidden border-t md:hidden">
    <ul class="mx-auto max-w-5xl px-4 py-2 text-base">
      {nav.map((item) => (
        <li class="py-0.5">
          {/*
            Sur mobile, un conteneur devient un simple intitulé au-dessus de ses
            sous-entrées — jamais une cible tactile qui ne mènerait nulle part. Rien ne
            s'y perd : ce menu rend déjà les sous-entrées dépliées, elles sont donc
            sous les yeux sans qu'aucun repli n'ait à être ouvert.
          */}
          {isContainer(item) ? (
            <p class="text-muted-foreground px-2 pt-3 pb-1 text-xs font-semibold uppercase tracking-wide">
              {item.label}
            </p>
          ) : (
            <a
              href={item.href}
              target={isExternal(item) ? '_blank' : undefined}
              rel={isExternal(item) ? 'noopener noreferrer' : undefined}
              aria-current={item.href === current ? 'page' : undefined}
              class:list={['block rounded-md px-2 py-2.5', isActive(item) && 'text-primary font-medium']}
            >
              {item.label}
            </a>
          )}
          {item.children.length > 0 && (
            <ul class="border-border ml-3 border-l pl-2">
              {item.children.map((child) => (
                <li>
                  <a
                    href={child.href}
                    target={child.externalUrl !== null ? '_blank' : undefined}
                    rel={child.externalUrl !== null ? 'noopener noreferrer' : undefined}
                    aria-current={child.href === current ? 'page' : undefined}
                    class:list={[
                      'text-muted-foreground block rounded-md px-2 py-2.5',
                      child.href === current && 'text-primary font-medium'
                    ]}
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>
</header>

<script is:inline>
  (() => {
    const burger = document.getElementById('burger');
    const nav = document.getElementById('mobile-nav');
    if (!burger || !nav) return;
    burger.addEventListener('click', () => {
      const open = !nav.classList.toggle('hidden');
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    });
  })();
</script>
