---
import type { PostRow } from '../lib/cms';
import Picture from './Picture.astro';

/**
 * Largeur rendue de la carte, pour la grille à trois colonnes de `PostsFeed`.
 *
 * Sous `sm` la carte occupe la largeur utile ; entre `sm` et `lg` la moitié ; au-delà
 * la grille est bornée par `max-w-5xl`, ce qui fige la case à environ 320 px. Une
 * page qui dispose ses cartes autrement doit passer son propre `sizes`, faute de quoi
 * le navigateur choisit sa déclinaison sur une largeur qui n'est pas la bonne.
 */
const DEFAULT_SIZES = '(min-width: 1024px) 320px, (min-width: 640px) 50vw, calc(100vw - 2rem)';

interface Props {
  post: PostRow;
  /** Première carte au-dessus de la ligne de flottaison : image chargée sans délai. */
  priority?: boolean;
  showImage?: boolean;
  sizes?: string;
  /**
   * Niveau du titre de la carte.
   *
   * `h3` sous le `h2` d'un bloc « Actualités » ordinaire. Le bloc posé dans une colonne
   * descend son propre titre en `h3` : ses cartes doivent suivre, sinon elles
   * deviendraient les sœurs du titre qui les annonce, et un lecteur d'écran perdrait le
   * rattachement.
   */
  headingLevel?: 'h3' | 'h4';
}

const {
  post,
  priority = false,
  showImage = true,
  sizes = DEFAULT_SIZES,
  headingLevel: Heading = 'h3'
} = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' });
const published = post.publishedAt ? new Date(post.publishedAt) : null;

/**
 * Amorce du texte.
 *
 * Le chapô fait autorité quand il existe — c'est la phrase que la rédaction a
 * choisie. À défaut on retombe sur le corps, débarrassé de son balisage : les
 * fermetures de blocs deviennent des espaces, sans quoi « …du club.</p><p>Rendez-vous »
 * se lirait « du club.Rendez-vous ».
 */
const preview =
  post.excerpt?.trim() ||
  post.bodyHtml
    .replace(/<\/(p|li|ul|ol|h2|h3|h4|blockquote)\s*>/gi, ' ')
    .replace(/<[^>]*>/g, '')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&#39;|&apos;/g, "'")
    .replace(/&quot;/g, '"')
    .replace(/\s+/g, ' ')
    .trim();

const cover = showImage ? post.cover : null;
---
{/*
  Toute la carte est cliquable via le lien du titre étendu en overlay : la cible reste
  un seul lien pour le lecteur d'écran, là où envelopper la carte entière dupliquerait
  l'annonce du titre, de la date et du texte dans un même intitulé.
*/}
<article class="group border-border relative flex flex-col overflow-hidden rounded-lg border transition-shadow hover:shadow-md">
  {cover && (
    <div class="bg-muted aspect-[16/9] overflow-hidden">
      {/*
        `<Picture>` et non un `<img>` nu : la carte servait l'original de la
        couverture, soit jusqu'à 1600 px de large pour une vignette rendue à 380.
        Le composant pose les `srcset` avif et webp par largeur, et le navigateur
        prend la déclinaison qui correspond à `sizes`.
      */}
      <Picture
        media={cover}
        variants={post.coverVariants}
        priority={priority}
        sizes={sizes}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    </div>
  )}

  <div class="flex flex-1 flex-col p-4">
    {post.categories && post.categories.length > 0 && (
      <ul class="mb-2 flex flex-wrap gap-1.5">
        {post.categories.map((category) => (
          <li class="bg-primary/10 text-primary rounded-full px-2 py-0.5 text-xs font-medium">
            {category.name}
          </li>
        ))}
      </ul>
    )}

    <Heading class="text-lg font-semibold leading-snug tracking-tight">
      {/* `after:absolute inset-0` : la zone cliquable couvre la carte, le lien reste unique. */}
      <a href={post.path} class="after:absolute after:inset-0 hover:underline">{post.title}</a>
    </Heading>

    {published && (
      <p class="text-muted-foreground mt-1 text-sm">
        <time datetime={published.toISOString()}>{dateFormatter.format(published)}</time>
      </p>
    )}

    {preview && <p class="text-muted-foreground mt-2 line-clamp-3 text-sm">{preview}</p>}

    <span class="text-primary mt-3 inline-block text-sm font-medium group-hover:underline">
      Voir plus <span aria-hidden="true">→</span>
    </span>
  </div>
</article>
