---
import type { ScheduleBlock } from '@nba/cms/public';
import type { ScheduleSlotView } from '../../lib/cms';

interface Props { block: ScheduleBlock; slots?: ScheduleSlotView[]; nested?: boolean }
const { block, slots = [], nested = false } = Astro.props;

/*
  Imbriqué dans une colonne, le bloc perd son enveloppe et son niveau de titre.

  La grille garde en revanche son point de bascule `md` : son seul mode étroit est la
  liste par jour, qui n'a rien à gagner à la largeur d'une colonne.
*/
const shell = nested ? '' : 'mx-auto max-w-5xl px-4 py-8';
const Heading = nested ? 'h3' : 'h2';
/** Le nom du jour reste d'un cran sous le titre du bloc, imbriqué ou non. */
const DayHeading = nested ? 'h4' : 'h3';

const WEEKDAYS = ['', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];
const SHORT_WEEKDAYS = ['', 'Lun.', 'Mar.', 'Mer.', 'Jeu.', 'Ven.', 'Sam.', 'Dim.'];
const AUDIENCES: Record<string, string> = {
  minibad: 'Minibad (U9)', poussins: 'Poussins (U11)', jeunes: 'Jeunes',
  elite_jeunes: 'Élite Jeunes', adultes_loisir: 'Adultes loisirs',
  adultes_competition: 'Adultes compétition', jeu_libre: 'Jeu libre'
};

/**
 * Trois familles de couleur, et pas une par public.
 *
 * Sept aplats distincts ne passent pas : sur une grille, l'œil compare n'importe
 * quelle case à n'importe quelle autre — toutes les paires comptent, pas seulement
 * les voisines. Dans cette configuration le vert et l'orange tombent à ΔE 3,2 en
 * protanopie, et le magenta et l'orange à 12,9 en vision normale, sous le plancher
 * de 15. Trois teintes sont le maximum qui tienne à la fois en clair et en sombre
 * (vérifié : pire paire ΔE 9,2 / 20,9).
 *
 * La couleur ne porte donc que la famille ; le public exact est **écrit dans chaque
 * case**. Personne ne dépend de la couleur pour lire le tableau.
 */
const FAMILY: Record<string, 'jeunes' | 'adultes' | 'libre'> = {
  minibad: 'jeunes', poussins: 'jeunes', jeunes: 'jeunes', elite_jeunes: 'jeunes',
  adultes_loisir: 'adultes', adultes_competition: 'adultes',
  jeu_libre: 'libre'
};
const FAMILY_LABELS: Record<string, string> = {
  jeunes: 'Jeunes', adultes: 'Adultes', libre: 'Jeu libre'
};

// Le bloc ne porte qu'une requête : le filtrage final se fait ici, sur les créneaux
// que le domaine a rendus.
const shown = block.audiences.length > 0
  ? slots.filter((slot) => block.audiences.includes(slot.audience))
  : slots;

/** « 18:30 » → 1110. Le club n'a qu'un fuseau, l'heure locale suffit. */
const toMinutes = (time: string) => {
  const [hours, minutes] = time.split(':').map(Number);
  return hours * 60 + (minutes || 0);
};

const pad = (n: number) => String(n).padStart(2, '0');

/**
 * Nom court d'un gymnase.
 *
 * Heuristique assumée, faute d'un champ dédié en base : « Gymnase Pierre Dupuis »
 * donne « Dupuis » — le mot distinctif est le patronyme — tandis que « Halle des
 * Sports » donne « Halle », son nom d'usage. Le nom complet reste disponible en
 * infobulle et dans la liste par jour ; rien ne se perd si la règle tombe à côté sur
 * un futur gymnase. Le jour où le club en compte plus de deux, mieux vaudra une
 * colonne `shortName` sur `venues` qu'une heuristique plus fine.
 */
function shortVenue(name: string): string {
  const words = name.trim().split(/\s+/);
  if (words.length < 2) return name;
  return /^gymnase$/i.test(words[0]) ? words[words.length - 1] : words[0];
}

/**
 * Placement d'un créneau dans sa colonne « jour × gymnase ».
 *
 * Deux étapes, parce qu'il y a deux façons de se superposer et qu'une seule mérite de
 * couper la colonne :
 *
 * 1. **Même intervalle exact** — deux groupes qui se partagent la salle de 18:00 à
 *    19:30. Ils s'empilent dans une seule case, sur toute la largeur. Les couper en deux
 *    demi-colonnes de quarante pixels casserait leurs libellés en morceaux (« Pous /
 *    sins ») sans rien apprendre à personne : ils ont la même heure, c'est justement ce
 *    que la case dit déjà.
 * 2. **Chevauchement partiel** — un créneau qui déborde sur un autre. Là, les voies sont
 *    la seule façon honnête de le montrer, et le partage se calcule par **grappe** : le
 *    Minibad du mercredi midi n'a pas à rétrécir parce que deux créneaux se superposent
 *    le soir.
 */
interface Placed {
  /** Un seul le plus souvent ; plusieurs quand la salle accueille deux groupes à la même heure. */
  slots: ScheduleSlotView[];
  startMin: number;
  endMin: number;
  lane: number;
  lanes: number;
}

function place(venueSlots: ScheduleSlotView[]): Placed[] {
  const byRange = new Map<string, ScheduleSlotView[]>();
  for (const slot of venueSlots) {
    const key = `${slot.startTime}|${slot.endTime}`;
    const bucket = byRange.get(key);
    if (bucket) bucket.push(slot);
    else byRange.set(key, [slot]);
  }

  const sorted = [...byRange.values()]
    .map((slots) => ({
      slots,
      startMin: toMinutes(slots[0].startTime),
      endMin: toMinutes(slots[0].endTime)
    }))
    .sort((a, b) => a.startMin - b.startMin || a.endMin - b.endMin);

  const placed: Placed[] = [];
  let cluster: Placed[] = [];
  let laneEnds: number[] = [];
  let clusterEnd = -1;

  const flush = () => {
    for (const item of cluster) item.lanes = laneEnds.length;
    placed.push(...cluster);
    cluster = [];
    laneEnds = [];
    clusterEnd = -1;
  };

  for (const item of sorted) {
    // Plus aucun recouvrement avec ce qui précède : la grappe est close, la largeur
    // repart à pleine colonne.
    if (cluster.length > 0 && item.startMin >= clusterEnd) flush();

    let lane = laneEnds.findIndex((end) => end <= item.startMin);
    if (lane === -1) {
      laneEnds.push(item.endMin);
      lane = laneEnds.length - 1;
    } else {
      laneEnds[lane] = item.endMin;
    }

    cluster.push({ ...item, lane, lanes: 1 });
    clusterEnd = Math.max(clusterEnd, item.endMin);
  }
  flush();

  return placed;
}

/**
 * Colonnes : un jour, scindé par les gymnases **qu'il utilise**.
 *
 * Le découpage se calcule jour par jour, et non une fois pour toute la semaine : un
 * gymnase qui ne sert pas le mardi n'y ouvre pas de colonne vide. Sur la saison en
 * cours, la grille tient ainsi en dix colonnes là où le produit jours × gymnases en
 * demanderait quatorze.
 *
 * Le gymnase étant porté par la colonne, il sort du créneau : chaque case y regagne en
 * texte la ligne qu'elle vient de perdre en largeur.
 */
const days = WEEKDAYS
  .map((label, weekday) => ({ label, short: SHORT_WEEKDAYS[weekday], weekday }))
  .filter((day) => day.weekday > 0 && shown.some((slot) => slot.weekday === day.weekday))
  .map((day) => {
    const daySlots = shown.filter((slot) => slot.weekday === day.weekday);
    const names = [...new Set(daySlots.map((slot) => slot.venue?.name ?? '—'))].sort();
    return {
      ...day,
      venues: names.map((name) => ({
        name,
        // Les voies ne servent plus qu'au vrai chevauchement : deux groupes à la même
        // heure **dans la même salle**, ce que la colonne ne peut pas départager.
        placed: place(daySlots.filter((slot) => (slot.venue?.name ?? '—') === name))
      }))
    };
  });

/** Total des sous-colonnes : ce que la grille doit répartir sur sa largeur. */
const columnCount = days.reduce((total, day) => total + day.venues.length, 0);

/**
 * Lignes : une par heure pleine, du premier début au dernier fin.
 *
 * Les horaires du club sont irréguliers (13:15–14:15, 15:45–16:30) ; une ligne par
 * plage distincte donnait une règle verticale sans échelle, où deux lignes voisines
 * pouvaient valoir quinze minutes ou trois heures. La règle est donc au pas fixe et les
 * créneaux se positionnent **au prorata des minutes** : un créneau à cheval sur deux
 * heures les chevauche pour de bon, sans décaler quoi que ce soit autour de lui.
 */
const bounds = shown.flatMap((slot) => [toMinutes(slot.startTime), toMinutes(slot.endTime)]);
const startHour = bounds.length > 0 ? Math.floor(Math.min(...bounds) / 60) : 0;
const endHour = bounds.length > 0 ? Math.ceil(Math.max(...bounds) / 60) : 0;
const hours = Array.from({ length: Math.max(endHour - startHour, 0) }, (_, i) => startHour + i);
const originMin = startHour * 60;
const spanMin = Math.max((endHour - startHour) * 60, 1);

/** Position d'un créneau, en pourcentage de la hauteur totale de la règle. */
const offsetOf = (placedSlot: Placed) => ((placedSlot.startMin - originMin) / spanMin) * 100;
const heightOf = (placedSlot: Placed) => ((placedSlot.endMin - placedSlot.startMin) / spanMin) * 100;

const titleOf = (slot: ScheduleSlotView) => slot.label ?? AUDIENCES[slot.audience] ?? slot.audience;

const usedFamilies = [...new Set(shown.map((slot) => FAMILY[slot.audience] ?? 'libre'))];
---
<section class:list={[shell]}>
  {block.heading && <Heading class="mb-4 text-2xl font-display">{block.heading}</Heading>}

  {shown.length === 0 ? (
    <p class="text-muted-foreground">Les créneaux ne sont pas encore renseignés pour cette saison.</p>
  ) : (
    <div class="nba-schedule">
      {usedFamilies.length > 1 && (
        <ul class="mb-4 flex flex-wrap gap-x-4 gap-y-1.5 text-sm">
          {usedFamilies.map((family) => (
            <li class="flex items-center gap-2">
              <span
                class="h-3 w-3 shrink-0 rounded-sm"
                style={`background: var(--group-${family})`}
                aria-hidden="true"
              ></span>
              <span class="text-muted-foreground">{FAMILY_LABELS[family]}</span>
            </li>
          ))}
        </ul>
      )}

      {/*
        Grille hebdomadaire : les jours en colonnes, scindés par gymnase, sur une règle
        d'heures pleines.

        Elle est purement visuelle — `aria-hidden` — parce qu'aucune sémantique HTML ne
        décrit honnêtement un créneau posé à 22 % de la hauteur d'une colonne. C'est la
        liste par jour, juste en dessous, qui porte l'information pour les lecteurs
        d'écran : elle reste dans le flux à toutes les largeurs, seulement masquée à
        l'œil au-delà de `md`.
      */}
      <div class="nba-schedule-scroll hidden md:block">
        <div
          class="nba-schedule-grid"
          style={`grid-template-columns: var(--gutter) repeat(${columnCount}, minmax(var(--col-min), 1fr)); --hours: ${hours.length}`}
          aria-hidden="true"
        >
          <div class="nba-schedule-corner"></div>

          {days.map((day) => (
            <div class="nba-schedule-day-head" style={`grid-column: span ${day.venues.length}`}>
              <span class="lg:hidden">{day.short}</span>
              <span class="hidden lg:inline">{day.label}</span>
            </div>
          ))}

          {days.map((day) =>
            day.venues.map((venue, index) => (
              <div class="nba-schedule-venue-head" data-first={index === 0 ? 'true' : undefined}>
                {/*
                  Le nom court est affiché, le nom complet reste lisible en infobulle et
                  écrit en toutes lettres dans la liste par jour, qui est la version lue.
                */}
                <span title={venue.name}>{shortVenue(venue.name)}</span>
              </div>
            ))
          )}

          <div class="nba-schedule-gutter">
            {hours.map((hour) => (
              <div class="nba-schedule-hour">{pad(hour)}:00</div>
            ))}
          </div>

          {days.map((day) =>
            day.venues.map((venue, index) => (
              <div class="nba-schedule-col" data-first={index === 0 ? 'true' : undefined}>
                {venue.placed.map((entry) => (
                  <div
                    class="nba-schedule-cell"
                    data-narrow={entry.lanes > 1 ? 'true' : undefined}
                    data-stacked={entry.slots.length > 1 ? 'true' : undefined}
                    style={`--top: ${offsetOf(entry)}; --height: ${heightOf(entry)}; --lane: ${entry.lane}; --lanes: ${entry.lanes}`}
                  >
                    {/*
                      Deux groupes empilés partagent l'horaire par construction : l'écrire
                      sur chacun le répète et, sur une case d'une heure et demie, en tronque
                      les deux. Il est donc écrit une fois, en tête de case.
                    */}
                    {entry.slots.length > 1 && (
                      <span class="nba-schedule-cell-time">
                        {entry.slots[0].startTime}–{entry.slots[0].endTime}
                      </span>
                    )}
                    {entry.slots.map((slot) => (
                      <div
                        class="nba-slot"
                        data-family={FAMILY[slot.audience] ?? 'libre'}
                        title={`${titleOf(slot)} — ${slot.startTime}–${slot.endTime} · ${venue.name}`}
                      >
                        <span class="nba-slot-title">{titleOf(slot)}</span>
                        <span class="nba-slot-meta">{slot.startTime}–{slot.endTime}</span>
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            ))
          )}
        </div>
      </div>

      {/*
        Sur téléphone, la grille devient une liste par jour : même information, sans
        défilement latéral. Au-delà de `md`, elle reste lue mais n'est plus vue.
      */}
      <div class="space-y-5 md:sr-only">
        {days.map((day) => (
          <div>
            <DayHeading class="mb-2 font-semibold">{day.label}</DayHeading>
            <ul class="space-y-1.5">
              {shown
                .filter((slot) => slot.weekday === day.weekday)
                .sort((a, b) => a.startTime.localeCompare(b.startTime))
                .map((slot) => (
                  <li class="nba-slot rounded-md px-3 py-2" data-family={FAMILY[slot.audience] ?? 'libre'}>
                    <span class="block font-medium">{titleOf(slot)}</span>
                    <span class="text-muted-foreground block text-xs tabular-nums">
                      {slot.startTime} – {slot.endTime} · {slot.venue?.name ?? '—'}
                    </span>
                  </li>
                ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  )}
</section>

<style>
  /*
    Trois teintes, choisies dans la palette catégorielle de référence et vérifiées
    au validateur pour les deux fonds du site (toutes paires) :
      clair  #faf9f5 — pire paire ΔE 9,2 (deutan) / 24,0 (vision normale)
      sombre #262624 — pire paire ΔE 9,4 (deutan) / 20,9 (vision normale)

    Les pas sombres sont **choisis** pour le fond sombre, jamais dérivés des clairs :
    éclaircir mécaniquement ferait sortir de la bande de luminosité.
  */
  .nba-schedule {
    --group-jeunes: #2a78d6;
    --group-adultes: #eb6834;
    --group-libre: #1baf7a;
  }

  :global(.dark) .nba-schedule {
    --group-jeunes: #3987e5;
    --group-adultes: #d95926;
    --group-libre: #199e70;
  }

  .nba-schedule-scroll {
    /*
      Filet de sécurité, et non mode de fonctionnement : à dix sous-colonnes la grille
      tient dans les 992 px du gabarit sans défiler. `--col-min` ne se fait sentir que
      le jour où le club obtiendrait une troisième salle — mieux vaut alors défiler que
      rendre chaque colonne illisible.
    */
    overflow-x: auto;
  }

  .nba-schedule-grid {
    display: grid;
    /*
      Hauteur d'une heure. C'est l'unique échelle de la grille : tout le reste — la
      règle, la position et la hauteur des créneaux — s'en déduit, et un créneau de
      quarante-cinq minutes fait bien les trois quarts d'un créneau d'une heure.
    */
    --hour-h: 4rem;
    --gutter: 3.25rem;
    --col-min: 4.5rem;
  }

  @media (min-width: 1024px) {
    .nba-schedule-grid {
      --hour-h: 4.5rem;
      --gutter: 3.75rem;
      --col-min: 5rem;
    }
  }

  /* Le jour coiffe ses gymnases ; l'angle mort couvre les deux rangs d'en-tête. */
  .nba-schedule-corner {
    grid-row: 1 / 3;
    grid-column: 1;
    border-bottom: 1px solid var(--border);
  }

  .nba-schedule-day-head {
    grid-row: 1;
    border-left: 1px solid var(--border);
    padding: 0.375rem 0.5rem;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .nba-schedule-venue-head {
    grid-row: 2;
    border-bottom: 1px solid var(--border);
    padding: 0.25rem 0.375rem;
    text-align: center;
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--muted-foreground);
    /* Un nom de gymnase ne doit pas élargir la colonne : il est déjà abrégé. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /*
    Deux traits de force différente : le jour se sépare franchement du précédent, les
    salles d'un même jour se distinguent d'un filet discret. Sans cette hiérarchie, dix
    colonnes équidistantes ne laissent plus voir où commence le mardi.
  */
  .nba-schedule-venue-head[data-first],
  .nba-schedule-col[data-first] {
    border-left: 1px solid var(--border);
  }
  .nba-schedule-venue-head:not([data-first]),
  .nba-schedule-col:not([data-first]) {
    border-left: 1px dotted color-mix(in oklab, var(--border) 70%, transparent);
  }

  .nba-schedule-gutter {
    grid-row: 3;
    grid-column: 1;
  }

  .nba-schedule-col {
    grid-row: 3;
  }

  .nba-schedule-gutter,
  .nba-schedule-col {
    height: calc(var(--hours) * var(--hour-h));
  }

  .nba-schedule-hour {
    /*
      Le libellé coiffe sa tranche plutôt que de chevaucher le trait : la ligne
      « 18:00 » nomme la bande qui va de 18 h à 19 h, ce qui se lit sans légende.
    */
    height: var(--hour-h);
    padding-top: 0.125rem;
    padding-right: 0.5rem;
    text-align: right;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
  }

  .nba-schedule-col {
    position: relative;
    /*
      Les traits d'heure sont peints, pas empilés en éléments : une seule déclaration
      donne la règle complète, et rien dans le DOM ne peut la décaler.
    */
    background-image: repeating-linear-gradient(
      to bottom,
      var(--border) 0,
      var(--border) 1px,
      transparent 1px,
      transparent var(--hour-h)
    );
    border-bottom: 1px solid var(--border);
  }

  /*
    Fond teinté et non aplat : le texte garde l'encre du thème plutôt que la couleur
    de sa famille — une couleur de série ne doit jamais porter du texte. Le liseré
    à gauche donne la teinte à pleine saturation, seule zone où elle est franche.
  */
  .nba-slot {
    border-left: 3px solid var(--family-color);
    /*
      Fond **opaque**, et non teinté par transparence : sur la grille, les traits
      d'heure passeraient sinon au travers du créneau et le barreraient en deux. Le
      mélange se fait donc avec le fond de page plutôt qu'avec du transparent, pour
      exactement la même couleur à l'œil et un créneau qui masque ce qu'il recouvre.
    */
    background: color-mix(in oklab, var(--family-color) 12%, var(--background));
  }
  .nba-slot[data-family='jeunes'] { --family-color: var(--group-jeunes); }
  .nba-slot[data-family='adultes'] { --family-color: var(--group-adultes); }
  .nba-slot[data-family='libre'] { --family-color: var(--group-libre); }

  /*
    La case : positionnée sur la règle, elle porte l'heure ; les créneaux qu'elle
    contient se partagent sa hauteur. Un seul le plus souvent, deux quand la salle
    accueille deux groupes au même horaire.
  */
  .nba-schedule-cell {
    position: absolute;
    top: calc(var(--top) * 1%);
    height: calc(var(--height) * 1% - 2px);
    /*
      Les cases qui se chevauchent partiellement se partagent la largeur de la colonne.
      `right` reste automatique : la largeur est donc bien celle demandée, moins l'espace
      qui sépare deux voies.
    */
    left: calc(var(--lane) / var(--lanes) * 100%);
    width: calc(100% / var(--lanes) - 3px);
    margin-left: 2px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nba-schedule-cell-time {
    flex: 0 0 auto;
    padding: 0 0.125rem;
    font-size: 0.625rem;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--muted-foreground);
  }

  /* L'horaire vit sur la case : les créneaux empilés n'ont plus à le porter. */
  .nba-schedule-cell[data-stacked] .nba-slot-meta {
    display: none;
  }

  .nba-schedule-cell[data-stacked] .nba-slot-title {
    font-size: 0.6875rem;
  }

  .nba-schedule-cell .nba-slot {
    /* Deux groupes empilés se partagent la hauteur ; un seul la prend toute. */
    flex: 1 1 0;
    min-height: 0;
    overflow: hidden;
    border-radius: 0.25rem;
    padding: 0.25rem 0.375rem;
    line-height: 1.2;
  }

  /*
    Empilés, deux créneaux se partagent la hauteur d'un seul : la marge intérieure et
    l'interligne se resserrent pour rendre à chacun la troisième ligne de libellé qu'un
    « Groupe collège / Loisirs jeunes » réclame.
  */
  .nba-schedule-cell[data-stacked] .nba-slot {
    padding: 0.125rem 0.3125rem;
    line-height: 1.15;
  }

  /*
    Sous `lg`, une sous-colonne descend vers 77 px : un intervalle en 11 px n'y tient
    plus et, `nowrap` aidant, se ferait trancher en fin de ligne. Il passe donc d'un
    cran, comme le libellé.
  */
  @media (max-width: 1023px) {
    .nba-schedule-cell .nba-slot-title {
      font-size: 0.6875rem;
    }
    .nba-schedule-cell .nba-slot-meta {
      font-size: 0.625rem;
    }
  }

  .nba-slot-title {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
  }

  .nba-slot-meta {
    display: block;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted-foreground);
    /*
      Un intervalle horaire ne se coupe jamais : « 18:00–19:30 » réparti sur quatre
      lignes ne se lit plus comme une heure. S'il ne tient pas, il vaut mieux qu'il soit
      tronqué — la règle de gauche et l'infobulle donnent l'information de toute façon.
    */
    white-space: nowrap;
  }

  /*
    `break-word` et non `anywhere` : le second entre dans le calcul de la largeur
    minimale et coupe « Poussins » en « Poussin / s » alors même que le mot tenait.
