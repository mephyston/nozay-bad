---
import {
  isBlockColumn,
  type ColumnsBlock,
  type CmsMediaRow,
  type CmsMediaVariantRow,
  type EventAnnouncement
} from '@nba/cms/public';
import { obfuscateEmails } from '@nba/html';
import type { ScheduleSlotView, PostRow, ClubEventView } from '../../lib/cms';
import Picture from '../Picture.astro';
import PostsFeed from './PostsFeed.astro';
import Events from './Events.astro';
import Schedule from './Schedule.astro';
import Gallery from './Gallery.astro';
import PdfLink from './PdfLink.astro';
import CtaGrid from './CtaGrid.astro';

interface Props {
  block: ColumnsBlock;
  media?: Map<number, { media: CmsMediaRow; variants: CmsMediaVariantRow[] }>;
  slots?: ScheduleSlotView[];
  events?: ClubEventView[];
  /** Actualité qui annonce chaque rendez-vous, par identifiant d'événement. */
  announcements?: Map<number, EventAnnouncement>;
  /** Actualités déjà chargées par la page, par catégorie demandée ('' = toutes). */
  postsByCategory?: Map<string, PostRow[]>;
}

const {
  block,
  media = new Map(),
  slots = [],
  events = [],
  announcements = new Map<number, EventAnnouncement>(),
  postsByCategory = new Map<string, PostRow[]>()
} = Astro.props;

/**
 * Colonnes côte à côte à partir de `md`, empilées en dessous.
 *
 * Le point de bascule est `md` (768 px) et non `sm` : deux colonnes de texte sur un
 * écran de 640 px donnent des lignes de six mots, moins lisibles que la pile. C'est
 * la limite que ne franchissait pas l'ancien site, dont les `td width="45%"`
 * restaient côte à côte jusque sur un téléphone.
 *
 * Les classes sont écrites en toutes lettres et non composées : Tailwind balaie les
 * sources à la recherche de noms de classes complets, et `md:grid-cols-${n}` ne
 * produirait aucune règle.
 *
 * Le réglage de largeur ne vaut qu'à deux colonnes — la normalisation l'efface au-delà,
 * et le rendu ne le relit pas. Une colonne large s'obtient en posant la grille sur
 * **trois** pistes et en lui en faisant occuper deux : c'est ce qui donne le deux tiers
 * – un tiers de la page d'accueil, actualités à gauche et agenda à droite.
 */
const wide = block.items.length === 2 ? block.ratio : undefined;

const grid =
  block.items.length === 3 || wide === 'wide-first' || wide === 'wide-last'
    ? 'md:grid-cols-3'
    : 'md:grid-cols-2';

const spanOf = (index: number) => {
  if (wide === 'wide-first' && index === 0) return 'md:col-span-2';
  if (wide === 'wide-last' && index === block.items.length - 1) return 'md:col-span-2';
  return undefined;
};

/**
 * `sizes` accordé à la grille : chaque colonne occupe une fraction de la colonne de
 * texte (max-w-5xl, soit 1024 px) sur grand écran, toute la largeur sinon. Sans lui, le
 * navigateur téléchargerait la variante prévue pour la pleine largeur.
 */
const sizesOf = (index: number) => {
  if (spanOf(index)) return '(min-width: 768px) 640px, 100vw';
  if (grid === 'md:grid-cols-3') return '(min-width: 768px) 320px, 100vw';
  return '(min-width: 768px) 480px, 100vw';
};

/** Les actualités que réclame un bloc imbriqué, comme la page le fait au premier niveau. */
const postsFor = (categorySlug?: string) => postsByCategory.get(categorySlug ?? '') ?? [];
---

<section class="mx-auto max-w-5xl px-4 py-6">
  {block.heading && (
    <h2 class="mb-6 text-2xl font-display">{block.heading}</h2>
  )}

  <div class:list={['grid gap-6', grid]}>
    {block.items.map((column, index) => (
      /*
        `@container` sur la colonne : c'est ce qui permet à un bloc imbriqué de régler
        sa grille sur la largeur qu'il occupe **réellement**. Une grille d'actualités
        posée dans un tiers de page ne doit pas compter ses colonnes d'après la fenêtre,
        qui reste large — elle produirait trois cartes de 200 pixels.
      */
      <div class:list={['@container', spanOf(index)]}>
        {isBlockColumn(column) ? (
          /*
            Aiguillage local, et non un appel à `BlockRenderer`.

            Deux raisons. L'une technique : `BlockRenderer` rend déjà ce composant, et
            le rappeler d'ici fermerait un cycle d'imports. L'autre tient au fond — la
            liste blanche des blocs imbriquables est ici **appliquée**, et pas seulement
            déclarée : une accroche glissée dans une charge utile ne trouve aucune
            branche et ne rend rien.
          */
          <>
            {column.block.type === 'posts_feed' && (
              <PostsFeed block={column.block} posts={postsFor(column.block.categorySlug)} nested />
            )}
            {column.block.type === 'events' && <Events block={column.block} {events} {announcements} nested />}
            {column.block.type === 'schedule' && <Schedule block={column.block} {slots} nested />}
            {column.block.type === 'gallery' && <Gallery block={column.block} {media} nested />}
            {column.block.type === 'pdf_link' && <PdfLink block={column.block} {media} nested />}
            {column.block.type === 'cta_grid' && <CtaGrid block={column.block} {media} nested />}
          </>
        ) : (
          <>
            {column.mediaId && media.get(column.mediaId) && (
              <Picture
                media={media.get(column.mediaId)!.media}
                variants={media.get(column.mediaId)!.variants}
                sizes={sizesOf(index)}
                class="mb-3 h-auto w-full rounded-lg"
              />
            )}
            {/*
              Même conteneur `prose` que le bloc de texte : les colonnes doivent lire
              exactement comme un paragraphe ordinaire, à la largeur près.
            */}
            <div
              class="prose prose-neutral dark:prose-invert max-w-none"
              set:html={obfuscateEmails(column.html)}
            />
          </>
        )}
      </div>
    ))}
  </div>
</section>
