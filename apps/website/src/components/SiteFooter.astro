---
/**
 * Pied de page.
 *
 * Écrit de zéro : celui de WordPress était le contenu de démonstration du thème,
 * jamais remplacé — « Book Sales », « Rare Book Sourcing », liens morts et mention
 * « © Sports Association ». Il était en ligne et indexé.
 */
const year = new Date().getFullYear();
---
<footer class="border-border text-muted-foreground border-t text-sm">
  <div class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-8">
    <p class="text-foreground font-medium">Nozay Badminton Association</p>
    {/* Aucune adresse ici. La localité reste déclarée en données structurées
        (`jsonld.ts`), où elle sert le référencement local sans encombrer le pied
        de page. */}
    {/* Réduit aux seules obligations légales. Les réseaux sociaux viendront s'y
        ajouter plus tard ; d'ici là, mieux vaut deux liens justes qu'une rangée de
        raccourcis qui doublonnent la navigation principale. */}
    <nav aria-label="Liens de bas de page" class="flex flex-wrap gap-x-4 gap-y-1">
      <a href="/mentions-legales/" class="hover:text-foreground">Mentions légales</a>
      <a href="/politique-de-confidentialite/" class="hover:text-foreground">Politique de confidentialité</a>
    </nav>
    <p>© {year} Nozay Badminton Association</p>
  </div>
</footer>
