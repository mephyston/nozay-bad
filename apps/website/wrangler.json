{
  "name": "nba-website",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "routes": [
    {
      "pattern": "nozaybad.fr",
      "custom_domain": true
    },
    {
      "pattern": "www.nozaybad.fr",
      "custom_domain": true
    }
  ],
  "vars": {
    "SITE_URL": "https://nozaybad.fr",
    "APP_ENV": "production"
  },
  "services": [
    {
      "binding": "API_SERVICE",
      "service": "nba-api"
    }
  ],
  "ratelimits": [
    {
      "name": "SEARCH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "env": {
    "staging": {
      "name": "nba-website-staging",
      "routes": [
        {
          "pattern": "staging-www.nozaybad.fr",
          "custom_domain": true
        }
      ],
      "vars": {
        "SITE_URL": "https://staging-www.nozaybad.fr",
        "APP_ENV": "staging"
      },
      "services": [
        {
          "binding": "API_SERVICE",
          "service": "nba-api-staging"
        }
      ],
      "ratelimits": [
        {
          "name": "SEARCH_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 30,
            "period": 60
          }
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "nba-media-staging"
        }
      ]
    }
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nba-media"
    }
  ]
}
