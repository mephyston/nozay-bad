---
import Layout from '../../layouts/Layout.astro';
import AdminLayout from '../../components/AdminLayout.svelte';
import CashBoxManager from '../../components/CashBoxManager.svelte';

import { env } from 'cloudflare:workers';

const userEmail = Astro.locals.user?.email || "admin@nozay-bad.fr";
const apiService = env.API_SERVICE;

const season = Astro.url.searchParams.get('season') || '25-26';

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.json() as any;
    if (data.action === 'create') {
      const apiRes = await apiService.fetch('http://localhost/transactions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
    } else if (data.action === 'delete') {
      const apiRes = await apiService.fetch(`http://localhost/transactions/${data.id}`, {
        method: 'DELETE'
      });
      if (!apiRes.ok) {
        return new Response('Erreur suppression', { status: apiRes.status });
      }
    }
    return new Response(JSON.stringify({ success: true }));
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let transactionsList = [];
let initialBalance = 0;
let seasonsList = [];
let errorMsg = '';

try {
  // 1. Récupérer les soldes de départ de la saison
  const balancesRes = await apiService.fetch(`http://localhost/seasons/${season}/balances`);
  if (balancesRes.ok) {
    const json = await balancesRes.json() as any;
    const balances = json.data || [];
    const cashBalance = balances.find((b: any) => b.accountId === 'cash');
    initialBalance = cashBalance ? cashBalance.initialBalance : 0;
  }

  // 2. Récupérer les transactions réelles sur le compte cash
  const txRes = await apiService.fetch(`http://localhost/transactions?season=${season}&accountId=cash&limit=100`);
  if (txRes.ok) {
    const json = await txRes.json() as any;
    transactionsList = json.data || [];
  }

  // 3. Récupérer la liste des saisons
  const seasonsRes = await apiService.fetch('http://localhost/seasons');
  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasonsList = json.data || [];
  }
} catch (err: any) {
  errorMsg = 'Une erreur est survenue lors du chargement des données de la caisse.';
}
---

<Layout title="Gestion de la Caisse - NBA 91">
  <AdminLayout client:load email={userEmail}>
    <div class="space-y-6">
      {errorMsg && (
        <div class="p-4 bg-destructive/15 border border-destructive text-destructive rounded-lg">
          {errorMsg}
        </div>
      )}

      <CashBoxManager
        client:load
        initialBalance={initialBalance}
        transactions={transactionsList}
        seasonId={season}
        seasons={seasonsList}
      />
    </div>
  </AdminLayout>
</Layout>
