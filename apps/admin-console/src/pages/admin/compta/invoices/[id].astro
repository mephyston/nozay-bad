---
import Layout from '../../../../layouts/Layout.astro';
import { env } from 'cloudflare:workers';

const { id } = Astro.params;
const apiService = env.API_SERVICE;

let invoice = null;
let errorMsg = '';

try {
  const res = await apiService.fetch(`http://localhost/accounting/invoices/${id}`);
  if (!res.ok) {
    if (res.status === 404) {
      throw new Error(`Facture #${id} introuvable.`);
    }
    throw new Error('Erreur de communication avec le service API.');
  }
  const body = await res.json() as any;
  invoice = body.data;
} catch (err: any) {
  errorMsg = err.message || 'Une erreur inattendue est survenue.';
}

function formatFrenchDate(dateStr: string): string {
  if (!dateStr) return '';
  const parts = dateStr.split('-');
  if (parts.length !== 3) return dateStr;
  const year = parts[0];
  const monthNum = parseInt(parts[1], 10);
  const day = parseInt(parts[2], 10);
  const months = [
    'janvier', 'février', 'mars', 'avril', 'mai', 'juin',
    'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'
  ];
  const monthName = months[monthNum - 1] || parts[1];
  return `${day} ${monthName} ${year}`;
}
---

<Layout title={invoice ? `Facture ${invoice.invoiceNumber}` : "Facture Introuvable"}>
  <div class="min-h-screen bg-white text-slate-900 p-8 sm:p-12 md:p-16 max-w-[210mm] mx-auto print:p-0 print:m-0 print:max-w-full print:bg-transparent font-sans">
    
    <!-- Float Print Button -->
    <button 
      onclick="window.print()" 
      class="no-print fixed bottom-8 right-8 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-full shadow-lg transition-all duration-200 flex items-center gap-2 cursor-pointer z-50 hover:scale-105"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
      </svg>
      Imprimer cette facture
    </button>

    {errorMsg && (
      <div class="p-6 bg-red-50 border border-red-200 text-red-700 rounded-lg max-w-lg mx-auto mt-12 no-print">
        <h2 class="text-lg font-bold mb-2">Erreur</h2>
        <p>{errorMsg}</p>
        <a href="/admin/compta/invoices" class="mt-4 inline-block text-blue-600 hover:underline">&larr; Retour aux factures</a>
      </div>
    )}

    {invoice && (
      <div class="space-y-12">
        <!-- Header -->
        <div class="flex justify-between items-start gap-8 border-b-2 border-slate-100 pb-8">
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <img src="/images/logo-nba.jpg" alt="Nozay Badminton Logo" class="w-16 h-16 object-contain shrink-0" />
              <div>
                <h1 class="text-xl font-bold tracking-tight text-blue-950 font-serif leading-none">Nozay Badminton</h1>
                <p class="text-[10px] text-slate-500 font-semibold tracking-wider uppercase mt-1">Nozay Badminton Association</p>
              </div>
            </div>
            <div class="text-xs text-slate-600 leading-relaxed font-mono">
              <p>Adresse : Mairie de Nozay, 91620 NOZAY</p>
              <p>Site web : <a href="https://sites.google.com/site/nozaybad/" target="_blank" class="text-blue-600 hover:underline">https://sites.google.com/site/nozaybad/</a></p>
              <p>Association N° 0913011863</p>
              <p>Agrément DDJS : 91 S 744</p>
              <p>Affiliation FFBaD : LIFB.91.96.018</p>
              <p>SIRET : 43321871600010</p>
            </div>
          </div>

          <!-- Top Right logos -->
          <div class="flex flex-wrap items-center justify-end gap-3 max-w-sm pt-2">
            <img src="/images/logo-nozay.png" alt="Nozay" class="h-10 object-contain" />
            <img src="/images/logo-essonne.jpg" alt="Essonne" class="h-10 object-contain" />
            <img src="/images/logo-idf.png" alt="Île-de-France" class="h-6 object-contain" />
            <img src="/images/logo-efb.png" alt="EFB" class="h-12 object-contain" />
          </div>
        </div>

        <!-- Client & Meta Info -->
        <div class="grid grid-cols-2 gap-8 items-start">
          <div class="space-y-4">
            <div class="bg-slate-50 border border-slate-100 p-4 rounded-xl font-mono text-xs space-y-1 max-w-sm">
              <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block mb-1">Informations Facture</span>
              <p><span class="text-slate-500">Date :</span> <strong class="text-slate-800">{formatFrenchDate(invoice.date)}</strong></p>
              <p><span class="text-slate-500">Date d'échéance :</span> <span class="text-slate-800">{formatFrenchDate(invoice.dueDate)}</span></p>
              <div class="mt-3 pt-3 border-t border-slate-200/60">
                <span class="inline-block bg-slate-200 text-slate-800 font-bold px-3 py-1 rounded text-xs font-mono">
                  {invoice.invoiceNumber}
                </span>
              </div>
            </div>
          </div>

          <div class="space-y-2 text-right">
            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">A l'attention de</span>
            <div class="text-sm font-semibold text-slate-900 font-serif">
              {invoice.clientName}
            </div>
            {invoice.clientAddress && (
              <div class="text-xs text-slate-600 leading-relaxed max-w-xs ml-auto whitespace-pre-line">
                {invoice.clientAddress}
              </div>
            )}
            {invoice.clientEmail && (
              <div class="text-xs text-blue-600">
                {invoice.clientEmail}
              </div>
            )}
          </div>
        </div>

        <!-- Details list (Subject, Location, etc.) -->
        <div class="bg-slate-50/50 rounded-xl p-6 border border-slate-100 space-y-2 text-sm leading-relaxed">
          <p><strong class="text-slate-700">Objet :</strong> <span class="text-slate-900 font-medium">{invoice.subject || '—'}</span></p>
          {invoice.location && (
            <p><strong class="text-slate-700">Lieu :</strong> <span class="text-slate-900">{invoice.location}</span></p>
          )}
          {invoice.period && (
            <p><strong class="text-slate-700">Date :</strong> <span class="text-slate-900">{invoice.period}</span></p>
          )}
          {invoice.attendees && (
            <p><strong class="text-slate-700">Personnes concernées :</strong> <span class="text-slate-900">{invoice.attendees}</span></p>
          )}
        </div>

        <!-- Table of items -->
        <div class="space-y-4">
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400">Montant détaillé</h2>
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="border-b-2 border-slate-200 text-slate-500 font-semibold uppercase tracking-wider text-[10px]">
                <th class="py-3 pr-4">Description</th>
                <th class="py-3 px-4 text-center w-24">Quantité</th>
                <th class="py-3 px-4 text-right w-32">Prix unitaire</th>
                <th class="py-3 pl-4 text-right w-32">Total</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {invoice.items && invoice.items.length > 0 ? (
                invoice.items.map((item: any) => (
                  <tr class="text-slate-800">
                    <td class="py-4 pr-4 font-medium">{item.description}</td>
                    <td class="py-4 px-4 text-center text-slate-500">{item.quantity}</td>
                    <td class="py-4 px-4 text-right font-mono text-slate-600">{(item.unitPrice / 100).toFixed(2)} €</td>
                    <td class="py-4 pl-4 text-right font-mono font-semibold">{(item.totalPrice / 100).toFixed(2)} €</td>
                  </tr>
                ))
              ) : (
                <tr class="text-slate-800">
                  <td class="py-4 pr-4 font-medium">Prestation de services</td>
                  <td class="py-4 px-4 text-center text-slate-500">1</td>
                  <td class="py-4 px-4 text-right font-mono text-slate-600">{(invoice.totalAmount / 100).toFixed(2)} €</td>
                  <td class="py-4 pl-4 text-right font-mono font-semibold">{(invoice.totalAmount / 100).toFixed(2)} €</td>
                </tr>
              )}
            </tbody>
          </table>

          <!-- Total section -->
          <div class="flex justify-end pt-4">
            <div class="bg-slate-900 text-white font-mono text-base px-6 py-3 rounded-lg flex items-center gap-8 shadow-sm">
              <span class="font-sans font-bold uppercase tracking-wider text-xs text-slate-400">Total</span>
              <strong class="text-lg">{(invoice.totalAmount / 100).toFixed(2)} €</strong>
            </div>
          </div>
        </div>

        <!-- Bank details & Settlement information -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-8 border-t border-slate-100 text-sm">
          <div class="space-y-3">
            <h3 class="font-bold text-slate-800 uppercase tracking-wider text-[11px]">Règlement Virement</h3>
            <div class="bg-slate-50 border border-slate-100 rounded-xl p-4 font-mono text-xs space-y-1 text-slate-700">
              <p class="font-semibold text-slate-800 uppercase tracking-wider text-[9px] mb-2 text-slate-400">Coordonnées bancaires</p>
              <p><span class="text-slate-400">Nom :</span> <strong class="text-slate-800">Société Générale</strong></p>
              <p><span class="text-slate-400">IBAN :</span> <strong class="text-slate-800">FR76 3000 3008 4600 0500 0784 720</strong></p>
              <p><span class="text-slate-400">BIC :</span> <strong class="text-slate-800">SOGEFRPP</strong></p>
            </div>
            <p class="text-xs text-slate-500 italic mt-1">Merci d'indiquer le numéro de facture dans le motif du virement.</p>
          </div>

          <div class="flex flex-col justify-end text-right md:items-end">
            <!-- VAT exemption mention -->
            <p class="text-xs font-semibold text-slate-500 max-w-xs leading-relaxed italic">
              Association exonérée de TVA - Art. 261-7-1° du CGI
            </p>
          </div>
        </div>
      </div>
    )}
  </div>
</Layout>

<style is:global>
  @media print {
    .no-print {
      display: none !important;
    }
    body {
      background-color: white !important;
      color: black !important;
    }
  }
</style>
