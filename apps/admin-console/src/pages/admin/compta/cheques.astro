---
import Layout from '../../../layouts/Layout.astro';
import AdminLayout from '../../../components/AdminLayout.svelte';
import CheckDepositManager from '../../../components/CheckDepositManager.svelte';

import { env } from 'cloudflare:workers';

const userEmail = Astro.locals.user?.email || "admin@nozay-bad.fr";
const apiService = env.API_SERVICE;

const season = Astro.url.searchParams.get('season') || '25-26';

if (Astro.request.method === 'POST') {
  try {
    const actionHeader = Astro.request.headers.get('x-action');

    // Action 1: Vision AI analysis
    if (actionHeader === 'analyze') {
      const formData = await Astro.request.formData();
      const apiRes = await apiService.fetch('http://localhost/checks/analyze', {
        method: 'POST',
        body: formData as any
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
      return new Response(await apiRes.text(), {
        headers: { 'Content-Type': 'application/json' }
      });
    }

    // Action 2: Standard JSON API requests
    const data = await Astro.request.json() as any;

    if (data.action === 'create-check') {
      const apiRes = await apiService.fetch('http://localhost/checks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
    } else if (data.action === 'delete-check') {
      const apiRes = await apiService.fetch(`http://localhost/checks/${data.id}`, {
        method: 'DELETE'
      });
      if (!apiRes.ok) {
        return new Response('Erreur suppression chèque', { status: apiRes.status });
      }
    } else if (data.action === 'create-deposit') {
      const apiRes = await apiService.fetch('http://localhost/check-deposits', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
    } else if (data.action === 'delete-deposit') {
      const apiRes = await apiService.fetch(`http://localhost/check-deposits/${data.id}/delete`, {
        method: 'POST'
      });
      if (!apiRes.ok) {
        return new Response('Erreur suppression bordereau', { status: apiRes.status });
      }
    } else if (data.action === 'clear-deposit') {
      const apiRes = await apiService.fetch(`http://localhost/check-deposits/${data.id}/clear`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (!apiRes.ok) {
        return new Response(await apiRes.text(), { status: apiRes.status });
      }
    }

    return new Response(JSON.stringify({ success: true }));
  } catch (err: any) {
    return new Response(err.message, { status: 500 });
  }
}

let checksList = [];
let depositsList = [];
let membersList = [];
let seasonsList = [];
let pendingBankTx = [];
let errorMsg = '';

try {
  // 1. Récupérer les chèques de la saison
  const checksRes = await apiService.fetch(`http://localhost/checks?season=${season}`);
  if (checksRes.ok) {
    const json = await checksRes.json() as any;
    checksList = json.data || [];
  }

  // 2. Récupérer les remises de chèques de la saison
  const depositsRes = await apiService.fetch(`http://localhost/check-deposits?season=${season}`);
  if (depositsRes.ok) {
    const json = await depositsRes.json() as any;
    depositsList = json.data || [];
  }

  // 3. Récupérer les adhérents pour le select
  const membersRes = await apiService.fetch(`http://localhost/members?limit=1000&season=${season}`);
  if (membersRes.ok) {
    const json = await membersRes.json() as any;
    membersList = json.data || [];
  }

  // 4. Récupérer les saisons
  const seasonsRes = await apiService.fetch('http://localhost/seasons');
  if (seasonsRes.ok) {
    const json = await seasonsRes.json() as any;
    seasonsList = json.data || [];
  }

  // 5. Récupérer les écritures bancaires de crédit en attente (supérieures à 0)
  const bankTxRes = await apiService.fetch(`http://localhost/bank-transactions?season=${season}`);
  if (bankTxRes.ok) {
    const json = await bankTxRes.json() as any;
    const allBankTx = json.data || [];
    pendingBankTx = allBankTx.filter((tx: any) => tx.status === 'pending' && tx.amount > 0);
  }
} catch (err: any) {
  errorMsg = 'Erreur lors de la récupération des données de remise de chèques.';
}
---

<Layout title="Remises de Chèques - NBA 91">
  <AdminLayout client:load email={userEmail} breadcrumb="Comptabilité / Remises de chèques">
    <div class="space-y-6">
      {errorMsg && (
        <div class="p-4 bg-destructive/15 border border-destructive text-destructive rounded-lg">
          {errorMsg}
        </div>
      )}

      <CheckDepositManager
        client:load
        seasonId={season}
        seasons={seasonsList}
        checks={checksList}
        checkDeposits={depositsList}
        members={membersList}
        pendingBankTransactions={pendingBankTx}
      />
    </div>
  </AdminLayout>
</Layout>
