{
  "name": "nba-admin-console",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "routes": [
    {
      "pattern": "dashboard.nozaybad.fr",
      "custom_domain": true
    }
  ],
  "services": [
    { "binding": "API_SERVICE", "service": "nba-api" }
  ],
  "kv_namespaces": [
    { "binding": "SESSION", "id": "99e6af4a54a94260a15b2f21224eeb43" }
  ],
  "env": {
    "staging": {
      "name": "nba-admin-console-staging",
      "routes": [
        {
          "pattern": "staging-dashboard.nozaybad.fr",
          "custom_domain": true
        }
      ],
      "services": [
        { "binding": "API_SERVICE", "service": "nba-api-staging" }
      ],
      "kv_namespaces": [
        { "binding": "SESSION", "id": "d434276dcda343cda761a895fe99912d" }
      ]
    }
  }
}
