# =============================================================================
# nozay-bad — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs pour le développement.
# Ne jamais committer de fichier contenant de vraies valeurs.
# =============================================================================

# ---------------------------------------------------------------------------
# API Worker (apps/api)
# Configuré via wrangler.dev.json pour le local, secrets Cloudflare en prod.
# ---------------------------------------------------------------------------
# Clé d'API secrète partagée inter-services (admin / storefront -> api)
# Définir avec wrangler secret put en production et staging :
#   npx wrangler secret put INTERNAL_API_KEY --name nba-api
#   npx wrangler secret put INTERNAL_API_KEY --name nba-admin
#   npx wrangler secret put INTERNAL_API_KEY --name nba-storefront
INTERNAL_API_KEY=
API_URL=

# ---------------------------------------------------------------------------
# Admin Console (apps/admin-console) — Cloudflare Access
# Ces variables sont injectées comme secrets Wrangler en production.
# En développement, le middleware bypasse l'auth (import.meta.env.DEV = true).
# ---------------------------------------------------------------------------

# URL de votre organisation Cloudflare Access (sans slash final)
# Exemple : https://monclub.cloudflareaccess.com
CF_TEAM_DOMAIN=

# Audience du service admin-console dans votre policy Cloudflare Access
# À récupérer dans : Cloudflare Zero Trust > Access > Applications > [votre app] > Overview
CF_AUDIENCE=

# ---------------------------------------------------------------------------
# Storefront / Boutique (apps/storefront) — Cloudflare Turnstile
# La clé secrète TURNSTILE_SECRET_KEY doit être définie en secret Wrangler :
#   Production : npx wrangler secret put TURNSTILE_SECRET_KEY --name nba-boutique
#   Staging    : npx wrangler secret put TURNSTILE_SECRET_KEY --name nba-boutique-staging
# La clé publique est dans le HTML (visible côté client, c'est normal).
# ---------------------------------------------------------------------------

# Clé publique Turnstile (sitekey) — visible dans le HTML
PUBLIC_TURNSTILE_SITE_KEY=

# URL de l'API de vérification siteverify Turnstile (optionnel, par défaut official endpoint)
PUBLIC_TURNSTILE_SITEVERIFY_URL=https://turnstile.cloudflare.com/turnstile/v0/siteverify

# Clé secrète Turnstile — à poser via wrangler secret put (PAS de préfixe PUBLIC_)
# Production : npx wrangler secret put TURNSTILE_SECRET_KEY --name nba-boutique
# Staging    : npx wrangler secret put TURNSTILE_SECRET_KEY --name nba-boutique-staging
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# - Les bindings D1, Service Bindings, KV et AI sont déclarés dans wrangler.*.json :
#     • Production KV Rate Limiting : nba-rate-limit-kv (id: 281c9992dd914501a709ef8f03fe2ab8)
#     • Staging KV Rate Limiting    : nba-rate-limit-kv-staging (id: e1f0b19b7ea44399ba66d10fe7907ce9)
# - Les vraies valeurs de production sont à définir via :
#     wrangler secret put CF_TEAM_DOMAIN --name nba-admin-console
#     wrangler secret put CF_AUDIENCE --name nba-admin-console
# - Voir la documentation Cloudflare :
#     https://developers.cloudflare.com/workers/configuration/secrets/
