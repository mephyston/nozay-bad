# =============================================================================
# nozay-bad — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs pour le développement.
# Ne jamais committer de fichier contenant de vraies valeurs.
# =============================================================================

# ---------------------------------------------------------------------------
# API Worker (apps/api)
# Configuré via wrangler.dev.json pour le local, secrets Cloudflare en prod.
# ---------------------------------------------------------------------------
# Clé d'API secrète partagée inter-services (admin / storefront -> api)
# Définir avec wrangler secret put en production et staging :
#   npx wrangler secret put INTERNAL_API_KEY --name nba-api
#   npx wrangler secret put INTERNAL_API_KEY --name nba-admin
#   npx wrangler secret put INTERNAL_API_KEY --name nba-storefront
INTERNAL_API_KEY=
API_URL=

# ---------------------------------------------------------------------------
# Admin Console (apps/admin-console) — Cloudflare Access
# Ces variables sont injectées comme secrets Wrangler en production.
# En développement, le middleware bypasse l'auth (import.meta.env.DEV = true).
# ---------------------------------------------------------------------------

# URL de votre organisation Cloudflare Access (sans slash final)
# Exemple : https://monclub.cloudflareaccess.com
CF_TEAM_DOMAIN=

# Audience du service admin-console dans votre policy Cloudflare Access
# À récupérer dans : Cloudflare Zero Trust > Access > Applications > [votre app] > Overview
CF_AUDIENCE=

# ---------------------------------------------------------------------------
# Storefront / Boutique (apps/storefront) — Cloudflare Turnstile
# La clé secrète TURNSTILE_SECRET_KEY doit être définie en secret Wrangler :
#   Production : npx wrangler secret put TURNSTILE_SECRET_KEY --name nba-boutique
#   Staging    : npx wrangler secret put TURNSTILE_SECRET_KEY --name nba-boutique-staging
# La clé publique est dans le HTML (visible côté client, c'est normal).
# ---------------------------------------------------------------------------

# Clé publique Turnstile (sitekey) — visible dans le HTML
PUBLIC_TURNSTILE_SITE_KEY=

# URL de l'API de vérification siteverify Turnstile (optionnel, par défaut official endpoint)
PUBLIC_TURNSTILE_SITEVERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Clé secrète Turnstile — à poser via wrangler secret put (PAS de préfixe PUBLIC_)
# Production : npx wrangler secret put TURNSTILE_SECRET_KEY --name nba-boutique
# Staging    : npx wrangler secret put TURNSTILE_SECRET_KEY --name nba-boutique-staging
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Authentification storefront (OTP email passwordless)
# ---------------------------------------------------------------------------
# Clé API Resend pour l'envoi des codes OTP — secret (PAS de préfixe PUBLIC_).
#   Production : npx wrangler secret put RESEND_API_KEY --name nba-storefront
#   Staging    : npx wrangler secret put RESEND_API_KEY --name nba-storefront-staging
RESEND_API_KEY=

# Secret de signature des cookies de session (JWT HS256) — chaîne aléatoire longue.
#   openssl rand -hex 32
#   Production : npx wrangler secret put SESSION_SECRET --name nba-storefront
#   Staging    : npx wrangler secret put SESSION_SECRET --name nba-storefront-staging
SESSION_SECRET=

# Adresse expéditrice des emails (domaine vérifié dans Resend). Déclarée en `vars`
# dans wrangler.json ; surchargeable ici en local.
EMAIL_FROM="Nozay Badminton Association <tresorier@nozaybad.fr>"

# Garde-fou anti-envoi hors production (fail-closed). Déclaré en `vars` par env :
#   - Production : EMAIL_MODE=live      (envoi réel aux adhérents)
#   - Staging    : EMAIL_MODE=dry-run   (jamais d'envoi ; OTP visible via `wrangler tail`)
#   - Local      : laisser vide → dry-run par défaut
# Pour tester un envoi réel en staging SANS toucher les adhérents, passer en :
#   EMAIL_MODE=allowlist + EMAIL_ALLOWLIST=ton.email@perso.fr,autre@perso.fr
#   (seules ces adresses reçoivent ; tout autre destinataire est ignoré)
# Ou rediriger TOUT vers une boîte de test :
#   EMAIL_MODE=redirect + EMAIL_TEST_INBOX=ta.boite.test@perso.fr
EMAIL_MODE=
EMAIL_ALLOWLIST=
EMAIL_TEST_INBOX=

# ---------------------------------------------------------------------------
# Drapeaux de fonctionnalité (apps/api, apps/storefront, apps/admin)
# ---------------------------------------------------------------------------
# Fonctionnalités du club : ce n'est plus une variable.
#
# Jeu libre, séances individuelles, boutique, interclubs, rappels… s'allument et
# s'éteignent depuis l'administration (Réglages → Configuration du club →
# Fonctionnalités), en base (`club_features`). Les anciens drapeaux
# OPEN_PLAY_ENABLED, INDIV_ENABLED et PUSH_*_ENABLED n'existent plus côté API.
#
# Seul reste un interrupteur d'ENVIRONNEMENT pour les envois programmés du cron :
# « true » en production, « false » en préproduction dont la base est un clone de la
# production. Fermé par défaut : toute valeur autre que « true » éteint.
SCHEDULED_SENDS_ENABLED=

# L'espace adhérent garde un drapeau de LIVRAISON pour les séances individuelles :
# l'entraîneur prépare ses soirées depuis l'admin, les adhérents ne doivent pas encore
# les voir. INDIV_ENABLED=true dans `apps/storefront/.dev.vars` pour développer dessus.
# À retirer quand la fonctionnalité ouvre aux adhérents ; le réglage du club prendra
# alors seul le relais.
INDIV_ENABLED=

# ---------------------------------------------------------------------------
# Autorisation RBAC (apps/api, apps/admin)
# ---------------------------------------------------------------------------
# Mode d'application de l'autorisation par route dans l'API.
#   - vide ou « enforce » (défaut) : les refus s'appliquent
#   - « log » : rien n'est refusé, chaque refus qui aurait eu lieu est journalisé
# Le mode « log » sert uniquement à répéter une mise en service sur un environnement
# de recette : le laisser en production reviendrait à désactiver l'autorisation.
RBAC_ENFORCE=

# Développement uniquement (apps/admin). En local, le jeton Cloudflare Access n'est
# pas vérifié ; ces variables décident de l'identité empruntée. Le contrôle des
# droits, lui, s'applique exactement comme en production.
#   DEV_EMAIL : adresse utilisée à défaut de cookie d'usurpation
#   DEV_ROLE  : rôle appliqué quand cette adresse n'a pas de compte en base
#               (super_admin | president | tresorier | secretaire | membre)
# Exemple pour vérifier ce que voit un trésorier : DEV_ROLE=tresorier npm run dev:admin
DEV_EMAIL=
DEV_ROLE=

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# - Les bindings D1, Service Bindings, KV et AI sont déclarés dans wrangler.*.json :
#     • Production KV Rate Limiting : nba-rate-limit-kv (id: 281c9992dd914501a709ef8f03fe2ab8)
#     • Staging KV Rate Limiting    : nba-rate-limit-kv-staging (id: e1f0b19b7ea44399ba66d10fe7907ce9)
# - Les vraies valeurs de production sont à définir via :
#     wrangler secret put CF_TEAM_DOMAIN --name nba-admin-console
#     wrangler secret put CF_AUDIENCE --name nba-admin-console
# - Voir la documentation Cloudflare :
#     https://developers.cloudflare.com/workers/configuration/secrets/

# Secret de signature des liens d'aperçu du site public.
# Posé par `wrangler secret put` sur nba-admin* (qui signe) et nba-website* (qui
# vérifie). Sans lui, l'aperçu d'un brouillon est simplement indisponible.
PREVIEW_TOKEN_SECRET=

# Analytique Cloudflare — alimente la page « Consommation de la plateforme » de
# l'administration (requêtes Workers, temps CPU, lignes D1, le tout rapporté aux quotas
# du plan gratuit). Jeton en LECTURE SEULE, mais à portée compte : il voit tous les
# Workers hébergés. Portées requises : Account Analytics: Read.
#   npx wrangler secret put CLOUDFLARE_ANALYTICS_TOKEN --name nba-api
# L'identifiant de compte, lui, n'est pas un secret : il est déclaré en `vars` dans
# apps/api/wrangler.json.
CLOUDFLARE_ANALYTICS_TOKEN=
