    "@storybook/addon-themes": "^10.6.6",
    "@storybook/svelte-vite": "^10.6.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@vite-pwa/astro": "^1.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "fast-xml-parser": "^5.12.0",
    "globals": "^17.14.0",
