#!/bin/sh
# Joue en local, AVANT que le push ne parte, ce que la CI jouerait côté runner :
# garde-fous, typecheck, tests d'architecture, puis les tests affectés par rapport
# à la branche distante. Un échec ici coûte quelques minutes de poste de travail ;
# le même échec côté runner coûte des minutes Actions facturées et bloque staging.
#
# Contournement ponctuel (hotfix urgent, CI assumée) : git push --no-verify
set -e

echo "[pre-push] garde-fous…"
node scripts/check-env-declarations.js
node scripts/check-migrations-append-only.js
node scripts/check-schema-integrity.js
node scripts/check-nx-deps.js
node scripts/check-aliases.js
node scripts/patch-wrangler.mjs --check

echo "[pre-push] typecheck…"
npm run typecheck

# Les fichiers .astro échappent à `tsc` : ni son typecheck, ni le build, ni les tests ne
# voient un identifiant manquant dans un frontmatter. Une page ainsi cassée compile, se
# déploie, et tombe en 500 au premier chargement — c'est arrivé le 30/08/2026 sur l'écran
# des menus. `astro check` est le seul des quatre contrôles à l'attraper.
echo "[pre-push] contrôle des fichiers .astro…"
npx nx run-many -t check --projects=admin,website,storefront

echo "[pre-push] tests d'architecture…"
npx vitest run --config vitest.architecture.config.ts

# ESLint, comme en CI : --max-warnings 0, graphe Nx calculé d'abord (sans lui, la règle
# du plugin Nx se tait sur un simple avertissement).
echo "[pre-push] eslint…"
npx nx show projects > /dev/null
npx eslint . --max-warnings 0

# Secrets dans les commits qui vont partir. Le pre-commit a vu chaque commit ; ceci
# rattrape un --no-verify, un commit fait ailleurs, ou un poste sans gitleaks.
if command -v gitleaks >/dev/null 2>&1; then
  echo "[pre-push] secrets…"
  RANGE_BASE=$(git merge-base HEAD "@{upstream}" 2>/dev/null || git merge-base HEAD origin/main 2>/dev/null || echo "")
  if [ -n "$RANGE_BASE" ] && [ "$RANGE_BASE" != "$(git rev-parse HEAD)" ]; then
    gitleaks git --no-banner --redact --config .gitleaks.toml --log-opts="${RANGE_BASE}..HEAD"
  fi
else
  echo "[pre-push] gitleaks absent (brew install gitleaks) : pas de contrôle local des secrets." >&2
fi

# Base de comparaison : le point de divergence avec la branche amont si elle existe,
# sinon le commit précédent (première poussée d'une branche).
BASE=$(git merge-base HEAD "@{upstream}" 2>/dev/null || git rev-parse HEAD~1 2>/dev/null || echo "")
if [ -n "$BASE" ]; then
  echo "[pre-push] tests affectés depuis ${BASE}…"
  npx vitest run --changed "$BASE" --passWithNoTests
else
  echo "[pre-push] pas de base de comparaison : suite complète…"
  npx vitest run
fi

echo "[pre-push] OK — push autorisé."
